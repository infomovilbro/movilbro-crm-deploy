  // ========== ENRICH ORDERS WITH DRAFT ORDER DATA ==========
  window.enrichOrders = function enrichOrders() {
    var cid = typeof clientId !== 'undefined' ? clientId : (typeof window.clientIdGlobal !== 'undefined' ? window.clientIdGlobal : '');
    if (!cid) { var fb = document.querySelector('.ver-consumo'); if (fb) cid = fb.dataset.client; }
    if (!cid) return;
    var rows = document.querySelectorAll('#ordenes tbody tr');
    rows.forEach(function(row) {
      var idCell = row.querySelector('td:nth-child(1) small');
      if (!idCell) return;
      var fullId = (idCell.textContent || '').trim();
      var productCell = row.querySelector('td:nth-child(3)');
      var lineCell = row.querySelector('td:nth-child(4)');
      if (!productCell) return;
      // Si la celda YA tiene datos (no es '-' y no es un spinner), saltar
      var txt = (productCell.textContent || '').trim();
      if (txt && txt !== '-' && !productCell.querySelector('.spinner-border')) return;
      // Try to find the full order ID from the Ver detalle button
      var detBtn = row.querySelector('button[onclick*="verResumenOrden"]');
      if (!detBtn) return;
      var clickAttr = detBtn.getAttribute('onclick') || '';
      var matchO = clickAttr.match(/verResumenOrden\('([^']+)'\)/);
      var orderId = matchO ? matchO[1] : fullId;
      if (!orderId) return;
      productCell.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
      var cidFetch = (typeof clientId !== 'undefined' ? clientId : '') || (window.clientId || '');
      fetch('/clientes/' + cidFetch + '/order/' + encodeURIComponent(orderId) + '/summary')
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var order = res.data;
            var prods = [];
            if (order.products && Array.isArray(order.products)) {
              order.products.forEach(function(p) {
                if (p.productName) prods.push(p.productName);
                if (p.optionalProducts && Array.isArray(p.optionalProducts)) {
                  p.optionalProducts.forEach(function(op) {
                    if (op.productName) prods.push(op.productName);
                  });
                }
              });
            }
            if (prods.length > 0) {
              productCell.textContent = prods.join(', ').substring(0, 80);
              productCell.title = prods.join(', ');
            } else {
              productCell.textContent = '-';
            }
            // Try to get line number
            var lines = [];
            if (order.products && Array.isArray(order.products)) {
              order.products.forEach(function(p) {
                if (p.fixedNumber) lines.push(p.fixedNumber);
                if (p.optionalProducts && Array.isArray(p.optionalProducts)) {
                  p.optionalProducts.forEach(function(op) {
                    if (op.fixedNumber) lines.push(op.fixedNumber);
                  });
                }
              });
            }
            if (lines.length > 0 && lineCell) lineCell.textContent = lines.join(', ');
          }
        }).catch(function() { if (productCell) productCell.textContent = '-'; });
    });
  }
  // Ejecutar al cargar la pagina y cuando se muestre la pestaña
  enrichOrders();
  document.getElementById('ordenes-tab')?.addEventListener('shown.bs.tab', enrichOrders);

