function cargarConsumoModal(line) {
  if (!line) return;
  // 1) Cargar info de linea
  fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/info', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.data) {
        var d = res.data;
        document.getElementById('consLineInfoCard').style.display = '';
        document.getElementById('consLineTitular').textContent = d.titular || d.holderName || d.clientName || '-';
        document.getElementById('consLineDni').textContent = d.dni || d.fiscalId || '-';
        document.getElementById('consLineSpn').textContent = d.spn || d.operator || '-';
        document.getElementById('consLineStatus').textContent = d.status || d.estado || '-';
        document.getElementById('consLineSim').textContent = d.iccid || d.sim || d.icc || '-';
        document.getElementById('consLinePin').textContent = d.pin || d.pinCode || '-';
        document.getElementById('consLinePuk').textContent = d.puk || d.pukCode || '-';
        document.getElementById('consLineCreditLimit').textContent = d.creditLimit || d.credit_limit || '-';
      } else { document.getElementById('consLineInfoCard').style.display = 'none'; }
    }).catch(function() { document.getElementById('consLineInfoCard').style.display = 'none'; });
  // 2) Cargar consumo GB
  fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/consumption', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.data) {
        var gb = parseGBData(res.data);
        document.getElementById('consTotalGB').textContent = gb.total ? gb.total.toFixed(2) + ' GB' : '-';
        document.getElementById('consUsedGB').textContent = gb.used ? gb.used.toFixed(2) + ' GB' : '-';
        document.getElementById('consRemainingGB').textContent = (gb.remaining || (gb.total - gb.used)) ? (gb.remaining || (gb.total - gb.used)).toFixed(2) + ' GB' : '-';
        document.getElementById('consRoamingGB').textContent = gb.roaming ? gb.roaming.toFixed(2) + ' GB' : '-';
        if (typeof Chart !== 'undefined') {
          var consCtx = document.getElementById('consGBChart');
          if (consCtx) {
            if (_consChartInstance) { _consChartInstance.destroy(); }
            _consChartInstance = new Chart(consCtx, {
              type: 'bar',
              data: { labels: ['Totales', 'Usados', 'Restantes'],
                datasets: [{ label: 'GB', data: [gb.total || 0, gb.used || 0, gb.remaining || Math.max(0, (gb.total||0) - (gb.used||0))],
                  backgroundColor: ['#17a2b8', '#ffc107', '#28a745'] }]
              },
              options: { animation: false, responsive: true, maintainAspectRatio: false, indexAxis: 'y',
                plugins: { legend: { display: false } } }
            });
          }
        }
      } else { document.getElementById('consTotalGB').textContent = 'Error'; }
    }).catch(function() { document.getElementById('consTotalGB').textContent = 'Error'; });
  // 3) Cargar CDRs
  fetchCDRData(line, document.getElementById('cdrsBody'));
  // 4) Cargar consumo diario con navegacion de meses y grafico interactivo
  var dailyBody2 = document.getElementById('consDailyBody2');
  if (dailyBody2) {
    dailyBody2.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Cargando...</td></tr>';
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/daily-consumption', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok && res.data && res.data.length > 0) {
          window._dailyData = res.data;
          window._dailyMesActual = -1; // -1 = ultimo mes disponible
          renderDailyView();
        } else { dailyBody2.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin consumo diario</td></tr>'; }
      }).catch(function() {
        if (dailyBody2) dailyBody2.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Error al cargar consumo diario</td></tr>';
      });
  }
};

// ===== FUNCIONES AYUDA CONSUMO DIARIO =====
window.renderDailyView = function renderDailyView() {
  var data = window._dailyData || [];
  if (data.length === 0) return;
  var meses = {};
  data.forEach(function(d) {
    if (d.date && d.date.length >= 7) {
      var m = d.date.substring(0, 7);
      meses[m] = (meses[m] || 0) + 1;
    }
  });
  var mesesArr = Object.keys(meses).sort();
  if (mesesArr.length === 0) return;
  if (window._dailyMesActual === -1 || window._dailyMesActual >= mesesArr.length) window._dailyMesActual = mesesArr.length - 1;
  var mesSel = mesesArr[window._dailyMesActual];
  var mesData = data.filter(function(d) { return d.date && d.date.substring(0, 7) === mesSel; });
  var labelMes = mesSel.substring(0, 4) + '/' + mesSel.substring(5, 7);
  var tipoSel = 'gb';
  var rb = document.querySelector('input[name="dailyChartType"]:checked');
  if (rb) tipoSel = rb.value;
  renderDailyChart(mesData, tipoSel, mesSel);
  renderDailyTable(mesData, tipoSel);
  var navHtml = '<div style="display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:6px;">';
  navHtml += '<button class="btn btn-sm btn-outline-secondary" onclick="navegarMes(-1)" ' + (window._dailyMesActual <= 0 ? 'disabled' : '') + '><i class="bi bi-chevron-left"></i></button>';
  navHtml += '<span class="fw-semibold">' + labelMes + '</span>';
  navHtml += '<button class="btn btn-sm btn-outline-secondary" onclick="navegarMes(1)" ' + (window._dailyMesActual >= mesesArr.length - 1 ? 'disabled' : '') + '><i class="bi bi-chevron-right"></i></button>';
  navHtml += '</div>';
  var navContainer = document.getElementById('dailyMonthNav');
  if (!navContainer) {
    navContainer = document.createElement('div');
    navContainer.id = 'dailyMonthNav';
    var dcEl = document.getElementById('consDailyChart');
    if (dcEl && dcEl.parentNode) dcEl.parentNode.insertBefore(navContainer, dcEl);
  }
  navContainer.innerHTML = navHtml;
}

function renderDailyChart(mesData, tipo, mesSel) {
  if (typeof Chart === 'undefined') return;
  var dcCtx = document.getElementById('consDailyChart');
  if (!dcCtx) return;
  try { if (window._dailyChart) window._dailyChart.destroy(); } catch(e) {}
  var labels = mesData.map(function(d) { var p = d.date.split('-'); return p[2] + '/' + p[1]; });
  var valores = mesData.map(function(d) { return d[tipo] || 0; });
  var colores = { gb: '#06b6d4', calls: '#8b5cf6', sms: '#10b981' };
  var etiquetas = { gb: 'GB', calls: 'Llamadas', sms: 'SMS' };
  window._dailyChart = new Chart(dcCtx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [{ label: etiquetas[tipo] || tipo, data: valores, backgroundColor: colores[tipo] || '#06b6d4', borderRadius: 3 }]
    },
    options: {
      animation: false, responsive: true, maintainAspectRatio: false,
      onClick: function(e, items) {
        if (items && items.length > 0) {
          var idx = items[0].dataIndex;
          var diaData = mesData[idx];
          if (diaData && diaData.date) {
            // Expandir fila en la tabla
            var row = document.querySelector('.cons-day-row[data-idx="' + idx + '"]');
            var detailRow = document.querySelector('.cons-day-detail[data-idx="' + idx + '"]');
            if (row && detailRow) {
              if (detailRow.style.display === 'none') {
                detailRow.style.display = '';
                row.querySelector('.bi').className = 'bi bi-chevron-up';
                if (!detailRow.dataset.loaded) {
                  detailRow.dataset.loaded = '1';
                  mostrarCDRsPorFecha(diaData.date, tipo);
                }
              }
            }
          }
        }
      },
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 8 }, maxRotation: 0 } },
        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { font: { size: 8 } } }
      }
    }
  });
}

function renderDailyTable(mesData, tipo) {
  var tbody = document.getElementById('consDailyBody2');
  if (!tbody) return;
  // Mostrar todos los dias del mes, resaltando el tipo seleccionado
  var html = '';
  var colTipo = { gb: 'GB', calls: 'Llamadas', sms: 'SMS' };
  mesData.forEach(function(d, idx) {
    html += '<tr class="cons-day-row" style="cursor:pointer;" data-idx="' + idx + '" data-fecha="' + d.date + '">' +
      '<td>' + d.date + '</td>' +
      '<td class="text-end">' + (d.gb || 0).toFixed(4) + '</td>' +
      '<td class="text-end">' + (d.calls || 0) + '</td>' +
      '<td class="text-end">' + (d.sms || 0) + '</td>' +
      '<td><i class="bi bi-chevron-down"></i></td></tr>' +
      '<tr class="cons-day-detail" data-idx="' + idx + '" style="display:none;"><td colspan="5" class="p-2 bg-light"><div class="small text-muted">Cargando CDRs de ' + d.date + '...</div></td></tr>';
  });
  tbody.innerHTML = html;
  // Click en fila expande detalle
  tbody.querySelectorAll('.cons-day-row').forEach(function(row) {
    row.addEventListener('click', function() {
      var idx = this.dataset.idx;
      var fecha = this.dataset.fecha;
      var detailRow = tbody.querySelector('.cons-day-detail[data-idx="' + idx + '"]');
      if (!detailRow) return;
      if (detailRow.style.display !== 'none') {
        detailRow.style.display = 'none';
        this.querySelector('.bi').className = 'bi bi-chevron-down';
        return;
      }
      detailRow.style.display = '';
      this.querySelector('.bi').className = 'bi bi-chevron-up';
      if (!detailRow.dataset.loaded) {
        detailRow.dataset.loaded = '1';
        mostrarCDRsPorFecha(fecha, tipo || 'gb');
      }
    });
  });
}

window.navegarMes = function(dir) {
  var data = window._dailyData || [];
  if (data.length === 0) return;
  var meses = {};
  data.forEach(function(d) { if (d.date && d.date.length >= 7) meses[d.date.substring(0, 7)] = true; });
  var mesesArr = Object.keys(meses).sort();
  if (mesesArr.length === 0) return;
  window._dailyMesActual = Math.max(0, Math.min(mesesArr.length - 1, (window._dailyMesActual || 0) + dir));
  window.renderDailyView();
};

function mostrarCDRsPorFecha(fecha, tipo) {
  var cdrBody = document.getElementById('cdrsBody');
  if (!cdrBody) return;
  // Buscar CDRs en el tbody actual que coincidan con la fecha
  var rows = Array.from(cdrBody.querySelectorAll('tr'));
  var cdrsFiltrados = [];
  rows.forEach(function(tr) {
    var dateCell = tr.querySelector('td:first-child');
    if (dateCell && dateCell.textContent.trim().startsWith(fecha)) {
      cdrsFiltrados.push({
        fecha: dateCell.textContent.trim(),
        tipo: (tr.cells[1] || {}).textContent || '',
        destino: (tr.cells[2] || {}).textContent || '',
        duracion: (tr.cells[3] || {}).textContent || '',
        coste: (tr.cells[4] || {}).textContent || ''
      });
    }
  });
  // Filtrar por tipo si es necesario
  if (tipo === 'calls') cdrsFiltrados = cdrsFiltrados.filter(function(c) { return c.tipo.toLowerCase().indexOf('voice') >= 0 || c.tipo.toLowerCase().indexOf('llamada') >= 0 || c.tipo.toLowerCase().indexOf('call') >= 0; });
  else if (tipo === 'sms') cdrsFiltrados = cdrsFiltrados.filter(function(c) { return c.tipo.toLowerCase().indexOf('sms') >= 0; });
  // Mostrar en los detalles expandidos de la tabla diaria
  var detailRows = document.querySelectorAll('.cons-day-detail');
  detailRows.forEach(function(dr) {
    var idx = dr.dataset.idx;
    var row = document.querySelector('.cons-day-row[data-idx="' + idx + '"]');
    if (!row) return;
    var fechaRow = row.dataset.fecha;
    if (fechaRow === fecha) {
      if (cdrsFiltrados.length > 0) {
        var html = '<td colspan="5" class="p-2 bg-light"><table class="table table-sm mb-0"><thead><tr><th>Hora</th><th>Tipo</th><th>Destino</th><th>Duraci�n</th><th>Coste</th></tr></thead><tbody>';
        cdrsFiltrados.forEach(function(c) {
          html += '<tr><td class="small">' + c.fecha + '</td><td>' + c.tipo + '</td><td>' + c.destino + '</td><td>' + c.duracion + '</td><td>' + c.coste + '</td></tr>';
        });
        html += '</tbody></table></td>';
        dr.innerHTML = html;
      } else {
        dr.innerHTML = '<td colspan="5" class="p-2 bg-light"><div class="small text-muted py-2">' + fecha + ': sin CDRs de ' + (tipo === 'calls' ? 'llamadas' : tipo === 'sms' ? 'SMS' : 'GB') + ' registrados</div></td>';
      }
    }
  });
  // Hacer scroll hasta la tabla de CDRs
  var cdrSection = document.getElementById('cdrsBody');
  if (cdrSection) cdrSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Radio buttons para cambiar tipo de chart
document.querySelectorAll('input[name="dailyChartType"]').forEach(function(rb) {
  rb.addEventListener('change', function() { if (this.checked) renderDailyView(); });
});
  // ========== CONSUMPTION MODAL ==========
  var _consChartInstance = null;

  function parseGBData(payload) {
    var d = payload.data || payload;
    return {
      total: parseFloat(d.totalGB || d.total_gb || d.total || d.totalGb || d.allowance || 0),
      used: parseFloat(d.usedGB || d.used_gb || d.used || d.consumed || d.consumption || d.usage || 0),
      remaining: parseFloat(d.remainingGB || d.remaining_gb || d.remaining || d.remainingGb || d.balance || d.left || 0),
      roaming: parseFloat(d.roamingGB || d.roaming_gb || d.roaming || d.roaming_used || 0)
    };
  }

  function fetchCDRData(line, tbody) {
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/cdrs', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        tbody.innerHTML = '';
        if (res.ok && res.data) {
          var cdrList = Array.isArray(res.data) ? res.data : (res.data.data || res.data.cdrs || res.data.records || res.data.items || []);
          if (!Array.isArray(cdrList)) cdrList = [];
          if (cdrList.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin registros de llamadas</td></tr>';
          } else {
            cdrList.forEach(function(cdr) {
              var tr = document.createElement('tr');
              var fecha = cdr.date || cdr.fecha || cdr.startTime || cdr.start_date || cdr.startDate || '-';
              var tipo = cdr.type || cdr.tipo || cdr.callType || cdr.direction || '-';
              var destino = cdr.calledNumber || cdr.callee || cdr.phone || cdr.destination || cdr.destino || '-'; if (destino !== '-' && (cdr.destination || cdr.destino) && (cdr.calledNumber || cdr.callee || cdr.phone)) destino += ' (' + (cdr.destination || cdr.destino) + ')';
              var cost = (cdr.cost != null ? cdr.cost : (cdr.coste != null ? cdr.coste : (cdr.price != null ? cdr.price : (cdr.amount != null ? cdr.amount : '-'))));
              var dur = cdr.duration || cdr.duracion || cdr.durationSec || cdr.seconds || cdr.durationSeconds || '-';
              var cost = cdr.cost || cdr.coste || cdr.price || cdr.amount || '-';
              if (dur !== '-' && !isNaN(parseFloat(dur))) {
                var secs = parseInt(dur);
                dur = Math.floor(secs / 60) + 'm ' + (secs % 60) + 's';
              }
              if (cost !== '-' && !isNaN(parseFloat(cost))) cost = parseFloat(cost).toFixed(4) + '€';
              tr.innerHTML = '<td class="small">' + fecha + '</td><td>' + tipo + '</td><td>' + destino + '</td><td>' + dur + '</td><td>' + cost + '</td>';
              tbody.appendChild(tr);
            });
          }
        } else {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin registros de llamadas</td></tr>';
        }
      })
      .catch(function(err) {
        console.error('CDRs error:', err);
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Error al cargar CDRs</td></tr>';
      });
  }

  document.querySelectorAll('.ver-consumo').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      document.getElementById('consLineNumber').textContent = line;
      cargarConsumoModal(line);
      new bootstrap.Modal(document.getElementById('consumptionModal')).show();
    });
  });

  // ========== BLOCK TOGGLE (inline buttons) ==========
  document.querySelectorAll('.toggle-block').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      var blocked = this.dataset.blocked === 'true';
