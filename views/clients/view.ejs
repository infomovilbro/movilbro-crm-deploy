// ===== PER-LINE CHARTS =====
var _lineChartData = {};
var _lineCharts = {};

function toggleLineChart(line) {
  var container = document.getElementById('chart-' + line);
  if (!container) return;
  if (container.style.display !== 'none') { container.style.display = 'none'; return; }
  container.style.display = '';
  if (_lineChartData[line]) { renderLineChart(line); return; }
  var clientEl = document.querySelector('.ver-consumo');
  var cid = clientEl ? clientEl.dataset.client : '';
  fetch('/clientes/' + encodeURIComponent(cid) + '/line/' + encodeURIComponent(line) + '/daily-consumption', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.data && res.data.length > 0) {
        _lineChartData[line] = res.data;
        renderLineChart(line);
      }
    })
    .catch(function() { container.innerHTML = '<div class="small text-muted p-2">Sin datos</div>'; });
}

function renderLineChart(line) {
  var data = _lineChartData[line];
  if (!data || !data.length) return;
  var tipo = 'gb';
  var meses = {};
  data.forEach(function(d) { if (d.date && d.date.length >= 7) meses[d.date.substring(0, 7)] = true; });
  var mesesArr = Object.keys(meses).sort();
  if (!mesesArr.length) return;
  var mesSel = mesesArr[mesesArr.length - 1];
  var mesData = data.filter(function(d) { return d.date && d.date.substring(0, 7) === mesSel; });
  if (!mesData.length) return;
  var nav = document.getElementById('nav-' + line);
  if (nav) { nav.style.display = ''; nav.innerHTML = '<span class="fw-semibold" style="font-size:0.65rem;">' + mesSel.substring(0,4) + '/' + mesSel.substring(5,7) + '</span>'; }
  var ctx = document.getElementById('chart-' + line);
  if (!ctx) return;
  if (_lineCharts[line]) { _lineCharts[line].destroy(); }
  var labels = mesData.map(function(d) { var p = d.date.split('-'); return p[2] + '/' + p[1]; });
  var valores = mesData.map(function(d) { return d[tipo] || 0; });
  if (typeof Chart !== 'undefined') {
    try {
      _lineCharts[line] = new Chart(ctx, { type: 'bar',
        data: { labels: labels, datasets: [{ label: 'GB', data: valores, backgroundColor: '#06b6d4', borderRadius: 2 }] },
        options: { animation: false, responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
          scales: { x: { grid: { display: false }, ticks: { font: { size: 7 }, maxRotation: 0 } }, y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.03)' } } } }
      });
    } catch(e) {}
  }
  var total = 0;
  mesData.forEach(function(d) { total += (d[tipo] || 0); });
  var usage = document.getElementById('usage-' + line);
  if (usage) usage.textContent = 'Total GB: ' + total.toFixed(2) + ' GB';
}

