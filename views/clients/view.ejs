function esc(t) {
  if (!t) return '';
  return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}
function escapeStr(s) {
  if (!s) return '';
  return String(s).replace(/'/g,"\\'").replace(/"/g,'&quot;');
}
// Auto-load per-line data
setTimeout(function() { if (typeof initLineCharts === 'function') initLineCharts(); }, 500);
setTimeout(function() { if (typeof autoCalcularScoring === 'function') { var c = document.querySelector('[onclick*="calcularScoring"]'); if (c) { var m = c.getAttribute('onclick').match(/'([^']+)'/); if (m) autoCalcularScoring(m[1]); } } }, 1500);
setTimeout(function() { var fp = document.querySelector('.pill'); if (fp) selectLine((fp.textContent || '').trim()); }, 600);
setTimeout(function() { if (typeof renderChartBars === 'function') renderChartBars(); }, 3500);
</script>

<!-- Modal de Línea -->
