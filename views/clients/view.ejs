function setCreditLimit(lineNumber, fiscalId, amount) {
  if (!amount || amount <= 0) return;
  fetch('/clientes/' + encodeURIComponent(fiscalId) + '/line/' + encodeURIComponent(lineNumber) + '/credit-limit', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ limit: parseFloat(amount) })
  }).then(function(r){ return r.json() }).then(function(res){
    if (res.ok) {
      document.querySelectorAll('#tab-resumen .btn-primary').forEach(function(b){ b.className = b.className.replace('btn-primary','btn-outline-secondary'); });
      var btns = document.querySelectorAll('#tab-resumen button');
      btns.forEach(function(b){
        if (b.textContent.trim() === amount + '€') b.className = b.className.replace('btn-outline-secondary','btn-primary');
      });
    } else {
      alert('Error al actualizar límite');
    }
  }).catch(function(err){
    alert('Error de conexión');
  });
}
