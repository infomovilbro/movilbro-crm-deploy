<!-- Duplicate SIM Modal -->
<div class="modal fade" id="duplicateSimModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-sd-card"></i> Duplicar SIM</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">L&iacute;nea</label>
          <select id="simLine" class="form-select"><option value="">Seleccione l&iacute;nea...</option></select>
        </div>
        <div class="mb-3">
          <label class="form-label">Motivo</label>
          <select id="simReason" class="form-select">
            <option value="lost">Perdida</option>
            <option value="stolen">Robada</option>
            <option value="broken">Rota / Defectuosa</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Tipo</label>
          <div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="simType" id="simTypePhysical" value="sim" checked>
              <label class="form-check-label" for="simTypePhysical">SIM f&iacute;sica</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="simType" id="simTypeEsim" value="esim">
              <label class="form-check-label" for="simTypeEsim">eSIM</label>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button id="submitDuplicateSim" class="btn btn-info"><i class="bi bi-check"></i> Solicitar</button>
      </div>
    </div>
  </div>
</div>

<script>
function mostrarPinPuk(linea, pin, puk) {
  document.getElementById('pinPukLinea').textContent = linea || '-';
  document.getElementById('pinPukPin').textContent = pin || '-';
  document.getElementById('pinPukPuk').textContent = puk || '-';
  new bootstrap.Modal(document.getElementById('pinPukModal')).show();
}

document.addEventListener('DOMContentLoaded', function() {
  var statusData = <%- linesByStatus || '{}' %>;
  var linesArr = <%- lineNumbers || '[]' %>;
  var clientId = <%= cliente.id %>;

  function formatDate(d) {
    if (!d) return '-';
    try { return new Date(d).toLocaleDateString('es-ES'); } catch(e) { return d; }
  }

  // ========== INSTALLATION DETAIL ==========
  document.querySelectorAll('.ver-instalacion').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('instDetId').textContent = this.dataset.id || '-';
      document.getElementById('instDetAddress').textContent = (this.dataset.address || '') + (this.dataset.city ? ', ' + this.dataset.city : '');
      document.getElementById('instDetProduct').textContent = this.dataset.product || '-';
      var st = this.dataset.status || '';
      var badge = 'secondary';
      if (st.toLowerCase() === 'completed' || st.toLowerCase() === 'completada') badge = 'success';
      else if (st.toLowerCase() === 'scheduled' || st.toLowerCase() === 'programada') badge = 'info';
      else if (st.toLowerCase() === 'pending' || st.toLowerCase() === 'pendiente') badge = 'warning';
      document.getElementById('instDetStatus').innerHTML = '<span class="badge bg-' + badge + '">' + st + '</span>';
      document.getElementById('instDetScheduled').textContent = formatDate(this.dataset.scheduled);
      document.getElementById('instDetCompleted').textContent = formatDate(this.dataset.completed);
      document.getElementById('instDetTechnician').textContent = this.dataset.technician || '-';
      document.getElementById('instDetNotes').textContent = this.dataset.notes || '-';
      var docsEl = document.getElementById('instDetDocuments');
      try {
        var docs = JSON.parse(this.dataset.documents || '[]');
        if (docs.length > 0) {
          var html = '<div class="d-flex flex-wrap gap-2">';
          docs.forEach(function(d) {
            html += '<a href="' + (d.url || '#') + '" class="btn btn-sm btn-outline-success" target="_blank" download><i class="bi bi-download"></i> ' + (d.name || 'Documento') + '</a>';
          });
          html += '</div>';
          docsEl.innerHTML = html;
        } else {
          docsEl.innerHTML = '<span class="text-muted small">Sin documentos</span>';
        }
      } catch(e) {
        docsEl.innerHTML = '<span class="text-muted small">Sin documentos</span>';
      }
      new bootstrap.Modal(document.getElementById('instalacionDetailModal')).show();
    });
  });

  // ========== STATUS CHART ==========
  var statusCtx = document.getElementById('statusChart');
  if (statusCtx && Object.keys(statusData).length > 0) {
    new Chart(statusCtx, {
      type: 'doughnut',
      data: {
        labels: Object.keys(statusData),
        datasets: [{
          data: Object.values(statusData),
          backgroundColor: ['#28a745', '#ffc107', '#dc3545', '#17a2b8', '#6c757d']
        }]
      },
      options: {
        animation: false, resizeDelay: 0,
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
        }
      }
    });
  }

  // ========== GB CHART ==========
  var gbCtx = document.getElementById('gbChart');
  var gbChart = null;
  if (gbCtx) {
    gbChart = new Chart(gbCtx, {
      type: 'bar',
      data: {
        labels: ['GB Totales', 'GB Usados', 'GB Restantes'],
        datasets: [{ label: 'GB', data: [0, 0, 0], backgroundColor: ['#17a2b8', '#ffc107', '#28a745'] }]
      },
      options: {
        animation: false, resizeDelay: 0,
        responsive: true, maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } },
        plugins: { legend: { display: false } }
      }
    });
    if (linesArr.length > 0) {
      var firstLine = linesArr[0];
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(firstLine) + '/consumption', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var d = res.data;
            var payload = d.gb || d.data || d;
            var total = parseFloat(payload.totalGB || payload.total_gb || payload.total || payload.totalGb || 0);
            var used = parseFloat(payload.usedGB || payload.used_gb || payload.used || payload.consumed || payload.consumption || 0);
            var remaining = parseFloat(payload.remainingGB || payload.remaining_gb || payload.remaining || payload.remainingGb || 0);
            gbChart.data.datasets[0].data = [total, used, remaining];
            gbChart.update();
          }
        })
        .catch(function(err) { console.error('Auto-fetch consumption error:', err); });
    }
  }

  // ========== CONSUMPTION MODAL ==========
  var _consChartInstance = null;

  function parseGBData(payload) {
    var d = payload.gb || payload.data || payload;
    return {
      total: parseFloat(d.totalGB || d.total_gb || d.total || d.totalGb || d.allowance || 0),
      used: parseFloat(d.usedGB || d.used_gb || d.used || d.consumed || d.consumption || d.usage || 0),
      remaining: parseFloat(d.remainingGB || d.remaining_gb || d.remaining || d.remainingGb || d.balance || d.left || 0),
      roaming: parseFloat(d.roamingGB || d.roaming_gb || d.roaming || d.roaming_used || 0)
    };
  }

  function formatDuration(secs) {
    if (secs === '-' || secs === undefined || secs === null) return '-';
    var n = parseInt(secs);
    if (isNaN(n)) return secs;
    if (n < 60) return n + 's';
    return Math.floor(n / 60) + 'm ' + (n % 60) + 's';
  }

  function formatCost(val) {
    if (val === '-' || val === undefined || val === null) return '-';
    var n = parseFloat(val);
    if (isNaN(n)) return val;
    return n.toFixed(4) + '€';
  }

  function extractDateStr(cdr) {
    return cdr.date || cdr.fecha || cdr.startTime || cdr.start_date || cdr.startDate || '';
  }

  function extractDestino(cdr) {
    return cdr.destination || cdr.destino || cdr.calledNumber || cdr.callee || cdr.phone || '-';
  }

  function extractDuration(cdr) {
    return cdr.duration || cdr.duracion || cdr.durationSec || cdr.seconds || cdr.durationSeconds || '-';
  }

  function extractCost(cdr) {
    return cdr.cost || cdr.coste || cdr.price || cdr.amount || '-';
  }

  var _allCdrs = [];
  var _cdrLine = '';

  function renderCdrAccordion(filterMonth) {
    var accordion = document.getElementById('cdrsAccordion');
    var emptyMsg = document.getElementById('cdrsBody');
    var filterSel = document.getElementById('cdrMonthFilter');
    var countSpan = document.getElementById('cdrCount');

    if (!_allCdrs.length) {
      accordion.innerHTML = '';
      emptyMsg.innerHTML = 'Sin registros de llamadas';
      countSpan.textContent = '';
      return;
    }

    // Group by month, then by day
    var months = {};
    _allCdrs.forEach(function(cdr) {
      var ds = extractDateStr(cdr);
      if (!ds) return;
      var d = new Date(ds);
      if (isNaN(d.getTime())) return;
      var monthKey = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      var dayKey = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      if (!months[monthKey]) months[monthKey] = {};
      if (!months[monthKey][dayKey]) months[monthKey][dayKey] = [];
      months[monthKey][dayKey].push(cdr);
    });

    var sortedMonths = Object.keys(months).sort().reverse();
    var totalCount = 0;
    var html = '';

    sortedMonths.forEach(function(monthKey, mi) {
      if (filterMonth && filterMonth !== monthKey) return;
      var days = months[monthKey];
      var sortedDays = Object.keys(days).sort().reverse();
      var monthCount = 0;
      sortedDays.forEach(function(dayKey) { monthCount += days[dayKey].length; });
      totalCount += monthCount;

      var parts = monthKey.split('-');
      var monthLabel = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
      monthLabel = monthLabel.charAt(0).toUpperCase() + monthLabel.slice(1);

      html += '<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#cdrMonth' + mi + '" aria-expanded="false"><strong>' + monthLabel + '</strong> <span class="badge bg-secondary ms-2">' + monthCount + '</span></button></h2>';
      html += '<div id="cdrMonth' + mi + '" class="accordion-collapse collapse" data-bs-parent="#cdrsAccordion"><div class="accordion-body p-0">';

      sortedDays.forEach(function(dayKey) {
        var cdrs = days[dayKey];
        var dd = new Date(dayKey);
        var dayLabel = dd.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
        dayLabel = dayLabel.charAt(0).toUpperCase() + dayLabel.slice(1);
        html += '<div class="px-2 pt-2"><small class="text-muted fw-semibold">' + dayLabel + ' <span class="badge bg-light text-dark">' + cdrs.length + '</span></small></div>';
        html += '<table class="table table-sm table-borderless mb-0"><tbody>';
        cdrs.forEach(function(cdr) {
          var ds = extractDateStr(cdr);
          var timeStr = '';
          if (ds) { var td = new Date(ds); if (!isNaN(td.getTime())) timeStr = td.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }); }
          var destino = extractDestino(cdr);
          var dur = formatDuration(extractDuration(cdr));
          var cost = formatCost(extractCost(cdr));
          html += '<tr><td class="small text-nowrap ps-3" style="width:75px;">' + timeStr + '</td><td class="small">' + destino + '</td><td class="small text-nowrap" style="width:80px;">' + dur + '</td><td class="small text-nowrap text-end" style="width:90px;">' + cost + '</td></tr>';
        });
        html += '</tbody></table>';
      });

      html += '</div></div></div>';
    });

    accordion.innerHTML = html;
    emptyMsg.innerHTML = '';
    countSpan.textContent = totalCount + ' registros';

    // Mark months not matching filter
    if (filterMonth) {
      accordion.querySelectorAll('.accordion-collapse').forEach(function(el) { el.classList.add('show'); });
    }
  }

  function populateMonthFilter() {
    var sel = document.getElementById('cdrMonthFilter');
    var months = {};
    _allCdrs.forEach(function(cdr) {
      var ds = extractDateStr(cdr);
      if (!ds) return;
      var d = new Date(ds);
      if (isNaN(d.getTime())) return;
      var mk = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      months[mk] = (months[mk] || 0) + 1;
    });
    var sorted = Object.keys(months).sort().reverse();
    sel.innerHTML = '<option value="">Todos</option>';
    sorted.forEach(function(mk) {
      var parts = mk.split('-');
      var label = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
      label = label.charAt(0).toUpperCase() + label.slice(1);
      var opt = document.createElement('option');
      opt.value = mk;
      opt.textContent = label + ' (' + months[mk] + ')';
      sel.appendChild(opt);
    });
  }

  function fetchCDRData(line) {
    _cdrLine = line;
    var accordion = document.getElementById('cdrsAccordion');
    var emptyMsg = document.getElementById('cdrsBody');
    accordion.innerHTML = '';
    emptyMsg.innerHTML = 'Cargando...';

    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/cdrs', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok && res.data) {
          _allCdrs = Array.isArray(res.data) ? res.data : (res.data.data || res.data.cdrs || res.data.records || res.data.items || []);
          if (!Array.isArray(_allCdrs)) _allCdrs = [];
        } else {
          _allCdrs = [];
        }
        populateMonthFilter();
        renderCdrAccordion('');
      })
      .catch(function(err) {
        console.error('CDRs error:', err);
        accordion.innerHTML = '';
        emptyMsg.innerHTML = 'Error al cargar CDRs';
      });
  }

  document.getElementById('cdrMonthFilter').addEventListener('change', function() {
    renderCdrAccordion(this.value);
  });

  document.querySelectorAll('.ver-consumo').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      document.getElementById('consLineNumber').textContent = line;

      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/consumption', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var gb = parseGBData(res.data);
            document.getElementById('consTotalGB').textContent = gb.total.toFixed(2);
            document.getElementById('consUsedGB').textContent = gb.used.toFixed(2);
            document.getElementById('consRemainingGB').textContent = gb.remaining.toFixed(2);
            document.getElementById('consRoamingGB').textContent = gb.roaming.toFixed(2);
            if (gbChart) {
              gbChart.data.datasets[0].data = [gb.total, gb.used, gb.remaining];
              gbChart.update();
            }
            var consCtx = document.getElementById('consGBChart');
            if (consCtx) {
              if (_consChartInstance) { _consChartInstance.destroy(); }
              _consChartInstance = new Chart(consCtx, {
                type: 'bar',
                data: {
                  labels: ['Totales', 'Usados', 'Restantes'],
                  datasets: [{ label: 'GB', data: [gb.total, gb.used, gb.remaining], backgroundColor: ['#17a2b8', '#ffc107', '#28a745'] }]
                },
                options: {
                  animation: false, resizeDelay: 0,
                  responsive: true, maintainAspectRatio: false,
                  indexAxis: 'y',
                  plugins: { legend: { display: false } }
                }
              });
            }
            // Populate monthly consumption
            var monthly = res.data.monthly || [];
            var monthlyBody = document.getElementById('monthlyBody');
            var monthSel = document.getElementById('monthSelector');
            if (monthly.length > 0) {
              monthlyBody.innerHTML = '';
              monthSel.innerHTML = '<option value="">Todos los meses</option>';
              monthly.forEach(function(m) {
                var tr = document.createElement('tr');
                tr.innerHTML = '<td>' + m.mes + '</td><td>' + m.gbUsados.toFixed(2) + ' GB</td><td>' + (m.gbTotales ? m.gbTotales.toFixed(2) + ' GB' : '-') + '</td>';
                monthlyBody.appendChild(tr);
                var opt = document.createElement('option');
                opt.value = m.mes;
                opt.textContent = m.mes;
                monthSel.appendChild(opt);
              });
              monthSel.onchange = function() {
                var val = this.value;
                var rows = monthlyBody.querySelectorAll('tr');
                rows.forEach(function(row) {
                  row.style.display = (!val || row.cells[0].textContent === val) ? '' : 'none';
                });
              };
            } else {
              monthlyBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">Sin datos mensuales</td></tr>';
            }
          } else {
            document.getElementById('consTotalGB').textContent = 'Error';
            document.getElementById('consUsedGB').textContent = '-';
            document.getElementById('consRemainingGB').textContent = '-';
            document.getElementById('consRoamingGB').textContent = '-';
          }
        })
        .catch(function(err) {
          console.error('Consumption error:', err);
          document.getElementById('consTotalGB').textContent = 'Error';
        });

      fetchCDRData(line);
      new bootstrap.Modal(document.getElementById('consumptionModal')).show();
    });
  });

  // ========== BLOCK TOGGLE (inline buttons) ==========
  document.querySelectorAll('.toggle-block').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      var blocked = this.dataset.blocked === 'true';
      if (!line) return;
      if (!confirm((blocked ? 'Desbloquear' : 'Bloquear') + ' la l&iacute;nea ' + line + '?')) return;
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/block', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blocked: !blocked })
      })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok) { location.reload(); }
          else { alert('Error: ' + (res.error || 'Desconocido')); }
        })
        .catch(function(err) { alert('Error: ' + err.message); });
    });
  });

  // ========== POPULATE SELECTS ==========
  function populateSelect(id) {
    var sel = document.getElementById(id);
    if (!sel) return;
    linesArr.forEach(function(ln) {
      if (!ln) return;
      var opt = document.createElement('option');
      opt.value = ln;
      opt.textContent = ln;
      sel.appendChild(opt);
    });
  }
  populateSelect('tariffLine');
  populateSelect('blockLineSelect');
  populateSelect('simLine');

  // ========== CAMBIAR TARIFA FROM INLINE BUTTON ==========
  document.querySelectorAll('.cambiar-tarifa-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      var sel = document.getElementById('tariffLine');
      if (sel) { sel.value = line; }
      new bootstrap.Modal(document.getElementById('changeTariffModal')).show();
    });
  });

  // ========== DUPLICAR SIM FROM INLINE BUTTON ==========
  document.querySelectorAll('.duplicar-sim-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      var sel = document.getElementById('simLine');
      if (sel) { sel.value = line; }
      new bootstrap.Modal(document.getElementById('duplicateSimModal')).show();
    });
  });

  // ========== CHANGE TARIFF MODAL ==========
  var _allTariffProducts = [];
  function renderFamilyGrid(products) {
    var grid = document.getElementById('tariffFamilyGrid');
    var families = {};
    products.forEach(function(p) {
      var fam = p.family || 'Otras';
      if (!families[fam]) families[fam] = [];
      families[fam].push(p);
    });
    var palette = {Mobile:'📱',Fiber:'🌐',TV:'📺',Device:'📟',International:'🌍',Energy:'🔋',Satellite:'📡',Fixed:'📞'};
    var labels = {Mobile:'Móvil',Fiber:'Fibra',TV:'TV',Device:'Dispositivo',International:'Internacional',Energy:'Energía',Satellite:'Satélite',Fixed:'Fijo'};
    grid.innerHTML = '';
    var allCount = products.length;
    var allCard = document.createElement('div');
    allCard.className = 'col-4 col-md-2';
    allCard.innerHTML = '<div class="card family-card text-center p-1 border-primary" data-family="all" style="cursor:pointer;" onclick="selectTariffFamily(\'all\')"><div class="fs-5">📋</div><small>Todas</small><span class="badge bg-secondary" style="font-size:0.6rem;">' + allCount + '</span></div>';
    grid.appendChild(allCard);
    Object.keys(families).forEach(function(fam) {
      var icon = palette[fam] || '📦';
      var label = labels[fam] || fam;
      var count = families[fam].length;
      var card = document.createElement('div');
      card.className = 'col-4 col-md-2';
      card.innerHTML = '<div class="card family-card text-center p-1" data-family="' + fam + '" style="cursor:pointer;" onclick="selectTariffFamily(\'' + fam + '\')"><div class="fs-5">' + icon + '</div><small>' + label + '</small><span class="badge bg-secondary" style="font-size:0.6rem;">' + count + '</span></div>';
      grid.appendChild(card);
    });
    window._tariffFamilies = families;
  }
  window.selectTariffFamily = function(fam) {
    var list = document.getElementById('tariffProductList');
    var wrap = document.getElementById('tariffProductsWrap');
    document.getElementById('tariffSelectedFamily').value = fam;
    document.querySelectorAll('#tariffFamilyGrid .family-card').forEach(function(c) { c.classList.remove('border-primary'); });
    var cards = document.querySelectorAll('#tariffFamilyGrid .family-card');
    cards.forEach(function(c) { if (c.dataset.family === fam) c.classList.add('border-primary'); });
    var families = window._tariffFamilies || {};
    var products = fam === 'all' ? _allTariffProducts : (families[fam] || []);
    list.innerHTML = '';
    if (products.length === 0) {
      list.innerHTML = '<div class="text-muted small p-2">Sin productos en esta categor&iacute;a</div>';
      wrap.style.display = 'none';
      return;
    }
    products.forEach(function(p) {
      var name = p.name || p.productName || p.description || p.product || '';
      var price = p.price ? parseFloat(p.price).toFixed(2) + '\u20AC' : '';
      var item = document.createElement('div');
      item.className = 'd-flex justify-content-between align-items-center p-2 border-bottom tariff-item';
      item.style.cursor = 'pointer';
      item.innerHTML = '<span><strong>' + name + '</strong>' + (price ? ' <span class="text-muted">(' + price + ')</span>' : '') + '</span><span><button class="btn btn-sm btn-outline-primary seleccionar-tarifa" data-value="' + (p.id || p.code || name) + '" data-name="' + name.replace(/'/g, '') + '"><i class="bi bi-check"></i> Seleccionar</button></span>';
      list.appendChild(item);
    });
    wrap.style.display = 'block';
  };
  document.getElementById('changeTariffModal').addEventListener('show.bs.modal', function() {
    var wrap = document.getElementById('tariffProductsWrap');
    wrap.style.display = 'none';
    document.getElementById('tariffSelectedInfo').style.display = 'none';
    document.getElementById('tariffFamilyGrid').innerHTML = '<div class="col-12 text-center py-3"><div class="spinner-border spinner-border-sm"></div> Cargando productos...</div>';
    fetch('/clientes/' + clientId + '/compatible-products')
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok && Array.isArray(res.data) && res.data.length > 0) {
          _allTariffProducts = res.data;
          renderFamilyGrid(res.data);
        } else {
          document.getElementById('tariffFamilyGrid').innerHTML = '<div class="col-12 text-muted small">No hay productos disponibles</div>';
        }
      })
      .catch(function() {
        document.getElementById('tariffFamilyGrid').innerHTML = '<div class="col-12 text-muted small">Error al cargar productos</div>';
      });
  });
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.seleccionar-tarifa');
    if (!btn) return;
    var val = btn.dataset.value;
    var name = btn.dataset.name;
    document.getElementById('tariffProduct').value = val;
    document.getElementById('tariffSelectedInfo').style.display = 'block';
    document.getElementById('tariffSelectedInfo').innerHTML = '<i class="bi bi-check-circle text-success"></i> Producto seleccionado: <strong>' + name + '</strong>';
    document.querySelectorAll('.seleccionar-tarifa').forEach(function(b) { b.className = 'btn btn-sm btn-outline-secondary'; b.innerHTML = '<i class="bi bi-check"></i>'; });
    btn.className = 'btn btn-sm btn-success';
    btn.innerHTML = '<i class="bi bi-check-circle"></i> Seleccionado';
  });

  document.getElementById('submitChangeTariff').addEventListener('click', function() {
    var line = document.getElementById('tariffLine').value;
    var product = document.getElementById('tariffProduct').value;
    var schedule = document.getElementById('tariffSchedule').value || null;
    if (!line || !product) { alert('Seleccione l&iacute;nea y producto'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/change-tariff', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, productId: product, productCode: product, schedule: schedule })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('Cambio de tarifa solicitado correctamente');
          bootstrap.Modal.getInstance(document.getElementById('changeTariffModal')).hide();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== BLOCK LINE MODAL ==========
  document.getElementById('submitBlockLine').addEventListener('click', function() {
    var line = document.getElementById('blockLineSelect').value;
    var blocked = document.querySelector('input[name="blockAction"]:checked').value === 'block';
    if (!line) { alert('Seleccione una l&iacute;nea'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/block', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ blocked: blocked })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('L&iacute;nea ' + (blocked ? 'bloqueada' : 'desbloqueada') + ' correctamente');
          bootstrap.Modal.getInstance(document.getElementById('blockLineModal')).hide();
          location.reload();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== DUPLICATE SIM MODAL ==========
  document.getElementById('submitDuplicateSim').addEventListener('click', function() {
    var line = document.getElementById('simLine').value;
    var reason = document.getElementById('simReason').value;
    var simType = document.querySelector('input[name="simType"]:checked').value;
    if (!line) { alert('Seleccione una l&iacute;nea'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/duplicate-sim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, reason: reason, simType: simType, type: simType })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('Solicitud de duplicado de SIM realizada correctamente');
          bootstrap.Modal.getInstance(document.getElementById('duplicateSimModal')).hide();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== INIT POPOVERS ==========
  var popoverList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
  popoverList.forEach(function(el) {
    new bootstrap.Popover(el);
  });
});
</script>
