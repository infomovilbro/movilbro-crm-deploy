function copiarICC() {
  var el = document.getElementById('detIcc');
  if (!el) return;
  var txt = el.textContent.replace(/📋/g, '').trim();
  if (!txt || txt === '-') { alert('No hay ICC para copiar'); return; }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(txt).then(function() { alert('ICC copiado: ' + txt); }).catch(function() { alert('ICC: ' + txt); });
  } else { alert('ICC: ' + txt); }
}

function abrirPagoModal() {
  var line = detLineSelected || '';
  if (!line) { alert('Selecciona una línea primero'); return; }
  var metodo = prompt('Método de pago para la línea ' + line + ' (ej: domiciliacion, tarjeta):', 'domiciliacion');
  if (metodo === null) return;
  cambiarPagoLinea(line, metodo.trim());
}

function abrirCreditoModal() {
