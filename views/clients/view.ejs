            <div class="row g-2">
              <% kycDocs.forEach(function(d) { %>
              <div class="col-md-4 col-6">
                <div class="card border h-100">
                  <div class="card-body text-center py-3">
                    <a href="<%= d.download_url %>" target="_blank">
                      <img src="<%= d.download_url %>" alt="<%= d.tipo %>" style="max-width:100%;max-height:150px;object-fit:contain;border-radius:4px;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';"><i class="bi bi-file-earmark-image" style="font-size:2rem;display:none;"></i>
                    </a>
                    <div class="mt-1"><small><strong><%= d.tipo || 'Documento' %></strong></small></div>
                    <div class="mt-1"><span class="badge bg-success"><%= d.estado || 'subido' %></span></div>
                    <% if (d.download_url) { %>
                    <div class="mt-2 d-flex gap-1 justify-content-center">
                      <a href="<%= d.download_url %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Ver"><i class="bi bi-eye"></i></a>
                      <button class="btn btn-sm btn-outline-secondary" title="Descargar" onclick="var u='<%= d.download_url || '' %>';var m=u.match(/[-\w]{25,}/);window.location.href=(m?'/clientes/drive-download?fileId='+m[0]+'&name='+encodeURIComponent('<%= (d.tipo || 'documento').replace(/'/g,'') %>')+'&download=1':u)"><i class="bi bi-download"></i></button>
                    </div>
                    <% } %>
                  </div>
                </div>
              </div>
              <% }); %>
            </div>
            <% } %>

            <% if (documentos && documentos.length > 0) { %>
            <hr class="my-3">
            <h6><i class="bi bi-folder"></i> Documentos ISP</h6>
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead class="table-light">
                  <tr><th>Nombre</th><th>Tipo</th><th>Categor&iacute;a</th><th>Fecha</th><th></th></tr>
                </thead>
                <tbody>
                  <% documentos.forEach(function(d) { %>
                  <tr>
                    <td><%= d.nombre || d.archivo || 'Documento' %></td>
                    <td><span class="badge bg-secondary"><%= d.tipo || '-' %></span></td>
                    <td><%= d.categoria || '-' %></td>
                    <td><small><%= d.created_at ? new Date(d.created_at).toLocaleDateString('es-ES') : '-' %></small></td>
                    <td>
                      <% if (d.ruta) { %>
                      <a href="<%= d.ruta %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i></a>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
          <% } %>
          <!-- KYC Upload buttons -->
          <hr class="my-3">
          <h6><i class="bi bi-cloud-upload"></i> Subir documentos KYC</h6>
          <div class="d-flex flex-wrap gap-1 mb-2" id="kycUploadButtons">
            <span class="text-muted small me-1" style="line-height:30px;">Subir:</span>
            <button class="btn btn-sm btn-outline-success" onclick="uploadKycDoc('obverseDocument', this)"><i class="bi bi-camera"></i> DNI anverso</button>
            <button class="btn btn-sm btn-outline-success" onclick="uploadKycDoc('reverseDocument', this)"><i class="bi bi-camera"></i> DNI reverso</button>
            <button class="btn btn-sm btn-outline-success" onclick="uploadKycDoc('obverseFace', this)"><i class="bi bi-person"></i> Selfie</button>
            <button class="btn btn-sm btn-outline-secondary" onclick="uploadKycDoc('otro', this)"><i class="bi bi-plus"></i> Otro</button>
          </div>
          <input type="file" id="kycFileInput" accept="image/*,.pdf" style="display:none;">
          <div id="kycUploadResult" class="small mt-1"></div>
        </div>

        <!-- ==================== TAB 7: CONTRATO ==================== -->
        <div class="tab-pane fade" id="contrato" role="tabpanel" aria-labelledby="contrato-tab">
          <div class="mb-3">
            <a href="/isp/contratos?search=<%= encodeURIComponent(cliente.dni_nif || cliente.nombre || '') %>" class="btn btn-sm btn-outline-primary" target="_blank">
              <i class="bi bi-box-arrow-up-right"></i> Ver contratos ISP
            </a>
          </div>
          <% if (altasOrdenes.length === 0 && contratos.length === 0 && (!apiContratos || apiContratos.length === 0)) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-file-text" style="font-size:3rem;"></i>
            <p class="mt-2">Sin contratos</p>
          </div>
          <% } else { %>
            <% if (altasOrdenes.length > 0) { %>
            <h6 class="mb-3"><i class="bi bi-cart"></i> Contratos de altas_ordenes</h6>
            <div class="table-responsive mb-4">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                  <tr><th>#</th><th>Producto</th><th>Estado</th><th>Fecha</th><th>Contrato firmado</th><th></th></tr>
                </thead>
                <tbody>
                  <% altasOrdenes.forEach(function(o) { %>
                  <% var dp = o.datos_producto ? JSON.parse(o.datos_producto) : {}; %>
                  <tr>
                    <td><strong>#<%= o.id %></strong></td>
                    <td><%= dp.producto_id || '-' %></td>
                    <td><span class="badge bg-<%= o.estado === 'completada' ? 'success' : o.estado === 'pendiente_kyc' ? 'warning' : o.estado === 'cancelada' ? 'danger' : 'info' %>"><%= o.estado %></span></td>
                    <td><small><%= o.created_at ? new Date(o.created_at).toLocaleDateString('es-ES') : '-' %></small></td>
                    <td>
                      <% if (o.kyc_contrato_firmado) { %>
                      <span class="text-success"><i class="bi bi-check-circle"></i> Firmado</span>
                      <% } else { %>
                      <span class="text-warning"><i class="bi bi-clock"></i> Pendiente</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/kyc/contrato/<%= o.token %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-text"></i> Ver contrato</a>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
<% if (contratosS3 && contratosS3.length > 0) { %>
<h6 class="mb-3 mt-3"><i class="bi bi-file-check"></i> Contratos Firmados</h6>
<div class="row g-2">
  <% contratosS3.forEach(function(c) { %>
  <div class="col-md-6">
    <div class="card border h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
