function filtrarLineas(){
  var g=document.getElementById('globalFilter');
  var v=g?g.value:'activa';
  document.querySelectorAll('[data-estado]').forEach(function(el){
    var est=el.getAttribute('data-estado');
    var isTerm=est==='terminada'||est==='terminated'||est==='baja'||est==='cancelled'||est==='canceled'||est==='cancelada';
    var isAct=est==='activa'||est==='active'||est==='activo';
    if(v==='all')el.style.display='';
    else if(v==='cancelada')el.style.display=isTerm?'':'none';
    else el.style.display=isAct?'':'none';
  });
}
