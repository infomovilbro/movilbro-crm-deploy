  fetch('/clientes/' + clienteId + '/campo', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ campo: 'iban', valor: iban })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.ok) { alert('IBAN actualizado'); location.reload(); }
