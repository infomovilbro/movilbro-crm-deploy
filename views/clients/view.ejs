    else { alert('Error: ' + (d.error || '')); }
  })
  .catch(function() { alert('Error de conexión'); });
}



function calcularScoring(clienteId) {
  var modal = new bootstrap.Modal(document.getElementById('scoringModal'));
  document.getElementById('scoringResultValue').textContent = '...';
  document.getElementById('scoringResultRisk').innerHTML = '';
  document.getElementById('scoringResultDetails').innerHTML = '<li class="text-muted">Calculando...</li>';
  modal.show();
  fetch('/clientes/' + clienteId + '/calculate-scoring', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        document.getElementById('scoringResultValue').textContent = res.scoring;
        var riskBadge = 'secondary';
        if (res.risk === 'bajo' || res.risk === 'low') riskBadge = 'success';
        else if (res.risk === 'medio' || res.risk === 'medium') riskBadge = 'warning';
        else if (res.risk === 'alto' || res.risk === 'high') riskBadge = 'danger';
        document.getElementById('scoringResultRisk').innerHTML = '<span class="badge bg-' + riskBadge + ' fs-6">Riesgo: ' + res.risk + '</span>';
        var detallesHtml = '';
        if (res.detalleCompleto && res.detalleCompleto.length > 0) {
          detallesHtml += '<table class="table table-sm table-borderless mb-0" style="font-size:0.75rem;"><thead><tr><th>Factor</th><th>Valor</th><th>Impacto</th></tr></thead><tbody>';
          res.detalleCompleto.forEach(function(d) {
            var icono = d.color === 'success' ? '✅' : d.color === 'danger' ? '❌' : '➖';
            detallesHtml += '<tr><td>' + d.factor + '</td><td>' + d.valor + '</td><td><span class="badge bg-' + d.color + '">' + icono + ' ' + d.impacto + '</span></td></tr>';
          });
          detallesHtml += '</tbody></table>';
        } else if (res.detalles && res.detalles.length > 0) {
          res.detalles.forEach(function(det) { detallesHtml += '<li>' + det + '</li>'; });
        } else {
          detallesHtml += '<li class="text-muted">Sin detalles</li>';
        }
        document.getElementById('scoringResultDetails').innerHTML = detallesHtml;
        // Update card
        var sb = document.getElementById('scoringBadge');
        if (sb) sb.innerHTML = '<span class="badge bg-' + riskBadge + ' fs-6">' + res.scoring + '/10</span>';
        var sr = document.getElementById('scoringRecomendacion');
        if (sr) {
          var recHtml = '';
          if (res.scoring >= 7) recHtml = '<span class="badge bg-success fs-6">✅ Recomendado</span>';
          else if (res.scoring >= 4) recHtml = '<span class="badge bg-warning fs-6">⚠️ Revisar</span>';
          else recHtml = '<span class="badge bg-danger fs-6">❌ No recomendado</span>';
          if (res.recomendacion) recHtml += '<br><small class="text-muted">' + res.recomendacion + '</small>';
          sr.innerHTML = recHtml;
        }
        // Mostrar resumen breve en el card
        var sr2 = document.getElementById('scoringResumen');
        if (sr2) {
          var resumenPts = [];
          if (res.detalleCompleto) { res.detalleCompleto.forEach(function(d) { resumenPts.push(d.factor + ': ' + d.impacto); }); }
          else if (res.detalles) { resumenPts = res.detalles; }
          if (resumenPts.length > 0) {
            sr2.innerHTML = resumenPts.slice(0, 4).join(' · ') + (resumenPts.length > 4 ? ' (+' + (resumenPts.length-4) + ' más)' : '');
            sr2.style.display = '';
          }
        }
        // Actualizar resumen inline detallado
        var sdl = document.getElementById('scoringDetalleList');
        if (sdl) {
          sdl.innerHTML = detallesHtml;
          var sdb = document.getElementById('scoringDetalleBody');
          if (sdb && sdb.style.display === 'none') {
            sdb.style.display = '';
            var sdi = document.getElementById('scoringDetalleIcon');
            if (sdi) sdi.className = 'bi bi-chevron-up';
          }
        }
      } else {
        document.getElementById('scoringResultValue').textContent = 'Error';
        document.getElementById('scoringResultDetails').innerHTML = '<li class="text-danger">' + (res.error || 'Error al calcular scoring') + '</li>';
      }
    })
    .catch(function(err) {
      document.getElementById('scoringResultValue').textContent = 'Error';
      document.getElementById('scoringResultDetails').innerHTML = '<li class="text-danger">Error de conexión: ' + err.message + '</li>';
    });
}
function autoCalcularScoring(clienteId) {
  if (!clienteId) return;
  fetch('/clientes/' + clienteId + '/calculate-scoring', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.ok) return;
      var riskBadge = 'secondary';
      if (res.risk === 'bajo' || res.risk === 'low') riskBadge = 'success';
      else if (res.risk === 'medio' || res.risk === 'medium') riskBadge = 'warning';
      else if (res.risk === 'alto' || res.risk === 'high') riskBadge = 'danger';
      var sv = document.getElementById('scoringVal');
      if (sv) { sv.textContent = res.scoring || '-'; sv.style.color = riskBadge === 'success' ? '#198754' : riskBadge === 'warning' ? '#ffc107' : riskBadge === 'danger' ? '#dc3545' : '#6c757d'; }
      var sr = document.getElementById('scoringRisk');
      if (sr) { sr.textContent = res.risk || '-'; sr.style.color = riskBadge === 'success' ? '#198754' : riskBadge === 'warning' ? '#ffc107' : riskBadge === 'danger' ? '#dc3545' : '#6c757d'; }
      var sf = document.getElementById('scoringFactores');
      if (sf && res.detalleCompleto && res.detalleCompleto.length > 0) {
