<% var _cid = (cliente && cliente.id != null) ? cliente.id : (typeof fiscalId !== 'undefined' && fiscalId ? fiscalId : ''); %>
<style>
/* Fix dropdowns appearing behind other elements (Note 15) */
.dropdown-menu { z-index: 9999 !important; }
.table-responsive { overflow: visible; }
.card-body { overflow: visible; }
.tab-content { overflow: visible; }
/* Mockup layout styles */
.info-card { background:#fff; border-radius:6px; box-shadow:0 1px 2px rgba(0,0,0,.06); padding:10px 16px; margin-bottom:6px; display:flex; flex-wrap:wrap; align-items:center; gap:4px 16px; font-size:0.95rem; border:1px solid #e9ecef; }
.info-card a { color:#0d6efd; text-decoration:none; font-size:0.85rem; }
.row2 { display:flex; gap:8px; margin-bottom:8px; }
.col70 { flex:7; min-width:0; display:flex; flex-direction:column; gap:8px; }
.col30 { flex:3; min-width:0; display:flex; flex-direction:column; gap:8px; }
.lc { background:#fff; border:1px solid #e9ecef; border-radius:6px; box-shadow:0 1px 2px rgba(0,0,0,.04); }
.h { padding:6px 12px; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center; font-size:0.85rem; }
.b { padding:8px 12px; }
.ln { font-weight:600; font-size:0.95rem; }
.lp { font-size:0.75rem; color:#6c757d; display:flex; justify-content:space-between; margin-bottom:2px; }
.be { font-size:0.7rem; padding:2px 8px; border-radius:4px; font-weight:500; }
.ba { background:#d1e7dd; color:#0f5132; }
.cr { height:44px; display:flex; align-items:flex-end; gap:2px; margin:4px 0; }
.cr .b { flex:1; background:#0dcaf0; border-radius:1px 1px 0 0; min-height:3px; position:relative; }
.cr .bl { position:absolute; bottom:-14px; left:50%; transform:translateX(-50%); font-size:0.55rem; color:#adb5bd; }
.cl { display:flex; justify-content:space-between; align-items:center; margin:4px 0; }
.tg { display:flex; gap:2px; }
.tb { font-size:0.7rem; padding:2px 8px; border:1px solid #dee2e6; background:#fff; border-radius:3px; cursor:pointer; }
.tb.act { background:#0dcaf0; color:#fff; }
.ut { font-size:0.7rem; color:#6c757d; }
.dg { display:grid; grid-template-columns:1fr 1fr; gap:2px 12px; font-size:0.8rem; margin-top:4px; }
.dg .r { display:flex; justify-content:space-between; padding:3px 0; border-bottom:1px solid #f5f5f5; }
.dg .l { color:#6c757d; }
.dg .v { font-weight:500; }
.ei { font-size:0.65rem; color:#0d6efd; cursor:pointer; }
.ar { display:flex; gap:4px; margin-top:6px; flex-wrap:wrap; }
.ab { font-size:0.72rem; padding:3px 10px; border-radius:4px; cursor:pointer; border:1px solid #ced4da; background:#fff; color:#333; }
.ab.pri { background:#0d6efd; color:#fff; }
.sc-bg { background:#f8f9fa; border-radius:5px; padding:8px 10px; margin-bottom:4px; }
.sc-bg h6 { font-size:0.8rem; margin-bottom:3px; font-weight:600; }
.sc-val { font-size:1.4rem; font-weight:700; color:#198754; }
.sc-btn { font-size:0.75rem; padding:3px 8px; border:1px solid #0d6efd; background:#fff; color:#0d6efd; border-radius:3px; cursor:pointer; }
.sc-tb { font-size:0.72rem; width:100%; }
.sc-tb td { padding:3px 4px; }
.sc-links { display:flex; flex-wrap:wrap; gap:3px; }
.sc-links a { font-size:0.68rem; padding:2px 6px; border:1px solid #dee2e6; border-radius:3px; color:#495057; text-decoration:none; }
.sub2 { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.sub2 > * { min-width:0; }
.bp { background:#fff; border-radius:8px; box-shadow:0 1px 3px rgba(0,0,0,.05); margin-top:8px; }
.bph { padding:8px 16px; border-bottom:1px solid #f0f0f0; font-size:0.85rem; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.pills { display:flex; flex-wrap:wrap; gap:4px; padding:6px 16px; }
.pill { font-size:0.75rem; padding:3px 12px; border:1px solid #dee2e6; border-radius:12px; cursor:pointer; background:#fff; color:#495057; }
.bd { display:grid; grid-template-columns:1fr 1fr 1fr auto; gap:10px; padding:8px 16px; }
.bd table { font-size:0.8rem; width:100%; }
.bd table th { color:#6c757d; font-weight:400; padding:2px 6px; width:80px; }
.bd table td { padding:2px 6px; }
.tab-row { display:flex; gap:5px; margin-bottom:8px; flex-wrap:wrap; }
.tab-card { background:#fff; border-radius:6px; box-shadow:0 1px 2px rgba(0,0,0,.06); padding:9px 16px; font-size:0.95rem; cursor:pointer; color:#495057; border:1px solid #e9ecef; }
.tab-card.active { background:#e7f1ff; border-color:#0d6efd; color:#0d6efd; font-weight:600; }
.tab-card .badge { font-size:0.7rem; background:#e9ecef; color:#495057; padding:2px 7px; border-radius:5px; margin-left:4px; }
/* Override de estilos inline con rem muy pequeños para legibilidad */
.info-card table, .info-card td, .info-card th { font-size:0.85rem !important; }
#detalleTabContent table td, #detalleTabContent table th { font-size:0.85rem; }
.lc .b table, .lc .b td, .lc .b th { font-size:0.8rem !important; }
#scoringVal { font-size:1.6rem !important; }
#scoringRisk { font-size:0.8rem !important; }
#scoringFactores td { font-size:0.72rem !important; padding:3px 4px !important; }
#chartInfoText { font-size:0.78rem !important; }
#detProd, #detEstado, #detIcc, #detPinPuk, #detPago, #detCredito, #detAlta, #detGbNac, #detGbRoam { font-size:0.82rem !important; }
.lc .ab { font-size:0.72rem !important; padding:4px 10px !important; margin-bottom:2px; }
#subsFilter2, #globalFilter { font-size:0.8rem !important; }
.pill { font-size:0.75rem !important; padding:3px 12px !important; }
#detalleTabContent .table { font-size:0.85rem; }
#detalleTabContent .btn { font-size:0.78rem; }
#detalleTabContent .badge { font-size:0.78rem; }
</style>
<section>
  <% if (typeof apiError !== 'undefined' && apiError) { %>
  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle"></i> <strong>Aviso:</strong> <%= apiError %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <!-- TABS como cards independientes -->
  <div class="tab-row">
    <button class="tab-card active" data-target="#info"><i class="bi bi-info-circle"></i> Informaci&oacute;n</button>
    <button class="tab-card" data-target="#lineas"><i class="bi bi-phone"></i> L&iacute;neas / Suscripciones <% if (apiSubscriptions.length > 0 || lineas.length > 0) { %><span class="badge"><%= apiSubscriptions.length + lineas.length %></span><% } %></button>
    <button class="tab-card" data-target="#ordenes"><i class="bi bi-cart"></i> &Oacute;rdenes <% if (apiOrders.length > 0) { %><span class="badge"><%= apiOrders.length %></span><% } %></button>
    <button class="tab-card" data-target="#facturas"><i class="bi bi-receipt"></i> Facturas <% if (apiInvoices.length > 0) { %><span class="badge"><%= apiInvoices.length %></span><% } %></button>
    <button class="tab-card" data-target="#instalaciones"><i class="bi bi-wrench"></i> Instalaciones <% if (apiInstallations.length > 0) { %><span class="badge"><%= apiInstallations.length %></span><% } %></button>
    <button class="tab-card" data-target="#kyc"><i class="bi bi-file-earmark-text"></i> KYC</button>
    <button class="tab-card" data-target="#contrato"><i class="bi bi-file-text"></i> Contrato <% if (contratos.length > 0 || altasOrdenes.length > 0) { %><span class="badge"><%= contratos.length + altasOrdenes.length + contratosS3.length %></span><% } %></button>
  </div>

  <!-- INFO CARD compacta -->
  <div class="info-card">
    <span><strong><%= (apiCustomer.name || apiCustomer.firstName || cliente.nombre) %> <%= (apiCustomer.lastName || apiCustomer.surname || cliente.apellidos || '') %></strong> · <%= apiCustomer.fiscalId || cliente.dni_nif || '' %></span>
    <span class="text-muted">|</span>
    <span>📧 <%= apiCustomer.email || cliente.email || '-' %></span>
    <span>📱 <%= apiCustomer.phone || cliente.telefono || '-' %></span>
    <span class="text-muted">|</span>
    <span>🏢 <%= apiCustomer.customerType || cliente.tipo_cliente || 'particular' %></span>
    <span>📅 <%= apiCustomer.created || cliente.created_at ? new Date(apiCustomer.created || cliente.created_at).toLocaleDateString('es-ES') : '-' %></span>
    <span>📍 <%= (apiCustomer.billingAddress && (apiCustomer.billingAddress.street || apiCustomer.billingAddress.cityName)) || cliente.direccion || cliente.ciudad || '-' %></span>
    <a href="/clientes/<%= _cid %>/editar">✏️ Editar</a>
    <span class="text-muted">|</span>
    <select id="globalFilter" style="font-size:0.6rem;border:1px solid #dee2e6;border-radius:4px;padding:2px 4px;">
      <option value="activa">Activas</option>
      <option value="all">Todas</option>
      <option value="cancelada">Canceladas</option>
    </select>
  </div>

  <div class="tab-content" id="detalleTabContent">
        <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
  <!-- INFO + SCORING -->
  <div style="display:flex;gap:6px;margin-bottom:6px;">
    <div style="flex:7;min-width:0;">
      <div class="info-card" style="height:100%;">
        <table style="width:100%;font-size:0.65rem;">
          <tr><th style="color:#6c757d;font-weight:400;padding:2px 6px;width:70px;">Nombre</th><td style="padding:2px 6px;"><strong><%= (apiCustomer.name || apiCustomer.firstName || cliente.nombre) %> <%= (apiCustomer.lastName || apiCustomer.surname || cliente.apellidos || '') %></strong> · <%= apiCustomer.fiscalId || cliente.dni_nif || '' %></td></tr>
          <tr><th style="color:#6c757d;font-weight:400;padding:2px 6px;">📧 Email</th><td style="padding:2px 6px;"><%= apiCustomer.email || cliente.email || '-' %></td></tr>
          <tr><th style="color:#6c757d;font-weight:400;padding:2px 6px;">📱 Teléfono</th><td style="padding:2px 6px;"><%= apiCustomer.phone || cliente.telefono || '-' %></td></tr>
          <tr><th style="color:#6c757d;font-weight:400;padding:2px 6px;">🏢 Tipo</th><td style="padding:2px 6px;"><%= apiCustomer.customerType || cliente.tipo_cliente || 'particular' %></td></tr>
          <tr><th style="color:#6c757d;font-weight:400;padding:2px 6px;">📅 Cliente desde</th><td style="padding:2px 6px;"><%= apiCustomer.created || cliente.created_at ? new Date(apiCustomer.created || cliente.created_at).toLocaleDateString('es-ES') : '-' %></td></tr>
          <tr><th style="color:#6c757d;font-weight:400;padding:2px 6px;">📍 Dirección</th><td style="padding:2px 6px;"><%= (apiCustomer.billingAddress && (apiCustomer.billingAddress.street || apiCustomer.billingAddress.cityName)) || cliente.direccion || cliente.ciudad || '-' %></td></tr>
        </table>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px;padding-top:4px;border-top:1px solid #f0f0f0;">
          <div><a href="/clientes/<%= _cid %>/editar" style="color:#0d6efd;font-size:0.55rem;">✏️ Editar</a> <a href="#" onclick="openTicketModal()" style="color:#0d6efd;font-size:0.55rem;margin-left:8px;">🎫 Ticket</a></div>
        </div>
      </div>
    </div>
    <div style="flex:3;min-width:240px;">
      <div class="lc" style="height:100%;">
        <div class="h"><span>🧠 Scoring</span></div>
        <div class="b">
          <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:1.1rem;font-weight:700;color:#198754;" id="scoringVal">-</span><span style="font-size:0.5rem;">/10 · Riesgo: <strong id="scoringRisk">-</strong></span>
          </div>
          <button class="ab pri" style="font-size:0.4rem;padding:2px 8px;margin:4px 0;" onclick="calcularScoring('<%= _cid %>')">🔄 Calcular</button>
          <table style="font-size:0.42rem;width:100%;"><tbody id="scoringFactores"><tr><td style="color:#6c757d;">Pulsa Calcular</td></tr></tbody></table>
          <div style="margin-top:3px;display:flex;flex-wrap:wrap;gap:1px;">
            <a href="https://www.boe.es/buscar/boe.php?campo%5B%5D=NIF&dato%5B%5D=<%= encodeURIComponent(apiCustomer.fiscalId || cliente.dni_nif || '') %>&campo%5B%5D=TIT&operador%5B%5D=and&page_h_t=1&lang=es" target="_blank" style="font-size:0.3rem;padding:1px 3px;border:1px solid #dee2e6;border-radius:2px;color:#495057;text-decoration:none;">BOE</a>
            <a href="https://www.google.com/search?q=<%= encodeURIComponent((apiCustomer.fiscalId || cliente.dni_nif || '') + ' morosidad') %>" target="_blank" style="font-size:0.3rem;padding:1px 3px;border:1px solid #dee2e6;border-radius:2px;color:#495057;text-decoration:none;">Google</a>
            <a href="https://www.borme.es/BormeBuscar/paginas/InformeEmpresa.aspx?cif=<%= encodeURIComponent(apiCustomer.fiscalId || cliente.dni_nif || '') %>" target="_blank" style="font-size:0.3rem;padding:1px 3px;border:1px solid #dee2e6;border-radius:2px;color:#495057;text-decoration:none;">BORME</a>
            <a href="https://www1.sedecatastro.gob.es/OVCFrames.aspx?TIPO=CONSULTA&NUMERO=<%= encodeURIComponent(apiCustomer.fiscalId || cliente.dni_nif || '') %>" target="_blank" style="font-size:0.3rem;padding:1px 3px;border:1px solid #dee2e6;border-radius:2px;color:#495057;text-decoration:none;">Catastro</a>
            <a href="https://www.axesor.es/buscador/?tipo=1&query=<%= encodeURIComponent(apiCustomer.fiscalId || cliente.dni_nif || '') %>" target="_blank" style="font-size:0.3rem;padding:1px 3px;border:1px solid #dee2e6;border-radius:2px;color:#495057;text-decoration:none;">Axesor</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- LINEAS / SUSCRIPCIONES -->
  <div class="bp" style="margin-bottom:6px;">
    <div class="bph">
      <span style="font-weight:600;font-size:0.55rem;">📱 Líneas / Suscripciones</span>
      <select style="font-size:0.42rem;" id="subsFilter2"><option value="activa" selected>Activas</option><option value="all">Todas</option><option value="cancelada">Canceladas</option></select>
      <span style="margin-left:auto;font-size:0.42rem;"><%= (apiSubscriptions||[]).length %> líneas</span>
    </div>
    <div class="pills" id="subsPills2">
      <% (apiSubscriptions||[]).forEach(function(s) { %>
        <% (s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber, status: s.status}]).forEach(function(p) { %>
          <% var _pln = String(p.lineNumber || s.lineNumber || '').replace(/'/g, ""); %>
          <% var _pst = String(p.status || s.status || '').toLowerCase(); %>
          <span class="pill" data-estado="<%= _pst %>" onclick="selectLine('<%= _pln %>')"><%= p.lineNumber || s.lineNumber %></span>
        <% }); %>
      <% }); %>
    </div>
  </div>
  <!-- LINE CARD FULL WIDTH -->
  <% var _primeraLinea = ''; if (apiSubscriptions) { apiSubscriptions.forEach(function(s) { (s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber, status: s.status, icc: s.icc}]).forEach(function(p) { var ln = p.lineNumber || s.lineNumber || ''; if (!_primeraLinea && /^[67]\d{8}$/.test(ln)) _primeraLinea = ln; }); }); } %>
  <div class="lc">
    <div class="h"><span><span style="font-weight:600;font-size:0.7rem;"><%= _primeraLinea || '-' %></span> <span class="be ba">Activa</span></span></div>
    <div class="b">
      <div style="display:flex;justify-content:space-between;font-size:0.45rem;color:#6c757d;margin-bottom:2px;"><span id="lineProd">-</span><span id="linePago">💳 IBAN</span></div>
      <div style="font-size:0.38rem;color:#6c757d;">📅 Julio 2026 ◀ ▶</div>
      <div style="height:60px;display:flex;align-items:flex-end;gap:1px;margin:3px 0;" id="chartBars"></div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin:3px 0;flex-wrap:wrap;">
        <div style="display:flex;gap:2px;">
          <span class="tb act" onclick="window._chartTipo='gb';renderChartBars()">GB</span>
          <span class="tb" onclick="window._chartTipo='calls';renderChartBars()">📞</span>
          <span class="tb" onclick="window._chartTipo='sms';renderChartBars()">💬</span>
        </div>
        <span style="font-size:0.42rem;color:#6c757d;" id="chartInfoText">Total GB: -</span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px 8px;font-size:0.42rem;margin-top:2px;">
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">Producto</span><span style="font-weight:500;" id="detProd">-</span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">Estado</span><span style="font-weight:500;" id="detEstado">-</span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">ICC</span><span style="font-weight:500;" id="detIcc">- <span style="font-size:0.3rem;color:#0d6efd;cursor:pointer;" onclick="copiarICC()" title="Copiar ICC">📋</span></span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">PIN/PUK</span><span style="font-weight:500;" id="detPinPuk">- <span style="font-size:0.3rem;color:#0d6efd;cursor:pointer;" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)mostrarPinPuk(l)" title="Ver PIN/PUK">👁️</span></span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">💳 Pago</span><span style="font-weight:500;" id="detPago">- <span style="font-size:0.3rem;color:#0d6efd;cursor:pointer;" onclick="abrirPagoModal()" title="Cambiar método de pago">✏️</span></span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">💰 Crédito</span><span style="font-weight:500;" id="detCredito">- <span style="font-size:0.3rem;color:#0d6efd;cursor:pointer;" onclick="abrirCreditoModal()" title="Gestionar límite de crédito">✏️</span></span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">🏢 SPN</span><span style="font-weight:500;">Movilbro</span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">📅 Alta</span><span style="font-weight:500;" id="detAlta">-</span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">📊 GB Nac</span><span style="font-weight:500;" id="detGbNac">-</span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">🌍 GB Roam</span><span style="font-weight:500;" id="detGbRoam">-</span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">📱 Notificar</span><span><input type="checkbox" style="transform:scale(0.4);"></span></div>
        <div style="display:flex;justify-content:space-between;padding:1px 0;border-bottom:1px solid #f5f5f5;"><span style="color:#6c757d;">🚫 Bloquear</span><span><input type="checkbox" style="transform:scale(0.4);"> <span style="font-size:0.3rem;color:#0d6efd;cursor:pointer;">✏️</span></span></div>
      </div>
      <div style="display:flex;gap:3px;margin-top:4px;flex-wrap:wrap;">
        <button class="ab pri" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)window.location.href='/clientes/<%= _cid %>/line/'+l+'/gestion'">⚙️ Gestión</button>
        <button class="ab" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)mostrarPinPuk(l)">🔑 PIN/PUK</button>
        <button class="ab" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)alert('Bloquear '+l)">🚫 Bloquear</button>
        <button class="ab" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)alert('Desbloquear '+l)">✅ Desbloquear</button>
        <button class="ab" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)window.location.href='/clientes/<%= _cid %>/line/'+l+'/gestion'">💳 Cambiar pago</button>
        <button class="ab" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)window.location.href='/clientes/<%= _cid %>/line/'+l+'/gestion'">📱 eSIM</button>
        <button class="ab" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)alert('Cambio tarifa '+l)">📝 Cambio tarifa</button>
        <button class="ab" onclick="var l=detLineSelected||'<%= _primeraLinea %>';if(l)alert('Duplicar SIM '+l)">📋 Duplicar SIM</button>
      </div>
    </div>
  </div>
        </div>

        <!-- ==================== TAB 2: L├ìNEAS / SUSCRIPCIONES ==================== -->
        <div class="tab-pane fade" id="lineas" role="tabpanel" aria-labelledby="lineas-tab">
          <% if (apiSubscriptions.length === 0 && lineas.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-phone" style="font-size:3rem;"></i>
            <p class="mt-2">Este cliente no tiene l&iacute;neas o suscripciones</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>L&iacute;nea</th>
                  <th>Producto / Tarifa</th>
                  <th>Estado</th>
