function filtrarSubs(){
  var sel = document.getElementById('subsFilter2') || document.getElementById('globalFilter');
  if(!sel)return;
  var val = sel.value || sel.options[sel.selectedIndex].text.toLowerCase();
  if (val === 'todas') val = 'all';
  if (val === 'canceladas') val = 'cancelada';
  if (val === 'activas') val = 'activa';
  // Filtrar pills por estado
  document.querySelectorAll('.pill[data-estado]').forEach(function(p){
    var est = (p.getAttribute('data-estado')||'').toLowerCase();
    var isTerm = est==='cancelada'||est==='canceled'||est==='terminada'||est==='terminated'||est==='baja'||est==='cancelled'||est==='inactive'||est==='terminated';
    var isAct = est==='activa'||est==='active'||est==='activo'||est==='en servicio'||est==='operativa'||est==='preactiva';
    if(val==='all') p.style.display='';
    else if(val==='cancelada') p.style.display=isTerm?'':'none';
    else p.style.display=isAct?'':'none';
  });
  // Filtrar filas de tabla lineas (si existen)
  document.querySelectorAll('#lineas tbody tr').forEach(function(row){
    var badge=row.querySelector('td:nth-child(3) .badge');
    if(!badge){row.style.display='';return}
    var est=badge.textContent.trim().toLowerCase();
    var isTerm=est==='cancelada'||est==='canceled'||est==='terminada'||est==='terminated'||est==='baja'||est==='cancelled'||est==='inactive';
    var isAct=est==='activa'||est==='active'||est==='activo';
    if(val==='all')row.style.display='';
    else if(val==='cancelada')row.style.display=isTerm?'':'none';
    else row.style.display=isAct?'':'none';
  });
}

