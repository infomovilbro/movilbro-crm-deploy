function abrirLineModal(lineNumber, fiscalId) {
  if (!lineNumber || !fiscalId) return;
  var modal = document.getElementById('lineModal');
  if (!modal) return;
  try {
    var bsModal = bootstrap.Modal.getInstance(modal);
    if (!bsModal) bsModal = new bootstrap.Modal(modal);
  } catch(e) {
    var body = document.getElementById('lineModalBody');
    if (body) body.innerHTML = '<div class="alert alert-danger">Error al abrir modal: Bootstrap no disponible</div>';
    return;
  }
  document.getElementById('lineModalNumber').textContent = lineNumber;
  document.getElementById('lineModalBody').innerHTML = '<div class="p-3"><div class="placeholder-glow"><span class="placeholder col-12"></span><span class="placeholder col-8 mt-2"></span><span class="placeholder col-6 mt-2"></span><span class="placeholder col-10 mt-2"></span><span class="placeholder col-4 mt-2"></span></div><div class="mt-3 placeholder-glow"><span class="placeholder col-12"></span><span class="placeholder col-7 mt-1"></span><span class="placeholder col-9 mt-1"></span></div></div>';
  bsModal.show();

  // Timeout de 15s para el fetch
  var controller = new AbortController();
  var timeoutId = setTimeout(function() { controller.abort(); }, 15000);

  fetch('/clientes/' + encodeURIComponent(fiscalId) + '/line/' + encodeURIComponent(lineNumber) + '/full-consumption', { method: 'POST', signal: controller.signal })
    .then(function(r) {
      clearTimeout(timeoutId);
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function(res) {
      if (!res.ok) { document.getElementById('lineModalBody').innerHTML = '<div class="alert alert-danger">Error del servidor: ' + (res.error || 'desconocido') + '</div>'; return; }
      if (typeof renderLineModal === 'function') {
        renderLineModal(res.data, lineNumber, fiscalId);
      } else {
        document.getElementById('lineModalBody').innerHTML = '<div class="alert alert-danger">Error interno: renderLineModal no disponible</div>';
      }
    })
    .catch(function(err) {
      var msg = err.name === 'AbortError' ? 'Tiempo de espera agotado (15s)' : err.message;
      document.getElementById('lineModalBody').innerHTML = '<div class="alert alert-danger">Error: ' + msg + '</div>';
    });
}
