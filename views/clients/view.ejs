                  <tr>
                    <td><strong>#<%= o.id %></strong></td>
                    <td><%= dp.producto_id || '-' %></td>
                    <td><span class="badge bg-<%= o.estado === 'completada' ? 'success' : o.estado === 'pendiente_kyc' ? 'warning' : o.estado === 'cancelada' ? 'danger' : 'info' %>"><%= o.estado %></span></td>
