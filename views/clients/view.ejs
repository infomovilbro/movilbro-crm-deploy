                        <i class="bi <%= (est === 'activa' || est === 'active') ? 'bi-lock' : 'bi-unlock' %>"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-primary cambiar-tarifa-btn" data-line="<%= linea %>" title="Cambiar tarifa">
