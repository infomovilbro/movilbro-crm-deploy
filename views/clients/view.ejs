      </a>
      <% } else if (c.orderId) { %>
      <a href="/clientes/contrato/s3/<%= c.orderId %>" target="_blank" class="btn btn-sm btn-outline-success">
        <i class="bi bi-download"></i> Descargar Contrato Firmado
      </a>
      <% } else { %>
      <span class="text-muted">No disponible</span>
      <% } %>
    </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

          <% } %>
        </div>

      </div>
    </div>
  </div>
