<section>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1"><i class="bi bi-person-circle text-primary"></i>
        <%= (apiCustomer.name || apiCustomer.firstName || cliente.nombre) %> <%= (apiCustomer.lastName || apiCustomer.surname || cliente.apellidos || '') %>
      </h4>
      <small class="text-muted"><%= apiCustomer.fiscalId || cliente.dni_nif || '' %> &middot; #<%= cliente.id %></small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/clientes/<%= cliente.id %>/editar" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
      <a href="/clientes" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>
  </div>

  <div class="card">
    <div class="card-header p-0">
      <ul class="nav nav-tabs card-header-tabs mx-2 mt-2" id="detalleTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="true">
            <i class="bi bi-info-circle"></i> Informaci&oacute;n
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="lineas-tab" data-bs-toggle="tab" data-bs-target="#lineas" type="button" role="tab" aria-controls="lineas" aria-selected="false">
            <i class="bi bi-phone"></i> L&iacute;neas / Suscripciones
            <% if (apiSubscriptions.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiSubscriptions.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="ordenes-tab" data-bs-toggle="tab" data-bs-target="#ordenes" type="button" role="tab" aria-controls="ordenes" aria-selected="false">
            <i class="bi bi-cart"></i> &Oacute;rdenes
            <% if (apiOrders.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiOrders.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="facturas-tab" data-bs-toggle="tab" data-bs-target="#facturas" type="button" role="tab" aria-controls="facturas" aria-selected="false">
            <i class="bi bi-receipt"></i> Facturas
            <% if (apiInvoices.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiInvoices.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="instalaciones-tab" data-bs-toggle="tab" data-bs-target="#instalaciones" type="button" role="tab" aria-controls="instalaciones" aria-selected="false">
            <i class="bi bi-wrench"></i> Instalaciones
            <% if (apiInstallations.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiInstallations.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="kyc-tab" data-bs-toggle="tab" data-bs-target="#kyc" type="button" role="tab" aria-controls="kyc" aria-selected="false">
            <i class="bi bi-file-earmark-text"></i> Documentos KYC
          </button>
        </li>
      </ul>
    </div>
    <div class="card-body">
      <div class="tab-content" id="detalleTabContent">

        <!-- ==================== TAB 1: INFO ==================== -->
        <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="card h-100 border">
                <div class="card-header fw-semibold"><i class="bi bi-person"></i> Datos personales</div>
                <div class="card-body">
                  <table class="table table-sm mb-0">
                    <% var nom = apiCustomer.name || apiCustomer.firstName || cliente.nombre; %>
                    <% var ape = apiCustomer.lastName || apiCustomer.surname || cliente.apellidos || ''; %>
                    <tr><th style="width:100px;">Nombre</th><td><%= nom %> <%= ape %></td></tr>
                    <tr><th>DNI/NIF</th><td><strong><%= apiCustomer.fiscalId || cliente.dni_nif || '-' %></strong></td></tr>
                    <tr><th>Email</th><td>
                      <% var em = apiCustomer.email || apiCustomer.contactInfo?.email || cliente.email; %>
                      <% if (em) { %><a href="mailto:<%= em %>"><%= em %></a><% } else { %>-<% } %>
                    </td></tr>
                    <tr><th>Tel&eacute;fono</th><td>
                      <% var tf = apiCustomer.phone || apiCustomer.contactInfo?.phone || cliente.telefono; %>
                      <% if (tf) { %><a href="tel:<%= tf %>"><%= tf %></a><% } else { %>-<% } %>
                    </td></tr>
                    <tr><th>Tel&eacute;fono 2</th><td><%= cliente.telefono2 || '-' %></td></tr>
                    <tr><th>Tipo</th><td>
                      <% var t = apiCustomer.customerType || cliente.tipo_cliente || 'particular'; %>
                      <span class="badge bg-<%= t === 'empresa' || t === 'Business' ? 'secondary' : 'primary' %>"><%= t %></span>
                    </td></tr>
                    <% if (cliente.likes_customer_id) { %><tr><th>ID Likes</th><td><code><%= cliente.likes_customer_id %></code></td></tr><% } %>
                    <tr><th>Cliente desde</th><td>
                      <%= apiCustomer.created || cliente.created_at ? new Date(apiCustomer.created || cliente.created_at).toLocaleDateString('es-ES') : '-' %>
                    </td></tr>
                  </table>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card h-100 border">
                <div class="card-header fw-semibold"><i class="bi bi-geo-alt"></i> Direcci&oacute;n y pago</div>
                <div class="card-body">
                  <table class="table table-sm mb-0">
                    <% var addr = apiCustomer.billingAddress || apiCustomer.address || {}; %>
                    <tr><th style="width:100px;">Direcci&oacute;n</th><td>
                      <%= addr.street || cliente.direccion || '-' %>
                      <%= addr.cityName || addr.city || cliente.ciudad ? ', ' + (addr.cityName || addr.city || cliente.ciudad) : '' %>
                      <%= addr.state || cliente.provincia ? ', ' + (addr.state || cliente.provincia) : '' %>
                      <%= addr.zipCode || addr.zip || cliente.codigo_postal ? ' (' + (addr.zipCode || addr.zip || cliente.codigo_postal) + ')' : '' %>
                    </td></tr>
                    <tr><th>M&eacute;todo pago</th><td>
                      <% var pm = apiCustomer.paymentMethod || apiCustomer.paymentInfo?.method || cliente.metodo_pago; %>
                      <% if (pm) { %><span class="badge bg-info"><i class="bi bi-credit-card"></i> <%= pm %></span><% } else { %>-<% } %>
                    </td></tr>
                    <tr><th>IBAN</th><td><% if (cliente.iban) { %><code><%= cliente.iban %></code><% } else { %>-<% } %></td></tr>
                    <% if (cliente.stripe_payment_method) { %>
                    <tr><th>Stripe PM</th><td><small class="text-muted"><%= cliente.stripe_payment_method %></small></td></tr>
                    <% } %>
                  </table>
                </div>
              </div>
            </div>
            <% if (apiCustomer.aeatStatus || apiCustomer.aeat_status || apiCustomer.scoring || apiCustomer.score || apiCustomer.scoring) { %>
            <div class="col-md-6">
              <div class="card h-100 border">
                <div class="card-header fw-semibold"><i class="bi bi-shield-check"></i> AEAT &amp; Scoring</div>
                <div class="card-body">
                  <table class="table table-sm mb-0">
                    <tr><th style="width:120px;">Estado AEAT</th><td>
                      <% var ae = apiCustomer.aeatStatus || apiCustomer.aeat_status || ''; %>
                      <% if (ae) { %><span class="badge bg-<%= ae === 'ok' || ae === 'verified' || ae === 'valido' ? 'success' : ae === 'pending' || ae === 'pendiente' ? 'warning' : 'danger' %>"><%= ae %></span><% } else { %><span class="text-muted">-</span><% } %>
                    </td></tr>
                    <tr><th>Scoring</th><td>
                      <% var sc = apiCustomer.scoring || apiCustomer.score || apiCustomer.rating || ''; %>
                      <% if (sc) { %>
                        <span class="badge bg-<%= parseFloat(sc) >= 7 ? 'success' : parseFloat(sc) >= 4 ? 'warning' : 'danger' %> fs-6"><%= sc %></span>
                      <% } else { %><span class="text-muted">-</span><% } %>
                    </td></tr>
                    <tr><th>Riesgo</th><td>
                      <% var rk = apiCustomer.riskLevel || apiCustomer.risk || apiCustomer.risk_level || ''; %>
                      <% if (rk) { %><span class="badge bg-<%= rk === 'bajo' || rk === 'low' ? 'success' : rk === 'medio' || rk === 'medium' ? 'warning' : 'danger' %>"><%= rk %></span><% } else { %><span class="text-muted">-</span><% } %>
                    </td></tr>
                  </table>
                </div>
              </div>
            </div>
            <% } %>
            <% if (cliente.notas) { %>
            <div class="col-12">
              <div class="card border">
                <div class="card-header fw-semibold"><i class="bi bi-sticky"></i> Notas</div>
                <div class="card-body">
                  <p class="mb-0 text-muted"><%= cliente.notas %></p>
                </div>
              </div>
            </div>
            <% } %>
            <div class="col-md-6">
              <div class="card border" style="height:150px;overflow:hidden;">
                <div class="card-header py-1"><small><i class="bi bi-pie-chart"></i> Estado de L&iacute;neas</small></div>
                <div class="card-body p-2"><canvas id="statusChart"></canvas></div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card border" style="height:150px;overflow:hidden;">
                <div class="card-header py-1"><small><i class="bi bi-bar-chart"></i> Consumo GB</small></div>
                <div class="card-body p-2"><canvas id="gbChart"></canvas></div>
              </div>
            </div>
          </div>
        </div>

        <!-- ==================== TAB 2: LÍNEAS / SUSCRIPCIONES ==================== -->
        <div class="tab-pane fade" id="lineas" role="tabpanel" aria-labelledby="lineas-tab">
          <% if (apiSubscriptions.length === 0 && lineas.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-phone" style="font-size:3rem;"></i>
            <p class="mt-2">Este cliente no tiene l&iacute;neas o suscripciones</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>L&iacute;nea</th>
                  <th>Producto / Tarifa</th>
                  <th>Estado</th>
                  <th>ICC / ICCID</th>
                  <th>PIN / PUK</th>
                  <th>Alta</th>
                  <th>Baja</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% apiSubscriptions.forEach(function(s) { %>
                <% var prods = s.products && s.products.length ? s.products : (s.productName ? [s] : []); %>
                <% prods.forEach(function(p) { %>
                <% var linea = p.lineNumber || p.line || s.phone || s.line || ''; %>
                <tr>
                  <td><strong><%= linea || '-' %></strong></td>
                  <td><%= p.productName || s.productName || s.product || '-' %></td>
                  <td>
                    <% var est = (p.status || s.status || s.estado || 'activa').toLowerCase(); %>
                    <span class="badge bg-<%= est === 'activa' || est === 'activo' || est === 'active' ? 'success' : est === 'suspendida' || est === 'suspended' ? 'warning' : est === 'baja' || est === 'cancelled' ? 'secondary' : 'danger' %> fs-6">
                      <%= est %>
                    </span>
                  </td>
                  <td><small class="text-muted"><%= p.icc || p.iccid || s.icc || s.iccid || '-' %></small></td>
                  <td>
                    <% var ctr = lineas.find(function(l) { return l.linea === linea; }); %>
                    <% if (ctr && (ctr.pin || ctr.puk)) { %>
                    <button class="btn btn-sm btn-outline-secondary" onclick="mostrarPinPuk('<%= linea %>', '<%= ctr.pin %>', '<%= ctr.puk %>')">
                      <i class="bi bi-key"></i> PIN/PUK
                    </button>
                    <% } else { %>
                    <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td><small><%= (s.created || s.sellDate || s.startDate || s.fecha_alta) ? new Date(s.created || s.sellDate || s.startDate || s.fecha_alta).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td><small><%= (s.cancelled_at || s.endDate || s.fecha_baja) ? new Date(s.cancelled_at || s.endDate || s.fecha_baja).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <button class="btn btn-sm btn-outline-info ver-consumo" data-line="<%= linea %>" data-client="<%= cliente.id %>" <%= linea ? '' : 'disabled' %>>
                        <i class="bi bi-graph-up"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-warning toggle-block" data-line="<%= linea %>" data-client="<%= cliente.id %>" data-blocked="<%= est !== 'activa' && est !== 'active' %>" <%= linea ? '' : 'disabled' %>>
                        <i class="bi <%= (est === 'activa' || est === 'active') ? 'bi-lock' : 'bi-unlock' %>"></i>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }); %>
                <% }); %>
                <% lineas.forEach(function(l) { %>
                <% if (!apiSubscriptions.some(function(s) { var prods = s.products && s.products.length ? s.products : (s.productName ? [s] : []); return prods.some(function(p) { return (p.lineNumber || p.line || s.phone || s.line) === l.linea; }); })) { %>
                <tr class="table-secondary">
                  <td><strong><%= l.linea || '-' %></strong></td>
                  <td><%= l.producto || '-' %> <small class="text-muted">(local)</small></td>
                  <td>
                    <span class="badge bg-<%= l.estado === 'activo' ? 'success' : l.estado === 'pendiente' ? 'warning' : l.estado === 'baja' ? 'secondary' : 'danger' %> fs-6"><%= l.estado %></span>
                  </td>
                  <td><small class="text-muted"><%= l.iccid || '-' %></small></td>
                  <td>
                    <% if (l.pin || l.puk) { %>
                    <button class="btn btn-sm btn-outline-secondary" onclick="mostrarPinPuk('<%= l.linea %>', '<%= l.pin %>', '<%= l.puk %>')">
                      <i class="bi bi-key"></i> PIN/PUK
                    </button>
                    <% } else { %><span class="text-muted">-</span><% } %>
                  </td>
                  <td><small><%= l.fecha_alta ? new Date(l.fecha_alta).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td><small>-</small></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <button class="btn btn-sm btn-outline-info ver-consumo" data-line="<%= l.linea %>" data-client="<%= cliente.id %>" <%= l.linea ? '' : 'disabled' %>>
                        <i class="bi bi-graph-up"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-warning toggle-block" data-line="<%= l.linea %>" data-client="<%= cliente.id %>" data-blocked="<%= l.estado !== 'activo' %>" <%= l.linea ? '' : 'disabled' %>>
                        <i class="bi <%= l.estado === 'activo' ? 'bi-lock' : 'bi-unlock' %>"></i>
                      </button>
                    </div>
                  </td>
                </tr>
                <% } %>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="d-flex gap-2 flex-wrap mt-3">
            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#changeTariffModal"><i class="bi bi-arrow-left-right"></i> Cambiar tarifa</button>
            <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#blockLineModal"><i class="bi bi-lock"></i> Bloquear / Desbloquear</button>
            <button class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#duplicateSimModal"><i class="bi bi-sd-card"></i> Duplicar SIM</button>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 3: ÓRDENES ==================== -->
        <div class="tab-pane fade" id="ordenes" role="tabpanel" aria-labelledby="ordenes-tab">
          <% if (apiOrders.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-cart" style="font-size:3rem;"></i>
            <p class="mt-2">No hay &oacute;rdenes en la API para este cliente</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>#</th>
                  <th>Estado</th>
                  <th>Producto</th>
                  <th>L&iacute;nea</th>
                  <th>Total</th>
                  <th>Creaci&oacute;n</th>
                  <th>Actualizaci&oacute;n</th>
                </tr>
              </thead>
              <tbody>
                <% apiOrders.forEach(function(o) { %>
                <tr>
                  <td><strong>#<%= o.id || o.orderId || o.order_id || '-' %></strong></td>
                  <td>
                    <span class="badge bg-<%= (o.status || o.estado || '').toLowerCase() === 'completed' || (o.status || o.estado || '').toLowerCase() === 'completada' ? 'success' : (o.status || o.estado || '').toLowerCase() === 'pending' || (o.status || o.estado || '').toLowerCase() === 'pendiente' ? 'warning' : (o.status || o.estado || '').toLowerCase() === 'cancelled' || (o.status || o.estado || '').toLowerCase() === 'cancelada' ? 'danger' : 'info' %> fs-6">
                      <%= o.status || o.estado || o.state || 'desconocido' %>
                    </span>
                  </td>
                  <td><%= o.productName || o.product || o.description || '-' %></td>
                  <td><%= o.lineNumber || o.line || '-' %></td>
                  <td><%= o.total || o.amount || o.price ? (o.total || o.amount || o.price) + '€' : '-' %></td>
                  <td><small><%= (o.created || o.created_at || o.createdAt || o.date) ? new Date(o.created || o.created_at || o.createdAt || o.date).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td><small><%= (o.updated || o.updated_at || o.updatedAt) ? new Date(o.updated || o.updated_at || o.updatedAt).toLocaleDateString('es-ES') : '-' %></small></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 4: FACTURAS ==================== -->
        <div class="tab-pane fade" id="facturas" role="tabpanel" aria-labelledby="facturas-tab">
          <% if (apiInvoices.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-receipt" style="font-size:3rem;"></i>
            <p class="mt-2">No hay facturas en la API para este cliente</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>#</th>
                  <th>Concepto</th>
                  <th>Importe</th>
                  <th>Emisi&oacute;n</th>
                  <th>Vencimiento</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                <% apiInvoices.forEach(function(f) { %>
                <tr>
                  <td><strong>#<%= f.id || f.invoiceId || f.invoice_id || f.number || '-' %></strong></td>
                  <td><%= f.concept || f.concepto || f.description || f.descripcion || '-' %></td>
                  <td><strong><%= (f.amount || f.importe || f.total || f.amountDue || 0).toFixed(2) %>€</strong></td>
                  <td><small><%= (f.issuedDate || f.issued_date || f.fecha_emision || f.date || f.created) ? new Date(f.issuedDate || f.issued_date || f.fecha_emision || f.date || f.created).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td><small><%= (f.dueDate || f.due_date || f.fecha_vencimiento) ? new Date(f.dueDate || f.due_date || f.fecha_vencimiento).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <% var fs = (f.status || f.estado || 'pending').toLowerCase(); %>
                    <span class="badge bg-<%= fs === 'paid' || fs === 'pagada' || fs === 'completada' ? 'success' : fs === 'pending' || fs === 'pendiente' ? 'warning' : fs === 'overdue' || fs === 'vencida' ? 'danger' : fs === 'cancelled' || fs === 'cancelada' ? 'secondary' : 'info' %>">
                      <%= f.status || f.estado || 'pendiente' %>
                    </span>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 5: INSTALACIONES ==================== -->
        <div class="tab-pane fade" id="instalaciones" role="tabpanel" aria-labelledby="instalaciones-tab">
          <% if (apiInstallations.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-wrench" style="font-size:3rem;"></i>
            <p class="mt-2">No hay instalaciones para este cliente</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>#</th>
                  <th>Direcci&oacute;n</th>
                  <th>Producto</th>
                  <th>Estado</th>
                  <th>Fecha programada</th>
                  <th>Fecha real</th>
                </tr>
              </thead>
              <tbody>
                <% apiInstallations.forEach(function(i) { %>
                <tr>
                  <td><strong>#<%= i.id || i.installationId || '-' %></strong></td>
                  <td>
                    <%= i.address || i.direccion || (i.address?.street || '') %>
                    <%= (i.address?.cityName || i.address?.city || i.ciudad) ? ', ' + (i.address?.cityName || i.address?.city || i.ciudad) : '' %>
                  </td>
                  <td><%= i.productName || i.product || '-' %></td>
                  <td>
                    <span class="badge bg-<%= (i.status || i.estado || '').toLowerCase() === 'completed' || (i.status || i.estado || '').toLowerCase() === 'completada' ? 'success' : (i.status || i.estado || '').toLowerCase() === 'scheduled' || (i.status || i.estado || '').toLowerCase() === 'programada' ? 'info' : (i.status || i.estado || '').toLowerCase() === 'pending' || (i.status || i.estado || '').toLowerCase() === 'pendiente' ? 'warning' : 'secondary' %>">
                      <%= i.status || i.estado || 'desconocido' %>
                    </span>
                  </td>
                  <td><small><%= (i.scheduledDate || i.scheduled_date || i.fecha_programada || i.date) ? new Date(i.scheduledDate || i.scheduled_date || i.fecha_programada || i.date).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td><small><%= (i.completedDate || i.completed_date || i.fecha_real || i.installationDate) ? new Date(i.completedDate || i.completed_date || i.fecha_real || i.installationDate).toLocaleDateString('es-ES') : '-' %></small></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 6: DOCUMENTOS KYC ==================== -->
        <div class="tab-pane fade" id="kyc" role="tabpanel" aria-labelledby="kyc-tab">
          <% if (altasOrdenes.length === 0 && (!documentos || documentos.length === 0)) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-file-earmark-text" style="font-size:3rem;"></i>
            <p class="mt-2">No hay documentos KYC ni documentos ISP</p>
          </div>
          <% } else { %>
            <% if (altasOrdenes.length > 0) { %>
              <% altasOrdenes.forEach(function(o, oidx) { %>
              <% var datosCliente = o.datos_cliente ? JSON.parse(o.datos_cliente) : {}; %>
              <% var datosProducto = o.datos_producto ? JSON.parse(o.datos_producto) : {}; %>
              <div class="card border mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <span class="fw-semibold">
                    <i class="bi bi-cart"></i> Orden #<%= o.id %>
                    <span class="badge bg-<%= o.estado === 'completada' ? 'success' : o.estado === 'pendiente_kyc' ? 'warning' : o.estado === 'pendiente_aprobacion' ? 'info' : o.estado === 'cancelada' ? 'danger' : 'secondary' %> ms-2"><%= o.estado %></span>
                  </span>
                  <small class="text-muted"><%= new Date(o.created_at).toLocaleDateString('es-ES') %></small>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <table class="table table-sm mb-0">
                        <tr><th style="width:120px;">Producto</th><td><%= datosProducto.producto_id || '-' %></td></tr>
                        <tr><th>Contrataci&oacute;n</th><td><%= datosProducto.tipo_contratacion || '-' %></td></tr>
                        <tr><th>M&eacute;todo pago</th><td><%= (o.datos_pago ? JSON.parse(o.datos_pago).metodo : '') || '-' %></td></tr>
                        <tr><th>KYC docs</th><td><%= o.kyc_docs_subidos || 0 %> subidos<%= o.kyc_completado ? ' &middot; <span class="text-success"><i class="bi bi-check-circle"></i> Completado</span>' : '' %></td></tr>
                        <tr><th>Contrato firmado</th><td><%= o.kyc_contrato_firmado ? '<span class="text-success"><i class="bi bi-check-circle"></i> S&iacute;</span>' : '<span class="text-warning"><i class="bi bi-clock"></i> Pendiente</span>' %></td></tr>
                      </table>
                    </div>
                    <div class="col-md-6 text-end">
                      <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <a href="/kyc/contrato/<%= o.token %>" target="_blank" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-file-text"></i> Ver contrato
                        </a>
                        <% if (o.kyc_contrato_firmado) { %>
                        <button class="btn btn-sm btn-success" onclick="window.open('/kyc/contrato/<%= o.token %>','_blank')">
                          <i class="bi bi-file-earmark-check"></i> Contrato firmado
                        </button>
                        <% } %>
                      </div>
                    </div>
                  </div>

                  <% var docsOrden = kycDocsPorOrden && kycDocsPorOrden[o.id] ? kycDocsPorOrden[o.id] : []; %>
                  <% if (docsOrden.length > 0) { %>
                  <hr>
                  <h6 class="mb-2"><i class="bi bi-images"></i> Documentos subidos</h6>
                  <div class="row g-2">
                    <% docsOrden.forEach(function(d) { %>
                    <div class="col-md-4 col-6">
                      <div class="card border h-100">
                        <div class="card-body text-center py-3">
                          <i class="bi bi-file-earmark-image" style="font-size:2rem;"></i>
                          <div class="mt-1"><small><strong><%= d.tipo || 'Documento' %></strong></small></div>
                          <div class="mt-1">
                            <span class="badge bg-<%= d.estado === 'subido' ? 'success' : 'warning' %>"><%= d.estado %></span>
                          </div>
                          <% if (d.download_url) { %>
                          <a href="<%= d.download_url %>" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                            <i class="bi bi-download"></i> Descargar (Drive)
                          </a>
                          <% } else if (d.archivo) { %>
                          <a href="/uploads/kyc/<%= d.archivo %>" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                            <i class="bi bi-eye"></i> Ver
                          </a>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <% }) %>
                  </div>
                  <% } %>
                </div>
              </div>
              <% }) %>
            <% } %>

            <% if (documentos && documentos.length > 0) { %>
            <hr class="my-3">
            <h6><i class="bi bi-folder"></i> Documentos ISP</h6>
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead class="table-light">
                  <tr><th>Nombre</th><th>Tipo</th><th>Categor&iacute;a</th><th>Fecha</th><th></th></tr>
                </thead>
                <tbody>
                  <% documentos.forEach(function(d) { %>
                  <tr>
                    <td><%= d.nombre || d.archivo || 'Documento' %></td>
                    <td><span class="badge bg-secondary"><%= d.tipo || '-' %></span></td>
                    <td><%= d.categoria || '-' %></td>
                    <td><small><%= d.created_at ? new Date(d.created_at).toLocaleDateString('es-ES') : '-' %></small></td>
                    <td>
                      <% if (d.ruta) { %>
                      <a href="<%= d.ruta %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-download"></i></a>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- PIN/PUK Modal -->
<div class="modal fade" id="pinPukModal" tabindex="-1">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-key"></i> PIN / PUK</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center">
        <p class="mb-2"><strong>L&iacute;nea:</strong> <span id="pinPukLinea" class="text-primary"></span></p>
        <div class="row g-2">
          <div class="col-6">
            <div class="border rounded p-3 bg-light">
              <small class="text-muted d-block">PIN</small>
              <strong id="pinPukPin" style="font-size:1.3rem;letter-spacing:2px;">-</strong>
            </div>
          </div>
          <div class="col-6">
            <div class="border rounded p-3 bg-light">
              <small class="text-muted d-block">PUK</small>
              <strong id="pinPukPuk" style="font-size:1.3rem;letter-spacing:2px;">-</strong>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer justify-content-center">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
