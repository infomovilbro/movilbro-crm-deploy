<script>
function mostrarPinPuk(linea, pin, puk) {
  document.getElementById('pinPukLinea').textContent = linea || '-';
  document.getElementById('pinPukPin').textContent = pin || '-';
  document.getElementById('pinPukPuk').textContent = puk || '-';
  new bootstrap.Modal(document.getElementById('pinPukModal')).show();
}

document.addEventListener('DOMContentLoaded', function() {
  var statusData = <%- linesByStatus || '{}' %>;
  var linesArr = <%- lineNumbers || '[]' %>;
  var clientId = <%= cliente.id %>;

  function formatDate(d) {
    if (!d) return '-';
    try { return new Date(d).toLocaleDateString('es-ES'); } catch(e) { return d; }
  }

  // ========== INSTALLATION DETAIL ==========
  document.querySelectorAll('.ver-instalacion').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('instDetId').textContent = this.dataset.id || '-';
      document.getElementById('instDetAddress').textContent = (this.dataset.address || '') + (this.dataset.city ? ', ' + this.dataset.city : '');
      document.getElementById('instDetProduct').textContent = this.dataset.product || '-';
      var st = this.dataset.status || '';
      var badge = 'secondary';
      if (st.toLowerCase() === 'completed' || st.toLowerCase() === 'completada') badge = 'success';
      else if (st.toLowerCase() === 'scheduled' || st.toLowerCase() === 'programada') badge = 'info';
      else if (st.toLowerCase() === 'pending' || st.toLowerCase() === 'pendiente') badge = 'warning';
      document.getElementById('instDetStatus').innerHTML = '<span class="badge bg-' + badge + '">' + st + '</span>';
      document.getElementById('instDetScheduled').textContent = formatDate(this.dataset.scheduled);
      document.getElementById('instDetCompleted').textContent = formatDate(this.dataset.completed);
      document.getElementById('instDetTechnician').textContent = this.dataset.technician || '-';
      document.getElementById('instDetNotes').textContent = this.dataset.notes || '-';
      new bootstrap.Modal(document.getElementById('instalacionDetailModal')).show();
    });
  });

  // ========== STATUS CHART ==========
  var statusCtx = document.getElementById('statusChart');
  if (statusCtx && Object.keys(statusData).length > 0) {
    new Chart(statusCtx, {
      type: 'doughnut',
      data: {
        labels: Object.keys(statusData),
        datasets: [{
          data: Object.values(statusData),
          backgroundColor: ['#28a745', '#ffc107', '#dc3545', '#17a2b8', '#6c757d']
        }]
      },
      options: {
        animation: false, resizeDelay: 0,
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
        }
      }
    });
  }

  // ========== GB CHART ==========
  var gbCtx = document.getElementById('gbChart');
  var gbChart = null;
  if (gbCtx) {
    gbChart = new Chart(gbCtx, {
      type: 'bar',
      data: {
        labels: ['GB Totales', 'GB Usados', 'GB Restantes'],
        datasets: [{ label: 'GB', data: [0, 0, 0], backgroundColor: ['#17a2b8', '#ffc107', '#28a745'] }]
      },
      options: {
        animation: false, resizeDelay: 0,
        responsive: true, maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } },
        plugins: { legend: { display: false } }
      }
    });
    if (linesArr.length > 0) {
      var firstLine = linesArr[0];
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(firstLine) + '/consumption', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var d = res.data;
            var payload = d.data || d;
            var total = parseFloat(payload.totalGB || payload.total_gb || payload.total || payload.totalGb || 0);
            var used = parseFloat(payload.usedGB || payload.used_gb || payload.used || payload.consumed || payload.consumption || 0);
            var remaining = parseFloat(payload.remainingGB || payload.remaining_gb || payload.remaining || payload.remainingGb || 0);
            gbChart.data.datasets[0].data = [total, used, remaining];
            gbChart.update();
          }
        })
        .catch(function(err) { console.error('Auto-fetch consumption error:', err); });
    }
  }

  // ========== CONSUMPTION MODAL ==========
  var _consChartInstance = null;

  function parseGBData(payload) {
    var d = payload.data || payload;
    return {
      total: parseFloat(d.totalGB || d.total_gb || d.total || d.totalGb || d.allowance || 0),
      used: parseFloat(d.usedGB || d.used_gb || d.used || d.consumed || d.consumption || d.usage || 0),
      remaining: parseFloat(d.remainingGB || d.remaining_gb || d.remaining || d.remainingGb || d.balance || d.left || 0),
      roaming: parseFloat(d.roamingGB || d.roaming_gb || d.roaming || d.roaming_used || 0)
    };
  }

  function fetchCDRData(line, tbody) {
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/cdrs', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        tbody.innerHTML = '';
        if (res.ok && res.data) {
          var cdrList = Array.isArray(res.data) ? res.data : (res.data.data || res.data.cdrs || res.data.records || res.data.items || []);
          if (!Array.isArray(cdrList)) cdrList = [];
          if (cdrList.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin registros de llamadas</td></tr>';
          } else {
            cdrList.forEach(function(cdr) {
              var tr = document.createElement('tr');
              var fecha = cdr.date || cdr.fecha || cdr.startTime || cdr.start_date || cdr.startDate || '-';
              var tipo = cdr.type || cdr.tipo || cdr.callType || cdr.direction || '-';
              var destino = cdr.destination || cdr.destino || cdr.calledNumber || cdr.callee || cdr.phone || '-';
              var dur = cdr.duration || cdr.duracion || cdr.durationSec || cdr.seconds || cdr.durationSeconds || '-';
              var cost = cdr.cost || cdr.coste || cdr.price || cdr.amount || '-';
              if (dur !== '-' && !isNaN(parseFloat(dur))) {
                var secs = parseInt(dur);
                dur = Math.floor(secs / 60) + 'm ' + (secs % 60) + 's';
              }
              if (cost !== '-' && !isNaN(parseFloat(cost))) cost = parseFloat(cost).toFixed(4) + '€';
              tr.innerHTML = '<td class="small">' + fecha + '</td><td>' + tipo + '</td><td>' + destino + '</td><td>' + dur + '</td><td>' + cost + '</td>';
              tbody.appendChild(tr);
            });
          }
        } else {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin registros de llamadas</td></tr>';
        }
      })
      .catch(function(err) {
        console.error('CDRs error:', err);
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Error al cargar CDRs</td></tr>';
      });
  }

  document.querySelectorAll('.ver-consumo').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      document.getElementById('consLineNumber').textContent = line;
      var cdrBody = document.getElementById('cdrsBody');
      cdrBody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Cargando...</td></tr>';

      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/consumption', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var gb = parseGBData(res.data);
            document.getElementById('consTotalGB').textContent = gb.total.toFixed(2);
            document.getElementById('consUsedGB').textContent = gb.used.toFixed(2);
            document.getElementById('consRemainingGB').textContent = gb.remaining.toFixed(2);
            document.getElementById('consRoamingGB').textContent = gb.roaming.toFixed(2);
            if (gbChart) {
              gbChart.data.datasets[0].data = [gb.total, gb.used, gb.remaining];
              gbChart.update();
            }
            var consCtx = document.getElementById('consGBChart');
            if (consCtx) {
              if (_consChartInstance) { _consChartInstance.destroy(); }
              _consChartInstance = new Chart(consCtx, {
                type: 'bar',
                data: {
                  labels: ['Totales', 'Usados', 'Restantes'],
                  datasets: [{ label: 'GB', data: [gb.total, gb.used, gb.remaining], backgroundColor: ['#17a2b8', '#ffc107', '#28a745'] }]
                },
                options: {
                  animation: false, resizeDelay: 0,
                  responsive: true, maintainAspectRatio: false,
                  indexAxis: 'y',
                  plugins: { legend: { display: false } }
                }
              });
            }
          } else {
            document.getElementById('consTotalGB').textContent = 'Error';
            document.getElementById('consUsedGB').textContent = '-';
            document.getElementById('consRemainingGB').textContent = '-';
            document.getElementById('consRoamingGB').textContent = '-';
          }
        })
        .catch(function(err) {
          console.error('Consumption error:', err);
          document.getElementById('consTotalGB').textContent = 'Error';
        });

      fetchCDRData(line, cdrBody);
      new bootstrap.Modal(document.getElementById('consumptionModal')).show();
    });
  });

  // ========== BLOCK TOGGLE (inline buttons) ==========
  document.querySelectorAll('.toggle-block').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      var blocked = this.dataset.blocked === 'true';
      if (!line) return;
      if (!confirm((blocked ? 'Desbloquear' : 'Bloquear') + ' la l&iacute;nea ' + line + '?')) return;
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/block', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blocked: !blocked })
      })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok) { location.reload(); }
          else { alert('Error: ' + (res.error || 'Desconocido')); }
        })
        .catch(function(err) { alert('Error: ' + err.message); });
    });
  });

  // ========== POPULATE SELECTS ==========
  function populateSelect(id) {
    var sel = document.getElementById(id);
    if (!sel) return;
    linesArr.forEach(function(ln) {
      if (!ln) return;
      var opt = document.createElement('option');
      opt.value = ln;
      opt.textContent = ln;
      sel.appendChild(opt);
    });
  }
  populateSelect('tariffLine');
  populateSelect('blockLineSelect');
  populateSelect('simLine');

  // ========== CAMBIAR TARIFA FROM INLINE BUTTON ==========
  document.querySelectorAll('.cambiar-tarifa-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      var sel = document.getElementById('tariffLine');
      if (sel) { sel.value = line; }
      new bootstrap.Modal(document.getElementById('changeTariffModal')).show();
    });
  });

  // ========== DUPLICAR SIM FROM INLINE BUTTON ==========
  document.querySelectorAll('.duplicar-sim-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      var sel = document.getElementById('simLine');
      if (sel) { sel.value = line; }
      new bootstrap.Modal(document.getElementById('duplicateSimModal')).show();
    });
  });

  // ========== CHANGE TARIFF MODAL ==========
  document.getElementById('changeTariffModal').addEventListener('show.bs.modal', function() {
    var sel = document.getElementById('tariffProduct');
    sel.innerHTML = '<option>Cargando productos...</option>';
    sel.disabled = true;
    fetch('/clientes/' + clientId + '/compatible-products')
      .then(function(r) { return r.json(); })
      .then(function(res) {
        sel.innerHTML = '';
        if (res.ok && Array.isArray(res.data) && res.data.length > 0) {
          sel.appendChild(new Option('Seleccione producto...', ''));
          res.data.forEach(function(p) {
            var name = p.name || p.productName || p.product || p.description || '';
            var val = p.id || p.code || name;
            sel.appendChild(new Option(name, val));
          });
        } else {
          sel.innerHTML = '<option>No hay productos disponibles</option>';
        }
        sel.disabled = false;
      })
      .catch(function() {
        sel.innerHTML = '<option>Error al cargar</option>';
        sel.disabled = false;
      });
  });

  document.getElementById('submitChangeTariff').addEventListener('click', function() {
    var line = document.getElementById('tariffLine').value;
    var product = document.getElementById('tariffProduct').value;
    var schedule = document.getElementById('tariffSchedule').value || null;
    if (!line || !product) { alert('Seleccione l&iacute;nea y producto'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/change-tariff', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, productId: product, productCode: product, schedule: schedule })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('Cambio de tarifa solicitado correctamente');
          bootstrap.Modal.getInstance(document.getElementById('changeTariffModal')).hide();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== BLOCK LINE MODAL ==========
  document.getElementById('submitBlockLine').addEventListener('click', function() {
    var line = document.getElementById('blockLineSelect').value;
    var blocked = document.querySelector('input[name="blockAction"]:checked').value === 'block';
    if (!line) { alert('Seleccione una l&iacute;nea'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/block', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ blocked: blocked })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('L&iacute;nea ' + (blocked ? 'bloqueada' : 'desbloqueada') + ' correctamente');
          bootstrap.Modal.getInstance(document.getElementById('blockLineModal')).hide();
          location.reload();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== DUPLICATE SIM MODAL ==========
  document.getElementById('submitDuplicateSim').addEventListener('click', function() {
    var line = document.getElementById('simLine').value;
    var reason = document.getElementById('simReason').value;
    var simType = document.querySelector('input[name="simType"]:checked').value;
    if (!line) { alert('Seleccione una l&iacute;nea'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/duplicate-sim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, reason: reason, simType: simType, type: simType })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('Solicitud de duplicado de SIM realizada correctamente');
          bootstrap.Modal.getInstance(document.getElementById('duplicateSimModal')).hide();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== INIT POPOVERS ==========
  var popoverList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
  popoverList.forEach(function(el) {
    new bootstrap.Popover(el);
  });
});
</script>
