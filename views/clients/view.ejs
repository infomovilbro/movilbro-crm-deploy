                  <td>
                    <% var fs = (f.status || '').toLowerCase(); %>
                    <span class="badge bg-<%= fs === 'paid' || fs === 'pagada' || fs === 'completada' ? 'success' : fs === 'pending' || fs === 'pendiente' ? 'warning' : fs === 'overdue' || fs === 'vencida' ? 'danger' : fs === 'cancelled' || fs === 'cancelada' ? 'secondary' : 'info' %>">
                      <%= f.status %>
                    </span>
                  </td>
                  <td><small><%= f.issuedDate ? new Date(f.issuedDate).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <% if (f.id) { %>
                    <a href="/isp/facturacion/facturas/<%= f.id %>" target="_blank" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-eye"></i>
                    </a>
                    <% } %>
                  </td>
                </tr>
                <% if (f.fees && f.fees.length > 0) { %>
