var detLineSelected = '';
var _apiSubsData = <%- JSON.stringify(apiSubscriptions || []) %>;
function selectLine(line) {
  detLineSelected = line;
  // Resaltar pill seleccionado
  document.querySelectorAll('.pill').forEach(function(p) { p.classList.remove('act'); });
  document.querySelectorAll('.pill').forEach(function(p) {
    if ((p.textContent || '').trim() === line) p.classList.add('act');
  });
  // Actualizar header de la line card (la que contiene detProd)
  var detProd = document.getElementById('detProd');
  var lc = detProd ? detProd.closest('.lc') : null;
  if (lc) {
    var hdr = lc.querySelector('.h');
    if (hdr) hdr.innerHTML = '<span>' + line + ' <span class="be ba">Activa</span></span>';
    // Actualizar botones de la line card con la línea seleccionada
    lc.querySelectorAll('.ab').forEach(function(b) {
      var oc = b.getAttribute('onclick') || '';
      oc = oc.replace(/'[0-9]{9}'/g, "'" + line.replace(/'/g,'') + "'");
      b.setAttribute('onclick', oc);
    });
  }
  // Poblar detalles del producto desde _apiSubsData
  var subData = null;
  _apiSubsData.forEach(function(s) {
    (s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber, status: s.status, icc: s.icc, startDate: s.startDate}]).forEach(function(p) {
      if ((p.lineNumber || s.lineNumber) === line) {
        subData = {
          productName: p.productName || s.productName || '-',
          status: p.status || s.status || '-',
          icc: p.icc || s.icc || '-',
          startDate: p.startDate || s.startDate || '-'
        };
      }
    });
  });
  if (subData) {
    var eProd = document.getElementById('detProd');
    if (eProd) eProd.textContent = subData.productName;
    var eEst = document.getElementById('detEstado');
    if (eEst) eEst.textContent = subData.status;
    var eIcc = document.getElementById('detIcc');
    if (eIcc) eIcc.textContent = subData.icc;
    var eAlta = document.getElementById('detAlta');
    if (eAlta) eAlta.textContent = subData.startDate;
  }
  // Cargar consumo real de la línea
  var cid = window.clientId || '';
  if (cid) {
    fetch('/clientes/' + encodeURIComponent(cid) + '/line/' + encodeURIComponent(line) + '/consumption', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok && res.data) {
          var d = res.data.data || res.data;
          var nacEl = document.getElementById('detGbNac');
          if (nacEl) nacEl.textContent = (d.totalGB || d.total_gb || 0).toFixed(2) + ' GB';
          var roamEl = document.getElementById('detGbRoam');
          if (roamEl) roamEl.textContent = (d.totalRoamingGB || d.total_roaming_gb || 0).toFixed(2) + ' GB';
        }
      }).catch(function() {});
    // Cargar consumo diario para la gráfica de la line card
    fetch('/clientes/' + encodeURIComponent(cid) + '/line/' + encodeURIComponent(line) + '/daily-consumption', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok && res.data && res.data.length > 0) {
          window._chartDailyData = res.data;
          window._chartTipo = window._chartTipo || 'gb';
          renderChartBars();
        } else {
          window._chartDailyData = [];
          renderChartBars();
        }
      }).catch(function() {});
    // Cargar PIN/PUK de la línea
    fetch('/clientes/' + encodeURIComponent(cid) + '/line/' + encodeURIComponent(line) + '/pinpuk', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok && res.data) {
          var d = res.data.data || res.data;
          var pin = d.pin || d.pinCode || '';
          var puk = d.puk || d.pukCode || '';
          var elPin = document.getElementById('detPinPuk');
          if (elPin && (pin || puk)) {
            elPin.innerHTML = pin + ' / ' + puk + ' <span style="font-size:0.3rem;color:#0d6efd;cursor:pointer;" onclick="var l=detLineSelected;if(l)mostrarPinPuk(l)" title="Ver PIN/PUK">👁️</span>';
          }
        }
      }).catch(function() {});
  }
}
function renderChartBars() {
  var container = document.getElementById('chartBars');
  if (!container) return;
  var tipo = window._chartTipo || 'gb';
  var data = window._chartDailyData || [];
  if (!data.length) {
    container.innerHTML = '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#adb5bd;font-size:0.55rem;">Sin datos de consumo diario</div>';
    return;
  }
  // Mostrar últimos 31 días
  var ultimos = data.slice(0, 31);
  var max = 1;
  ultimos.forEach(function(d) { var v = d[tipo] || 0; if (v > max) max = v; });
  var html = '';
  ultimos.forEach(function(d) {
    var v = d[tipo] || 0;
    var h = Math.max(2, Math.round((v / max) * 100));
    var label = d.date ? d.date.substring(8, 10) : '';
    html += '<div style="flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%;gap:1px;" title="' + (d.date || '') + ': ' + v + '">' +
      '<div style="width:100%;background:#06b6d4;height:' + h + '%;border-radius:1px;min-height:2px;"></div>' +
      (ultimos.length <= 15 ? '<span style="font-size:0.3rem;color:#adb5bd;">' + label + '</span>' : '') +
      '</div>';
  });
  container.innerHTML = html;
  // Actualizar texto total
  var total = 0, coste = 0;
  data.forEach(function(d) { total += d[tipo] || 0; coste += d.cost || 0; });
  var label = { gb: 'GB', calls: 'Llamadas', sms: 'SMS' }[tipo] || 'GB';
  var info = document.getElementById('chartInfoText');
  if (info) info.innerHTML = 'Total ' + label + ': <strong>' + (tipo === 'gb' ? total.toFixed(2) + ' GB' : total) + '</strong>' + (coste ? ' · Coste: ' + coste.toFixed(2) + '€' : '');
}
