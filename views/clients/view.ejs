var _lineChartData = {};
var _lineCharts = {};
function initLineCharts() {
  if (typeof Chart === 'undefined') { setTimeout(initLineCharts, 1000); return; }
  var cid = '';
  var match = window.location.pathname.match(/\/fiscal\/([^\/]+)/);
  if (match) cid = match[1];
  if (!cid) cid = document.querySelector('[data-client]')?.getAttribute('data-client') || document.querySelector('.ver-consumo')?.dataset.client || '';
  if (!cid) return;
  var lineIds = [];
  document.querySelectorAll('[id^="chart-"]').forEach(function(c) {
    var id = c.id.replace('chart-', '');
    if (id && lineIds.indexOf(id) === -1 && /^\d+$/.test(id)) lineIds.push(id);
  });
  lineIds.forEach(function(line) { loadLineData(line, cid); loadLineGB(line, cid); });
}
function actualizarChart() {
  var tipo = window._chartTipo || 'gb';
  document.querySelectorAll('#chartBars ~ .cl .tb').forEach(function(b) { b.classList.remove('act'); });
  var btn = document.querySelector('#chartBars ~ .cl .tb[onclick*=\"' + tipo + '\"]');
  if (btn) btn.classList.add('act');
  var data = window._chartDailyData || [];
  if (data.length === 0) return;
  var total = 0, coste = 0;
  data.forEach(function(d) { total += d[tipo] || 0; coste += d.cost || 0; });
  var label = { gb: 'GB', calls: 'Llamadas', sms: 'SMS' }[tipo] || 'GB';
  document.getElementById('chartInfoText').innerHTML = 'Total ' + label + ': <strong>' + (tipo === 'gb' ? total.toFixed(2) + ' GB' : total) + '</strong> · Coste: ' + coste.toFixed(2) + '€';
}
function loadLineData(line, cid) {
  fetch('/clientes/' + encodeURIComponent(cid) + '/line/' + encodeURIComponent(line) + '/daily-consumption', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.data && res.data.length > 0) {
        _lineChartData[line] = res.data;
        renderLineChart(line);
      }
    }).catch(function() {});
}
function loadLineGB(line, cid) {
  fetch('/clientes/' + encodeURIComponent(cid) + '/line/' + encodeURIComponent(line) + '/consumption', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.data) {
        var d = res.data.data || res.data;
        var nac = d.usedGB || d.used_gb || d.used || 0;
        var nacTotal = d.totalGB || d.total_gb || d.total || 0;
        var roam = d.usedRoamingGB || d.used_roaming_gb || d.roaming || 0;
        var roamTotal = d.totalRoamingGB || d.total_roaming_gb || 0;
        var nacEl = document.getElementById('gbNac-' + line);
        if (nacEl) nacEl.textContent = nac.toFixed(2) + ' / ' + (nacTotal || 30).toFixed(2) + ' GB';
        var roamEl = document.getElementById('gbRoam-' + line);
        if (roamEl) roamEl.textContent = (roam || 0).toFixed(2) + ' / ' + (roamTotal || 1).toFixed(2) + ' GB';
      }
    }).catch(function() {});
}
