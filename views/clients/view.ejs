        <div class="d-flex gap-2 mt-2">
          <a href="/clientes/contrato/s3/<%= c.orderId %>" target="_blank" class="btn btn-sm btn-outline-success flex-fill">
            <i class="bi bi-download"></i> Descargar Contrato
          </a>
          <button class="btn btn-sm btn-outline-info flex-fill" onclick="verResumenOrden('<%= c.orderId %>')">
            <i class="bi bi-eye"></i> Ver resumen
          </button>
        </div>
      </div>
    </div>
  </div>
  <% }); %>
</div>
<% } %>

          <% } %>
        </div>

      </div>
    </div>
  </div>
</section>

