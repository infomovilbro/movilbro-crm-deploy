          <label class="form-label small">Tipo <span class="text-danger">*</span></label>
          <select class="form-select form-select-sm" id="ticketType">
            <option value="incidencia">Incidencia</option>
            <option value="consulta">Consulta</option>
            <option value="reclamacion">Reclamaci&oacute;n</option>
            <option value="baja">Baja</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small">L&iacute;nea</label>
          <select class="form-select form-select-sm" id="ticketLine">
            <option value="">Seleccionar l&iacute;nea...</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small">Asunto <span class="text-danger">*</span></label>
          <input type="text" class="form-control form-control-sm" id="ticketSubject" placeholder="Describe brevemente">
        </div>
        <div class="mb-2">
          <label class="form-label small">Descripci&oacute;n</label>
          <textarea class="form-control form-control-sm" id="ticketDesc" rows="2" placeholder="Detalla la incidencia..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="submitTicket()"><i class="bi bi-send"></i> Enviar</button>
      </div>
    </div>
  </div>
</div>

<script>
function toggleSection(id) {
  var el = document.getElementById(id);
  var icon = document.getElementById(id.replace('Body', 'Icon'));
  if (!el) return;
  if (el.style.display === 'none') {
    el.style.display = '';
    if (icon) icon.className = 'bi bi-chevron-down';
  } else {
    el.style.display = 'none';
    if (icon) icon.className = 'bi bi-chevron-up';
  }
}
function mostrarPinPuk(linea, pin, puk, icc) {
  document.getElementById('pinPukLinea').textContent = linea || '-';
  document.getElementById('pinPukPin').textContent = pin || '-';
  document.getElementById('pinPukPuk').textContent = puk || '-';
  document.getElementById('pinPukIcc').textContent = icc || '-';
  document.getElementById('pinPukModal').dataset.line = linea || '';
  var modalEl = document.getElementById('pinPukModal');
  var inst = bootstrap.Modal.getInstance(modalEl);
  if (inst) inst.dispose();
  new bootstrap.Modal(modalEl).show();
}

function generarPinPuk() {
  var line = document.getElementById('pinPukModal').dataset.line;
  if (!line) return alert('Seleccione una l&iacute;nea');
  if (!confirm('Generar nuevo PIN/PUK para ' + line + '?')) return;
  fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/generate-pinpuk', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.data) {
        var d = res.data.data || res.data;
        document.getElementById('pinPukPin').textContent = d.pin || d.pinCode || 'Generado';
        document.getElementById('pinPukPuk').textContent = d.puk || d.pukCode || 'Generado';
        alert('Nuevo PIN/PUK generado correctamente');
      } else {
        alert('Error: ' + (res.error || 'No se pudo generar'));
      }
    })
    .catch(function(err) { alert('Error: ' + err.message); });
}

function uploadKycDoc(tipo, btn) {
  var input = document.getElementById('kycFileInput');
  input.accept = 'image/*,.pdf';
  input.onchange = function() {
    var file = input.files && input.files[0];
    if (!file) return;
    var origText = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Subiendo...';
    var fd = new FormData();
    fd.append('file', file);
    fd.append('tipo', tipo);
    fetch('/clientes/' + clientId + '/upload-kyc', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          var msg = 'Documento subido' + (res.apiOk ? ' (API + Drive)' : ' (solo Drive)');
          document.getElementById('kycUploadResult').innerHTML = '<span class="text-success">' + msg + '</span>';
          setTimeout(function() { location.reload(); }, 1500);
        } else {
          alert(res.error || 'Error al subir');
        }
        btn.disabled = false; btn.innerHTML = origText;
      })
      .catch(function(e) { alert(e.message); btn.disabled = false; btn.innerHTML = origText; });
  };
  input.value = '';
  input.click();
}

function fetchWorkOrder(btn) {
  var installId = document.getElementById('instalacionDetailModal').dataset.installId;
  if (!installId) return alert('ID de instalaci&oacute;n no disponible');
  btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Buscando...';
  fetch('/clientes/' + clientId + '/installation/' + encodeURIComponent(installId) + '/work-order', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok && res.data) {
        var url = res.data.url || res.data.downloadUrl || res.data.parteUrl || res.data.link || '';
        if (url) {
          window.open(url, '_blank');
          document.getElementById('instDetParteLink').href = url;
          document.getElementById('instDetParteLink').classList.remove('d-none');
          btn.parentElement.removeChild(btn);
        } else {
          alert('Parte de trabajo encontrado pero sin URL disponible');
          btn.disabled = false; btn.innerHTML = '<i class="bi bi-search"></i> Buscar parte';
        }
      } else {
        alert(res.error || 'No se encontr&oacute; parte de trabajo');
        btn.disabled = false; btn.innerHTML = '<i class="bi bi-search"></i> Buscar parte';
      }
    })
    .catch(function(err) {
      alert('Error: ' + err.message);
      btn.disabled = false; btn.innerHTML = '<i class="bi bi-search"></i> Buscar parte';
    });
}

function openTicketModal() {
  var sel = document.getElementById('ticketLine');
  sel.innerHTML = '<option value="">Seleccionar l&iacute;nea...</option>';
  linesArr.forEach(function(ln) {
    if (!ln) return;
    var opt = document.createElement('option');
    opt.value = ln;
    opt.textContent = ln;
    sel.appendChild(opt);
  });
  new bootstrap.Modal(document.getElementById('ticketModal')).show();
}

function submitTicket() {
  var type = document.getElementById('ticketType').value;
  var line = document.getElementById('ticketLine').value;
  var subject = document.getElementById('ticketSubject').value.trim();
  var desc = document.getElementById('ticketDesc').value.trim();
  if (!subject) { alert('Escribe un asunto'); return; }
  var data = { type: type, subject: subject, description: desc || subject };
  if (line) data.line = line;
  fetch('/clientes/' + clientId + '/ticket', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (res.ok) {
      alert('Ticket creado correctamente');
      bootstrap.Modal.getInstance(document.getElementById('ticketModal')).hide();
      document.getElementById('ticketSubject').value = '';
      document.getElementById('ticketDesc').value = '';
    } else {
      alert(res.error || 'Error al crear ticket');
    }
  })
  .catch(function(e) { alert(e.message); });
}

function loadNubeInvoices(cid) {
  var container = document.getElementById('nubeInvoicesContainer');
  container.innerHTML = '<div class="text-center py-3"><span class="spinner-border spinner-border-sm me-2"></span>Buscando en Drive...</div>';
  fetch('/clientes/' + cid + '/drive-invoices')
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (!res.ok || !res.data || res.data.length === 0) {
        container.innerHTML = '<div class="small text-muted py-2"><i class="bi bi-inbox"></i> No se encontraron facturas en Drive para este cliente.</div>';
        return;
      }
      var html = '<div class="small text-muted mb-1">' + (res.total || res.data.length) + ' archivos encontrados</div><div class="accordion" id="nubeAccordion">';
      res.data.forEach(function(group, idx) {
        var collapseId = 'nubeCollapse' + idx;
        var headingId = 'nubeHeading' + idx;
        var monthNames = { '01':'Enero','02':'Febrero','03':'Marzo','04':'Abril','05':'Mayo','06':'Junio','07':'Julio','08':'Agosto','09':'Septiembre','10':'Octubre','11':'Noviembre','12':'Diciembre' };
        var monthLabel = monthNames[group.month] || group.month;
        html += '<div class="accordion-item" style="border:1px solid #e0e0e0;">' +
          '<h2 class="accordion-header" id="' + headingId + '">' +
            '<button class="accordion-button collapsed small py-2" data-bs-toggle="collapse" data-bs-target="#' + collapseId + '">' +
              '<i class="bi bi-folder me-1"></i> ' + group.year + ' - ' + monthLabel + ' <span class="badge bg-secondary ms-2">' + group.files.length + '</span>' +
            '</button></h2>' +
          '<div id="' + collapseId + '" class="accordion-collapse collapse" data-bs-parent="#nubeAccordion">' +
            '<div class="accordion-body p-1">';
        group.files.forEach(function(f) {
          var sizeStr = f.size ? (parseInt(f.size) / 1024).toFixed(0) + ' KB' : '';
          html += '<div class="d-flex justify-content-between align-items-center px-2 py-1 small" style="border-bottom:1px solid #f0f0f0;">' +
            '<span><i class="bi bi-file-pdf text-danger me-1"></i> ' + f.fileName + ' <span class="text-muted">' + sizeStr + '</span></span>' +
            '<a href="' + f.link + '" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-1"><i class="bi bi-download"></i></a>' +
          '</div>';
        });
        html += '</div></div></div>';
      });
      html += '</div>';
      container.innerHTML = html;
    })
    .catch(function(e) {
      container.innerHTML = '<div class="alert alert-danger small py-1">Error: ' + e.message + '</div>';
    });
}

function editarCampo(campo, clienteId) {
  var valorActual = '';
  if (campo === 'aeat_status') valorActual = '<%= (cliente.aeat_status || apiCustomer.aeatStatus || "") %>';
  else if (campo === 'scoring') valorActual = '<%= (cliente.scoring || apiCustomer.scoring || "") %>';
  else if (campo === 'riesgo') valorActual = '<%= (cliente.riesgo || apiCustomer.riskLevel || "") %>';
  var nuevoValor = prompt('Valor para ' + campo + ':', valorActual);
  if (nuevoValor === null) return;
  fetch('/clientes/' + clienteId + '/campo', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ campo: campo, valor: nuevoValor })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.ok) { location.reload(); }
    else { alert('Error: ' + (d.error || '')); }
  })
  .catch(function() { alert('Error de conexión'); });
}

function cambiarPagoLinea(linea, metodo) {
  if (!confirm('¿Cambiar método de pago de la línea ' + linea + ' a ' + metodo + '?')) return;
  fetch('/clientes/' + <%= _cid %> + '/line/' + encodeURIComponent(linea) + '/metodo-pago', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ metodo_pago: metodo })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.ok) { alert('Método de pago actualizado'); location.reload(); }
    else { alert('Error: ' + (d.error || '')); }
  })
  .catch(function() { alert('Error de conexión'); });
}

function guardarIBAN(clienteId) {
  var iban = document.getElementById('clienteIban').value.trim();
  if (!iban) { alert('Introduce un IBAN'); return; }
  fetch('/clientes/' + clienteId + '/campo', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ campo: 'iban', valor: iban })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.ok) { alert('IBAN actualizado'); location.reload(); }
    else { alert('Error: ' + (d.error || '')); }
  })
  .catch(function() { alert('Error de conexión'); });
}



function calcularScoring(clienteId) {
  var modal = new bootstrap.Modal(document.getElementById('scoringModal'));
  document.getElementById('scoringResultValue').textContent = '...';
  document.getElementById('scoringResultRisk').innerHTML = '';
  document.getElementById('scoringResultDetails').innerHTML = '<li class="text-muted">Calculando...</li>';
  modal.show();
  fetch('/clientes/' + clienteId + '/calculate-scoring', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        document.getElementById('scoringResultValue').textContent = res.scoring;
        var riskBadge = 'secondary';
        if (res.risk === 'bajo' || res.risk === 'low') riskBadge = 'success';
        else if (res.risk === 'medio' || res.risk === 'medium') riskBadge = 'warning';
        else if (res.risk === 'alto' || res.risk === 'high') riskBadge = 'danger';
        document.getElementById('scoringResultRisk').innerHTML = '<span class="badge bg-' + riskBadge + ' fs-6">Riesgo: ' + res.risk + '</span>';
        var detallesHtml = '';
        if (res.detalles && res.detalles.length > 0) {
          res.detalles.forEach(function(det) {
            detallesHtml += '<li>' + det + '</li>';
          });
        } else {
          detallesHtml += '<li class="text-muted">Sin detalles</li>';
        }
        document.getElementById('scoringResultDetails').innerHTML = detallesHtml;
        // Update card
        var sb = document.getElementById('scoringBadge');
        if (sb) sb.innerHTML = '<span class="badge bg-' + riskBadge + ' fs-6">' + res.scoring + '/10</span>';
        var sr = document.getElementById('scoringRecomendacion');
        if (sr) {
          var recHtml = '';
          if (res.scoring >= 7) recHtml = '<span class="badge bg-success fs-6">✅ Recomendado</span>';
          else if (res.scoring >= 4) recHtml = '<span class="badge bg-warning fs-6">⚠️ Revisar</span>';
          else recHtml = '<span class="badge bg-danger fs-6">❌ No recomendado</span>';
          sr.innerHTML = recHtml;
        }
      } else {
        document.getElementById('scoringResultValue').textContent = 'Error';
        document.getElementById('scoringResultDetails').innerHTML = '<li class="text-danger">' + (res.error || 'Error al calcular scoring') + '</li>';
      }
    })
    .catch(function(err) {
      document.getElementById('scoringResultValue').textContent = 'Error';
      document.getElementById('scoringResultDetails').innerHTML = '<li class="text-danger">Error de conexión: ' + err.message + '</li>';
    });
}
document.addEventListener('DOMContentLoaded', function() {
  var statusData = <%- JSON.stringify(linesByStatus || {}) %>;
  var linesArr = <%- JSON.stringify(lineNumbers || []) %>;
  var clientId = <%- JSON.stringify(_cid || null) %>;

  function formatDate(d) {
    if (!d) return '-';
    try { return new Date(d).toLocaleDateString('es-ES'); } catch(e) { return d; }
  }

  // ========== PIN/PUK BUTTONS ==========
  function getIccFromRow(btn) {
    var row = btn.closest('tr');
    if (!row) return '';
    var cells = row.querySelectorAll('td');
    for (var c of cells) {
      var txt = (c.textContent || '').trim();
      if (txt.length > 15 && !isNaN(txt.replace(/\s/g, '').slice(0,1))) return txt;
    }
    return '';
  }
  document.querySelectorAll('.mostrar-pinpuk').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      var pin = this.dataset.pin;
      var puk = this.dataset.puk;
      var icc = this.dataset.icc || '';
      if (!icc) icc = getIccFromRow(this);
      if (pin || puk) {
        mostrarPinPuk(line, pin, puk, icc);
      } else {
        mostrarPinPuk(line, 'Consultando...', '', icc);
        fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/pinpuk', { method: 'POST' })
          .then(function(r) { return r.json(); })
          .then(function(res) {
            if (res.ok && res.data) {
              var d = res.data.data || res.data;
              mostrarPinPuk(line, d.pin || d.pinCode || 'No disponible', d.puk || d.pukCode || 'No disponible', icc);
            } else {
              mostrarPinPuk(line, 'No disponible', 'No disponible', icc);
            }
          })
          .catch(function() {
            mostrarPinPuk(line, 'Error', 'Error', icc);
          });
      }
    });
  });

  // ========== INSTALLATION DETAIL ==========
  document.querySelectorAll('.ver-instalacion').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('instDetId').textContent = this.dataset.installationid || this.dataset.id || '-';
      document.getElementById('instDetAddress').textContent = (this.dataset.address || '') + (this.dataset.city ? ', ' + this.dataset.city : '');
      document.getElementById('instDetProduct').textContent = this.dataset.product || '-';
      var st = this.dataset.status || '';
      var badge = 'secondary';
      if (st.toLowerCase() === 'completed' || st.toLowerCase() === 'completada') badge = 'success';
      else if (st.toLowerCase() === 'scheduled' || st.toLowerCase() === 'programada') badge = 'info';
      else if (st.toLowerCase() === 'pending' || st.toLowerCase() === 'pendiente') badge = 'warning';
      document.getElementById('instDetStatus').innerHTML = '<span class="badge bg-' + badge + '">' + st + '</span>';
      document.getElementById('instDetScheduled').textContent = formatDate(this.dataset.scheduled);
      document.getElementById('instDetCompleted').textContent = formatDate(this.dataset.completed);
      document.getElementById('instDetTechnician').textContent = this.dataset.technician || '-';
      document.getElementById('instDetNotes').textContent = this.dataset.notes || '-';
      document.getElementById('instDetDni').textContent = this.dataset.dni || '-';
      document.getElementById('instDetOt').textContent = this.dataset.ot || '-';
      document.getElementById('instDetRouter').textContent = this.dataset.router || '-';
      document.getElementById('instDetOnt').textContent = this.dataset.ont || '-';
      document.getElementById('instDetCto').textContent = this.dataset.cto || '-';
      document.getElementById('instDetContrata').textContent = this.dataset.contrata || '-';
      // Parte link
      var parteUrl = this.dataset.parteUrl || '';
      var parteLink = document.getElementById('instDetParteLink');
      var fetchBtn = document.getElementById('instDetFetchParteBtn');
      var installId = this.dataset.installationid || this.dataset.id || '';
      document.getElementById('instalacionDetailModal').dataset.installId = installId;
      if (parteUrl) {
        parteLink.href = parteUrl;
        parteLink.classList.remove('d-none');
        if (fetchBtn) fetchBtn.classList.add('d-none');
      } else {
        parteLink.href = '#';
        parteLink.classList.add('d-none');
        if (fetchBtn && installId) fetchBtn.classList.remove('d-none');
        else if (fetchBtn) fetchBtn.classList.add('d-none');
      }
      // History
      var historyDiv = document.getElementById('instDetHistory');
      try {
        var hist = JSON.parse(decodeURIComponent(this.dataset.history || '[]'));
        if (hist.length > 0) {
          var html = '<ul style="list-style:none;padding:0;margin:0;">';
          hist.forEach(function(h) {
            var hDate = h.date || h.created || h.timestamp || '';
            var hStatus = h.status || h.estado || h.state || '';
            var hNote = h.note || h.nota || h.comment || h.notes || '';
            html += '<li style="padding:4px 0;border-bottom:1px solid #eee;">' +
              '<small class="text-muted">' + (hDate ? new Date(hDate).toLocaleString('es-ES') : '?') + '</small> ' +
              '<span class="badge bg-info">' + hStatus + '</span>' +
              (hNote ? '<br><em>' + hNote + '</em>' : '') +
              '</li>';
          });
          html += '</ul>';
          historyDiv.innerHTML = html;
        } else {
          historyDiv.innerHTML = '<div class="text-center text-muted py-2">Sin historial disponible</div>';
        }
      } catch(e) { historyDiv.innerHTML = '<div class="text-center text-muted py-2">Sin historial</div>'; }

      new bootstrap.Modal(document.getElementById('instalacionDetailModal')).show();
    });
  });

  // ========== FETCH PARTE DE TRABAJO ==========
  document.querySelectorAll('.fetch-parte-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var installId = this.dataset.installationid;
      var cid = this.dataset.clientid || clientId;
      if (!installId) { alert('ID de instalaci&oacute;n no disponible'); return; }
      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
      fetch('/clientes/' + cid + '/installation/' + encodeURIComponent(installId) + '/work-order', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var url = res.data.url || res.data.downloadUrl || res.data.parteUrl || res.data.link || '';
            if (url) {
              window.open(url, '_blank');
              btn.outerHTML = '<a href="' + url + '" target="_blank" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-pdf"></i> Descargar Parte</a>';
            } else {
              alert('Parte encontrado pero sin URL');
              btn.disabled = false; btn.innerHTML = '<i class="bi bi-search"></i> Buscar parte';
            }
          } else {
            alert(res.error || 'No se encontr&oacute; parte de trabajo');
            btn.disabled = false; btn.innerHTML = '<i class="bi bi-search"></i> Buscar parte';
          }
        })
        .catch(function(err) {
          alert('Error: ' + err.message);
          btn.disabled = false; btn.innerHTML = '<i class="bi bi-search"></i> Buscar parte';
        });
    });
  });

  // ========== LINES STATUS SUMMARY TABLE ==========
  var summaryBody = document.getElementById('linesStatusSummaryBody');
  if (summaryBody && linesArr.length > 0) {
    var statusHtml = '';
    Object.keys(statusData).forEach(function(est) {
      var badgeClass = est === 'activa' || est === 'active' ? 'success' : est === 'suspendida' || est === 'suspended' ? 'warning' : 'secondary';
      statusHtml += '<tr><td><span class="badge bg-' + badgeClass + '">' + est + '</span></td><td class="text-end"><strong>' + statusData[est] + '</strong></td></tr>';
    });
    if (statusHtml) {
      summaryBody.innerHTML = statusHtml;
    }
  }

  // ========== STATUS CHART (only if no lines) ==========
  var statusCtx = document.getElementById('statusChart');
  if (statusCtx && Object.keys(statusData).length > 0) {
    new Chart(statusCtx, {
      type: 'doughnut',
      data: {
        labels: Object.keys(statusData),
        datasets: [{
          data: Object.values(statusData),
          backgroundColor: ['#28a745', '#ffc107', '#dc3545', '#17a2b8', '#6c757d']
        }]
      },
      options: {
        animation: false, resizeDelay: 0,
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } }
        }
      }
    });
  }
  // ========== GB CHART (fixed size, no infinite loop) ==========
  var gbCtx = document.getElementById('gbChart');
  var gbChart = null;
  var gbLineSelect = document.getElementById('gbLineSelect');

  if (gbCtx && typeof Chart !== 'undefined') {
    try {
      gbChart = new Chart(gbCtx, {
        type: 'doughnut',
        data: {
          labels: ['Usado', 'Disponible'],
          datasets: [{ data: [0, 30], backgroundColor: ['#17a2b8', '#e9ecef'], borderWidth: 0 }]
        },
        options: {
          animation: false, resizeDelay: 0,
          responsive: true, maintainAspectRatio: true,
          cutout: '65%',
          plugins: { legend: { display: false }, tooltip: { enabled: true } }
        }
      });
    } catch(e) { gbChart = null; }

    // Populate line selector from linesArr
    if (gbLineSelect && linesArr.length > 0) {
      linesArr.forEach(function(ln) {
        if (!ln) return;
        var opt = document.createElement('option');
        opt.value = ln;
        opt.textContent = ln;
        gbLineSelect.appendChild(opt);
      });
    }

    // Load GB for a specific line
    function loadGB(line) {
      if (!line || !gbChart) return;
      var consPerLine = document.getElementById('consPerLine');
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/consumption', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var d = res.data.data || res.data;
            var used = parseFloat(d.usedGB || d.used_gb || d.used || 0);
            var total = parseFloat(d.totalGB || d.total_gb || d.total || 30);
            var roaming = parseFloat(d.roamingGB || d.roaming_gb || d.roaming || 0);
            var remaining = total - used;
            if (remaining < 0) remaining = 0;
            gbChart.data.datasets[0].data = [used, remaining];
            gbChart.update();
            consPerLine.innerHTML = '<div class="d-flex justify-content-between small"><span>Usado: <strong>' + used.toFixed(2) + ' GB</strong></span><span>Total: <strong>' + total.toFixed(2) + ' GB</strong></span><span>Restante: <strong>' + remaining.toFixed(2) + ' GB</strong></span></div>';
            if (roaming > 0) consPerLine.innerHTML += '<div class="small text-muted">Roaming: ' + roaming.toFixed(2) + ' GB</div>';
          } else {
            consPerLine.innerHTML = '<div class="small text-muted">Sin datos de consumo</div>';
          }
        })
        .catch(function() { consPerLine.innerHTML = '<div class="small text-muted">Error al cargar consumo</div>'; });
    }

    if (gbLineSelect) {
      gbLineSelect.addEventListener('change', function() { loadGB(this.value); });
    }

    // Load first line by default
    if (linesArr.length > 0) {
      if (gbLineSelect) gbLineSelect.value = linesArr[0];
      loadGB(linesArr[0]);
    }
  }
  // Funcion para abrir consumo detallado desde la tarjeta GB
  window.abrirConsumoModal = function() {
    var sel = document.getElementById('gbLineSelect');
    var line = sel ? sel.value : '';
    if (!line && linesArr.length > 0) line = linesArr[0];
    if (line) {
      // Simular clic en el boton de consumo correspondiente
      var btn = document.querySelector('.ver-consumo[data-line="' + line.replace(/"/g, '') + '"]');
      if (btn) { btn.click(); return; }
      // Si no hay boton, abrir modal directamente
      document.getElementById('consLineNumber').textContent = line;
      new bootstrap.Modal(document.getElementById('consumptionModal')).show();
    }
  };
  // ========== CONSUMPTION MODAL ==========
  var _consChartInstance = null;

  function parseGBData(payload) {
    var d = payload.data || payload;
    return {
      total: parseFloat(d.totalGB || d.total_gb || d.total || d.totalGb || d.allowance || 0),
      used: parseFloat(d.usedGB || d.used_gb || d.used || d.consumed || d.consumption || d.usage || 0),
      remaining: parseFloat(d.remainingGB || d.remaining_gb || d.remaining || d.remainingGb || d.balance || d.left || 0),
      roaming: parseFloat(d.roamingGB || d.roaming_gb || d.roaming || d.roaming_used || 0)
    };
  }

  function fetchCDRData(line, tbody) {
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/cdrs', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        tbody.innerHTML = '';
        if (res.ok && res.data) {
          var cdrList = Array.isArray(res.data) ? res.data : (res.data.data || res.data.cdrs || res.data.records || res.data.items || []);
          if (!Array.isArray(cdrList)) cdrList = [];
          if (cdrList.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin registros de llamadas</td></tr>';
          } else {
            cdrList.forEach(function(cdr) {
              var tr = document.createElement('tr');
              var fecha = cdr.date || cdr.fecha || cdr.startTime || cdr.start_date || cdr.startDate || '-';
              var tipo = cdr.type || cdr.tipo || cdr.callType || cdr.direction || '-';
              var destino = cdr.destination || cdr.destino || cdr.calledNumber || cdr.callee || cdr.phone || '-';
              var dur = cdr.duration || cdr.duracion || cdr.durationSec || cdr.seconds || cdr.durationSeconds || '-';
              var cost = cdr.cost || cdr.coste || cdr.price || cdr.amount || '-';
              if (dur !== '-' && !isNaN(parseFloat(dur))) {
                var secs = parseInt(dur);
                dur = Math.floor(secs / 60) + 'm ' + (secs % 60) + 's';
              }
              if (cost !== '-' && !isNaN(parseFloat(cost))) cost = parseFloat(cost).toFixed(4) + '€';
              tr.innerHTML = '<td class="small">' + fecha + '</td><td>' + tipo + '</td><td>' + destino + '</td><td>' + dur + '</td><td>' + cost + '</td>';
              tbody.appendChild(tr);
            });
          }
        } else {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin registros de llamadas</td></tr>';
        }
      })
      .catch(function(err) {
        console.error('CDRs error:', err);
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Error al cargar CDRs</td></tr>';
      });
  }

  document.querySelectorAll('.ver-consumo').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      document.getElementById('consLineNumber').textContent = line;

      // Fetch line info (SIM, PIN, PUK, titular, SPN, credit limit)
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/info', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var d = res.data;
            document.getElementById('consLineInfoCard').style.display = '';
            document.getElementById('consLineTitular').textContent = d.titular || d.holderName || d.clientName || '-';
            document.getElementById('consLineDni').textContent = d.dni || d.fiscalId || '-';
            document.getElementById('consLineSpn').textContent = d.spn || d.operator || '-';
            document.getElementById('consLineStatus').textContent = d.status || d.estado || '-';
            document.getElementById('consLineSim').textContent = d.iccid || d.sim || d.icc || '-';
            document.getElementById('consLinePin').textContent = d.pin || d.pinCode || '-';
            document.getElementById('consLinePuk').textContent = d.puk || d.pukCode || '-';
            document.getElementById('consLineCreditLimit').textContent = d.creditLimit || d.credit_limit || '-';
          } else {
            document.getElementById('consLineInfoCard').style.display = 'none';
          }
        }).catch(function() { document.getElementById('consLineInfoCard').style.display = 'none'; });

      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/consumption', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data) {
            var gb = parseGBData(res.data);
            document.getElementById('consTotalGB').textContent = gb.total.toFixed(2);
            document.getElementById('consUsedGB').textContent = gb.used.toFixed(2);
            document.getElementById('consRemainingGB').textContent = gb.remaining.toFixed(2);
            document.getElementById('consRoamingGB').textContent = gb.roaming.toFixed(2);
            if (gbChart) {
              gbChart.data.datasets[0].data = [gb.total, gb.used, gb.remaining];
              gbChart.update();
            }
            var consCtx = document.getElementById('consGBChart');
            if (consCtx) {
              if (_consChartInstance) { _consChartInstance.destroy(); }
              _consChartInstance = new Chart(consCtx, {
                type: 'bar',
                data: {
                  labels: ['Totales', 'Usados', 'Restantes'],
                  datasets: [{ label: 'GB', data: [gb.total, gb.used, gb.remaining], backgroundColor: ['#17a2b8', '#ffc107', '#28a745'] }]
                },
                options: {
                  animation: false, resizeDelay: 0,
                  responsive: true, maintainAspectRatio: false,
                  indexAxis: 'y',
                  plugins: { legend: { display: false } }
                }
              });
            }
          } else {
            document.getElementById('consTotalGB').textContent = 'Error';
            document.getElementById('consUsedGB').textContent = '-';
            document.getElementById('consRemainingGB').textContent = '-';
            document.getElementById('consRoamingGB').textContent = '-';
          }
        })
        .catch(function(err) {
          console.error('Consumption error:', err);
          document.getElementById('consTotalGB').textContent = 'Error';
        });

      fetchCDRData(line, cdrBody);
      
            // Cargar consumo diario desde daily-consumption endpoint
      var dailyBody2 = document.getElementById('consDailyBody2');
      dailyBody2.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Cargando...</td></tr>';
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/daily-consumption', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.data && res.data.length > 0) {
            var html = '';
            var dailyLabels = [];
            var dailyData = { gb: [], calls: [], sms: [] };
            res.data.forEach(function(d, idx) {
              dailyLabels.push(d.date ? d.date.substring(5) : idx);
              dailyData.gb.push(d.gb || 0);
              dailyData.calls.push(d.calls || 0);
              dailyData.sms.push(d.sms || 0);
              html += '<tr class="cons-day-row" style="cursor:pointer;" data-idx="' + idx + '">' +
                '<td>' + d.date + '</td>' +
                '<td class="text-end">' + (d.gb || 0).toFixed(4) + '</td>' +
                '<td class="text-end">' + (d.calls || 0) + '</td>' +
                '<td class="text-end">' + (d.sms || 0) + '</td>' +
                '<td><i class="bi bi-chevron-down"></i></td></tr>' +
                '<tr class="cons-day-detail" data-idx="' + idx + '" style="display:none;">' +
                '<td colspan="5" class="p-2 bg-light"><div class="small text-muted">Detalle del día ' + d.date + ': ' + (d.gb || 0).toFixed(4) + ' GB, ' + (d.calls || 0) + ' llamadas, ' + (d.sms || 0) + ' SMS</div></td></tr>';
            });
            dailyBody2.innerHTML = html;
            // Daily chart with view switching
            var dailyCtx = document.getElementById('consDailyChart');
            var chartColors = { gb: '#06b6d4', calls: '#8b5cf6', sms: '#10b981' };
            function renderDailyChart(type) {
              if (window._consDailyChartInstance) { window._consDailyChartInstance.destroy(); }
              if (!dailyCtx) return;
              window._consDailyChartInstance = new Chart(dailyCtx, {
                type: 'bar',
                data: {
                  labels: dailyLabels,
                  datasets: [{ label: { gb: 'GB/día', calls: 'Llamadas/día', sms: 'SMS/día' }[type] || 'GB/día', data: dailyData[type] || dailyData.gb, backgroundColor: chartColors[type] || '#06b6d4', borderRadius: 3 }]
                },
                options: {
                  animation: false, responsive: true, maintainAspectRatio: false,
                  plugins: { legend: { display: false } },
                  scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 8 }, maxRotation: 0 } },
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' }, ticks: { font: { size: 8 } } }
                  }
                }
              });
            }
            renderDailyChart('gb');
            // Radio buttons for chart type
            document.querySelectorAll('input[name="dailyChartType"]').forEach(function(rb) {
              rb.addEventListener('change', function() { if (this.checked) renderDailyChart(this.value); });
            });
            // Add click expand/collapse with CDR data
            var _dailyCdrsCache = {}; // cache: date → cdrs array
            dailyBody2.querySelectorAll('.cons-day-row').forEach(function(row) {
              row.addEventListener('click', function() {
                var idx = this.dataset.idx;
                var detailRow = dailyBody2.querySelector('.cons-day-detail[data-idx="' + idx + '"]');
                if (!detailRow) return;
                if (detailRow.style.display !== 'none') {
                  detailRow.style.display = 'none';
                  this.querySelector('.bi').className = 'bi bi-chevron-down';
                  return;
                }
                // Show detail and load CDRs for this date
                detailRow.style.display = '';
                this.querySelector('.bi').className = 'bi bi-chevron-up';
                var dateStr = this.querySelector('td:first-child').textContent.trim();
                if (detailRow.dataset.loaded) return;
                detailRow.dataset.loaded = '1';
                detailRow.innerHTML = '<div class="small text-muted text-center py-2">Cargando llamadas de ' + dateStr + '...</div>';
                // Use already-loaded CDR data if available, otherwise fetch
                var cdrTableBody = document.getElementById('cdrsBody');
                var existingRows = cdrTableBody ? Array.from(cdrTableBody.querySelectorAll('tr')) : [];
                var dayCdrs = [];
                existingRows.forEach(function(tr) {
                  var dateCell = tr.querySelector('td:first-child');
                  if (dateCell && dateCell.textContent.trim().startsWith(dateStr)) {
                    dayCdrs.push({ date: dateCell.textContent.trim(), type: (tr.cells[1]||{}).textContent||'', dest: (tr.cells[2]||{}).textContent||'', dur: (tr.cells[3]||{}).textContent||'', cost: (tr.cells[4]||{}).textContent||'' });
                  }
                });
                if (dayCdrs.length > 0) {
                  detailRow.innerHTML = '<td colspan="5" class="p-2 bg-light"><table class="table table-sm mb-0"><thead><tr><th>Hora</th><th>Tipo</th><th>Destino</th><th>Duración</th><th>Coste</th></tr></thead><tbody>' + dayCdrs.map(function(c) { return '<tr><td class="small">' + c.date + '</td><td>' + c.type + '</td><td>' + c.dest + '</td><td>' + c.dur + '</td><td>' + c.cost + '</td></tr>'; }).join('') + '</tbody></table></td>';
                } else {
                  detailRow.innerHTML = '<td colspan="5" class="p-2 bg-light"><div class="small text-muted py-2">' + dateStr + ': sin llamadas registradas</div></td>';
                }
              });
            });
          } else {
            dailyBody2.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Sin datos de consumo diario</td></tr>';
          }
        })
        .catch(function() {
          dailyBody2.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Error al cargar consumo diario</td></tr>';
        });
new bootstrap.Modal(document.getElementById('consumptionModal')).show();
    });
  });

  // ========== BLOCK TOGGLE (inline buttons) ==========
  document.querySelectorAll('.toggle-block').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      var blocked = this.dataset.blocked === 'true';
      if (!line) return;
      if (!confirm((blocked ? 'Desbloquear' : 'Bloquear') + ' la l&iacute;nea ' + line + '?')) return;
      fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/block', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blocked: !blocked })
      })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok) { location.reload(); }
          else { alert('Error: ' + (res.error || 'Desconocido')); }
        })
        .catch(function(err) { alert('Error: ' + err.message); });
    });
  });

  // ========== POPULATE SELECTS ==========
  function populateSelect(id) {
    var sel = document.getElementById(id);
    if (!sel) return;
    linesArr.forEach(function(ln) {
      if (!ln) return;
      var opt = document.createElement('option');
      opt.value = ln;
      opt.textContent = ln;
      sel.appendChild(opt);
    });
  }
  populateSelect('tariffLine');
  populateSelect('blockLineSelect');
  populateSelect('simLine');

  // ========== CAMBIAR TARIFA FROM INLINE BUTTON ==========
  document.querySelectorAll('.cambiar-tarifa-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      var sel = document.getElementById('tariffLine');
      if (sel) { sel.value = line; }
      new bootstrap.Modal(document.getElementById('changeTariffModal')).show();
    });
  });

  // ========== DUPLICAR SIM FROM INLINE BUTTON ==========
  document.querySelectorAll('.duplicar-sim-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var line = this.dataset.line;
      if (!line) return;
      var sel = document.getElementById('simLine');
      if (sel) { sel.value = line; }
      new bootstrap.Modal(document.getElementById('duplicateSimModal')).show();
    });
  });

  // ========== CHANGE TARIFF MODAL ==========
  document.getElementById('changeTariffModal').addEventListener('show.bs.modal', function() {
    var container = document.getElementById('tariffProductCards');
    var sel = document.getElementById('tariffProduct');
    container.innerHTML = '<div class="col-12 text-center text-muted py-3">Cargando productos...</div>';
    sel.classList.add('d-none');
    fetch('/clientes/' + clientId + '/compatible-products')
      .then(function(r) { return r.json(); })
      .then(function(res) {
        container.innerHTML = '';
        if (res.ok && Array.isArray(res.data) && res.data.length > 0) {
          var familias = {};
          res.data.forEach(function(p) {
            var name = p.name || p.productName || p.product || p.description || '';
            var val = p.id || p.code || name;
            var familia = p.family || p.familia || p.category || p.categoria || 'General';
            if (!familias[familia]) familias[familia] = [];
            familias[familia].push({ name: name, val: val, price: p.price, desc: p.description || '' });
          });
          var familiaIconos = { 'Movil': '📱', 'Móvil': '📱', 'Fibra': '🌐', 'TV': '📺', 'Television': '📺', 'Fijo': '📞', 'VoIP': '📞', 'General': '📡' };
          Object.keys(familias).forEach(function(fam) {
            var icono = familiaIconos[fam] || '📡';
            container.innerHTML += '<div class="col-12"><h6 class="mt-2 mb-1 border-bottom pb-1">' + icono + ' ' + fam + '</h6></div>';
            familias[fam].forEach(function(prod) {
              container.innerHTML += '<div class="col-md-4 col-6"><div class="card border tariff-card" style="cursor:pointer;" data-value="' + prod.val + '"><div class="card-body p-2 text-center"><div class="fw-semibold small">' + prod.name + '</div>' + (prod.price ? '<div class="text-primary small mt-1">' + parseFloat(prod.price).toFixed(2) + '€</div>' : '') + '</div></div></div>';
            });
          });
          document.querySelectorAll('.tariff-card').forEach(function(card) {
            card.addEventListener('click', function() {
              document.querySelectorAll('.tariff-card').forEach(function(c) { c.classList.remove('border-primary', 'bg-light'); });
              this.classList.add('border-primary', 'bg-light');
              sel.value = this.dataset.value;
            });
          });
          if (res.data.length === 1) {
            document.querySelector('.tariff-card').classList.add('border-primary', 'bg-light');
            sel.value = document.querySelector('.tariff-card').dataset.value;
          }
        } else {
          container.innerHTML = '<div class="col-12 text-center text-muted py-3">No hay productos disponibles</div>';
        }
      })
      .catch(function() {
        container.innerHTML = '<div class="col-12 text-center text-muted py-3">Error al cargar productos</div>';
      });
  });

  document.getElementById('submitChangeTariff').addEventListener('click', function() {
    var line = document.getElementById('tariffLine').value;
    var product = document.getElementById('tariffProduct').value;
    var schedule = document.getElementById('tariffSchedule').value || null;
    if (!line || !product) { alert('Seleccione l&iacute;nea y producto'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/change-tariff', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, productId: product, productCode: product, schedule: schedule })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('Cambio de tarifa solicitado correctamente');
          bootstrap.Modal.getInstance(document.getElementById('changeTariffModal')).hide();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== BLOCK LINE MODAL ==========
  document.getElementById('submitBlockLine').addEventListener('click', function() {
    var line = document.getElementById('blockLineSelect').value;
    var blocked = document.querySelector('input[name="blockAction"]:checked').value === 'block';
    if (!line) { alert('Seleccione una l&iacute;nea'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/block', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ blocked: blocked })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('L&iacute;nea ' + (blocked ? 'bloqueada' : 'desbloqueada') + ' correctamente');
          bootstrap.Modal.getInstance(document.getElementById('blockLineModal')).hide();
          location.reload();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== DUPLICATE SIM MODAL ==========
  document.getElementById('submitDuplicateSim').addEventListener('click', function() {
    var line = document.getElementById('simLine').value;
    var reason = document.getElementById('simReason').value;
    var simType = document.querySelector('input[name="simType"]:checked').value;
    if (!line) { alert('Seleccione una l&iacute;nea'); return; }
    fetch('/clientes/' + clientId + '/line/' + encodeURIComponent(line) + '/duplicate-sim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: line, reason: reason, simType: simType, type: simType })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          alert('Solicitud de duplicado de SIM realizada correctamente');
          bootstrap.Modal.getInstance(document.getElementById('duplicateSimModal')).hide();
        } else {
          alert('Error: ' + (res.error || 'Desconocido'));
        }
      })
      .catch(function(err) { alert('Error: ' + err.message); });
  });

  // ========== INIT POPOVERS ==========
  var popoverList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
  popoverList.forEach(function(el) {
    new bootstrap.Popover(el);
  });
});
</script>
