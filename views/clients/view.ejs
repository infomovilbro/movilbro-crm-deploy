<% var _cid = (cliente && cliente.id != null) ? cliente.id : (typeof fiscalId !== 'undefined' && fiscalId ? fiscalId : ''); %>
<style>
/* Fix dropdowns appearing behind other elements (Note 15) */
.dropdown-menu { z-index: 9999 !important; }
.table-responsive { overflow: visible; }
.card-body { overflow: visible; }
.tab-content { overflow: visible; }
</style>
<section>
  <% if (typeof apiError !== 'undefined' && apiError) { %>
  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle"></i> <strong>Aviso:</strong> <%= apiError %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1"><i class="bi bi-person-circle text-primary"></i>
        <%= (apiCustomer.name || apiCustomer.firstName || cliente.nombre) %> <%= (apiCustomer.lastName || apiCustomer.surname || cliente.apellidos || '') %>
      </h4>
      <small class="text-muted"><%= apiCustomer.fiscalId || cliente.dni_nif || '' %> &middot; #<%= _cid %></small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/clientes/<%= _cid %>/editar" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
      <button class="btn btn-outline-warning" onclick="openTicketModal()"><i class="bi bi-ticket"></i> Ticket</button>
      <a href="/clientes" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>
  </div>

  <div class="card">
    <div class="card-header p-0">
      <ul class="nav nav-tabs card-header-tabs mx-2 mt-2" id="detalleTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="true">
            <i class="bi bi-info-circle"></i> Informaci&oacute;n
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="lineas-tab" data-bs-toggle="tab" data-bs-target="#lineas" type="button" role="tab" aria-controls="lineas" aria-selected="false">
            <i class="bi bi-phone"></i> L&iacute;neas / Suscripciones
            <% if (apiSubscriptions.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiSubscriptions.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="ordenes-tab" data-bs-toggle="tab" data-bs-target="#ordenes" type="button" role="tab" aria-controls="ordenes" aria-selected="false">
            <i class="bi bi-cart"></i> &Oacute;rdenes
            <% if (apiOrders.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiOrders.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="facturas-tab" data-bs-toggle="tab" data-bs-target="#facturas" type="button" role="tab" aria-controls="facturas" aria-selected="false">
            <i class="bi bi-receipt"></i> Facturas
            <% if (apiInvoices.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiInvoices.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="instalaciones-tab" data-bs-toggle="tab" data-bs-target="#instalaciones" type="button" role="tab" aria-controls="instalaciones" aria-selected="false">
            <i class="bi bi-wrench"></i> Instalaciones
            <% if (apiInstallations.length > 0) { %><span class="badge bg-secondary ms-1"><%= apiInstallations.length %></span><% } %>
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="kyc-tab" data-bs-toggle="tab" data-bs-target="#kyc" type="button" role="tab" aria-controls="kyc" aria-selected="false">
            <i class="bi bi-file-earmark-text"></i> Documentos KYC
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="contrato-tab" data-bs-toggle="tab" data-bs-target="#contrato" type="button" role="tab" aria-controls="contrato" aria-selected="false">
            <i class="bi bi-file-text"></i> Contrato
            <% if (contratos.length > 0 || altasOrdenes.length > 0) { %><span class="badge bg-secondary ms-1"><%= contratos.length + altasOrdenes.length + contratosS3.length %></span><% } %>
          </button>
        </li>
      </ul>
    </div>
    <div class="card-body">
      <div class="tab-content" id="detalleTabContent">

        <!-- ==================== TAB 1: INFO ==================== -->
        <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="card h-100 border">
                <div class="card-header fw-semibold"><i class="bi bi-person"></i> Datos personales</div>
                <div class="card-body">
                  <table class="table table-sm mb-0">
                    <% var nom = apiCustomer.name || apiCustomer.firstName || cliente.nombre; %>
                    <% var ape = apiCustomer.lastName || apiCustomer.surname || cliente.apellidos || ''; %>
                    <tr><th style="width:100px;">Nombre</th><td><%= nom %> <%= ape %></td></tr>
                    <tr><th>DNI/NIF</th><td><strong><%= apiCustomer.fiscalId || cliente.dni_nif || '-' %></strong></td></tr>
                    <tr><th>Email</th><td>
                      <% var em = apiCustomer.email || cliente.email; %>
                      <% if (em) { %><a href="mailto:<%= em %>"><%= em %></a><% } else { %>-<% } %>
                    </td></tr>
                    <tr><th>Tel&eacute;fono</th><td>
                      <% var tf = apiCustomer.phone || cliente.telefono; %>
                      <% if (tf) { %><a href="tel:<%= tf %>"><%= tf %></a><% } else { %>-<% } %>
                    </td></tr>
                    <tr><th>Tel&eacute;fono 2</th><td><%= cliente.telefono2 || '-' %></td></tr>
                    <tr><th>Tipo</th><td>
                      <% var t = apiCustomer.customerType || cliente.tipo_cliente || 'particular'; %>
                      <span class="badge bg-<%= t === 'empresa' || t === 'Business' || t === 'business' ? 'secondary' : 'primary' %>"><%= t %></span>
                    </td></tr>
                    <% if (cliente.likes_customer_id) { %><tr><th>ID Likes</th><td><code><%= cliente.likes_customer_id %></code></td></tr><% } %>
                    <tr><th>Cliente desde</th><td>
                      <%= apiCustomer.created || cliente.created_at ? new Date(apiCustomer.created || cliente.created_at).toLocaleDateString('es-ES') : '-' %>
                    </td></tr>
                  </table>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card h-100 border">
                <div class="card-header d-flex justify-content-between align-items-center py-1" style="cursor:pointer;" onclick="toggleSection('dirPagoBody')">
                  <span class="fw-semibold small"><i class="bi bi-geo-alt"></i> Direcci&oacute;n y pago</span>
                  <i class="bi bi-chevron-down" id="dirPagoIcon"></i>
                </div>
                <div class="card-body p-2" id="dirPagoBody">
                  <table class="table table-sm mb-0">
                    <% var addr = apiCustomer.billingAddress || {}; %>
                    <tr><th style="width:100px;">Direcci&oacute;n</th><td>
                      <%= addr.street || cliente.direccion || '-' %>
                      <%= addr.cityName || addr.city || cliente.ciudad ? ', ' + (addr.cityName || addr.city || cliente.ciudad) : '' %>
                      <%= addr.state || cliente.provincia ? ', ' + (addr.state || cliente.provincia) : '' %>
                      <%= addr.zipCode || addr.zip || cliente.codigo_postal ? ' (' + (addr.zipCode || addr.zip || cliente.codigo_postal) + ')' : '' %>
                    </td></tr>

<tr><th>L&iacute;neas activas</th><td>
                      <% if (apiSubscriptions.length > 0) { %>
                        <% apiSubscriptions.forEach(function(s) { %>
                          <% var prods = s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber, status: s.status, icc: s.icc}]; %>
                          <% prods.forEach(function(p) { %>
                          <% var linea2 = p.lineNumber || s.lineNumber || ""; %>
                          <% var pname2 = (p.productName || s.productName || "").toLowerCase(); %>
                          <% var icono2 = "📡"; %>
                          <% if (pname2.includes("fibra") || pname2.includes("ftth")) { icono2 = "🌐"; } else if (pname2.includes("tv") || pname2.includes("television")) { icono2 = "📺"; } else if (pname2.includes("fijo") || pname2.includes("voip")) { icono2 = "📞"; } else if (pname2.includes("movil") || pname2.includes("mobile") || pname2.includes("tarifa")) { icono2 = "📱"; } %>
                          <% var ref2 = s.portabilidadId || s.referencia || p.portabilidadId || p.referencia || ""; %>
                          <div class="d-flex align-items-center justify-content-between mb-1 pb-1 border-bottom">
                            <div>
                              <span><%= icono2 %></span>
                              <strong><%= linea2 || "Nueva línea" %></strong>
                              <small class="text-muted d-block"><%= p.productName || s.productName || "" %></small>
                              <% if (ref2) { %><small class="text-muted">Ref: <%= ref2 %></small><% } %>
                            </div>
                          </div>
                          <% }); %>
                        <% }); %>
                      <% } else { %>
                        <% var pm = apiCustomer.paymentMethod || cliente.metodo_pago; %>
                        <div class="mb-1"><small class="text-muted">Sin líneas activas</small></div>
                        <div class="mt-1">
                          <% if (pm) { %><span class="badge bg-info"><i class="bi bi-credit-card"></i> <%= pm %></span><% } else { %><span class="text-muted">-</span><% } %>
                        </div>
                      <% } %>
                    </td></tr>
<tr><th>M&eacute;todo pago</th><td>
                      <% var lineasPago = (cliente.lineas_pago || '{}'); %>
                      <% try { var pagosJson = JSON.parse(lineasPago); } catch(e) { var pagosJson = {}; } %>
                      <% if (apiSubscriptions.length > 0) { %>
                        <% apiSubscriptions.forEach(function(s) { %>
                          <% var prods = s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber}]; %>
                          <% prods.forEach(function(p) { %>
                          <% var linea = p.lineNumber || s.lineNumber || ''; %>
                          <% var metodoActual = pagosJson[linea] || ''; %>
                          <div class="d-flex align-items-center justify-content-between mb-1 pb-1 border-bottom">
                            <small><strong><%= linea || 'Nueva línea' %></strong> - <%= p.productName || s.productName || '' %></small>
                            <div class="d-flex align-items-center gap-1">
                              <% if (metodoActual) { %>
                                <span class="badge bg-info"><%= metodoActual %></span>
                              <% } %>
                              <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-0" data-bs-toggle="dropdown" data-bs-popper="static" title="Cambiar método de pago">
                                  <i class="bi bi-credit-card"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                  <li><a class="dropdown-item" href="#" onclick="cambiarPagoLinea('<%= linea %>','IBAN')">🏦 IBAN</a></li>
                                  <li><a class="dropdown-item" href="#" onclick="cambiarPagoLinea('<%= linea %>','Stripe')">💳 Stripe</a></li>
                                  <li><a class="dropdown-item" href="#" onclick="cambiarPagoLinea('<%= linea %>','Prepago')">📱 Prepago</a></li>
                                  <li><a class="dropdown-item" href="#" onclick="cambiarPagoLinea('<%= linea %>','Efectivo')">💵 Efectivo</a></li>
                                </ul>
                              </div>
                            </div>
                          </div>
                          <% }); %>
                        <% }); %>
                      <% } else { %>
                        <% var pm = apiCustomer.paymentMethod || cliente.metodo_pago; %>
                        <% if (pm) { %><span class="badge bg-info"><i class="bi bi-credit-card"></i> <%= pm %></span><% } else { %>-<% } %>
                      <% } %>
                    </td></tr>
                    <tr><th>IBAN</th><td>
                      <div class="input-group input-group-sm">
                        <input type="text" id="clienteIban" class="form-control" value="<%= apiCustomer.iban || cliente.iban || '' %>" placeholder="ES00 0000 0000 00 0000000000">
                        <button class="btn btn-outline-primary" onclick="guardarIBAN(<%= _cid %>)"><i class="bi bi-check"></i></button>
                      </div>
                    </td></tr>
                  </table>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card h-100 border">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                  <span><i class="bi bi-shield-check"></i> An&aacute;lisis de Fiabilidad</span>
                  <button class="btn btn-sm btn-outline-success" onclick="calcularScoring(<%= _cid %>)">
                    <i class="bi bi-calculator"></i> Calcular
                  </button>
                </div>
                <div class="card-body" id="scoringCardBody">
                  <table class="table table-sm mb-0">
                    <tr><th style="width:130px;">DNI/NIF</th><td>
                      <% var dni = (cliente.dni_nif || '').toUpperCase(); %>
                      <% var dniValido = dni.length >= 8 && /^\d{8}[A-Z]$/.test(dni); %>
                      <span class="badge bg-<%= dniValido ? 'success' : 'danger' %>"><%= dni || '-' %></span>
                    </td></tr>
                    <tr><th>Email</th><td><%= apiCustomer.email || cliente.email || '-' %></td></tr>
                    <tr><th>Tel&eacute;fono</th><td><%= apiCustomer.phone || cliente.telefono || '-' %></td></tr>
                    <tr><th>L&iacute;neas</th><td><span class="badge bg-primary"><%= apiSubscriptions.length %></span></td></tr>
                    <tr><th>Antigüedad</th><td>
                      <% var fCreacion = apiCustomer.created || cliente.created_at || ''; %>
                      <% if (fCreacion) { %><%= new Date(fCreacion).toLocaleDateString('es-ES') %><% } else { %>-<% } %>
                    </td></tr>
                    <tr><th>Scoring</th><td>
                      <span id="scoringBadge" class="fs-6" title="Puntuación de fiabilidad del cliente (0-10). Más alto = más fiable."><span class="text-muted">Pulsa "Calcular"</span></span>
                    </td></tr>
                    <tr><th>Recomendaci&oacute;n</th><td>
                      <span id="scoringRecomendacion"><span class="text-muted">-</span></span>
                    </td></tr>
                  </table>
                </div>
              </div>
            </div>
            <% if (cliente.notas) { %>
            <div class="col-12">
              <div class="card border">
                <div class="card-header fw-semibold"><i class="bi bi-sticky"></i> Notas</div>
                <div class="card-body">
                  <p class="mb-0 text-muted"><%= cliente.notas %></p>
                </div>
              </div>
            </div>
            <% } %>
            <div class="col-md-6">
              <div class="card border">
                <div class="card-header py-1 d-flex justify-content-between align-items-center" style="cursor:pointer;" onclick="toggleSection('estadoLineasBody')">
                  <small><i class="bi bi-pie-chart"></i> Estado de L&iacute;neas</small>
                  <i class="bi bi-chevron-down" id="estadoLineasIcon"></i>
                </div>
                <div class="card-body p-2" id="estadoLineasBody">
                  <% if (apiSubscriptions && apiSubscriptions.length > 0) { %>
                    <% apiSubscriptions.forEach(function(s) { %>
                      <% var prods = s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber, status: s.status, icc: s.icc}]; %>
                      <% prods.forEach(function(p) { %>
                        <% var est = (p.status || s.status || 'activa').toLowerCase(); if (est === 'terminada' || est === 'baja' || est === 'cancelled' || est === 'cancelada') return; %>
                        <div class="d-flex align-items-center justify-content-between mb-1 pb-1 border-bottom">
                          <div>
                            <strong><%= p.lineNumber || s.lineNumber || 'Nueva línea' %></strong><br>
                            <small><%= p.productName || s.productName || '-' %></small>
                          </div>
                          <div class="text-end">
                            <span class="badge bg-<%= est === 'activa' || est === 'active' ? 'success' : est === 'suspendida' || est === 'suspended' ? 'warning' : 'secondary' %>">
                              <%= est %>
                            </span>
                            <% if (p.icc || s.icc) { %><br><small class="text-muted">ICC: <%= (p.icc || s.icc).substring(0,15) %>...</small><% } %>
                          </div>
                        </div>
                      <% }); %>
                    <% }); %>
                  <% } else { %>
                    <canvas id="statusChart" height="80"></canvas>
                  <% } %>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card border">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                  <small><i class="bi bi-bar-chart"></i> Consumo GB</small>
                  <select id="gbLineSelect" class="form-select form-select-sm" style="width:auto;max-width:160px;">
                    <option value="">Seleccionar línea...</option>
                  </select>
                </div>
                <div class="card-body p-2 text-center" style="min-height:140px;">
                  <div style="position:relative;width:100%;max-width:300px;height:120px;margin:0 auto;">
                    <canvas id="gbChart" width="300" height="120" style="width:100%;height:100%;"></canvas>
                  </div>
                  <div id="consPerLine" class="mt-1 small text-start"></div>
                  <button class="btn btn-sm btn-outline-info mt-1" onclick="abrirConsumoModal()" title="Abrir consumo detallado"><i class="bi bi-graph-up"></i> Ver consumo detallado</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ==================== TAB 2: LÍNEAS / SUSCRIPCIONES ==================== -->
        <div class="tab-pane fade" id="lineas" role="tabpanel" aria-labelledby="lineas-tab">
          <% if (apiSubscriptions.length === 0 && lineas.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-phone" style="font-size:3rem;"></i>
            <p class="mt-2">Este cliente no tiene l&iacute;neas o suscripciones</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>L&iacute;nea</th>
                  <th>Producto / Tarifa</th>
                  <th>Estado</th>
                  <th>ICC / ICCID</th>
                  <th>Fecha Alta</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% apiSubscriptions.forEach(function(s) { %>
                <% var prods = s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber, status: s.status, icc: s.icc}]; %>
                <% prods.forEach(function(p) { %>
                <% var linea = p.lineNumber || s.lineNumber || ''; %>
                <% var _est = ({'active':'activa','activa':'activa','suspended':'suspendida','cancelled':'cancelada','terminated':'terminada','baja':'baja'})[(p.status || s.status || '').toLowerCase()] || (p.status || s.status || 'activa'); %>
                <tr class="<%= (_est === 'terminada' || _est === 'cancelada' || _est === 'baja') ? 'table-secondary text-muted' : '' %>">
                  <td>
                    <% var pname = (p.productName || s.productName || '').toLowerCase(); %>
                    <% if (pname.includes('fibra') || pname.includes('ftth')) { %><span>🌐</span><% } else if (pname.includes('tv') || pname.includes('television')) { %><span>📺</span><% } else if (pname.includes('fijo') || pname.includes('voip')) { %><span>📞</span><% } else if (pname.includes('movil') || pname.includes('mobile') || pname.includes('tarifa')) { %><span>📱</span><% } else { %><span>📡</span><% } %>
                    <strong><%= linea || '-' %></strong>
                  </td>
                  <td><%= p.productName || s.productName || '-' %></td>
                  <td>
                    <% var est = (p.status || s.status || 'activa').toLowerCase(); %>
                    <span class="badge bg-<%= est === 'activa' || est === 'activo' || est === 'active' ? 'success' : est === 'suspendida' || est === 'suspended' ? 'warning' : est === 'baja' || est === 'cancelled' || est === 'cancelada' || est === 'terminated' || est === 'terminada' ? 'secondary' : 'danger' %> fs-6">
                      <%= ({'activa':'Activa','active':'Activa','activo':'Activa','suspendida':'Suspendida','suspended':'Suspendida','cancelled':'Cancelada','cancelada':'Cancelada','terminated':'Cancelada','terminada':'Cancelada','baja':'Cancelada','created':'Creada'})[est] || est %>
                    </span>
                  </td>
                  <td><small class="text-muted"><%= p.icc || s.icc || '-' %></small></td>
                  <td><small><%= (s.startDate || s.created) ? new Date(s.startDate || s.created).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <button class="btn btn-sm btn-outline-info ver-consumo" data-line="<%= linea %>" data-client="<%= _cid %>" <%= linea ? '' : 'disabled' %> title="Consumo">
                        <i class="bi bi-graph-up"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-warning toggle-block" data-line="<%= linea %>" data-client="<%= _cid %>" data-blocked="<%= est !== 'activa' && est !== 'active' %>" <%= linea ? '' : 'disabled' %> title="<%= (est === 'activa' || est === 'active') ? 'Bloquear' : 'Desbloquear' %>">
                        <i class="bi <%= (est === 'activa' || est === 'active') ? 'bi-lock' : 'bi-unlock' %>"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-primary cambiar-tarifa-btn" data-line="<%= linea %>" title="Cambiar tarifa">
                        <i class="bi bi-arrow-left-right"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-secondary duplicar-sim-btn" data-line="<%= linea %>" title="Duplicar SIM">
                        <i class="bi bi-sd-card"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-dark mostrar-pinpuk" data-line="<%= linea %>" data-pin="<%= p.pin || s.pin || '' %>" data-puk="<%= p.puk || s.puk || '' %>" data-icc="<%= p.icc || s.icc || '' %>" title="PIN/PUK">
                        <i class="bi bi-key"></i>
                      </button>
                    </div>
                    </div>
                  </td>
                </tr>
                <% }); %>
                <% }); %>
                <% lineas.forEach(function(l) { %>
                <% var _lest = (l.estado || '').toLowerCase(); if (_lest === 'terminada' || _lest === 'baja' || _lest === 'cancelled' || _lest === 'cancelada') return; %>
                <% if (!apiSubscriptions.some(function(s) { var prods = s.products && s.products.length ? s.products : [{productName: s.productName, lineNumber: s.lineNumber, status: s.status, icc: s.icc}]; return prods.some(function(p) { return p.lineNumber === l.linea; }); })) { %>
                <tr class="table-secondary">
                  <td>
                    <% var lpname = (l.producto || '').toLowerCase(); %>
                    <% if (lpname.includes('fibra') || lpname.includes('ftth')) { %><span>🌐</span><% } else if (lpname.includes('tv') || lpname.includes('television')) { %><span>📺</span><% } else if (lpname.includes('fijo') || lpname.includes('voip')) { %><span>📞</span><% } else if (lpname.includes('movil') || lpname.includes('mobile') || lpname.includes('tarifa')) { %><span>📱</span><% } else { %><span>📡</span><% } %>
                    <strong><%= l.linea || '-' %></strong>
                  </td>
                  <td><%= l.producto || '-' %> <small class="text-muted">(local)</small></td>
                  <td>
                    <span class="badge bg-<%= l.estado === 'activo' ? 'success' : l.estado === 'pendiente' ? 'warning' : l.estado === 'baja' ? 'secondary' : 'danger' %> fs-6"><%= l.estado %></span>
                  </td>
                  <td><small class="text-muted"><%= l.iccid || '-' %></small></td>
                  <td><small><%= l.fecha_alta ? new Date(l.fecha_alta).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <div class="d-flex gap-1 flex-wrap">
                      <button class="btn btn-sm btn-outline-info ver-consumo" data-line="<%= l.linea %>" data-client="<%= _cid %>" <%= l.linea ? '' : 'disabled' %> title="Consumo">
                        <i class="bi bi-graph-up"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-warning toggle-block" data-line="<%= l.linea %>" data-client="<%= _cid %>" data-blocked="<%= l.estado !== 'activo' %>" <%= l.linea ? '' : 'disabled' %> title="<%= l.estado === 'activo' ? 'Bloquear' : 'Desbloquear' %>">
                        <i class="bi <%= l.estado === 'activo' ? 'bi-lock' : 'bi-unlock' %>"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-primary cambiar-tarifa-btn" data-line="<%= l.linea %>" title="Cambiar tarifa">
                        <i class="bi bi-arrow-left-right"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-secondary duplicar-sim-btn" data-line="<%= l.linea %>" title="Duplicar SIM">
                        <i class="bi bi-sd-card"></i>
                      </button>
                      <button class="btn btn-sm btn-outline-dark mostrar-pinpuk" data-line="<%= l.linea %>" data-pin="<%= l.pin || '' %>" data-puk="<%= l.puk || '' %>" data-icc="<%= l.iccid || '' %>" title="PIN/PUK">
                        <i class="bi bi-key"></i>
                      </button>
                    </div>
                    </div>
                  </td>
                </tr>
                <% } %>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="d-flex gap-2 flex-wrap mt-3">
            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#changeTariffModal"><i class="bi bi-arrow-left-right"></i> Cambiar tarifa</button>
            <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#blockLineModal"><i class="bi bi-lock"></i> Bloquear / Desbloquear</button>
            <button class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#duplicateSimModal"><i class="bi bi-sd-card"></i> Duplicar SIM</button>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 3: ÓRDENES ==================== -->
        <div class="tab-pane fade" id="ordenes" role="tabpanel" aria-labelledby="ordenes-tab">
          <% if (apiOrders.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-cart" style="font-size:3rem;"></i>
            <p class="mt-2">No hay &oacute;rdenes en la API para este cliente</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th># ID</th>
                  <th>Estado</th>
                  <th>Producto</th>
                  <th>L&iacute;nea</th>
                  <th>Total</th>
                  <th>Fecha Creaci&oacute;n</th>
                  <th>Historial</th>
                </tr>
              </thead>
              <tbody>
                <% apiOrders.forEach(function(o) { %>
                <tr>
                  <td><small class="text-muted"><%= o.idShort || o.id || '-' %></small></td>
                  <td>
                    <% var os = (o.status || '').toLowerCase(); %>
                    <span class="badge bg-<%= os === 'completed' || os === 'completada' || os === 'delivered' ? 'success' : os === 'pending' || os === 'pendiente' || os === 'processing' || os === 'pending_provider' ? 'warning' : os === 'cancelled' || os === 'cancelada' || os === 'rejected' ? 'danger' : os === 'shipped' || os === 'enviado' ? 'info' : 'secondary' %> fs-6">
                      <%= o.statusES || o.status %>
                    </span>
                  </td>
                  <td><%= o.productName || '-' %></td>
                  <td><%= o.lineNumber || '-' %></td>
                  <td><strong><%= o.total ? parseFloat(o.total).toFixed(2) + '€' : '-' %></strong></td>
                  <td><small><%= o.created ? new Date(o.created).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <% if (o.statusHistory && o.statusHistory.length > 0) { %>
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="popover" data-bs-html="true" data-bs-trigger="focus" tabindex="0" title="Historial" data-bs-content="<%= o.statusHistory.map(function(h){ var hd = h.date || h.created || h.timestamp || ''; var hs = h.status || h.estado || h.state || ''; var hn = h.note || h.nota || h.comment || ''; return '<div class=\"small\">' + (hd ? new Date(hd).toLocaleDateString('es-ES') + ' ' : '') + '<span class=\"badge bg-info\">' + hs + '</span>' + (hn ? '<br><em>' + hn + '</em>' : '') + '</div>'; }).join('<hr class=\"my-1\">') %>">
                        <i class="bi bi-clock-history"></i> <%= o.statusHistory.length %>
                      </button>
                    <% } else { %>
                    <span class="text-muted">-</span>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 4: FACTURAS ==================== -->
        <div class="tab-pane fade" id="facturas" role="tabpanel" aria-labelledby="facturas-tab">
          <!-- Facturas ISP agrupadas por periodo -->
          <% if (facturasAgrupadas && Object.keys(facturasAgrupadas).length > 0) { %>
            <% var periodos = Object.keys(facturasAgrupadas).sort().reverse(); %>
            <div class="accordion mb-3" id="facturasAccordion">
              <% periodos.forEach(function(periodo) { %>
              <% var facturasPeriodo = facturasAgrupadas[periodo]; %>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#facturas<%= periodo.replace(/[^a-zA-Z0-9]/g,'_') %>">
                    <strong><%= periodo %></strong>
                    <span class="ms-2 badge bg-primary"><%= facturasPeriodo.length %> factura(s)</span>
                  </button>
                </h2>
                <div id="facturas<%= periodo.replace(/[^a-zA-Z0-9]/g,'_') %>" class="accordion-collapse collapse" data-bs-parent="#facturasAccordion">
                  <div class="accordion-body p-0">
                    <table class="table table-sm table-hover mb-0">
                      <thead class="table-light">
                        <tr><th>Nº Factura</th><th>Concepto</th><th>Importe</th><th>Estado</th><th></th></tr>
                      </thead>
                      <tbody>
                        <% facturasPeriodo.forEach(function(f) { %>
                        <tr>
                          <td><strong><%= (f.serie || 'F') + '-' + String(f.numero_factura || f.id).padStart(5, '0') %></strong></td>
                          <td><%= f.cliente_nombre || '-' %></td>
                          <td><%= parseFloat(f.importe_total || 0).toFixed(2) %>€</td>
                          <td><span class="badge bg-<%= f.estado === 'pagada' ? 'success' : f.estado === 'pendiente' ? 'warning' : f.estado === 'anulada' ? 'danger' : 'secondary' %>"><%= f.estado || '-' %></span></td>
                          <td>
                            <a href="/isp/facturacion/facturas/<%= f.id %>/view" class="btn btn-sm btn-outline-info" target="_blank"><i class="bi bi-eye"></i></a>
                            <a href="/isp/facturacion/facturas/<%= f.id %>" class="btn btn-sm btn-outline-primary" target="_blank"><i class="bi bi-info-circle"></i></a>
                          </td>
                        </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
              <% }); %>
            </div>
          <% } else { %>
          <div class="mb-3">
            <a href="/isp/facturacion/facturas?fiscal=<%= encodeURIComponent(cliente.dni_nif || '') %>" class="btn btn-sm btn-outline-primary" target="_blank">
              <i class="bi bi-box-arrow-up-right"></i> Ver facturas ISP completas
            </a>
            <a href="/isp/nube" class="btn btn-sm btn-outline-info" target="_blank">
              <i class="bi bi-cloud"></i> Ver nube/Drive
            </a>
            <button class="btn btn-sm btn-outline-danger" onclick="loadNubeInvoices(<%= _cid %>)">
              <i class="bi bi-google-drive"></i> Facturas en Drive
            </button>
          </div>
          <div id="nubeInvoicesContainer" class="mt-2"></div>
          <% } %>
          <% if (apiInvoices.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Periodo</th>
                  <th>Concepto</th>
                  <th>Importe</th>
                  <th>Estado</th>
                  <th>Fecha Emisi&oacute;n</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% apiInvoices.forEach(function(f) { %>
                <tr>
                  <td><strong><%= f.period || '-' %></strong></td>
                  <td><%= f.concept || '-' %></td>
                  <td><strong><%= f.amount.toFixed(2) %>€</strong></td>
                  <td>
                    <% var fs = (f.status || '').toLowerCase(); %>
                    <span class="badge bg-<%= fs === 'paid' || fs === 'pagada' || fs === 'completada' ? 'success' : fs === 'pending' || fs === 'pendiente' ? 'warning' : fs === 'overdue' || fs === 'vencida' ? 'danger' : fs === 'cancelled' || fs === 'cancelada' ? 'secondary' : 'info' %>">
                      <%= f.status %>
                    </span>
                  </td>
                  <td><small><%= f.issuedDate ? new Date(f.issuedDate).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <% if (f.id) { %>
                    <a href="/isp/facturacion/facturas/<%= f.id %>" target="_blank" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-eye"></i>
                    </a>
                    <% } %>
                  </td>
                </tr>
                <% if (f.fees && f.fees.length > 0) { %>
                <tr class="table-light">
                  <td colspan="6" class="p-0">
                    <table class="table table-sm table-borderless mb-0 ms-4" style="width:auto;">
                      <% f.fees.forEach(function(fee) { %>
                      <tr>
                        <td style="width:80px;"></td>
                        <td style="min-width:120px;"><small class="text-muted"><%= fee.productName %></small></td>
                        <td style="min-width:100px;"><% if (fee.lineNumber) { %><small class="text-muted"><%= fee.lineNumber %></small><% } %></td>
                        <td style="min-width:80px;text-align:right;"><small><%= fee.price.toFixed(2) %>€</small></td>
                      </tr>
                      <% }); %>
                    </table>
                  </td>
                </tr>
                <% } %>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 5: INSTALACIONES ==================== -->
        <div class="tab-pane fade" id="instalaciones" role="tabpanel" aria-labelledby="instalaciones-tab">
          <% if (apiInstallations.length === 0) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-wrench" style="font-size:3rem;"></i>
            <p class="mt-2">No hay instalaciones para este cliente</p>
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th>Direcci&oacute;n</th>
                  <th>Producto</th>
                  <th>Estado</th>
                  <th>Fecha Programada</th>
                  <th>Fecha Real</th>
                  <th>Parte</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% apiInstallations.forEach(function(i) { %>
                <tr>
                  <td><%= i.address || '-' %><br><small class="text-muted"><%= i.city || '' %></small></td>
                  <td><%= i.productName || '-' %></td>
                  <td>
                    <span class="badge bg-<%= (i.status || '').toLowerCase() === 'completed' || (i.status || '').toLowerCase() === 'completada' ? 'success' : (i.status || '').toLowerCase() === 'scheduled' || (i.status || '').toLowerCase() === 'programada' ? 'info' : (i.status || '').toLowerCase() === 'pending' || (i.status || '').toLowerCase() === 'pendiente' ? 'warning' : 'secondary' %>">
                      <%= i.status %>
                    </span>
                  </td>
                  <td><small><%= i.scheduledDate ? new Date(i.scheduledDate).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td><small><%= i.completedDate ? new Date(i.completedDate).toLocaleDateString('es-ES') : '-' %></small></td>
                  <td>
                    <% if (i.parteUrl) { %>
                    <a href="<%= i.parteUrl %>" target="_blank" class="btn btn-sm btn-outline-success" title="Descargar parte de instalaci&oacute;n">
                      <i class="bi bi-file-earmark-pdf"></i> Descargar Parte
                    </a>
                    <% } else { %>
                    <button class="btn btn-sm btn-outline-secondary fetch-parte-btn" data-installationid="<%= i.installationId || i.id || '' %>" data-clientid="<%= _cid %>" title="Buscar parte en la API">
                      <i class="bi bi-search"></i> Buscar parte
                    </button>
                    <% } %>
                  </td>
                  <td>
                    <button class="btn btn-sm btn-outline-info ver-instalacion"
                      data-id="<%= i.id %>"
                      data-address="<%= i.address %>"
                      data-city="<%= i.city %>"
                      data-product="<%= i.productName %>"
                      data-status="<%= i.status %>"
                      data-scheduled="<%= i.scheduledDate %>"
                      data-completed="<%= i.completedDate %>"
                      data-notes="<%= i.notes || '' %>"
                      data-technician="<%= i.technician || '' %>"
                      data-dni="<%= i.dni || '' %>"
                      data-ot="<%= i.ot || '' %>"
                      data-router="<%= i.router || '' %>"
                      data-ont="<%= i.ont || '' %>"
                      data-cto="<%= i.cto || '' %>"
                      data-contrata="<%= i.contrata || '' %>"
                      data-parte-url="<%= i.parteUrl || '' %>"
                      data-installationid="<%= i.installationId || i.id || '' %>"
                      data-history="<%= encodeURIComponent(JSON.stringify(i.history || [])) %>">
                      <i class="bi bi-eye"></i> Ver Detalle
                    </button>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <!-- ==================== TAB 6: DOCUMENTOS KYC ==================== -->
        <div class="tab-pane fade" id="kyc" role="tabpanel" aria-labelledby="kyc-tab">
          <% if ((altasOrdenes.length === 0 && (!documentos || documentos.length === 0)) && (!kycDocs || kycDocs.length === 0) && (!kycDocsApi || kycDocsApi.length === 0)) { %>
          <div class="text-center text-muted py-5">
            <i class="bi bi-file-earmark-text" style="font-size:3rem;"></i>
            <p class="mt-2">Sin documentos KYC</p>
          </div>
          <% } else { %>
            <% if (altasOrdenes.length > 0) { %>
              <% altasOrdenes.forEach(function(o, oidx) { %>
              <% var datosCliente = o.datos_cliente ? JSON.parse(o.datos_cliente) : {}; %>
              <% var datosProducto = o.datos_producto ? JSON.parse(o.datos_producto) : {}; %>
              <div class="card border mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <span class="fw-semibold">
                    <i class="bi bi-cart"></i> Orden #<%= o.id %>
                    <span class="badge bg-<%= o.estado === 'completada' ? 'success' : o.estado === 'pendiente_kyc' ? 'warning' : o.estado === 'pendiente_aprobacion' ? 'info' : o.estado === 'cancelada' ? 'danger' : 'secondary' %> ms-2"><%= o.estado %></span>
                  </span>
                  <small class="text-muted"><%= o.created_at ? new Date(o.created_at).toLocaleDateString('es-ES') : '-' %></small>
                </div>
                <div class="card-body">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <table class="table table-sm mb-0">
                        <tr><th style="width:120px;">Producto</th><td><%= datosProducto.producto_id || '-' %></td></tr>
                        <tr><th>Contrataci&oacute;n</th><td><%= datosProducto.tipo_contratacion || '-' %></td></tr>
                        <tr><th>M&eacute;todo pago</th><td><%= (o.datos_pago ? JSON.parse(o.datos_pago).metodo : '') || '-' %></td></tr>
                        <tr><th>KYC docs</th><td><%= o.kyc_docs_subidos || 0 %> subidos<%= o.kyc_completado ? ' &middot; <span class="text-success"><i class="bi bi-check-circle"></i> Completado</span>' : '' %></td></tr>
                        <tr><th>Contrato firmado</th><td><%= o.kyc_contrato_firmado ? '<span class="text-success"><i class="bi bi-check-circle"></i> S&iacute;</span>' : '<span class="text-warning"><i class="bi bi-clock"></i> Pendiente</span>' %></td></tr>
                      </table>
                    </div>
                    <div class="col-md-6 text-end">
                      <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <a href="/kyc/contrato/<%= o.token %>" target="_blank" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-file-text"></i> Ver contrato
                        </a>
                        <% if (o.kyc_contrato_firmado) { %>
                        <button class="btn btn-sm btn-success" onclick="window.open('/kyc/contrato/<%= o.token %>','_blank')">
                          <i class="bi bi-file-earmark-check"></i> Contrato firmado
                        </button>
                        <% } %>
                      </div>
                    </div>
                  </div>

                  <% var docsOrden = kycDocsPorOrden && kycDocsPorOrden[o.id] ? kycDocsPorOrden[o.id] : []; %>
                  <% if (docsOrden.length > 0) { %>
                  <hr>
                  <h6 class="mb-2"><i class="bi bi-images"></i> Documentos subidos</h6>
                  <div class="row g-2">
                    <% docsOrden.forEach(function(d) { %>
                    <div class="col-md-4 col-6">
                      <div class="card border h-100">
                        <div class="card-body text-center py-3">
                          <% var isImage = d.download_url && (d.download_url.match(/\.(jpeg|jpg|png|webp|gif)/i)); %>
                          <% if (isImage) { %>
                          <a href="<%= d.download_url %>" target="_blank">
                            <img src="<%= d.download_url %>" alt="<%= d.tipo %>" style="max-width:100%;max-height:100px;object-fit:contain;border-radius:4px;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';"><i class="bi bi-file-earmark-image" style="font-size:2rem;display:none;"></i>
                          </a>
                          <% } else { %>
                          <i class="bi bi-file-earmark-image" style="font-size:2rem;"></i>
                          <% } %>
                          <div class="mt-1"><small><strong><%= d.tipo || 'Documento' %></strong></small></div>
                          <div class="mt-1">
                            <span class="badge bg-<%= d.estado === 'subido' ? 'success' : 'warning' %>"><%= d.estado %></span>
                          </div>
                          <div class="mt-2 d-flex gap-1 justify-content-center">
                            <% if (d.download_url) { %>
                            <a href="<%= d.download_url %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Ver">
                              <i class="bi bi-eye"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-secondary" title="Descargar" onclick="var u='<%= d.download_url || '' %>';var m=u.match(/[-\w]{25,}/);window.location.href=(m?'/clientes/drive-download?fileId='+m[0]+'&name='+encodeURIComponent('<%= (d.tipo || 'documento').replace(/'/g,'') %>')+'&download=1':u)"><i class="bi bi-download"></i></button>
                            <% } else if (d.archivo) { %>
                            <a href="/uploads/kyc/<%= d.archivo %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Ver">
                              <i class="bi bi-eye"></i>
                            </a>
                            <a href="/uploads/kyc/<%= d.archivo %>" download class="btn btn-sm btn-outline-secondary" title="Descargar">
                              <i class="bi bi-download"></i>
                            </a>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <% }) %>
                  </div>
                  <% } %>
                </div>
              </div>
              <% }) %>
            <% } %>

            <% if (typeof kycDocs !== 'undefined' && kycDocs && kycDocs.length > 0) { %>
            <hr class="my-3">
            <h6><i class="bi bi-images"></i> Documentos</h6>
            <div class="row g-2">
              <% kycDocs.forEach(function(d) { %>
              <div class="col-md-4 col-6">
                <div class="card border h-100">
                  <div class="card-body text-center py-3">
                    <% if (d.download_url && (d.download_url.includes('.jpeg') || d.download_url.includes('.jpg') || d.download_url.includes('.png') || d.download_url.includes('.webp'))) { %>
                    <a href="<%= d.download_url %>" target="_blank">
                      <img src="<%= d.download_url %>" alt="<%= d.tipo %>" style="max-width:100%;max-height:150px;object-fit:contain;border-radius:4px;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';"><i class="bi bi-file-earmark-image" style="font-size:2rem;display:none;"></i>
                    </a>
                    <% } else { %>
                    <i class="bi bi-file-earmark" style="font-size:2rem;"></i>
                    <% } %>
                    <div class="mt-1"><small><strong><%= d.tipo || 'Documento' %></strong></small></div>
                    <div class="mt-1"><span class="badge bg-success"><%= d.estado || 'subido' %></span></div>
                    <% if (d.download_url) { %>
                    <div class="mt-2 d-flex gap-1 justify-content-center">
                      <a href="<%= d.download_url %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Ver"><i class="bi bi-eye"></i></a>
                      <button class="btn btn-sm btn-outline-secondary" title="Descargar" onclick="var u='<%= d.download_url || '' %>';var m=u.match(/[-\w]{25,}/);window.location.href=(m?'/clientes/drive-download?fileId='+m[0]+'&name='+encodeURIComponent('<%= (d.tipo || 'documento').replace(/'/g,'') %>')+'&download=1':u)"><i class="bi bi-download"></i></button>
                    </div>
                    <% } %>
                  </div>
                </div>
              </div>
              <% }); %>
            </div>
            <% } %>

            <% if (documentos && documentos.length > 0) { %>
            <hr class="my-3">
            <h6><i class="bi bi-folder"></i> Documentos ISP</h6>
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead class="table-light">
                  <tr><th>Nombre</th><th>Tipo</th><th>Categor&iacute;a</th><th>Fecha</th><th></th></tr>
                </thead>
                <tbody>
                  <% documentos.forEach(function(d) { %>
                  <tr>
                    <td><%= d.nombre || d.archivo || 'Documento' %></td>
                    <td><span class="badge bg-secondary"><%= d.tipo || '-' %></span></td>
                    <td><%= d.categoria || '-' %></td>
                    <td><small><%= d.created_at ? new Date(d.created_at).toLocaleDateString('es-ES') : '-' %></small></td>
                    <td>
                      <% if (d.ruta) { %>
