  function escHtml(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  }
  function cssSafe(s) {
    if (!s) return '';
    return String(s).replace(/@/g,'_at_').replace(/\./g,'_dot_');
  }

