  function loadModelUsage() {
    fetch('/codeopen/model-usage').then(function(r) { return r.json(); }).then(function(d) {
      if (!d.usage) return;
      for (var key in d.usage) {
        var u = d.usage[key];
        var el = document.getElementById('usage_' + key.replace(/[^a-zA-Z0-9]/g, '_'));
        if (el) {
          var bar = el.querySelector('div');
          if (bar) {
            var pct = u.percent || 0;
            bar.style.width = pct + '%';
            bar.style.background = pct > 80 ? '#ef4444' : pct > 50 ? '#f59e0b' : 'var(--accent)';
          }
        }
      }
    });
  }
  setInterval(function() { try { loadModelUsage(); } catch(e) {} }, 60000);

