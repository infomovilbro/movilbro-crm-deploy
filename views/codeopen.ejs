      msgsContainer.querySelectorAll('.btn-send-doc').forEach(function(b) {
        b.addEventListener('click', function(e) { e.stopPropagation(); 
          // Si el mensaje tiene document_ready, enviar directo sin preguntar
          var msgId = this.dataset.id;
          var hasDoc = this.dataset.docready === '1' || this.dataset.docready === 'true';
          if (hasDoc) {
            approveMessage(msgId, 'without_forward', this, false, true);
          } else {
            sendDocument(msgId, this);
          }
        });
      });
      msgsContainer.querySelectorAll('.btn-reject').forEach(function(b) {
        b.addEventListener('click', function(e) { e.stopPropagation(); rejectMessage(this.dataset.id, this); });
      });
      msgsContainer.querySelectorAll('.btn-delete-msg').forEach(function(b) {
        b.addEventListener('click', function(e) { e.stopPropagation(); deleteMessage(this.dataset.id, this); });
      });
    });
  }

  window.toggleContactGroup = function(header) {
    var msgs = header.parentElement.querySelector('.wa-contact-messages');
    var arrow = header.querySelector('.ri-arrow-down-s-line');
    if (msgs.style.display === 'none' || !msgs.style.display) {
      msgs.style.display = 'block';
      if (arrow) arrow.style.transform = 'rotate(180deg)';
    } else {
      msgs.style.display = 'none';
      if (arrow) arrow.style.transform = 'rotate(0deg)';
    }
  };

  function deleteMessage(id, btn) {
    if (!confirm('¿Borrar este mensaje?')) return;
    fetch('/codeopen/delete/' + id, { method: 'POST' }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) { refreshCurrentView(); loadPendingList(); pollPendingCount(); }
    });
  }

  function deleteContact(address, btn) {
    if (!confirm('¿Borrar TODOS los mensajes de este contacto?')) return;
    fetch('/codeopen/delete-contact/' + encodeURIComponent(address), { method: 'POST' }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) { refreshCurrentView(); loadPendingList(); pollPendingCount(); }
    });
  }

  function refreshCurrentView() {
    // No recargar contactos - solo actualizar badges y pendientes
    try { pollPendingCount(); } catch(e) {}
    try { updateTabBadges(); } catch(e) {}
  }

  function analyzeMessage(id, btn) {
    btn.disabled = true;
    isAnalyzing = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:10px;height:10px;"></span> Analizando...';
    // Mostrar barra de progreso
    var progBar = document.getElementById('progress_' + id);
    if (progBar) {
      progBar.style.display = 'block';
      var fill = progBar.querySelector('div');
      if (fill) { fill.style.width = '10%'; setTimeout(function() { fill.style.width = '50%'; }, 500); setTimeout(function() { fill.style.width = '80%'; }, 1500); }
    }
    fetch('/codeopen/analyze/' + id, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ model: currentModelId }) }).then(function(r) { return r.json(); }).then(function(d) {
      isAnalyzing = false;
      if (progBar) { var fill = progBar.querySelector('div'); if (fill) fill.style.width = '100%'; setTimeout(function() { if (progBar) progBar.style.display = 'none'; }, 500); }
      if (d.ok) {
        pollPendingCount();
        // Cambiar boton Analizar a Re-analizar
        btn.innerHTML = '<i class="ri-robot-line"></i> Re-analizar';
        btn.disabled = false;
        // Mostrar editor de respuesta debajo del mensaje, sin borrar el boton analizar
        var respText = d.response || d.proposed_response || '';
        var msgCard = btn.closest('[style*="background:var(--bg-main);border:1px solid var(--border-light)"]') || btn.closest('.wa-contact-messages > div') || btn.parentElement;
        if (msgCard) {
          var existingResp = msgCard.querySelector('.response-editor');
          if (existingResp) existingResp.value = respText;
          else {
            var respDiv = document.createElement('div');
            respDiv.style.cssText = 'margin-top:6px;padding:8px;border-radius:8px;border:1px solid rgba(34,197,94,0.2);background:rgba(34,197,94,0.08);';
            respDiv.innerHTML = 
              '<div style="font-size:0.7rem;color:#22c55e;margin-bottom:4px;"><i class="ri-check-line"></i> Respuesta lista - puedes editarla:</div>' +
              '<textarea class="response-editor" data-id="' + btn.dataset.id + '" style="width:100%;background:var(--bg-main);border:1px solid var(--border);border-radius:8px;padding:8px;font-size:0.75rem;color:var(--text);margin-bottom:6px;resize:vertical;min-height:50px;font-family:inherit;">' + escHtml(respText) + '</textarea>' +
              '<div style="display:flex;gap:4px;flex-wrap:wrap;">' +
              '<button class="btn-send-no-fwd" data-id="' + btn.dataset.id + '" style="flex:1;min-width:80px;background:var(--accent);color:#fff;border:0;border-radius:8px;padding:6px 8px;font-size:0.7rem;cursor:pointer;font-weight:600;"><i class="ri-send-plane-line"></i> Enviar</button>' +
              '<button class="btn-send-reply" data-id="' + btn.dataset.id + '" style="flex:1;min-width:80px;background:#0ea5e9;color:#fff;border:0;border-radius:8px;padding:6px 8px;font-size:0.7rem;cursor:pointer;font-weight:600;" title="Responder citando el mensaje original"><i class="ri-reply-line"></i> Responder</button>' +
              '<div style="position:relative;display:inline-flex;gap:2px;">' +
              '<button class="btn-send-audio" data-id="' + btn.dataset.id + '" style="min-width:70px;background:#8B5CF6;color:#fff;border:0;border-radius:8px 0 0 8px;padding:6px 8px;font-size:0.7rem;cursor:pointer;font-weight:600;"><i class="ri-voiceprint-line"></i> Audio ♀</button>' +
              '<button class="btn-send-audio-male" data-id="' + btn.dataset.id + '" style="min-width:30px;background:#6D28D9;color:#fff;border:0;border-radius:0 8px 8px 0;padding:6px 8px;font-size:0.7rem;cursor:pointer;font-weight:600;border-left:1px solid rgba(255,255,255,0.2);" title="Enviar como audio con voz masculina">♂</button>' +
              '</div>' +
              '<button class="btn-send-doc" data-id="' + btn.dataset.id + '" style="flex:1;min-width:70px;background:#f59e0b;color:#fff;border:0;border-radius:8px;padding:6px 8px;font-size:0.7rem;cursor:pointer;font-weight:600;"><i class="ri-file-pdf-line"></i> Doc</button>' +
              '<button class="btn-reject" data-id="' + btn.dataset.id + '" style="background:var(--error);color:#fff;border:0;border-radius:8px;padding:6px 8px;font-size:0.7rem;cursor:pointer;font-weight:600;"><i class="ri-close-line"></i></button>' +
              '</div>';
            // Insertar despues del contenedor de acciones actual
            var actionsDiv = btn.closest('.wa-msg-actions') || btn.parentElement;
            if (actionsDiv) actionsDiv.after(respDiv);
            else msgCard.appendChild(respDiv);
          }
          // Bind buttons
          respDiv.querySelector('.btn-send-no-fwd')?.addEventListener('click', function(e) { e.stopPropagation(); approveMessage(this.dataset.id, 'without_forward', this); });
          respDiv.querySelector('.btn-send-audio')?.addEventListener('click', function(e) { e.stopPropagation(); approveMessage(this.dataset.id, 'without_forward', this, true); });
          respDiv.querySelector('.btn-send-audio-male')?.addEventListener('click', function(e) { e.stopPropagation(); approveMessage(this.dataset.id, 'without_forward', this, true, false, true); });
          respDiv.querySelector('.btn-send-doc')?.addEventListener('click', function(e) { e.stopPropagation(); approveMessage(this.dataset.id, 'without_forward', this, false, true); });
          respDiv.querySelector('.btn-send-reply')?.addEventListener('click', function(e) { e.stopPropagation();
            var msgId = this.dataset.id;
            var editor = document.querySelector('.response-editor[data-id="' + msgId + '"]');
            if (editor) {
              var msgCard = this.closest('div[style*="background:var(--bg-main)"]') || this.closest('.wa-contact-messages > div');
              var bodyEl = msgCard ? msgCard.querySelector('div[style*="border-left:3px solid #25D366"]') : null;
              var originalMsg = bodyEl ? bodyEl.textContent.trim() : '';
              if (originalMsg) {
                editor.value = 'En respuesta a: \"' + originalMsg + '\"\n\n' + (editor.value || '');
                editor.focus();
                editor.setSelectionRange(0, 0);
              }
            }
            approveMessage(msgId, 'with_forward', this);
          });
          respDiv.querySelector('.btn-reject')?.addEventListener('click', function(e) { e.stopPropagation(); rejectMessage(this.dataset.id, this); });
        }
        loadPendingList();
      } else {
        btn.disabled = false;
        btn.innerHTML = '<i class="ri-robot-line"></i> Analizar';
        if (d.error) showToast('Error: ' + d.error);
      }
    }).catch(function() {
      isAnalyzing = false;
      btn.disabled = false;
      btn.innerHTML = '<i class="ri-robot-line"></i> Analizar';
      showToast('Error de red');
    });
  }

  function approveMessage(id, mode, btn, asAudio, asDoc, asMale) {
    btn.disabled = true;
    var label = asAudio ? 'Generando audio...' : mode === 'with_forward' ? 'Enviando con reenvío...' : 'Enviando...';
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:10px;height:10px;"></span> ' + label;
    // Leer el texto editado del textarea si existe
    var editor = document.querySelector('.response-editor[data-id="' + id + '"]');
    var customText = editor ? editor.value.trim() : '';
    fetch('/codeopen/approve/' + id, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: mode, asAudio: asAudio || false, asMale: asMale || false, customText: customText }) }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) {
        refreshCurrentView();
        loadPendingList();
        pollPendingCount();
        showToast(d.message || 'Enviado');
      } else {
        btn.disabled = false;
        btn.innerHTML = asAudio ? 'Audio' : (mode === 'with_forward' ? 'Con reenvío' : 'Sin reenvío');
        alert('Error: ' + (d.error || 'desconocido'));
      }
    }).catch(function() {
      btn.disabled = false;
      btn.innerHTML = asAudio ? 'Audio' : (mode === 'with_forward' ? 'Con reenvío' : 'Sin reenvío');
      alert('Error de red');
    });
  }

  function sendDocument(id, btn) {
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = '.pdf,.doc,.docx,.jpg,.png';
    input.onchange = function() {
      var file = input.files[0];
      if (!file) return;
      var formData = new FormData();
      formData.append('document', file);
      formData.append('message_id', id);
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:10px;height:10px;"></span>';
      fetch('/codeopen/send-document', { method: 'POST', body: formData }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) { showToast('📄 Documento enviado'); refreshCurrentView(); }
        else { alert('Error: ' + (d.error || '')); btn.disabled = false; btn.innerHTML = 'Doc'; }
      }).catch(function() { btn.disabled = false; btn.innerHTML = 'Doc'; });
    };
    input.click();
  }

  function rejectMessage(id, btn) {
    if (!confirm('¿Descartar este mensaje?')) return;
    fetch('/codeopen/reject/' + id, { method: 'POST' }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) { refreshCurrentView(); loadPendingList(); pollPendingCount(); }
      else { alert(d.error || 'Error'); }
    });
  }

  function showToast(msg) {
    var t = document.createElement('div');
    t.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--bg-card);border:1px solid var(--success);border-radius:10px;padding:10px 20px;font-size:0.85rem;z-index:9999;animation:fadeScale 0.3s ease;color:var(--text);box-shadow:0 4px 20px rgba(0,0,0,0.3);';
    t.innerHTML = '<i class="ri-checkbox-circle-line" style="color:var(--success);margin-right:6px;"></i> ' + msg;
    document.body.appendChild(t);
    setTimeout(function() { t.style.opacity = '0'; t.style.transition = 'opacity 0.3s'; setTimeout(function() { t.remove(); }, 300); }, 2500);
  }

  // ---- CHAT HISTORY MODAL ----
  var chatHistoryModal = $('chatHistoryModal');
  var chatHistoryOverlay = $('chatHistoryOverlay');
  var chatHistoryMessages = $('chatHistoryMessages');
  var chatHistoryContactName = $('chatHistoryContactName');
  var chatHistoryInput = $('chatHistoryInput');
  var chatHistorySendText = $('chatHistorySendText');
  var chatHistorySendAudio = $('chatHistorySendAudio');
  var chatHistoryStatus = $('chatHistoryStatus');
  var currentChatJid = null;

  function openCRMActions(address, name, btn) {
    var phone = address.replace('@s.whatsapp.net', '').replace('@lid', '').replace(/[^0-9]/g, '');
    var fiscalId = btn.dataset.fiscal || '';
    var existing = document.querySelector('.crm-dropdown');
    if (existing) { existing.remove(); return; }
    if (!fiscalId) {
      fetch('/clientes/api/find-by-phone/' + phone)
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d && d.ok && d.fiscalId) {
            btn.dataset.fiscal = d.fiscalId;
            fiscalId = d.fiscalId;
          }
          buildDD(fiscalId || phone);
        })
        .catch(function() { buildDD(phone); });
      return;
    }
    buildDD(fiscalId);
    function buildDD(fid) {
      var searchTerm = (address && address.includes('@lid')) ? encodeURIComponent(name) : (fid || phone);
      var dd = document.createElement('div');
      dd.className = 'crm-dropdown';
      dd.style.cssText = 'position:fixed;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;z-index:1000000;min-width:190px;box-shadow:0 8px 24px rgba(0,0,0,0.4);padding:4px;';
      var rect = btn.getBoundingClientRect();
      var spaceBelow = window.innerHeight - rect.bottom;
      var ddHeight = 320;
      if (spaceBelow < ddHeight && rect.top > ddHeight) {
        dd.style.bottom = (window.innerHeight - rect.top + 2) + 'px';
        dd.style.right = (window.innerWidth - rect.right) + 'px';
      } else {
        dd.style.top = (rect.bottom + 2) + 'px';
        dd.style.right = (window.innerWidth - rect.right) + 'px';
      }
      var esc = function(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); };
      var lienzo = function(icon, label, url) {
        return '<a href="' + esc(url) + '" target="_blank" style="display:flex;align-items:center;gap:6px;padding:7px 10px;border-radius:6px;text-decoration:none;color:var(--text);font-size:0.75rem;transition:background 0.15s;" onmouseover="this.style.background=\'var(--border)\'" onmouseout="this.style.background=\'transparent\'"><i class="' + esc(icon) + '" style="width:16px;text-align:center;"></i>' + esc(label) + '</a>';
      };
      var showCRM = fid && fid !== phone;
      dd.innerHTML = '<div style="padding:6px 10px;font-size:0.7rem;color:var(--text-faint);border-bottom:1px solid var(--border);margin-bottom:4px;">' + esc(name) + ' (' + esc(phone) + ')</div>' +
        (showCRM ? lienzo('ri-user-line', 'Ficha cliente', '/clientes/fiscal/' + encodeURIComponent(fid)) : '') +
        (showCRM ? lienzo('ri-receipt-line', 'Facturaci\u00f3n', '/isp/facturacion?fiscalId=' + encodeURIComponent(fid)) : '') +
        lienzo('ri-file-list-3-line', 'Contratos', '/isp/contratos?search=' + searchTerm) +
        (showCRM ? lienzo('ri-price-tag-3-line', 'Tarifas', '/clientes/fiscal/' + encodeURIComponent(fid)) : '') +
        (showCRM ? lienzo('ri-phone-line', 'CDRs', '/isp/cdrs?fiscal=' + encodeURIComponent(fid) + '&show=1') : '') +
        (showCRM ? lienzo('ri-key-2-line', 'PIN/PUK', '/clientes/fiscal/' + encodeURIComponent(fid) + '#lineas') : '') +
        (showCRM ? lienzo('ri-tools-line', 'Instalaci\u00f3n', '/clientes/fiscal/' + encodeURIComponent(fid) + '#instalaciones') : '') +
        (showCRM ? lienzo('ri-file-shield-2-line', 'Documentos KYC', '/clientes/fiscal/' + encodeURIComponent(fid) + '#kyc') : '') +
        (showCRM ? lienzo('ri-bar-chart-2-line', 'Consumo', '/clientes/fiscal/' + encodeURIComponent(fid) + '#lineas') : '') +
        (showCRM ? lienzo('ri-exchange-line', 'Cambiar Tarifa', '/clientes/fiscal/' + encodeURIComponent(fid) + '#lineas') : '') +
        (showCRM ? lienzo('ri-cloud-line', 'Documentos/Nube', '/isp/nube?fiscal=' + encodeURIComponent(fid)) : '') +
        (showCRM ? lienzo('ri-wifi-line', 'Cobertura', '/coverage') : '') +
        (showCRM ? lienzo('ri-eye-line', 'Portal Cliente', '/portal') : '') +
        (showCRM ? lienzo('ri-add-circle-line', 'Nueva Alta', '/altas') : '');
      document.body.appendChild(dd);
      var closeDD = function(e2) { if (!dd.contains(e2.target) && e2.target !== btn) { dd.remove(); document.removeEventListener('click', closeDD); } };
      setTimeout(function() { document.addEventListener('click', closeDD); }, 100);
    }
  }

  function openChatHistory(address, name) {
    currentChatJid = address;
    chatHistoryContactName.textContent = name;
    chatHistoryMessages.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-faint);"><div class="spinner-border spinner-border-sm"></div> Cargando historial...</div>';
    chatHistoryModal.style.right = '0';
    chatHistoryOverlay.style.display = 'block';
    chatHistoryStatus.textContent = 'cargando...';
    loadChatHistory(address);
  }

  function closeChatHistory() {
    chatHistoryModal.style.right = '-500px';
    chatHistoryOverlay.style.display = 'none';
    currentChatJid = null;
  }

  $('closeChatHistory').addEventListener('click', closeChatHistory);
  chatHistoryOverlay.addEventListener('click', closeChatHistory);

  function loadChatHistory(address) {
    var encoded = encodeURIComponent(address);
    fetch('/codeopen/whatsapp/chat/' + encoded + '/messages?count=40').then(function(r) { return r.json(); }).then(function(d) {
      if (!d.ok || !d.messages || d.messages.length === 0) {
        chatHistoryMessages.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text-faint);"><i class="ri-chat-history-line" style="font-size:2rem;display:block;margin-bottom:8px;opacity:0.4;"></i>No hay historial disponible<br><span style="font-size:0.75rem;">Los mensajes nuevos se guardan automáticamente</span></div>';
        chatHistoryStatus.textContent = '0 mensajes';
        return;
      }
      chatHistoryMessages.innerHTML = '';
      d.messages.forEach(function(m) {
        var div = document.createElement('div');
        var isMe = m.fromMe;
        var ts = m.timestamp ? new Date(m.timestamp).toLocaleString('es-ES', {hour:'2-digit', minute:'2-digit', day:'2-digit', month:'2-digit'}) : '';
        div.style.cssText = 'max-width:85%;padding:8px 12px;border-radius:12px;font-size:0.8rem;align-self:' + (isMe ? 'flex-end' : 'flex-start') + ';background:' + (isMe ? 'var(--accent)' : 'var(--bg-main)') + ';color:' + (isMe ? '#fff' : 'var(--text)') + ';border:1px solid ' + (isMe ? 'transparent' : 'var(--border)') + ';animation:fadeScale 0.2s ease;';
        div.innerHTML = '<div style="word-break:break-word;">' + escHtml(m.text || '(sin texto)') + '</div><div style="font-size:0.6rem;opacity:0.6;margin-top:4px;text-align:' + (isMe ? 'right' : 'left') + ';">' + ts + (isMe ? ' · Yo' : '') + '</div>';
        chatHistoryMessages.appendChild(div);
      });
      chatHistoryStatus.textContent = d.messages.length + ' mensajes';
      chatHistoryMessages.scrollTop = chatHistoryMessages.scrollHeight;
    }).catch(function() {
      chatHistoryMessages.innerHTML = '<div style="text-align:center;padding:30px;color:var(--error);">Error al cargar historial</div>';
    });
  }

  // Send message from chat history input
  function sendChatMessage(asAudio) {
    var text = chatHistoryInput.value.trim();
    if (!text || !currentChatJid) return;
    var btn = asAudio ? chatHistorySendAudio : chatHistorySendText;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:12px;height:12px;"></span>';
    fetch('/codeopen/whatsapp/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ jid: currentChatJid, text: text, asAudio: asAudio }) }).then(function(r) { return r.json(); }).then(function(d) {
      btn.disabled = false;
      btn.innerHTML = asAudio ? '<i class="ri-voiceprint-line"></i>' : '<i class="ri-send-plane-line"></i>';
      if (d.ok) {
        chatHistoryInput.value = '';
        loadChatHistory(currentChatJid);
        showToast('Mensaje enviado' + (asAudio ? ' (audio)' : ''));
      } else {
        alert('Error: ' + (d.error || 'desconocido'));
      }
    }).catch(function() {
      btn.disabled = false;
      btn.innerHTML = asAudio ? '<i class="ri-voiceprint-line"></i>' : '<i class="ri-send-plane-line"></i>';
      alert('Error de red');
    });
  }

  chatHistorySendText.addEventListener('click', function() { sendChatMessage(false); });
  chatHistorySendAudio.addEventListener('click', function() { sendChatMessage(true); });
  chatHistoryInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChatMessage(false); }
  });

  // ---- VOICE INPUT (Speech-to-Text en el input principal) ----
  var recognition = null;
  var isListening = false;
  var voiceBtn = document.createElement('button');
  voiceBtn.type = 'button';
  voiceBtn.id = 'voiceInputBtn';
  voiceBtn.innerHTML = '<i class="ri-mic-line"></i>';
  voiceBtn.style.cssText = 'background:none;border:1px solid var(--border);border-radius:10px;padding:12px 14px;cursor:pointer;font-size:0.9rem;color:var(--text-muted);display:flex;align-items:center;';
  voiceBtn.title = 'Dictar mensaje por voz';

  // Insert voice button next to askBtn
  try {
    var askForm = els.askForm;
    if (askForm && els.askBtn) askForm.insertBefore(voiceBtn, els.askBtn);
  } catch(e) { console.error('[Init] voiceBtn:', e); }

  voiceBtn.addEventListener('click', function() {
    if (isListening) {
      if (recognition) { recognition.stop(); }
      return;
    }
    try {
      var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) { alert('Tu navegador no soporta entrada por voz. Usa Chrome/Edge.'); return; }
      recognition = new SpeechRecognition();
      recognition.lang = 'es-ES';
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.onresult = function(event) {
        var transcript = '';
        for (var i = event.resultIndex; i < event.results.length; i++) {
          transcript += event.results[i][0].transcript;
          if (event.results[i].isFinal) {
            els.askInput.value = transcript;
          } else {
            els.askInput.value = transcript + '...';
          }
        }
      };
      recognition.onend = function() {
        isListening = false;
        voiceBtn.innerHTML = '<i class="ri-mic-line"></i>';
        voiceBtn.style.color = 'var(--text-muted)';
        voiceBtn.style.borderColor = 'var(--border)';
      };
      recognition.onerror = function() {
        isListening = false;
        voiceBtn.innerHTML = '<i class="ri-mic-line"></i>';
        voiceBtn.style.color = 'var(--text-muted)';
        voiceBtn.style.borderColor = 'var(--border)';
      };
      recognition.start();
      isListening = true;
      voiceBtn.innerHTML = '<i class="ri-mic-fill" style="color:#ef4444;animation:pulse 1s infinite;"></i>';
      voiceBtn.style.borderColor = '#ef4444';
    } catch(e) {
      alert('Error al iniciar reconocimiento de voz: ' + e.message);
    }
  });

  // Badges al cargar (una vez, sin auto-refresh)
  try { updateTabBadges(); } catch(e) {}
  // Actualizar badges tambien al abrir pendientes
  if (pendingBtn) {
    pendingBtn.addEventListener('click', function() { 
      setTimeout(function() { try { updateTabBadges(); } catch(e) {} }, 200);
    });
  }
})();
</script>
