  var waQRError = $('waQRError');
  var waStatusText = $('waStatusText');

  function pollWAStatus() {
    fetch('/codeopen/baileys-qr').then(function(r) { return r.json(); }).then(function(d) {
      var st = d.status || d;
      var waSessionActions = document.getElementById('waSessionActions');
      if (st.connected) {
        waStatusText.textContent = 'Conect.';
        waStatusText.style.color = '#22c55e';
        waQRLoading.style.display = 'none';
        waQRImageWrap.style.display = 'none';
        waQRConnected.style.display = 'block';
        waQRError.style.display = 'none';
        if (waSessionActions) waSessionActions.style.display = 'block';
      } else if (st.hasQR) {
        waStatusText.textContent = 'QR';
        waStatusText.style.color = '#f59e0b';
        waQRImage.src = '/codeopen/baileys-qr-image?' + Date.now();
        waQRImage.onload = function() {
          waQRLoading.style.display = 'none';
          waQRImageWrap.style.display = 'block';
          waQRConnected.style.display = 'none';
          waQRError.style.display = 'none';
        };
        waQRImage.onerror = function() {
          waQRLoading.innerHTML = '<div>Error al cargar QR</div>';
        };
      } else if (st.error) {
        waStatusText.textContent = 'Error';
        waStatusText.style.color = '#ef4444';
        waQRError.textContent = 'Error: ' + st.error;
        waQRError.style.display = 'block';
        waQRLoading.style.display = 'none';
      } else {
        waStatusText.textContent = 'Descon.';
        waStatusText.style.color = '#888';
      }
    });
  }

