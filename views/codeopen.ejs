                  '<a href="/isp/contratos?search=' + encodeURIComponent(data.client.name) + '" target="_blank" style="display:block;padding:6px 10px;border-radius:6px;text-decoration:none;color:var(--text);font-size:0.75rem;transition:background 0.2s;" onmouseover="this.style.background=\'var(--border)\'" onmouseout="this.style.background=\'transparent\'"><i class="ri-file-list-3-line"></i> Contratos</a>' +
