  function selectModel(modelId) {
    fetch('/codeopen/model/select', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ model: modelId }) }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) {
