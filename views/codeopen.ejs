        var item = document.createElement('div');
        var isActive = k === d.current;
        var needsKey = m.needsKey;
        item.style.cssText = 'padding:8px 10px;border-radius:8px;cursor:' + (needsKey ? 'default' : 'pointer') + ';font-size:0.78rem;display:flex;align-items:center;gap:8px;' + (isActive ? 'background:rgba(99,102,241,0.15);border:1px solid var(--accent);' : '') + ';transition:background 0.2s;';
