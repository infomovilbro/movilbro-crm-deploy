                  (dniClean ? '<a href="/clientes/fiscal/' + dniClean + '#instalaciones" target="_blank" style="display:block;padding:6px 10px;border-radius:6px;text-decoration:none;color:var(--text);font-size:0.75rem;transition:background 0.2s;" onmouseover="this.style.background=\'var(--border)\'" onmouseout="this.style.background=\'transparent\'"><i class="ri-tools-line"></i> Instalación</a>' : '') +
                  (dniClean ? '<a href="/clientes/fiscal/' + dniClean + '#kyc" target="_blank" style="display:block;padding:6px 10px;border-radius:6px;text-decoration:none;color:var(--text);font-size:0.75rem;transition:background 0.2s;" onmouseover="this.style.background=\'var(--border)\'" onmouseout="this.style.background=\'transparent\'"><i class="ri-file-shield-2-line"></i> Documentos KYC</a>' : '') +
                  (dniClean ? '<a href="/clientes/fiscal/' + dniClean + '#lineas" target="_blank" style="display:block;padding:6px 10px;border-radius:6px;text-decoration:none;color:var(--text);font-size:0.75rem;transition:background 0.2s;" onmouseover="this.style.background=\'var(--border)\'" onmouseout="this.style.background=\'transparent\'"><i class="ri-bar-chart-2-line"></i> Consumo</a>' : '') +
                  (dniClean ? '<a href="/clientes/fiscal/' + dniClean + '#lineas" target="_blank" style="display:block;padding:6px 10px;border-radius:6px;text-decoration:none;color:var(--text);font-size:0.75rem;transition:background 0.2s;" onmouseover="this.style.background=\'var(--border)\'" onmouseout="this.style.background=\'transparent\'"><i class="ri-exchange-line"></i> Cambiar Tarifa</a>' : '') +
                  '<a href="/isp/incidencias?search=' + (phoneClean || dniClean) + '" target="_blank" style="display:block;padding:6px 10px;border-radius:6px;text-decoration:none;color:var(--text);font-size:0.75rem;transition:background 0.2s;" onmouseover="this.style.background=\'var(--border)\'" onmouseout="this.style.background=\'transparent\'"><i class="ri-error-warning-line"></i> Incidencias</a>';
