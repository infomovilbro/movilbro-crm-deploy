  function loadModelDropdown() {
    fetch('/codeopen/models').then(function(r) { return r.json(); }).then(function(d) {
      if (!d.models) return;
      cerebroDropdown.innerHTML = '<div style="padding:6px 10px;font-size:0.7rem;color:var(--text-faint);border-bottom:1px solid var(--border);margin-bottom:4px;">🧠 Modelos</div>';
