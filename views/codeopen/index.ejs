      <span id="coFinalTime"></span>
      <div class="co-final-actions">
        <button class="co-btn-sm" onclick="copyFinal()">📋 Copiar</button>
        <button class="co-btn-sm" onclick="resetAll()">🔄 Nueva consulta</button>
      </div>
