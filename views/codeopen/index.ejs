</div>

<script>
(function generateParticles() {
  const canvas = document.getElementById('particles-canvas');
  for (let i = 0; i < 80; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const size = Math.random() * 3 + 1;
    p.style.width = size + 'px';
    p.style.height = size + 'px';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (Math.random() * 20 + 15) + 's';
    p.style.animationDelay = (Math.random() * 20) + 's';
    canvas.appendChild(p);
  }
  for (let i = 0; i < 40; i++) {
    const s = document.createElement('div');
    s.className = 'star-twinkle';
    const sz = Math.random() * 2 + 1;
    s.style.width = sz + 'px';
    s.style.height = sz + 'px';
    s.style.top = Math.random() * 100 + '%';
    s.style.left = Math.random() * 100 + '%';
    s.style.animationDuration = (Math.random() * 3 + 2) + 's';
    s.style.animationDelay = (Math.random() * 5) + 's';
    canvas.appendChild(s);
  }
})();

let currentTaskId = null;
let pollInterval = null;
let timerInterval = null;
let startTime = null;
let recognition = null;
let isRecording = false;

// Web Speech API
if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  recognition = new SpeechRecognition();
  recognition.lang = 'es-ES';
  recognition.continuous = false;
  recognition.interimResults = true;
  recognition.onresult = function(event) {
    let transcript = '';
    for (let i = event.resultIndex; i < event.results.length; i++) {
      transcript += event.results[i][0].transcript;
    }
    document.getElementById('coQuestion').value = transcript;
  };
  recognition.onend = function() {
    stopMic();
    const val = document.getElementById('coQuestion').value.trim();
    if (val) sendQuery();
  };
  recognition.onerror = function() {
    stopMic();
  };
}

function toggleMic() {
  if (!recognition) {
    alert('Reconocimiento de voz no disponible en este navegador. Usa Chrome/Edge.');
    return;
  }
  if (isRecording) {
    recognition.stop();
    stopMic();
  } else {
    isRecording = true;
    document.getElementById('coMicBtn').classList.add('recording');
    recognition.start();
  }
}

function stopMic() {
  isRecording = false;
  document.getElementById('coMicBtn').classList.remove('recording');
}

function startTimer() {
  startTime = Date.now();
  clearInterval(timerInterval);
  timerInterval = setInterval(function() {
    const elapsed = Date.now() - startTime;
    const secs = Math.floor(elapsed / 1000);
    const mins = String(Math.floor(secs / 60)).padStart(2, '0');
    const sss = String(secs % 60).padStart(2, '0');
    document.getElementById('coTimer').textContent = mins + ':' + sss;
  }, 200);
}

function stopTimer() {
  clearInterval(timerInterval);
}

async function sendQuery() {
  const input = document.getElementById('coQuestion');
  const question = input.value.trim();
  if (!question) { input.focus(); return; }

  resetAll();
  document.getElementById('coProgressGeneral').classList.add('active');
  document.getElementById('coSendBtn').disabled = true;
  document.getElementById('coSendBtn').textContent = '...';
  startTimer();

  try {
    const r = await fetch('/codeopen/ask', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question })
    });
    const data = await r.json();
    if (data.error) { alert(data.error); resetAll(); return; }
    currentTaskId = data.taskId;
    pollInterval = setInterval(function() { pollStatus(); }, 800);
  } catch (e) {
    alert('Error al enviar consulta: ' + e.message);
    resetAll();
  }
}

async function pollStatus() {
  if (!currentTaskId) return;
  try {
    const r = await fetch('/codeopen/status/' + currentTaskId);
    const data = await r.json();
    if (data.error) { clearInterval(pollInterval); return; }
    updateAgents(data);
    updateProgress(data);
    if (data.done) {
      clearInterval(pollInterval);
      stopTimer();
      document.getElementById('coSendBtn').disabled = false;
      document.getElementById('coSendBtn').textContent = '▶ Ejecutar';
      showFinal(data);
    }
  } catch (e) {
    // ignore polling errors
  }
}

function updateAgents(data) {
  const agents = data.agents;
  Object.keys(agents).forEach(function(name) {
    const agent = agents[name];
    const statusEl = document.getElementById('status-' + name);
    const progressEl = document.getElementById('progress-' + name);
    const resultEl = document.getElementById('result-' + name);
    const card = document.querySelector('[data-agent="' + name + '"]');

    statusEl.className = 'co-agent-status';
    if (agent.status === 'waiting') {
      statusEl.classList.add('status-waiting');
      statusEl.textContent = 'Esperando';
      card.classList.remove('glow');
    } else if (agent.status === 'working') {
      statusEl.classList.add('status-working');
      statusEl.textContent = 'Trabajando' + (name === 'ether' ? '' : '') + '...';
      card.classList.add('glow');
    } else if (agent.status === 'done') {
      statusEl.classList.add('status-done');
      statusEl.textContent = 'Completado ✓';
      card.classList.remove('glow');
      progressEl.classList.add('done');
    } else if (agent.status === 'error') {
      statusEl.classList.add('status-error');
      statusEl.textContent = 'Error ✗';
      card.classList.remove('glow');
      progressEl.classList.add('error');
    }

    progressEl.style.width = agent.progress + '%';

    if (agent.result && agent.status !== 'waiting') {
      resultEl.textContent = agent.result.substring(0, 300) + (agent.result.length > 300 ? '...' : '');
      resultEl.classList.add('visible');
    }
  });
}

function updateProgress(data) {
  const agents = data.agents;
  const names = Object.keys(agents);
  let totalProgress = 0;
  names.forEach(function(n) { totalProgress += agents[n].progress; });
  const avg = Math.round(totalProgress / names.length);
  document.getElementById('coProgressFill').style.width = avg + '%';

  const statuses = names.map(function(n) { return agents[n].status; });
  const working = statuses.filter(function(s) { return s === 'working'; }).length;
  const done = statuses.filter(function(s) { return s === 'done' || s === 'error'; }).length;
  const total = names.length;
  document.getElementById('coProgressText').textContent = done + '/' + total + ' agentes completados';
}

function showFinal(data) {
  const final = document.getElementById('coFinal');
  const content = document.getElementById('coFinalContent');
  const elapsed = Math.floor(data.elapsed / 1000);
  const mins = Math.floor(elapsed / 60);
  const secs = elapsed % 60;

  let responseText = data.finalResponse || data.agents.ether.result || 'No se generó respuesta.';
  responseText = marked(responseText);
  content.innerHTML = responseText;

  document.getElementById('coFinalTime').textContent = '⏱️ ' + mins + 'm ' + secs + 's | Pregunta: ' + escapeHtml(data.question.substring(0, 80)) + (data.question.length > 80 ? '...' : '');
  final.classList.add('visible');
  final.scrollIntoView({ behavior: 'smooth', block: 'center' });

  document.getElementById('coProgressFill').style.width = '100%';
  document.getElementById('coProgressText').textContent = 'Completado';
}

function marked(text) {
  text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  text = text.replace(/```(\w*)\n?([\s\S]*?)```/g, '<pre><code>$2</code></pre>');
  text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
  text = text.replace(/### (.+)/g, '<h3>$1</h3>');
  text = text.replace(/## (.+)/g, '<h2>$1</h2>');
  text = text.replace(/# (.+)/g, '<h1>$1</h1>');
  text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  text = text.replace(/\*(.+?)\*/g, '<em>$1</em>');
  text = text.replace(/^- (.+)/gm, '<li>$1</li>');
  text = text.replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>');
  text = text.replace(/\n\n/g, '</p><p>');
  text = text.replace(/\n/g, '<br>');
  text = '<p>' + text + '</p>';
  return text;
}

function escapeHtml(text) {
  const d = document.createElement('div');
  d.textContent = text;
  return d.innerHTML;
}

function copyFinal() {
  const el = document.getElementById('coFinalContent');
  const text = el.textContent || el.innerText;
  navigator.clipboard.writeText(text).then(function() {
    const btn = event.target;
    const orig = btn.textContent;
    btn.textContent = '✅ Copiado';
    setTimeout(function() { btn.textContent = orig; }, 2000);
  }).catch(function() { alert('No se pudo copiar'); });
}

function resetAll() {
  currentTaskId = null;
  clearInterval(pollInterval);
  stopTimer();
  document.getElementById('coProgressGeneral').classList.remove('active');
  document.getElementById('coProgressFill').style.width = '0%';
  document.getElementById('coSendBtn').disabled = false;
  document.getElementById('coSendBtn').textContent = '▶ Ejecutar';
  document.getElementById('coFinal').classList.remove('visible');
  document.getElementById('coFinalContent').innerHTML = '';
  document.getElementById('coTimer').textContent = '00:00';

  ['orion','nova','kronos','atlas','ether'].forEach(function(name) {
    const statusEl = document.getElementById('status-' + name);
    const progressEl = document.getElementById('progress-' + name);
    const resultEl = document.getElementById('result-' + name);
    const card = document.querySelector('[data-agent="' + name + '"]');
    statusEl.className = 'co-agent-status status-waiting';
    statusEl.textContent = 'Esperando';
    progressEl.style.width = '0%';
    progressEl.className = 'co-agent-progress-fill';
    resultEl.textContent = '';
    resultEl.classList.remove('visible');
    card.classList.remove('glow');
  });

  document.getElementById('coQuestion').value = '';
  document.getElementById('coQuestion').focus();
}
</script>
