<section style="height:calc(100vh - 120px);padding:0;margin:0;display:flex;flex-direction:column;">
  <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#075e54;color:#fff;flex-shrink:0;border-radius:8px 8px 0 0;">
    <i class="bi bi-whatsapp" style="font-size:1.3rem;"></i>
    <span style="font-weight:600;font-size:0.9rem;">WhatsApp Web</span>
    <span style="font-size:0.75rem;opacity:0.7;margin-left:auto;">web.whatsapp.com</span>
  </div>
  <div style="flex:1;border:1px solid #ddd;border-top:0;border-radius:0 0 8px 8px;overflow:hidden;background:#fff;">
    <iframe id="waIframe" src="/whatsapp/content/" style="width:100%;height:100%;border:0;" allow="camera;microphone" sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
  </div>
</section>
<script>
(function() {
  var iframe = document.getElementById('waIframe');
  // Reload iframe if it fails to load (common with WhatsApp blocking)
  iframe.onerror = function() {
    setTimeout(function() {
      iframe.src = '/whatsapp/content/?t=' + Date.now();
    }, 3000);
  };
})();
</script>
