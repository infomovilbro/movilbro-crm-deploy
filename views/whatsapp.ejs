<section>
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0"><i class="bi bi-whatsapp text-success"></i> WhatsApp</h5>
    <span id="waStatusBadge" class="badge bg-secondary">Desconectado</span>
  </div>

  <!-- QR Panel (visible when disconnected) -->
  <div id="waQRPanel" class="card mb-3 text-center" style="display:none;">
    <div class="card-body py-4">
      <h6><i class="bi bi-qr-code"></i> Escanea el código QR con tu móvil</h6>
      <p class="text-muted small">Abre WhatsApp → Ajustes → Dispositivos vinculados → Vincular</p>
      <div id="waQRContainer" class="d-flex justify-content-center">
        <div class="spinner-border text-success"></div>
      </div>
      <button class="btn btn-sm btn-outline-secondary mt-2" onclick="reconectarWA()"><i class="bi bi-arrow-clockwise"></i> Regenerar QR</button>
    </div>
  </div>

  <!-- Main WhatsApp Interface (visible when connected) -->
  <div id="waMainPanel" style="display:none;">
    <div class="row g-2" style="height:calc(100vh - 220px);min-height:400px;">
      <!-- Chat List -->
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-header py-2">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
              <input type="text" id="waChatSearch" class="form-control" placeholder="Buscar chat..." oninput="filtrarChatsWA()">
            </div>
          </div>
          <div class="card-body p-0 overflow-auto" id="waChatList" style="height:calc(100% - 45px);">
            <div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span> Cargando chats...</div>
          </div>
        </div>
      </div>
      <!-- Conversation -->
      <div class="col-md-8">
        <div class="card h-100">
          <div class="card-header py-2 d-flex justify-content-between align-items-center" id="waChatHeader">
            <span class="text-muted small"><i class="bi bi-chat-dots"></i> Selecciona un chat</span>
          </div>
          <div class="card-body p-0 overflow-auto" id="waMessages" style="height:calc(100% - 90px);background:#efeae2;">
            <div class="text-center text-muted py-5"><i class="bi bi-chat-square-text" style="font-size:3rem;"></i><p class="mt-2">Selecciona una conversación</p></div>
          </div>
          <div class="card-footer p-2" id="waSendPanel" style="display:none;">
            <div class="input-group input-group-sm">
              <input type="text" id="waMessageInput" class="form-control" placeholder="Escribe un mensaje..." onkeypress="if(event.key==='Enter')enviarWA()">
              <button class="btn btn-success" onclick="enviarWA()"><i class="bi bi-send"></i></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
var waEventSource = null;
var waCurrentJid = null;
var waPollInterval = null;

function iniciarWA() {
  // Check status
  fetch('/whatsapp/status')
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status === 'connected') {
        mostrarWAConectado();
      } else {
        mostrarWAQR();
        conectarSSE();
      }
    })
    .catch(function() {
      document.getElementById('waStatusBadge').textContent = 'Error';
      document.getElementById('waStatusBadge').className = 'badge bg-danger';
    });
}

function conectarSSE() {
  if (waEventSource) { waEventSource.close(); }
  waEventSource = new EventSource('/whatsapp/qr-stream');
  waEventSource.onmessage = function(e) {
    try {
      var d = JSON.parse(e.data);
      if (d.type === 'qr') {
        document.getElementById('waQRContainer').innerHTML = '<img src="' + d.data + '" alt="QR" style="width:260px;height:260px;border:4px solid #25D366;border-radius:8px;">';
      } else if (d.type === 'status' && d.data === 'connected') {
        waEventSource.close();
        mostrarWAConectado();
      }
    } catch(e) {}
  };
  waEventSource.onerror = function() {
    setTimeout(conectarSSE, 3000);
  };
}

function mostrarWAQR() {
  document.getElementById('waQRPanel').style.display = '';
  document.getElementById('waMainPanel').style.display = 'none';
  document.getElementById('waStatusBadge').textContent = 'Escanea QR';
  document.getElementById('waStatusBadge').className = 'badge bg-warning';
}

function mostrarWAConectado() {
  document.getElementById('waQRPanel').style.display = 'none';
  document.getElementById('waMainPanel').style.display = '';
  document.getElementById('waStatusBadge').textContent = 'Conectado';
  document.getElementById('waStatusBadge').className = 'badge bg-success';
  cargarChatsWA();
  // Poll for new chats/messages
  if (waPollInterval) clearInterval(waPollInterval);
  waPollInterval = setInterval(cargarChatsWA, 10000);
}

function cargarChatsWA() {
  fetch('/whatsapp/chats')
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.status !== 'connected') {
        mostrarWAQR();
        conectarSSE();
        return;
      }
      var container = document.getElementById('waChatList');
      if (!d.chats || d.chats.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-4">Sin conversaciones</div>';
        return;
      }
      var html = '';
      d.chats.forEach(function(c) {
        var isActive = waCurrentJid === c.jid;
        var unreadBadge = c.unreadCount > 0 ? ' <span class="badge bg-danger rounded-pill">' + c.unreadCount + '</span>' : '';
        html += '<div class="d-flex align-items-center px-3 py-2 border-bottom wa-chat-item" data-jid="' + c.jid + '" data-name="' + c.name.toLowerCase() + '" style="cursor:pointer;' + (isActive ? 'background:#dcf8c6;' : '') + '" onclick="seleccionarChat(\'' + c.jid + '\',\'' + c.name.replace(/'/g,"\\'") + '\')">';
        html += '<div class="avatar bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width:38px;height:38px;font-weight:600;font-size:0.9rem;">' + c.name.charAt(0).toUpperCase() + '</div>';
        html += '<div class="flex-grow-1 min-w-0"><div class="fw-semibold small">' + c.name + unreadBadge + '</div>';
        html += '<div class="text-muted small text-truncate">' + (c.lastMessage || '') + '</div></div></div>';
      });
      container.innerHTML = html;
    });
}

function filtrarChatsWA() {
  var q = document.getElementById('waChatSearch').value.toLowerCase();
  document.querySelectorAll('.wa-chat-item').forEach(function(el) {
    el.style.display = el.dataset.name.includes(q) ? '' : 'none';
  });
}

var waChatsCache = {};

function seleccionarChat(jid, name) {
  waCurrentJid = jid;
  document.getElementById('waChatHeader').innerHTML = '<span class="fw-semibold small"><i class="bi bi-person-circle"></i> ' + name + '</span>';
  document.getElementById('waSendPanel').style.display = '';
  document.getElementById('waMessages').innerHTML = '<div class="text-center py-4"><span class="spinner-border spinner-border-sm"></span> Cargando mensajes...</div>';

  // Highlight active chat
  document.querySelectorAll('.wa-chat-item').forEach(function(el) {
    el.style.background = el.dataset.jid === jid ? '#dcf8c6' : '';
  });

  fetch('/whatsapp/messages?jid=' + encodeURIComponent(jid) + '&limit=50')
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var msgs = d.messages || [];
      waChatsCache[jid] = msgs;
      renderMensajes(msgs, jid);
    });
}

function renderMensajes(msgs, jid) {
  var container = document.getElementById('waMessages');
  if (!msgs || msgs.length === 0) {
    container.innerHTML = '<div class="text-center text-muted py-5"><i class="bi bi-chat-dots" style="font-size:3rem;"></i><p class="mt-2">Sin mensajes</p></div>';
    return;
  }
  var html = '<div class="p-2" style="min-height:100%;">';
  msgs.forEach(function(m) {
    var isMe = m.fromMe;
    var time = m.timestamp ? new Date(m.timestamp * 1000).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) : '';
    html += '<div class="d-flex ' + (isMe ? 'justify-content-end' : 'justify-content-start') + ' mb-1">';
    html += '<div class="px-2 py-1 rounded" style="max-width:80%;background:' + (isMe ? '#dcf8c6' : '#ffffff') + ';box-shadow:0 1px 1px rgba(0,0,0,0.1);">';
    html += '<div class="small">' + escaparHTMLWA(m.text) + '</div>';
    html += '<div class="text-end" style="font-size:0.6rem;color:#999;">' + time + '</div>';
    html += '</div></div>';
  });
  html += '</div>';
  container.innerHTML = html;
  container.scrollTop = container.scrollHeight;
}

function enviarWA() {
  var input = document.getElementById('waMessageInput');
  var text = input.value.trim();
  if (!text || !waCurrentJid) return;
  input.disabled = true;

  fetch('/whatsapp/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ jid: waCurrentJid, text: text }) })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      input.value = '';
      input.disabled = false;
      input.focus();
      // Optimistically add message
      var msgs = waChatsCache[waCurrentJid] || [];
      msgs.push({ fromMe: true, text: text, timestamp: Math.floor(Date.now()/1000) });
      renderMensajes(msgs, waCurrentJid);
    })
    .catch(function() {
      alert('Error al enviar');
      input.disabled = false;
    });
}

function reconectarWA() {
  document.getElementById('waQRContainer').innerHTML = '<div class="spinner-border text-success"></div>';
  fetch('/whatsapp/reconnect', { method: 'POST' })
    .then(function() { conectarSSE(); });
}

function escaparHTMLWA(str) {
  var div = document.createElement('div');
  div.appendChild(document.createTextNode(str || ''));
  return div.innerHTML;
}

iniciarWA();
</script>
<style>
.wa-chat-item:hover { background:#f0f0f0; }
#waMessages { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" opacity="0.03"><rect width="100" height="100" fill="none"/><circle cx="20" cy="20" r="10"/></svg>'); }
</style>
