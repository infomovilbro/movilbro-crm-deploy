<section>
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0"><i class="ri-whatsapp-line text-success"></i> <%= ui.moduleName.whatsapp %></h2>
    <button class="btn btn-success" onclick="abrirModalVincular()" style="border-radius:20px;font-weight:600;font-size:0.95rem;padding:8px 18px;">
      <i class="ri-smartphone-line"></i> Vincular WhatsApp
    </button>
  </div>

  <!-- Modal Vincular WhatsApp -->
  <div class="modal fade" id="modalVincularWA" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="ri-smartphone-line text-success"></i> Vincular WhatsApp Web</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body text-center">
          <div style="font-size:4rem;color:#25D366;margin-bottom:12px;"><i class="ri-whatsapp-line"></i></div>
          <h6 class="fw-bold mb-3">Para usar WhatsApp Web desde este CRM:</h6>
          <ol class="text-start" style="font-size:0.95rem;">
            <li class="mb-2">Abre WhatsApp Web en una nueva pestaña →</li>
            <li class="mb-2">En tu móvil, abre WhatsApp → <strong>Ajustes → Dispositivos vinculados</strong></li>
            <li class="mb-2">Toca <strong>"Vincular un dispositivo"</strong></li>
            <li>Escanea el código QR que aparece en la pestaña que abriste</li>
          </ol>
          <div class="mt-3">
            <a href="https://web.whatsapp.com" target="_blank" class="btn btn-success btn-lg w-100">
              <i class="ri-external-link-line"></i> Abrir WhatsApp Web
            </a>
          </div>
          <div class="mt-2 text-muted small">
            Una vez vinculado, usa los botones "Chat" de cada cliente para abrir conversaciones.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-5">
      <div class="card">
        <div class="card-header"><i class="ri-people-line"></i> Clientes con WhatsApp</div>
        <div class="card-body p-0">
          <div class="p-2">
            <input type="text" id="waSearch" class="form-control form-control-sm" placeholder="Buscar cliente..." onkeyup="filterWAClients()">
          </div>
          <div id="waClientList" style="max-height:280px;overflow-y:auto;">
            <% if (clientes.length === 0) { %>
            <div class="text-center text-muted py-4">No hay clientes con teléfono</div>
            <% } else { clientes.forEach(c => { 
              const phoneClean = c.telefono ? c.telefono.replace(/[^\d]/g, '') : '';
            %>
            <div class="wa-client d-flex align-items-center px-3 py-2 border-bottom" data-name="<%= (c.nombre + ' ' + (c.apellidos || '')).toLowerCase() %>">
              <div class="avatar bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width:42px;height:42px;font-weight:600;">
                <%= c.nombre.charAt(0).toUpperCase() %>
              </div>
              <div class="flex-grow-1 min-w-0">
                <div class="fw-bold small"><%= c.nombre %> <%= c.apellidos || '' %></div>
                <div class="text-muted small"><%= c.telefono %></div>
              </div>
              <% if (phoneClean) { %>
              <a href="https://web.whatsapp.com/send?phone=<%= phoneClean %>" target="_blank" class="btn btn-sm btn-success" style="border-radius:20px;">
                <i class="ri-chat-1-line"></i> Chat
              </a>
              <% } %>
            </div>
            <% }); } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-7">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="ri-whatsapp-line text-success"></i> WhatsApp Web</span>
          <div class="d-flex gap-2 flex-wrap">
            <input type="text" id="waPhoneInput" class="form-control form-control-sm" style="width:200px;" placeholder="Teléfono (ej. 34612345678)" value="<%= typeof phone !== 'undefined' ? phone : '' %>">
            <button class="btn btn-success btn-sm" onclick="openWAChat()"><i class="ri-send-plane-line"></i> Abrir chat</button>
          </div>
        </div>
        <div class="card-body text-center py-5">
          <i class="ri-whatsapp-line" style="font-size:5rem;color:#25D366;display:block;margin-bottom:16px;"></i>
          <h5>WhatsApp Web no funciona en iframe</h5>
          <p class="text-muted mb-3">WhatsApp Web requiere abrirse en una pestaña nueva debido a restricciones de seguridad.</p>
          <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a href="https://web.whatsapp.com" target="_blank" class="btn btn-success btn-lg">
              <i class="ri-external-link-line"></i> Abrir WhatsApp Web
            </a>
            <% if (typeof phone !== 'undefined' && phone) { %>
            <a href="https://web.whatsapp.com/send?phone=<%= phone %>" target="_blank" class="btn btn-outline-success btn-lg">
              <i class="ri-chat-1-line"></i> Chat con +<%= phone %>
            </a>
            <% } %>
          </div>
          <div class="mt-3 text-muted small">
            Una vez abierto, escanea el QR con tu móvil desde <strong>Ajustes → Dispositivos vinculados</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function filterWAClients() {
  const q = document.getElementById('waSearch').value.toLowerCase();
  document.querySelectorAll('.wa-client').forEach(el => {
    el.style.display = el.dataset.name.includes(q) ? '' : 'none';
  });
}

function openWAChat() {
  const phone = document.getElementById('waPhoneInput').value.trim();
  if (!phone) { alert('Introduce un número de teléfono'); return; }
  const cleanPhone = phone.replace(/[^\d]/g, '');
  if (cleanPhone) {
    window.open('https://web.whatsapp.com/send?phone=' + cleanPhone, '_blank');
  }
}

function abrirModalVincular() {
  var modal = new bootstrap.Modal(document.getElementById('modalVincularWA'));
  modal.show();
}
</script>
