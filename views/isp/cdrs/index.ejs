<section>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5><i class="bi bi-graph-up-arrow"></i> CDRs y Excedentes</h5>
    <div>
      <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalSubirCSV"><i class="bi bi-upload"></i> Importar CSV</button>
      <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoCDR"><i class="bi bi-plus-lg"></i> Nuevo manual</button>
      <a href="/isp/cdrs/ejemplo" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download"></i> CSV ejemplo</a>
    </div>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-md-2"><div class="stat-card"><div class="stat-value"><%= total.c || 0 %></div><div class="stat-label">Excesos pendientes</div></div></div>
    <div class="col-md-2"><div class="stat-card"><div class="stat-value"><%= (total.t || 0).toFixed(2) %>€</div><div class="stat-label">Importe pendiente</div></div></div>
    <div class="col-md-2"><div class="stat-card"><div class="stat-value"><%= groups.length %></div><div class="stat-label">Clientes</div></div></div>
  </div>

  <!-- Navegación por meses/años -->
  <div class="card mb-3">
    <div class="card-body py-2">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="fw-semibold small">Filtrar por periodo:</span>
        <a href="/isp/cdrs" class="btn btn-sm <%= !selectedPeriodo ? 'btn-primary' : 'btn-outline-secondary' %>">Todos</a>
        <% var yearsSorted = Object.keys(yearsMap).sort().reverse(); %>
        <% yearsSorted.forEach(function(y) { %>
          <% var meses = Object.keys(yearsMap[y]).sort(function(a,b){return b-a}); %>
          <% meses.forEach(function(m) { %>
            <% var periodo = y + '-' + String(m).padStart(2, '0'); %>
            <a href="/isp/cdrs?periodo=<%= periodo %>" class="btn btn-sm <%= selectedPeriodo === periodo ? 'btn-primary' : 'btn-outline-secondary' %>"><%= MES_NOMBRES[m] %> <%= y %></a>
          <% }); %>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <% if (!groups || groups.length === 0) { %>
      <div class="text-center text-muted py-4"><i class="bi bi-inbox" style="font-size:2rem;"></i><br>No hay CDRs registrados en este periodo.<br>Sube un CSV con los consumos de los operadores o añádelos manualmente.</div>
      <% } else {
        // Flatten all CDRs and group by period
        var allCdrs = [];
        groups.forEach(function(g) {
          g.cdrs.forEach(function(c) {
            c._cliente_nombre = g.cliente;
            allCdrs.push(c);
          });
        });
        var byPeriod = {};
        allCdrs.forEach(function(c) {
          var p = c.periodo || 'sin-periodo';
          if (!byPeriod[p]) byPeriod[p] = [];
          byPeriod[p].push(c);
        });
        var periods = Object.keys(byPeriod).sort().reverse();
        var totalRegistros = allCdrs.length;
      %>
      <div class="p-2 small text-muted"><%= totalRegistros %> registros en total</div>
      <div class="accordion accordion-flush" id="cdrsIspAccordion">
        <% periods.forEach(function(p, pi) {
          var cdrs = byPeriod[p];
          var totalMes = 0;
          cdrs.forEach(function(c) { totalMes += parseFloat(c.importe || 0); });
          var label = p === 'sin-periodo' ? 'Sin periodo' : p;
        %>
        <div class="accordion-item">
          <h2 class="accordion-header">
            <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#cdrPeriod<%= pi %>">
              <strong><%= label %></strong>
              <span class="badge bg-secondary ms-2"><%= cdrs.length %></span>
              <span class="badge bg-primary ms-1"><%= totalMes.toFixed(2) %>€</span>
            </button>
          </h2>
          <div id="cdrPeriod<%= pi %>" class="accordion-collapse collapse" data-bs-parent="#cdrsIspAccordion">
            <div class="accordion-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0 table-sm">
                  <thead class="table-light">
                    <tr>
                      <th>Cliente</th>
                      <th>L&iacute;nea</th>
                      <th>Concepto</th>
                      <th>Tipo</th>
                      <th>Unidades</th>
                      <th>Importe</th>
                      <th>Factura</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% cdrs.forEach(function(c) { %>
                    <tr>
                      <td><strong><%= c._cliente_nombre %></strong></td>
                      <td><code><%= c.linea || '-' %></code></td>
                      <td><%= c.concepto || '-' %></td>
                      <td><span class="badge bg-info"><%= c.tipo || '-' %></span></td>
                      <td><%= c.unidades ? c.unidades + ' ' + (c.tipo === 'exceso' ? 'GB' : c.tipo === 'sms' ? 'SMS' : 'min') : '-' %></td>
                      <td class="fw-bold"><%= parseFloat(c.importe || 0).toFixed(2) %>€</td>
                      <td><%= c.factura_id ? '#'+c.factura_id : '<span class="text-warning">Pendiente</span>' %></td>
                      <td class="text-end">
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteCDR(<%= c.id %>)"><i class="bi bi-trash"></i></button>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Modal Subir CSV -->
<div class="modal" id="modalSubirCSV">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5>Importar CDRs desde CSV</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <form method="POST" action="/isp/cdrs/import" enctype="multipart/form-data">
      <div class="modal-body">
        <p class="text-muted">Formato CSV: <code>fiscalId,linea,concepto,tipo,importe,unidades,periodo</code></p>
        <p class="small"><a href="/isp/cdrs/ejemplo">Descargar ejemplo CSV</a></p>
        <input type="file" name="csv" class="form-control" accept=".csv" required>
      </div>
      <div class="modal-footer"><button type="submit" class="btn btn-primary">Importar</button></div>
    </form>
  </div></div>
</div>

<!-- Modal Nuevo CDR Manual -->
<div class="modal" id="modalNuevoCDR">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5>Añadir excedente manual</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <form method="POST" action="/isp/cdrs/create">
      <div class="modal-body">
        <div class="mb-2">
          <label class="form-label">Cliente (fiscalId)</label>
          <select name="fiscal_id" class="form-select">
            <option value="">Seleccionar cliente</option>
            <% clientes.forEach(function(c) { %>
            <option value="<%= c.likes_customer_id %>"><%= c.nombre %> (<%= c.likes_customer_id %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label">Línea</label>
          <input type="text" name="linea" class="form-control" placeholder="633879873">
        </div>
        <div class="mb-2">
          <label class="form-label">Concepto</label>
          <input type="text" name="concepto" class="form-control" placeholder="GB extra, llamadas internacionales..." required>
        </div>
        <div class="row g-2">
          <div class="col-4">
            <label class="form-label">Tipo</label>
            <select name="tipo" class="form-select">
              <option value="exceso">Exceso</option>
              <option value="llamadas">Llamadas</option>
              <option value="sms">SMS</option>
              <option value="otros">Otros</option>
            </select>
          </div>
          <div class="col-4">
            <label class="form-label">Unidades</label>
            <input type="number" step="0.01" name="unidades" class="form-control" placeholder="0">
          </div>
          <div class="col-4">
            <label class="form-label">Importe (€)</label>
            <input type="number" step="0.01" name="importe" class="form-control" required>
          </div>
        </div>
        <div class="mb-2 mt-2">
          <label class="form-label">Periodo</label>
          <input type="month" name="periodo" class="form-control" value="<%= new Date().toISOString().split('T')[0].substring(0,7) %>">
        </div>
      </div>
      <div class="modal-footer"><button type="submit" class="btn btn-primary">Guardar</button></div>
    </form>
  </div></div>
</div>

<script>
function deleteCDR(id) {
  if (!confirm('¿Eliminar este CDR?')) return;
  fetch('/isp/cdrs/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({id:id}) })
  .then(function(r){return r.json();})
  .then(function(d){if(d.ok)location.reload();else alert('Error: '+d.error);})
  .catch(function(){alert('Error de conexión');});
}
</script>

<style>
.stat-card { background:#f8f9fa; border-radius:10px; padding:12px 16px; text-align:center; border:1px solid #dee2e6; }
.stat-value { font-size:1.3rem; font-weight:700; color:#0d6efd; }
.stat-label { font-size:0.75rem; color:#6c757d; }
</style>