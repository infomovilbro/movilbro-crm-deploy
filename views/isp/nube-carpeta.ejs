<section>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5><i class="bi bi-folder"></i> <%= relativePath || 'Raíz' %></h5>
    <div class="d-flex gap-2">
      <% if (!isRoot) { %>
      <a href="/isp/nube/carpeta?path=<%= encodeURIComponent(parentPath) %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-up"></i> Subir</a>
      <% } %>
      <a href="/isp/nube" class="btn btn-outline-primary btn-sm"><i class="bi bi-cloud"></i> Nube</a>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>Nombre</th>
            <th>Tamaño</th>
            <th>Modificado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!isRoot) { %>
          <tr style="cursor:pointer;" onclick="window.location.href='/isp/nube/carpeta?path=<%= encodeURIComponent(parentPath) %>'">
            <td colspan="4"><i class="bi bi-arrow-up"></i> <strong>../</strong> (Subir)</td>
          </tr>
          <% } %>
          <% items.forEach(function(item) { %>
          <tr>
            <% if (item.isDirectory) { %>
            <td><a href="/isp/nube/carpeta?path=<%= encodeURIComponent(item.path) %>"><i class="bi bi-folder"></i> <%= item.name %>/</a></td>
            <td>-</td>
            <td class="small"><%= item.modified instanceof Date ? item.modified.toLocaleString('es-ES') : '-' %></td>
            <td class="text-end">
              <a href="/isp/nube/zip/todas" class="btn btn-sm btn-outline-secondary" title="Descargar carpeta"><i class="bi bi-download"></i></a>
            </td>
            <% } else { %>
            <td><%= item.ext === '.pdf' ? '<i class="bi bi-file-pdf text-danger"></i>' : '<i class="bi bi-file-text"></i>' %> <%= item.name %></td>
            <td class="small"><%= item.size > 1024 ? (item.size / 1024).toFixed(1) + ' KB' : item.size + ' B' %></td>
            <td class="small"><%= item.modified instanceof Date ? item.modified.toLocaleString('es-ES') : '-' %></td>
            <td class="text-end">
              <a href="/isp/nube/descargar?path=<%= encodeURIComponent(item.path) %>" class="btn btn-sm btn-outline-primary" title="Descargar"><i class="bi bi-download"></i></a>
            </td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>