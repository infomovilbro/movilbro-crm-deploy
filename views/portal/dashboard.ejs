<!DOCTYPE html>
<html lang="es">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Mi cuenta - Movilbro CRM</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"></head>
<body class="bg-light">
<div class="container mt-3">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-person-circle"></i> <%= cliente.nombre %> <%= cliente.apellidos || '' %></h3>
    <a href="/portal" class="btn btn-outline-secondary btn-sm"><i class="bi bi-box-arrow-right"></i> Salir</a>
  </div>
  <div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card text-center p-3"><h2><%= facturas.length %></h2><small class="text-muted">Facturas</small></div></div>
    <div class="col-md-3"><div class="card text-center p-3"><h2><%= contratos.length %></h2><small class="text-muted">Contratos</small></div></div>
    <div class="col-md-3"><div class="card text-center p-3"><h2><%= incidencias.length %></h2><small class="text-muted">Incidencias</small></div></div>
  </div>
  <% if (facturas.length > 0) { %>
  <div class="card mb-3"><div class="card-header"><i class="bi bi-receipt"></i> Mis Facturas</div>
    <div class="card-body p-0"><table class="table table-hover mb-0"><thead><tr><th>Periodo</th><th>Importe</th><th>Estado</th><th></th></tr></thead><tbody>
      <% facturas.forEach(function(f) { %>
      <tr><td><%= f.periodo %></td><td><%= parseFloat(f.importe_total || 0).toFixed(2) %>€</td><td><span class="badge bg-<%= f.estado === 'pagada' ? 'success' : f.estado === 'pendiente' ? 'warning' : 'secondary' %>"><%= f.estado %></span></td>
        <td><a href="/isp/facturacion/facturas/<%= f.id %>/view" class="btn btn-sm btn-outline-primary" target="_blank"><i class="bi bi-eye"></i></a></td></tr>
      <% }); %>
    </tbody></table></div>
  </div>
  <% } %>
  <% if (contratos.length > 0) { %>
  <div class="card mb-3"><div class="card-header"><i class="bi bi-file-text"></i> Mis Contratos</div>
    <div class="card-body p-0"><table class="table table-hover mb-0"><thead><tr><th>Producto</th><th>Línea</th><th>Estado</th><th>Fecha</th></tr></thead><tbody>
      <% contratos.forEach(function(c) { %>
      <tr><td><%= c.producto || '-' %></td><td><%= c.linea || '-' %></td><td><span class="badge bg-<%= c.estado === 'activo' ? 'success' : 'secondary' %>"><%= c.estado %></span></td><td><%= c.fecha_alta ? new Date(c.fecha_alta).toLocaleDateString('es-ES') : '-' %></td></tr>
      <% }); %>
    </tbody></table></div>
  </div>
  <% } %>
</div>
</body>
</html>
