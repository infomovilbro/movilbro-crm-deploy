<script>
var waOverlayVisible = false;
function toggleWAOverlay() {
  waOverlayVisible = !waOverlayVisible;
  var overlay = document.getElementById('waOverlay');
  var backdrop = document.getElementById('waOverlayBackdrop');
  if (waOverlayVisible) {
    overlay.style.display = 'flex';
    backdrop.style.display = 'block';
    document.body.style.overflow = 'hidden';
  } else {
    overlay.style.animation = 'slideOut 0.2s ease';
    setTimeout(function() {
      overlay.style.display = 'none';
      overlay.style.animation = 'slideIn 0.2s ease';
      backdrop.style.display = 'none';
      document.body.style.overflow = '';
    }, 200);
  }
}

// Enviar mensaje de WhatsApp a CodeOpen para análisis IA
function enviarACodeOpen() {
  var msgTexto = prompt('Pega el mensaje que quieres analizar (o déjalo vacío para cancelar):');
  if (!msgTexto || !msgTexto.trim()) return;
  
  var btn = event.target;
  if (btn.tagName !== 'BUTTON') btn = btn.closest('button');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm" style="width:10px;height:10px;"></span>';
  
  fetch('/codeopen/webhook/whatsapp', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      from: 'WhatsApp Web',
      message: msgTexto.trim(),
      timestamp: new Date().toISOString()
    })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-robot"></i> Analizar';
    if (d.ok) {
      alert('Mensaje enviado a CodeOpen para análisis. Ve al panel de Pendientes para aprobar o rechazar la respuesta.\n\nID Pendiente: #' + d.pending_id);
    } else {
      alert('Error: ' + (d.error || 'desconocido'));
    }
  })
  .catch(function() {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-robot"></i> Analizar';
    alert('Error de red');
  });
}

// Keep-alive: periodically check if WhatsApp iframe is alive
setInterval(function() {
  var dot = document.getElementById('waLiveDot');
  if (dot) {
    var frame = document.getElementById('waPersistentFrame');
    if (frame) {
      try {
        var doc = frame.contentDocument || frame.contentWindow?.document;
        if (doc && doc.body && doc.body.innerHTML.length > 100) {
          dot.style.background = '#4ade80';
        } else {
          dot.style.background = '#f87171';
        }
      } catch(e) {
        dot.style.background = '#fbbf24';
      }
    }
  }
}, 10000);

// ---- RECIBIR MENSAJES DEL IFRAME VIA postMessage ----
var waTextosVistos = {};
window.addEventListener('message', function(event) {
  if (event.data && event.data.type === 'wa_msg') {
    var texto = event.data.text;
    if (!texto || texto.length < 2 || waTextosVistos[texto.substring(0, 50)]) return;
    waTextosVistos[texto.substring(0, 50)] = Date.now();
    
    fetch('/codeopen/webhook/whatsapp', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ from: 'WhatsApp', message: texto, timestamp: new Date().toISOString() })
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) {
        var dot = document.getElementById('waLiveDot');
        if (dot) { dot.style.background = '#f59e0b'; setTimeout(function() { dot.style.background = '#4ade80'; }, 3000); }
      }
    }).catch(function() {});
  }
});

// Limpiar caché cada hora
setInterval(function() {
  var a = Date.now();
  Object.keys(waTextosVistos).forEach(function(k) { if (a - waTextosVistos[k] > 3600000) delete waTextosVistos[k]; });
}, 3600000);

// Close on Escape
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' && waOverlayVisible) toggleWAOverlay();
});
</script>
