              <li><a class="<%= title === 'Leads' ? 'active' : '' %>" href="/leads"><span class="emoji-icon">🎯</span>Leads</a></li>
              <li><a class="<%= title === 'Usuarios' ? 'active' : '' %>" href="/users"><span class="emoji-icon">👨‍💼</span>Usuarios</a></li>
              <li><a class="<%= title.includes('Factura') ? 'active' : '' %>" href="/invoices"><span class="emoji-icon">🧾</span>Facturas</a></li>
              -->
