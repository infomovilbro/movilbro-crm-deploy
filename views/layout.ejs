<script>
var fnActive = false, fnCurrent = null;
function fnToggle() {
  fnActive = !fnActive;
  document.getElementById('fn-btn').classList.toggle('active', fnActive);
  document.getElementById('fn-banner').classList.toggle('active', fnActive);
  document.body.style.cursor = fnActive ? 'crosshair' : '';
  if (!fnActive) fnClosePopup();
}
function fnCancel() {
  fnClosePopup();
  if (fnActive) fnToggle();
}
function fnClosePopup() {
  document.getElementById('fn-popup').classList.remove('open');
  document.getElementById('fn-overlay').classList.remove('open');
  fnCurrent = null;
}
function fnBuildSelector(el) {
  if (!el || el === document.body || el === document.documentElement) return el ? el.tagName.toLowerCase() : '';
  var path = [];
  while (el && el !== document.body && el !== document.documentElement) {
    var sel = el.tagName.toLowerCase();
    if (el.id) { sel = '#' + el.id; path.unshift(sel); break; }
    if (el.className && typeof el.className === 'string') {
      var cls = el.className.trim().split(/\s+/).filter(function(c){return c && !c.startsWith('fn-') && c !== 'active' && c !== 'open' && c !== 'show' && c !== 'fade' && c !== 'collapsing';}).slice(0,2);
      if (cls.length) sel += '.' + cls.join('.');
    }
    var parent = el.parentElement;
    if (parent) {
      var idx = 1;
      for (var i = 0; i < parent.children.length; i++) { if (parent.children[i] === el) break; if (parent.children[i].tagName === el.tagName) idx++; }
      if (parent.children.length > 1) sel += ':nth-child('+idx+')';
    }
    path.unshift(sel);
    el = parent;
  }
  return path.join(' > ');
}
document.addEventListener('click', function(e) {
  if (!fnActive) return;
  // Ignorar clicks dentro del popup, overlay, lista y botones propios
  var ex = e.target.closest('#fn-popup, #fn-overlay, #fn-list-panel, #fn-btn, #fn-btn.active, #fn-list-btn, #fn-banner');
  if (ex) return;
  e.preventDefault(); e.stopPropagation();
  var el = e.target;
  fnCurrent = {
    url: location.href,
    selector: fnBuildSelector(el),
    element_text: (el.textContent || '').trim().substring(0,200)
  };
  document.getElementById('fn-url').textContent = fnCurrent.url;
  document.getElementById('fn-sel').textContent = fnCurrent.selector;
  document.getElementById('fn-text').textContent = fnCurrent.element_text;
  document.getElementById('fn-note').value = '';
  document.getElementById('fn-status').textContent = '';
  document.getElementById('fn-popup').classList.add('open');
  document.getElementById('fn-overlay').classList.add('open');
  setTimeout(function(){ document.getElementById('fn-note').focus(); }, 100);
}, true);
function fnSave() {
  var note = document.getElementById('fn-note').value.trim();
  if (!note) { document.getElementById('fn-note').style.borderColor = '#e74c3c'; return; }
  document.getElementById('fn-note').style.borderColor = '';
  fetch('/api/fix-notes', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      url: fnCurrent.url,
      selector: fnCurrent.selector,
      element_text: fnCurrent.element_text,
      note: note
    })
  }).then(function(r){return r.json()}).then(function(d){
    if (d.ok) {
      fnClosePopup();
      fnUpdateCount();
    } else {
      document.getElementById('fn-status').innerHTML = '<span style="color:#e74c3c;">Error: '+d.error+'</span>';
    }
  }).catch(function(e){
    document.getElementById('fn-status').innerHTML = '<span style="color:#e74c3c;">Error: '+e.message+'</span>';
  });
}
function fnShowList() {
  document.getElementById('fn-list-panel').classList.add('open');
  document.getElementById('fn-overlay').classList.add('open');
  document.getElementById('fn-list-content').innerHTML = '<div class="text-center py-4" style="color:#999;"><div class="spinner-sm" style="display:inline-block;width:16px;height:16px;border:2px solid #ddd;border-top-color:#0050A1;border-radius:50%;animation:spin 0.6s linear infinite;vertical-align:middle;margin-right:6px;"></div>Cargando...</div>';
  fetch('/api/fix-notes').then(function(r){return r.json()}).then(function(d){
    if (!d.ok || !d.pending || d.pending.length === 0) {
      document.getElementById('fn-list-content').innerHTML = '<div class="text-center py-4" style="color:#999;">🎉 No hay errores pendientes.</div>';
      return;
    }
    var html = '';
    d.pending.forEach(function(n){
      html += '<div class="fn-list-item" id="fnli_'+n.id+'">'+
        '<div class="d-flex justify-content-between align-items-start">'+
        '<div style="flex:1;min-width:0;">'+
        '<div class="fn-li-url">📍 <a href="'+n.url+'" target="_blank" style="color:#888;">'+n.url+'</a></div>'+
        (n.selector ? '<div class="fn-li-sel">🎯 '+n.selector+'</div>' : '')+
        '<div class="fn-li-note">✏️ '+n.note+'</div>'+
        (n.element_text ? '<div class="fn-li-text">📄 '+n.element_text.substring(0,120)+'</div>' : '')+
        '<div class="fn-li-meta">#'+n.id+' · '+n.created_at+'</div>'+
        '</div>'+
        '<div style="display:flex;gap:4px;flex-shrink:0;">'+
        '<button class="btn btn-sm btn-outline-success" onclick="fnListFix('+n.id+')" title="Arreglado">✅</button>'+
        '<button class="btn btn-sm btn-outline-danger" onclick="fnListDel('+n.id+')" title="Eliminar nota">✕</button>'+
        '</div></div></div>';
    });
    document.getElementById('fn-list-content').innerHTML = html;
  }).catch(function(){
    document.getElementById('fn-list-content').innerHTML = '<div class="text-center py-4" style="color:#e74c3c;">Error al cargar notas.</div>';
  });
}
function fnCloseList() {
  document.getElementById('fn-list-panel').classList.remove('open');
  document.getElementById('fn-overlay').classList.remove('open');
}
function fnListFix(id) {
  fetch('/api/fix-notes/'+id+'/fix',{method:'POST',headers:{'Content-Type':'application/json'}})
  .then(function(r){return r.json()}).then(function(d){
    if(d.ok){var el=document.getElementById('fnli_'+id);if(el)el.style.display='none';fnUpdateCount();}
  });
}
function fnListDel(id) {
  if(!confirm('¿Eliminar nota #'+id+'?'))return;
  fetch('/api/fix-notes/'+id,{method:'DELETE'})
  .then(function(r){return r.json()}).then(function(d){
    if(d.ok){var el=document.getElementById('fnli_'+id);if(el)el.remove();fnUpdateCount();}
  });
}
function fnUpdateCount() {
  fetch('/api/fix-notes').then(function(r){return r.json()}).then(function(d){
    var c = document.getElementById('fn-count');
    var sc = document.getElementById('fn-sidebar-count');
    if (d.ok && d.pending && d.pending.length > 0) {
      var n = d.pending.length;
      if (c) { c.textContent = n; c.style.display = 'flex'; }
      if (sc) { sc.textContent = n; sc.style.display = 'inline'; }
    } else {
      if (c) c.style.display = 'none';
      if (sc) sc.style.display = 'none';
    }
  }).catch(function(){});
}
fnUpdateCount();
setInterval(fnUpdateCount, 30000);

/* === FIX: funciones para fix-notes (si no existen ya) === */
if (typeof fnDel === 'undefined') {
  window.fnDel = function(id) { if (!confirm('Eliminar nota #'+id+'?')) return; fetch('/api/fix-notes/'+id,{method:'DELETE'}).then(function(r){return r.json()}).then(function(d){if(d.ok){var el=document.getElementById('fn_'+id);if(el)el.remove();}}); };
  window.fnFix = function(id) { var v=prompt('Verificacion:');if(v===null)return;fetch('/api/fix-notes/'+id+'/fix',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({verification:v||'Sin verif'})}).then(function(r){return r.json()}).then(function(d){if(d.ok)location.reload()}); };
  window.fnTest = function(id) { var d=document.getElementById('testResult_'+id);if(!d)return;d.style.display='block';d.innerHTML='Probando...';fetch('/api/fix-notes/test/'+id,{method:'POST'}).then(function(r){return r.json()}).then(function(d2){d.innerHTML=d2.ok?(d2.failed===0?'✅ OK ':'❌ Fallos ')+d2.tested:'❌ '+d2.error}).catch(function(e){d.innerHTML='Error: '+e.message}); };
  window.fnReport = function(oid) { var url=prompt('URL:');if(url===null)return;if(!url)url=location.href;var sel=prompt('Selector:');var note=prompt('Describe:');if(!note)return;fetch('/api/fix-notes/report-fail',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({originalId:oid,url:url,selector:sel||'',note:note})}).then(function(r){return r.json()}).then(function(d){if(d.ok){alert('Reportado #'+d.id);location.reload()}}); };
}
/* ===== ASISTENTE IA DEFINITIVO ===== */
var aiSelActive = false, aiSelData = null, aiRec = null, aiRecOn = false, aiLastFix = null;
var aiMouseX = 0, aiMouseY = 0, aiModoPago = true, aiAnalizando = false, aiSilTimer = null;
var aiMute = true, aiChatHistorial = '';

/* Ruleta: PAGO por defecto */
function toggleModo() {
  aiModoPago = !aiModoPago;
  var btn = document.getElementById('ai-mode-btn');
  btn.textContent = aiModoPago ? '💎' : '🆓';
  btn.title = aiModoPago ? 'DeepSeek V4 Flash GO (PAGO)' : 'DeepSeek V4 Flash Free';
}
/* Mute */
function toggleMute() {
  aiMute = !aiMute;
  var btn = document.getElementById('ai-mute-btn');
  btn.textContent = aiMute ? '🔇' : '🔊';
  if (!aiMute && window.speechSynthesis) window.speechSynthesis.cancel();
}

/* Paso 1: 🤖 activa modo selector */
function toggleAssist() {
  if (aiSelActive) { aiDesactivarSelector(); return; }
  aiSelActive = true;
  document.body.style.cursor = 'crosshair';
  document.getElementById('ai-sel-banner').style.display = 'block';
  document.getElementById('ai-sel-btn').classList.add('active');
}
function closeAssist() {
  document.getElementById('ai-assist-panel').style.display = 'none';
  aiSelActive = false; aiDesactivarSelector(); pararMic();
  if (aiSilTimer) clearTimeout(aiSilTimer);
}
function aiToggleSelector() {
  if (aiSelActive) { aiDesactivarSelector(); return; }
  toggleAssist();
}
function aiDesactivarSelector() {
  aiSelActive = false; document.body.style.cursor = '';
  document.getElementById('ai-sel-banner').style.display = 'none';
  document.getElementById('ai-sel-btn')?.classList.remove('active');
}

/* Ventana centrada al hacer click */
document.getElementById('ai-assist-panel')?.addEventListener('mouseenter', function() {
  this.style.opacity = '1'; this.style.transform = 'scale(1)';
});

/* Paso 2: Click captura elemento + abre ventana + mic */
document.addEventListener('click', function(e) {
  if (!aiSelActive) return;
  var ex = e.target.closest('#ai-assist-panel, #ai-sel-banner, #ai-assist-btn, #ai-sel-btn, #ai-mic-btn, .ai-sendbtn, #ai-input, #ai-mode-btn');
  if (ex) return;
  e.preventDefault(); e.stopPropagation();
  var el = e.target;
  var parts = []; var tmp = el;
  while (tmp && tmp !== document.body && tmp !== document.documentElement) {
    var s = tmp.tagName.toLowerCase();
    if (tmp.id) { s = '#' + tmp.id; parts.unshift(s); break; }
    if (tmp.className && typeof tmp.className === 'string') {
      var cls = tmp.className.trim().split(/\s+/).filter(function(x){ return x && !x.startsWith('ai-') && x !== 'active' && x !== 'open' && x !== 'show' && x !== 'fade'; }).slice(0,2);
      if (cls.length) s += '.' + cls.join('.');
    }
    var par = tmp.parentElement;
    if (par) {
      var idx = 1;
      for (var i = 0; i < par.children.length; i++) { if (par.children[i] === tmp) break; if (par.children[i].tagName === tmp.tagName) idx++; }
      if (par.children.length > 1) s += ':nth-child('+idx+')';
    }
    parts.unshift(s); tmp = par;
  }
  aiSelData = { url: location.href, selector: parts.join(' > '), element_text: (el.textContent || '').trim().substring(0, 300) };
  document.getElementById('ai-sel-url').textContent = aiSelData.url;
  document.getElementById('ai-sel-css').textContent = aiSelData.selector;
  document.getElementById('ai-sel-text').textContent = aiSelData.element_text;
  document.getElementById('ai-sel-row').style.display = 'block';
  aiDesactivarSelector();
  // Abrir ventana centrada - limpiar chat si ya se acepto el anterior
  var p = document.getElementById('ai-assist-panel');
  // Si aiLastFix es null (ya se acepto) y hay mensajes, limpiar para nuevo error
  if (!aiLastFix) {
    var chatEl = document.getElementById('ai-chat-msgs');
    if (chatEl) chatEl.innerHTML = '';
  }
  p.style.display = 'flex';
  p.style.left = Math.max(10, (window.innerWidth - 420) / 2) + 'px';
  p.style.top = Math.max(10, (window.innerHeight - 500) / 2) + 'px';
  p.style.opacity = '1'; p.style.transform = 'scale(1)';
  // Auto-mic 6s silencio
  setTimeout(function() { iniciarMic6s(); }, 400);
}, true);

/* Paso 3: Mic SIN TIMER - solo se para al pulsar stop o enviar manual */
function iniciarMic6s() {
  if (!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) { setStatus('Voz no soportada'); return; }
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  aiRec = new SR();
  aiRec.lang = 'es-ES'; aiRec.continuous = true; aiRec.interimResults = true;
  var ultTexto = '';
  aiRec.onresult = function(ev) {
    for (var i = ev.resultIndex; i < ev.results.length; i++) {
      if (!ev.results[i].isFinal) continue;
      var txt = ev.results[i][0].transcript;
      if (txt && txt.trim().length > 0) {
        ultTexto = (ultTexto ? ultTexto + ' ' : '') + txt;
        document.getElementById('ai-input').value = '🎤 ' + ultTexto;
      }
    }
  };
  aiRec.onerror = function() { pararMic(); };
  // Reiniciar si el mic se acaba sin resultados (fallo intermitente)
  aiRec.onend = function() {
    if (aiRecOn && !document.getElementById('ai-input').value.includes('🎤')) {
      // Se acabo sin capturar nada - reiniciar
      try { var SR2 = window.SpeechRecognition || window.webkitSpeechRecognition;
        var newRec = new SR2(); newRec.lang = 'es-ES'; newRec.continuous = true; newRec.interimResults = true;
        newRec.onresult = aiRec.onresult; newRec.onerror = aiRec.onerror; newRec.onend = aiRec.onend;
        aiRec = newRec; aiRec.start();
      } catch(e2) { pararMic(); }
    }
  };
  aiRec.start();
  aiRecOn = true;
  document.getElementById('ai-mic-btn').classList.add('active');
  document.getElementById('ai-mic-btn').textContent = '⏹';
  setStatus('🎤 Grabando - pulsa ⏹ o escribe y envía');
}
function pararMicYEnviar() {
  if (aiRecOn) {
    var txt = document.getElementById('ai-input').value.replace('🎤 ','').trim();
    pararMic();
    if (txt) { document.getElementById('ai-input').value = ''; aiEnviar(txt); }
  }
}
function pararMic() {
  if (aiRec) { try { aiRec.stop(); } catch(e) {} aiRec = null; }
  aiRecOn = false; if (aiSilTimer) { clearTimeout(aiSilTimer); aiSilTimer = null; }
  var btn = document.getElementById('ai-mic-btn');
  if (btn) { btn.classList.remove('active'); btn.textContent = '🎤'; }
}
function toggleMic() {
  if (aiRecOn) { pararMic(); return; }
  iniciarMic6s();
}

var aiAbortController = null;
function detenerAnalisis() {
  if (aiAbortController) { aiAbortController.abort(); aiAbortController = null; }
  aiAnalizando = false;
  document.getElementById('ai-analyzing-msg').style.display = 'none';
  setStatus('Analisis detenido');
  addMsg('⛔ Analisis detenido', 'ai');
}

/* Paso 4: Enviar a analisis (ambos modos analizan en CRM) */
function aiEnviar(texto) {
  pararMic(); if (aiAnalizando) return; aiAnalizando = true;
  if (!texto && !aiSelData) { setStatus('Describe el error'); aiAnalizando = false; return; }
  addMsg((texto || '📤'), 'user');
  
  var modelo = aiModoPago ? 'deepseek-v4-flash' : 'nemotron-3-ultra-free';
  setStatus('Analizando...');
  if (!aiMute) speakText('Analizando...');
  document.getElementById('ai-analyzing-msg').style.display = 'block';
  // Boton para detener
  addMsg('⏳ Analizando... <button onclick="detenerAnalisis()" style="background:#e74c3c;color:#fff;border:0;padding:2px 10px;border-radius:6px;cursor:pointer;font-size:0.75rem;">Detener</button>', 'ai');
  
  aiAbortController = new AbortController();
  fetch('/ai-assist/analyze', {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, signal: aiAbortController.signal,
    body: JSON.stringify({
      text: texto, modelo: modelo,
      url: aiSelData ? aiSelData.url : null,
        selector: aiSelData ? aiSelData.selector : null,
        element_text: aiSelData ? aiSelData.element_text : null
      })
    }).then(function(r){ return r.json(); }).then(function(d){
      document.getElementById('ai-analyzing-msg').style.display = 'none';
      aiAnalizando = false;
      if (d.ok) {
        addMsg(d.response, 'ai');
        if (d.fix_data) {
          aiLastFix = d.fix_data;
          addMsg(
            '<button onclick="acceptFix()" style="background:#6c5ce7;color:#fff;border:0;padding:4px 14px;border-radius:6px;cursor:pointer;font-size:0.8rem;font-weight:600;margin-right:6px;">✅ Aceptar</button>' +
            '<button onclick="cancelFix()" style="background:#ddd;color:#333;border:0;padding:4px 14px;border-radius:6px;cursor:pointer;font-size:0.8rem;margin-right:6px;">❌ No me gusta</button>' +
            '<button onclick="iniciarMic6s()" style="background:#6c5ce7;color:#fff;border:0;padding:4px 14px;border-radius:6px;cursor:pointer;font-size:0.8rem;">🎤 Decir por que</button>',
            'ai');
        }
        if (d.tts && !aiMute) { speakText(d.response); }
        setStatus('');
      } else {
        addMsg('Error: ' + (d.error || 'desconocido'), 'ai');
        setStatus('');
      }
    }).catch(function(e){
      document.getElementById('ai-analyzing-msg').style.display = 'none';
      aiAnalizando = false;
      if (e.name === 'AbortError') return; // Usuario detuvo, no mostrar error
      addMsg('Error: ' + (e.message || 'conexion'), 'ai'); setStatus('');
    });
}
function sendToAI() {
  var t = document.getElementById('ai-input').value.trim();
  if (t) { document.getElementById('ai-input').value = ''; aiEnviar(t); }
}

/* Aceptar / Cancelar / Re-analizar */
function acceptFix() {
  var fd = aiLastFix;
  var sel = fd ? (fd.selector || (aiSelData ? aiSelData.selector : '') || '') : (aiSelData ? aiSelData.selector : '') || '';
  var et = fd ? (fd.element_text || (aiSelData ? aiSelData.element_text : '') || '') : (aiSelData ? aiSelData.element_text : '') || '';
  var u = fd ? (fd.url || (aiSelData ? aiSelData.url : null) || location.href) : (aiSelData ? aiSelData.url : null) || location.href;
  var historial = '';
  var msgs = document.getElementById('ai-chat-msgs');
  if (msgs) {
    var chats = msgs.querySelectorAll('.ai-msg-bubble');
    for (var h = 0; h < chats.length; h++) { historial += chats[h].textContent.trim() + '\n---\n'; }
  }
  var solucion = fd ? fd.solution : '';
  var notaFinal = (solucion || historial || 'Aceptado manualmente') + '\n\n--- HISTORIAL ---\n' + (historial || '(vacio)');
  fetch('/api/fix-notes', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ url: u, selector: sel, element_text: et, note: notaFinal.substring(0, 2000) })
  }).then(function(r){ return r.json(); }).then(function(d){
    if (d.ok) { addMsg('✅ Añadido #' + d.id, 'ai'); fnUpdateCount(); }
  }).catch(function(){});
  addMsg('✅ Guardado. Pulsa 🎯 para nuevo error', 'ai'); aiLastFix = null;
}
function cancelFix() {
  if (aiSelData) { iniciarMic6s(); addMsg('❌ Explica...', 'ai'); }
  else { addMsg('❌ Cancelado. Pulsa 🎯 para otro', 'ai'); aiLastFix = null; }
}

/* TTS - voz mas rapida */
function speakText(text) {
  if ('speechSynthesis' in window) {
    var utt = new SpeechSynthesisUtterance(text);
    utt.lang = 'es-ES'; utt.rate = 1.4;
    speechSynthesis.cancel(); speechSynthesis.speak(utt);
  }
}
function addMsg(text, role) {
  var c = document.getElementById('ai-chat-msgs');
  if (!c) return;
  var d = document.createElement('div');
  var id = 'msg_' + Date.now() + '_' + Math.random().toString(36).substr(2,4);
  d.id = id;
  d.className = 'ai-msg' + (role === 'user' ? ' ai-msg-user' : ' ai-msg-ai');
  d.innerHTML = '<div class="ai-msg-bubble">' + text.replace(/\n/g, '<br>') + '</div>' +
    '<button onclick="var e=document.getElementById(\''+id+'\');if(e)e.remove()" style="background:none;border:0;cursor:pointer;font-size:0.7rem;color:#999;padding:2px;flex-shrink:0;" title="Eliminar este mensaje">✕</button>';
  c.appendChild(d); c.scrollTop = c.scrollHeight;
}
function setStatus(t) { var s = document.getElementById('ai-status'); if (s) s.textContent = t; }

/* ===== VOICE ADMIN V5 - Ventana al pulsar, wake word OFF hasta boton ===== */
var vaRec=null,vaActivo=false,vaModoPagoVA=true,vaEscuchandoVA=false,vaCmdRec=null,vaSilencioTimer=null,vaUltTexto='',vaMaxVA=false;
var vaHistorial=[]; var vaWakeWordsVA=['movilbro estas','movilbro esta','movilbroesta','movilbroestas','mobilbro estas','mobilbroesta','oye estas','oye esta','ollestas','ollas','oye','o yes tas','y estas'];

function vaAddChat(text,role){var c=document.getElementById('va-chat-msgs');if(!c||!vaActivo)return;var d=document.createElement('div');d.className='ai-msg'+(role==='user'?' ai-msg-user':' ai-msg-ai');d.innerHTML='<div class="ai-msg-bubble">'+text.replace(/\n/g,'<br>')+'</div>';c.appendChild(d);c.scrollTop=c.scrollHeight;}

function vaIniciar(){
  if(vaActivo){vaCerrar();return;}
  vaHistorial=[];vaModoPagoVA=true;vaActivo=true;
  var p=document.getElementById('va-panel');if(p){p.style.display='flex';vaCentrarPanel('va-panel');}
  document.getElementById('va-btn').style.background='#e17055';
  document.getElementById('va-status-dot').style.display='block';
  speakText('Voice Admin activado.');
  if(!vaEscuchandoVA) setTimeout(vaEscucharWakeVA,1200);
}
function vaCerrar(){
  vaActivo=false;vaEscuchandoVA=false;
  try{if(vaRec)vaRec.stop();}catch(e){}try{if(vaCmdRec)vaCmdRec.stop();}catch(e){}
  if(vaSilencioTimer)clearTimeout(vaSilencioTimer);
  document.getElementById('va-btn').style.background='#00b894';
  document.getElementById('va-status-dot').style.display='none';
  var p=document.getElementById('va-panel');if(p)p.style.display='none';
}
function vaCentrarPanel(id){var p=document.getElementById(id);if(p){p.style.left=Math.max(10,(window.innerWidth-380)/2)+'px';p.style.top=Math.max(10,(window.innerHeight-420)/2)+'px';}}
function vaToggleModo(){vaModoPagoVA=!vaModoPagoVA;document.getElementById('va-mode-btn').textContent=vaModoPagoVA?'💎':'🆓';}
function vaToggleMax(){vaMaxVA=!vaMaxVA;var p=document.getElementById('va-panel');if(p){if(vaMaxVA){p.style.width='90%';p.style.height='90%';p.style.left='5%';p.style.top='5%';}else{p.style.width='';p.style.height='';p.style.left='';p.style.top='';vaCentrarPanel('va-panel');}}}
function aiToggleMax(){var p=document.getElementById('ai-assist-panel');var m=document.getElementById('ai-max-btn');if(p.style.width==='95%'){p.style.width='';p.style.height='';p.style.left='';p.style.top='';m.textContent='⛶';}else{p.style.width='95%';p.style.height='95%';p.style.left='2.5%';p.style.top='2.5%';m.textContent='⤓';}}

/* Wake word DESACTIVADO hasta pulsar boton - solo escucha wake si ya activo */
function vaEscucharWakeVA(){
  if(!vaActivo)return;
  if(!('webkitSpeechRecognition' in window||'SpeechRecognition' in window))return;
  try{if(vaRec)vaRec.stop();}catch(e){}
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  vaRec=new SR();vaRec.lang='es-ES';vaRec.continuous=true;vaRec.interimResults=true;
  vaEscuchandoVA=true;
  vaRec.onresult=function(ev){
    for(var i=ev.resultIndex;i<ev.results.length;i++){
      if(!ev.results[i].isFinal)continue;
      var t=ev.results[i][0].transcript.toLowerCase().replace(/[¿?¡!.,\/\-]/g,'').replace(/[áéíóú]/g,function(m){return{á:'a',é:'e',í:'i',ó:'o',ú:'u'}[m]||m;});
      for(var w=0;w<vaWakeWordsVA.length;w++){if(t.indexOf(vaWakeWordsVA[w])>-1){
        try{if(vaRec)vaRec.stop();}catch(e){}vaEscuchandoVA=false;
        speakText('Si dime.');
        document.getElementById('va-status-dot').style.background='#fdcb6e';
        setTimeout(vaEscucharComandoVA,1000);return;
      }}
    }
  };
  vaRec.onerror=function(){if(vaActivo)setTimeout(vaEscucharWakeVA,2000);};
  vaRec.onend=function(){if(vaActivo&&vaEscuchandoVA)setTimeout(vaEscucharWakeVA,1000);};
  try{vaRec.start();}catch(e){setTimeout(vaEscucharWakeVA,1000);}
}

/* Escucha comando - continua, se interrumpe si hablo, 3s silencio = responde */
function vaEscucharComandoVA(){
  if(!vaActivo)return;
  if(!('webkitSpeechRecognition' in window||'SpeechRecognition' in window))return;
  try{if(vaCmdRec)vaCmdRec.stop();}catch(e){}
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  vaCmdRec=new SR();vaCmdRec.lang='es-ES';vaCmdRec.continuous=true;vaCmdRec.interimResults=true;
  vaUltTexto='';
  vaCmdRec.onresult=function(ev){
    for(var i=ev.resultIndex;i<ev.results.length;i++){
      if(!ev.results[i].isFinal)continue;
      var txt=ev.results[i][0].transcript;
      if(txt&&txt.length>2){
        if(window.speechSynthesis&&window.speechSynthesis.speaking)window.speechSynthesis.cancel();
        vaUltTexto=(vaUltTexto?vaUltTexto+' ':'')+txt;
        document.getElementById('va-status-dot').style.background='#fdcb6e';
        if(vaSilencioTimer)clearTimeout(vaSilencioTimer);
        vaSilencioTimer=setTimeout(function(){if(vaUltTexto)vaProcesarComandoVA(vaUltTexto);},3000);
      }
    }
  };
  // Si se acaba sin texto, reiniciar escucha wake
  vaCmdRec.onerror=function(){if(vaActivo)setTimeout(vaEscucharWakeVA,2000);};
  vaCmdRec.onend=function(){if(vaActivo&&vaUltTexto)vaProcesarComandoVA(vaUltTexto);else if(vaActivo)setTimeout(vaEscucharWakeVA,500);};
  try{vaCmdRec.start();}catch(e){setTimeout(vaEscucharWakeVA,1000);}
}

function vaProcesarComandoVA(texto){
  try{if(vaCmdRec)vaCmdRec.stop();}catch(e){}
  vaAddChat('🗣️ '+texto,'user');
  vaHistorial.push({role:'user',text:texto});
  document.getElementById('va-status-dot').style.background='#e17055';
  speakText('Procesando.');
  // Aceptacion automatica
  var tLow=texto.toLowerCase();
  if((tLow.indexOf('acepta')>-1||tLow.indexOf('dale')>-1||tLow.indexOf('ok')===0||tLow.indexOf('si')===0)&&aiLastFix){acceptFix();speakText('Aceptado.');vaAddChat('✅ Aceptado','ai');setTimeout(vaEscucharWakeVA,1500);return;}
  var ctx='';for(var h=Math.max(0,vaHistorial.length-6);h<vaHistorial.length-1;h++){ctx+=vaHistorial[h].role+': '+vaHistorial[h].text+'\n';}
  fetch('/ai-assist/analyze',{
    method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({text:texto,modelo:vaModoPagoVA?'deepseek-v4-flash':'deepseek-v4-flash-free',url:location.href,historial:ctx})
  }).then(function(r){return r.json();}).then(function(d){
    document.getElementById('va-status-dot').style.background='#00b894';
    if(d.ok){
      vaAddChat(d.response,'ai');
      speakText(d.response);
      vaHistorial.push({role:'ai',text:d.response});
      var abrir=texto.toLowerCase().indexOf('abre')>-1||texto.toLowerCase().indexOf('abrir')>-1||texto.toLowerCase().indexOf('ve a')>-1;
      if(abrir){var m=d.response.match(/https?:\/\/[^\s]+/);if(m&&m[0].indexOf('movilbro-crm')>-1)setTimeout(function(){window.location.href=m[0];},1500);}
    }else{speakText('Error');vaAddChat('Error: '+(d.error||''),'ai');}
    setTimeout(vaEscucharWakeVA,2000);
  }).catch(function(){speakText('Error conexion');setTimeout(vaEscucharWakeVA,2000);});
}
function vaDetener(){vaCerrar();}

</script>
