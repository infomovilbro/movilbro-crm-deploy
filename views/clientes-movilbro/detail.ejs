    }

    var fields = {
      '🏢 SPN': li.spn||li.operatorName||'—',
      '📊 Estado': li.status||li.estado||'—',
      '👤 Titular': li.owner||li.titular||li.customerName||'—',
      '📟 ICCID': iccVal ? '<code>'+iccVal+'</code>' : '<span class="badge bg-secondary">No disponible</span>',
      '🔑 PIN': escPp(pinVal, 'PIN'),
      '🔐 PUK': escPp(pukVal, 'PUK'),
      '💳 Límite crédito': (li.creditLimit||li.credit_limit||'—')+(li.creditLimit?' €':''),
      '📅 Fecha alta': li.startDate||li.created||li.fecha_alta||'—'
    };
    var html = '<div class="row g-2">';
    Object.keys(fields).forEach(function(k){ html += '<div class="col-6 col-md-4"><small class="text-muted">'+k+'</small><div class="fw-bold" style="font-size:0.85rem;">'+fields[k]+'</div></div>'; });
    html += '</div>';
    html += '<div class="mt-2 small text-muted"><i class="bi bi-info-circle"></i> Fuentes: PINPUK API'+(pp.pin? ' ✅': ' ❌')+', LineInfo'+(li.pin? ' ✅': ' ❌')+', SIM'+(sim.pin? ' ✅': ' ❌')+'</div>';
    var tGB = parseFloat(gb.totalGB||gb.total_gb||0);
    if (tGB > 0) {
      var uGB = parseFloat(gb.usedGB||gb.used_gb||0), pct = Math.min(100,(uGB/tGB)*100);
      html += '<hr><h6>📶 GB del período</h6><div class="cons-bar"><div class="cons-bar-fill '+(pct>85?'danger':(pct>60?'warning':''))+'" style="width:'+pct+'%;"></div></div>';
      html += '<div class="small mt-1">'+uGB.toFixed(1)+' / '+tGB.toFixed(1)+' GB ('+pct.toFixed(0)+'%)</div>';
    }
    document.getElementById('cmLineModalBody').innerHTML = html;
  })
  .catch(function(e){ document.getElementById('cmLineModalBody').innerHTML = '<div class="alert alert-danger">Error: '+e.message+'</div>'; });
}

// --- Intenta obtener PIN/PUK de fuentes alternativas ---
function fetchPinPukAlt(line, type, btn) {
  var orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '<div class="spinner-sm"></div>';
  // Probar endpoint alternativo: full-consumption que incluye sim info
  fetch('/clientes-movilbro/'+CM_FISCAL+'/line/'+encodeURIComponent(line)+'/full-consumption',{method:'POST'})
  .then(function(r){return r.json()})
  .then(function(res){
    if (!res.ok) throw new Error(res.error);
    var d = res.data||{}, pp = d.pinpuk||{}, li = d.lineInfo||{}, sim = d.sim||{};
    var val = (type==='pin') ? (pp.pin||pp.pinCode||li.pin||sim.pin||'') : (pp.puk||pp.pukCode||li.puk||sim.puk||'');
    if (val) {
      toast('✅ '+type.toUpperCase()+' obtenido: '+val, 'success');
      showLineDetail(line); // Recargar modal
    } else {
      toast('⚠️ No se pudo obtener '+type.toUpperCase()+' de ninguna fuente', 'warning');
    }
  })
  .catch(function(e){
    toast('Error: '+e.message, 'danger');
  })
  .finally(function(){ btn.disabled = false; btn.innerHTML = orig; });
}

