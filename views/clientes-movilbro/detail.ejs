<!-- ===== JAVASCRIPT ===== -->
<script>
var CM_FISCAL = '<%= fiscalId %>';
var CM_LINES = <%= JSON.stringify(allLines.map(function(l){return l.linea;})) %>;
var modals = {};

function m(id) {
  if (!modals[id]) { var el = document.getElementById(id); if (el) modals[id] = new bootstrap.Modal(el); }
  return modals[id];
}

function toast(msg, type) {
  var d = document.createElement('div');
  d.className = 'alert alert-'+(type||'info')+' alert-dismissible fade show cm-toast';
  d.innerHTML = msg+'<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
  document.body.appendChild(d);
  setTimeout(function(){d.remove();},5000);
}

function err(msg) { toast('⚠️ '+msg, 'danger'); }

function toggleReveal(el) {
  var h = el.querySelector('.rh'), v = el.querySelector('.rv');
  if (h && v) {
    if (h.style.display !== 'none') { h.style.display='none'; v.style.display='inline';
      setTimeout(function(){h.style.display='inline';v.style.display='none';},8000); }
  }
}

// --- FACTURAS EN NUBE (DRIVE) ---
function loadNubeInvoices(fiscalId) {
  var container = document.getElementById('cmNubeInvoices');
  var countBadge = document.getElementById('nubeCount');
  container.innerHTML = '<div class="text-center py-3"><div class="spinner-sm me-2"></div>Buscando en Drive...</div>';
  if (countBadge) countBadge.textContent = '...';
  fetch('/clientes-movilbro/'+encodeURIComponent(fiscalId)+'/drive-invoices')
  .then(function(r){return r.json()})
  .then(function(res){
    if (!res.ok || !res.data || res.data.length===0) {
      container.innerHTML = '<div class="small text-muted py-2"><i class="bi bi-inbox"></i> No se encontraron facturas en Drive para este cliente.</div>';
      if (countBadge) countBadge.textContent = '0';
      return;
    }
    if (countBadge) countBadge.textContent = res.total || res.data.length;
    var totalFiles = res.total || 0;
    var html = '<div class="small text-muted mb-1">'+totalFiles+' archivos encontrados</div><div class="accordion" id="nubeAccordion">';
    res.data.forEach(function(group, idx) {
      var collapseId = 'nubeCollapse'+idx;
      var headingId = 'nubeHeading'+idx;
      var monthNames = { '01':'Enero','02':'Febrero','03':'Marzo','04':'Abril','05':'Mayo','06':'Junio','07':'Julio','08':'Agosto','09':'Septiembre','10':'Octubre','11':'Noviembre','12':'Diciembre' };
      var monthLabel = monthNames[group.month] || group.month;
      html += '<div class="accordion-item" style="border:1px solid #e0e0e0;">'+
        '<h2 class="accordion-header" id="'+headingId+'">'+
          '<button class="accordion-button collapsed small py-2" data-bs-toggle="collapse" data-bs-target="#'+collapseId+'">'+
            '<i class="bi bi-folder me-1"></i> '+group.year+' — '+monthLabel+' <span class="badge bg-secondary ms-2">'+group.files.length+'</span>'+
          '</button></h2>'+
        '<div id="'+collapseId+'" class="accordion-collapse collapse" data-bs-parent="#nubeAccordion">'+
          '<div class="accordion-body p-1">';
      group.files.forEach(function(f) {
        var sizeStr = f.size ? (parseInt(f.size)/1024).toFixed(0)+' KB' : '';
        html += '<div class="d-flex justify-content-between align-items-center px-2 py-1 small" style="border-bottom:1px solid #f0f0f0;">'+
          '<span><i class="bi bi-file-pdf text-danger me-1"></i> '+f.fileName+' <span class="text-muted">'+sizeStr+'</span></span>'+
          '<a href="'+f.link+'" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-1"><i class="bi bi-download"></i></a>'+
        '</div>';
      });
      html += '</div></div></div>';
    });
    html += '</div>';
    container.innerHTML = html;
  })
  .catch(function(e){
    container.innerHTML = '<div class="alert alert-danger small py-1">Error: '+e.message+'</div>';
    if (countBadge) countBadge.textContent = 'err';
  });
}

// --- SCORING ---
function calculateScoring(fiscalId) {
  m('cmScoringModal').show();
  document.getElementById('scoringResult').innerHTML = '<div class="text-center py-4"><div class="spinner-sm me-2"></div>Calculando...</div>';
  fetch('/clientes-movilbro/'+fiscalId+'/calculate-scoring',{method:'POST'})
  .then(function(r){return r.json()})
  .then(function(res){
    if (!res.ok) { document.getElementById('scoringResult').innerHTML = '<div class="alert alert-danger">'+(res.error||'Error')+'</div>'; return; }
    var riskColor = res.risk==='bajo'?'success':(res.risk==='alto'?'danger':'warning');
    var riskIcon = res.risk==='bajo'?'✅':(res.risk==='alto'?'⚠️':'➡️');
    var fiab = res.fiable ? '<span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-check-circle"></i> FIABLE</span>' : '<span class="badge bg-danger fs-6 px-3 py-2"><i class="bi bi-exclamation-triangle"></i> NO FIABLE</span>';
    var html =
      '<div class="text-center mb-3">'+
        '<div class="d-inline-block" style="width:120px;height:120px;border-radius:50%;background:conic-gradient('+(res.risk==='bajo'?'#28a745':'#dc3545')+' '+(res.scoring*10)+'%,#eee '+(res.scoring*10)+'%);display:flex;align-items:center;justify-content:center;margin:0 auto;">'+
          '<div style="width:90px;height:90px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column;">'+
            '<span style="font-size:1.8rem;font-weight:700;color:'+(res.risk==='bajo'?'#28a745':'#dc3545')+';">'+res.scoring+'</span>'+
            '<span style="font-size:0.65rem;color:#888;">/ 10</span>'+
          '</div>'+
        '</div>'+
        '<div class="mt-2">'+fiab+'</div>'+
        '<div class="mt-1"><span class="badge bg-'+riskColor+' px-3 py-1">'+riskIcon+' Riesgo '+res.risk.toUpperCase()+'</span></div>'+
      '</div>'+
      '<div class="small text-muted mb-2">'+res.recomendacion+'</div>'+
      '<hr><h6 class="small fw-bold">Detalles del cálculo:</h6><ul class="small mb-0">';
    if (Array.isArray(res.detalles)) {
      res.detalles.forEach(function(d){ html += '<li>'+d+'</li>'; });
    }
    html += '</ul>';
    document.getElementById('scoringResult').innerHTML = html;
  })
  .catch(function(e){ document.getElementById('scoringResult').innerHTML = '<div class="alert alert-danger">Error: '+e.message+'</div>'; });
}

// --- AGRUPA CDRs por día ---
function groupCDRsByDay(cdrs) {
  var groups = {};
  cdrs.forEach(function(c) {
    var fecha = (c.fecha||c.date||c.startTime||c.start_date||'').substring(0,10);
    if (!fecha) return;
    if (!groups[fecha]) groups[fecha] = { date: fecha, calls: 0, sms: 0, duration: 0, count: 0 };
    groups[fecha].count++;
    var tipo = (c.tipo||c.type||c.callType||c.call_type||'').toLowerCase();
    var dur = parseInt(c.duracion||c.duration||0);
    if (isNaN(dur)) dur = 0;
    if (tipo.includes('sms')||tipo.includes('mensaje')||tipo.includes('texto')||tipo==='mt'||tipo==='mo') {
      groups[fecha].sms++;
    } else if (tipo.includes('llam')||tipo.includes('call')||tipo.includes('voz')||tipo.includes('voice')||tipo==='') {
      groups[fecha].calls++;
      groups[fecha].duration += dur;
    } else {
      groups[fecha].calls++;
      groups[fecha].duration += dur;
    }
  });
  var result = [];
  Object.keys(groups).sort().forEach(function(k){ result.push(groups[k]); });
  return result;
}

// --- RENDERIZA GRÁFICO DE BARRAS CSS ---
function renderBarChart(data, labelKey, valueKey, labelUnit, maxVal, color) {
  if (!data || data.length===0) return '<div class="cm-empty">No hay datos</div>';
  var max = maxVal || Math.max.apply(null, data.map(function(d){ return d[valueKey]||0; })) || 1;
  var html = '<div style="display:flex;align-items:flex-end;gap:3px;height:140px;padding:10px 0;overflow-x:auto;">';
  data.forEach(function(d){
    var val = d[valueKey]||0;
    var pct = Math.min(100, (val/max)*100);
    var barH = Math.max(4, pct);
    var lbl = d[labelKey];
    if (lbl && lbl.length>10) lbl = lbl.substring(5);
    html += '<div style="flex:1;min-width:18px;display:flex;flex-direction:column;align-items:center;">';
    html += '<div style="font-size:0.6rem;color:#666;margin-bottom:2px;">'+(val>0?val.toFixed(val%1===0?0:1):'')+'</div>';
    html += '<div style="width:100%;height:'+barH+'px;background:'+color+';border-radius:3px 3px 0 0;opacity:0.8;transition:height 0.3s;"></div>';
    html += '<div style="font-size:0.55rem;color:#999;margin-top:2px;transform:rotate(-45deg);white-space:nowrap;">'+lbl+'</div>';
    html += '</div>';
  });
  html += '</div>';
  return html;
}

// --- ALMACÉN DE DATOS DE CONSUMO PARA NAVEGACIÓN MENSUAL ---
var CONSUMO_CACHE = {};
var CONSUMO_MONTH_OFFSET = 0;

function getMonthFilter(offset) {
  var d = new Date();
  d.setMonth(d.getMonth() + (offset||0));
  return { year: d.getFullYear(), month: String(d.getMonth()+1).padStart(2,'0'), label: d.toLocaleString('es',{month:'long',year:'numeric'}) };
}

function filterCDRsByMonth(cdrs, year, month) {
  if (!Array.isArray(cdrs) || !cdrs.length) return [];
  var prefix = year+'-'+month;
  return cdrs.filter(function(c) {
    var fecha = (c.fecha||c.date||c.startTime||c.start_date||'').substring(0,7);
    return fecha === prefix;
  });
}

function getUniqueMonths(cdrs) {
  var months = {};
  cdrs.forEach(function(c) {
    var m = (c.fecha||c.date||c.startTime||c.start_date||'').substring(0,7);
    if (m) months[m] = true;
  });
  return Object.keys(months).sort();
}

function navConsumoMonth(direction) {
  CONSUMO_MONTH_OFFSET += direction;
  var line = window._consLine;
  if (!line || !CONSUMO_CACHE[line]) { CONSUMO_MONTH_OFFSET = 0; return; }
  var cache = CONSUMO_CACHE[line];
  renderConsumoData(cache.data, line, cache.idx, cache.cdrs);
}

// --- RENDERIZA CONSUMO COMPLETO (GB + Llamadas + SMS + Resumen) ---
function renderConsumoData(d, line, idx, cdrs) {
  var pp = d.pinpuk||{}, li = d.lineInfo||{}, gb = d.gb||{}, svas = Array.isArray(d.svas)?d.svas:[];
  var tGB = parseFloat(gb.totalGB||gb.total_gb||0), uGB = parseFloat(gb.usedGB||gb.used_gb||0), rGB = parseFloat(gb.remainingGB||gb.remaining_gb||0), roamGB = parseFloat(gb.roamingGB||gb.roaming_gb||0);
  var hasCDRs = Array.isArray(cdrs) && cdrs.length > 0;

  // Filtrar CDRs por mes seleccionado
  var mf = getMonthFilter(CONSUMO_MONTH_OFFSET);
  var filteredCDRs = hasCDRs ? filterCDRsByMonth(cdrs, mf.year, mf.month) : [];
  var hasFiltered = filteredCDRs.length > 0;
  var daily = hasFiltered ? groupCDRsByDay(filteredCDRs) : [];

  // Obtener meses únicos de todos los CDRs para navegación
  var allMonths = hasCDRs ? getUniqueMonths(cdrs) : [];
  var canPrev = CONSUMO_MONTH_OFFSET > -12;
  var canNext = CONSUMO_MONTH_OFFSET < 12;

  var html = '';

  // Cards info
  html += '<div class="row g-2 mb-2">';
  html += '<div class="col-3"><div class="cm-card-stat"><div class="cm-stat-label">PIN</div><div class="h5 mb-0"><span class="pinpuk-toggle" onclick="toggleReveal(this)"><code class="rh" style="cursor:pointer;font-size:1rem;">••••</code><code class="rv" style="display:none;font-size:1rem;">'+(pp.pin||li.pin||'—')+'</code></span></div></div></div>';
  html += '<div class="col-3"><div class="cm-card-stat"><div class="cm-stat-label">PUK</div><div class="h5 mb-0"><span class="pinpuk-toggle" onclick="toggleReveal(this)"><code class="rh" style="cursor:pointer;font-size:1rem;">•••••••</code><code class="rv" style="display:none;font-size:1rem;">'+(pp.puk||li.puk||'—')+'</code></span></div></div></div>';
  html += '<div class="col-3"><div class="cm-card-stat"><div class="cm-stat-label">📟 ICCID</div><div class="h6 mb-0"><code>'+(pp.icc||li.icc||li.iccid||'—')+'</code></div></div></div>';
  html += '<div class="col-3"><div class="cm-card-stat"><div class="cm-stat-label">🏢 SPN</div><div class="h6 mb-0">'+(li.spn||li.operatorName||'—')+'</div></div></div>';
  html += '</div>';

  // Navegación mensual
  html += '<div class="d-flex justify-content-between align-items-center mb-2 bg-light rounded p-1">';
  html += '<button class="btn btn-sm '+(canPrev?'btn-outline-secondary':'btn-outline-light disabled')+'" onclick="navConsumoMonth(-1)">← Anterior</button>';
  html += '<span class="fw-bold small">'+mf.label+(hasFiltered&&filteredCDRs.length!==cdrs.length?' <span class="badge bg-info">'+filteredCDRs.length+' registros</span>':'')+'</span>';
  html += '<button class="btn btn-sm '+(canNext?'btn-outline-secondary':'btn-outline-light disabled')+'" onclick="navConsumoMonth(1)">Siguiente →</button>';
  html += '</div>';

  // Tabs: GB, Llamadas, SMS, Resumen
  html += '<ul class="nav nav-tabs cm-tabs mb-3" id="consTabs" role="tablist">';
  html += '<li class="nav-item"><button class="nav-link active" id="ctab-gb" data-bs-toggle="tab" data-bs-target="#ccont-gb" role="tab"><i class="bi bi-wifi"></i> GB</button></li>';
  if (hasFiltered) {
    html += '<li class="nav-item"><button class="nav-link" id="ctab-calls" data-bs-toggle="tab" data-bs-target="#ccont-calls" role="tab"><i class="bi bi-telephone"></i> Llamadas <span class="badge bg-secondary">'+daily.reduce(function(s,d){return s+d.calls;},0)+'</span></button></li>';
    html += '<li class="nav-item"><button class="nav-link" id="ctab-sms" data-bs-toggle="tab" data-bs-target="#ccont-sms" role="tab"><i class="bi bi-chat-dots"></i> SMS <span class="badge bg-secondary">'+daily.reduce(function(s,d){return s+d.sms;},0)+'</span></button></li>';
    html += '<li class="nav-item"><button class="nav-link" id="ctab-todos" data-bs-toggle="tab" data-bs-target="#ccont-todos" role="tab"><i class="bi bi-list-ul"></i> Todos</button></li>';
  }
  html += '<li class="nav-item"><button class="nav-link" id="ctab-resumen" data-bs-toggle="tab" data-bs-target="#ccont-resumen" role="tab"><i class="bi bi-graph-up"></i> Resumen</button></li>';
  html += '</ul>';

  html += '<div class="tab-content">';

  // ===== TAB GB =====
  html += '<div class="tab-pane fade show active" id="ccont-gb" role="tabpanel">';
  if (tGB > 0) {
    var pct = Math.min(100,(uGB/tGB)*100), cls = pct>85?'danger':(pct>60?'warning':'');
    html += '<div class="row g-2 mb-3">';
    html += '<div class="col-4"><div class="cm-card-stat"><div class="cm-stat-label">Total</div><div class="h3 mb-0 fw-bold">'+tGB.toFixed(1)+' <small>GB</small></div></div></div>';
    html += '<div class="col-4"><div class="cm-card-stat"><div class="cm-stat-label">Usados</div><div class="h3 mb-0 fw-bold text-'+(pct>85?'danger':(pct>60?'warning':'success'))+'">'+uGB.toFixed(1)+' <small>GB</small></div></div></div>';
    html += '<div class="col-4"><div class="cm-card-stat"><div class="cm-stat-label">Restantes</div><div class="h3 mb-0 fw-bold">'+rGB.toFixed(1)+' <small>GB</small></div></div></div>';
    html += '</div>';
    html += '<div class="cons-bar mb-2" style="height:16px;"><div class="cons-bar-fill '+cls+'" style="width:'+pct+'%;height:16px;"></div></div>';
    html += '<div class="d-flex justify-content-between small text-muted">';
    html += '<span>'+pct.toFixed(0)+'% consumido</span>';
    html += '<span>'+(roamGB>0?'🌍 Roaming: '+roamGB.toFixed(1)+' GB':'')+'</span>';
    html += '</div>';

    var barEl = document.getElementById('gbMiniBar_'+idx);
    var usedEl = document.getElementById('gbMiniUsed_'+idx);
    var totalEl = document.getElementById('gbMiniTotal_'+idx);
    var container = document.getElementById('gbMini_'+idx);
    if (barEl && usedEl && totalEl && container) {
      usedEl.textContent = uGB.toFixed(1)+' GB';
      totalEl.textContent = tGB.toFixed(1)+' GB';
      barEl.style.width = pct+'%';
      barEl.className = 'cons-bar-fill '+cls;
      container.style.display = 'block';
    }
  } else {
    html += '<div class="alert alert-light small py-3 text-center">No hay datos de GB disponibles para este período.</div>';
  }
  html += '</div>'; // end GB tab

  if (hasFiltered) {
    // ===== TAB LLAMADAS =====
    html += '<div class="tab-pane fade" id="ccont-calls" role="tabpanel">';
    html += '<h6 class="fw-bold mb-2"><i class="bi bi-telephone"></i> Llamadas por día</h6>';
    html += renderBarChart(daily, 'date', 'calls', 'llamadas', null, '#2196f3');
    html += '<h6 class="fw-bold mt-3 mb-2"><i class="bi bi-clock"></i> Duración por día (minutos)</h6>';
    html += renderBarChart(daily, 'date', 'duration', 'min', null, '#9c27b0');
    html += '</div>';

    // ===== TAB SMS =====
    html += '<div class="tab-pane fade" id="ccont-sms" role="tabpanel">';
    html += '<h6 class="fw-bold mb-2"><i class="bi bi-chat-dots"></i> SMS por día</h6>';
    html += renderBarChart(daily, 'date', 'sms', 'sms', null, '#4caf50');
    html += '</div>';

    // ===== TAB TODOS (tabla completa) =====
    html += '<div class="tab-pane fade" id="ccont-todos" role="tabpanel">';
    html += '<div class="table-responsive" style="max-height:400px;overflow-y:auto;"><table class="table table-sm table-hover"><thead class="table-light"><tr><th>📅 Fecha</th><th>📞 Tipo</th><th>🎯 Destino</th><th>⏱️ Duración</th><th>💰 Coste</th></tr></thead><tbody>';
    filteredCDRs.slice(0,500).forEach(function(c){
      var fecha = c.fecha||c.date||c.startTime||c.start_date||'';
      var tipo = c.tipo||c.type||c.callType||c.call_type||'—';
      var dest = c.destino||c.destination||c.calledNumber||c.called||c.numero||'—';
      var dur = c.duracion||c.duration||'';
      if (dur) { var segs=parseInt(dur); if(!isNaN(segs)) dur=Math.floor(segs/60)+'m '+(segs%60)+'s'; }
      var cost = c.coste||c.cost||c.price||c.importe||'';
      if (cost) cost = parseFloat(cost).toFixed(4)+' €';
      html += '<tr><td>'+fecha.substring(0,16)+'</td><td>'+tipo+'</td><td>'+dest+'</td><td>'+dur+'</td><td>'+cost+'</td></tr>';
    });
    html += '</tbody></table></div>';
    if (filteredCDRs.length>500) html += '<div class="small text-muted">Mostrando 500 de '+filteredCDRs.length+' registros.</div>';
    html += '</div>'; // end todos tab
  }

  // ===== TAB RESUMEN =====
  html += '<div class="tab-pane fade" id="ccont-resumen" role="tabpanel">';

  // Summary card
  html += '<div class="row g-2 mb-3">';
  if (tGB > 0) {
    var pct = Math.min(100,(uGB/tGB)*100), cls = pct>85?'danger':(pct>60?'warning':'');
    html += '<div class="col-6 col-md-3"><div class="cm-card-stat"><div class="cm-stat-label">📶 GB</div><div class="h4 mb-0">'+uGB.toFixed(1)+' / '+tGB.toFixed(1)+' GB</div><small class="text-'+(cls||'success')+'">'+pct.toFixed(0)+'%</small></div></div>';
  }
  if (hasFiltered) {
    var totMin = Math.floor(daily.reduce(function(s,d){return s+d.duration;},0)/60);
    html += '<div class="col-6 col-md-3"><div class="cm-card-stat"><div class="cm-stat-label">📞 Llamadas</div><div class="h4 mb-0">'+daily.reduce(function(s,d){return s+d.calls;},0)+'</div></div></div>';
    html += '<div class="col-6 col-md-3"><div class="cm-card-stat"><div class="cm-stat-label">💬 SMS</div><div class="h4 mb-0">'+daily.reduce(function(s,d){return s+d.sms;},0)+'</div></div></div>';
    html += '<div class="col-6 col-md-3"><div class="cm-card-stat"><div class="cm-stat-label">⏱️ Hablado</div><div class="h5 mb-0">'+totMin+' min</div></div></div>';
  }
  html += '</div>';

  // SVA services
  if (svas.length > 0) {
    html += '<h6 class="fw-bold mt-2"><i class="bi bi-toggles me-1"></i> Servicios (SVA)</h6><div class="d-flex flex-wrap gap-1">';
    svas.forEach(function(s){
      var name = s.name||s.type||s.service||s.code||'—';
      var st = s.status||s.estado||'';
      var active = st==='ACTIVE'||st==='active'||st==='Activo'||st==='true'||s.active===true;
      html += '<span class="cm-sva-chip '+(active?'active':'inactive')+'" title="'+(active?'Activo':'Inactivo')+'">'+(active?'✅ ':'⬜ ')+name+'</span>';
    });
    html += '</div>';
  }

  if (li.creditLimit || li.credit_limit) {
    html += '<div class="mt-2 p-2 bg-light rounded small"><i class="bi bi-credit-card"></i> Límite crédito: <strong>'+(li.creditLimit||li.credit_limit)+' €</strong></div>';
  }

  html += '</div>'; // end resumen tab

  html += '</div>'; // end tab-content

  document.getElementById('cmConsumoModalBody').innerHTML = html;
  document.getElementById('cmConsumoContent').innerHTML = html;
}

// --- CARGA CONSUMO + CDRs (Full Dashboard) usando /full-consumption ---
function loadLineInfo(line, idx) {
  document.getElementById('cmConsumoModalTitle').textContent = '📊 '+line;
  document.getElementById('cmConsumoContent').innerHTML = '<div class="text-center py-4"><div class="spinner-sm me-2"></div>Cargando...</div>';
  document.getElementById('cmConsumoModalBody').innerHTML = '<div class="text-center py-4"><div class="spinner-sm me-2"></div>Cargando...</div>';
  CONSUMO_MONTH_OFFSET = 0;
  window._consLine = line;
  m('cmConsumoModal').show();

  var cached = CM_ALL_LINES_DATA && CM_ALL_LINES_DATA[line];
  if (cached && (cached.gb || cached.svas.length > 0)) {
    CONSUMO_CACHE[line] = { data: cached, cdrs: [], idx: idx };
    renderConsumoData(cached, line, idx, []);
  }

  fetch('/clientes-movilbro/'+CM_FISCAL+'/line/'+encodeURIComponent(line)+'/full-consumption',{method:'POST'})
  .then(function(r){return r.json()})
  .then(function(res){
    if (!res.ok) throw new Error(res.error||'Error');
    var data = res.data||{};
    var cdrs = Array.isArray(data.cdrs)?data.cdrs:[];
    // Merge data with cached if available
    var merged = data;
    if (cached) {
      if (!merged.gb) merged.gb = cached.gb;
      if (!merged.svas || !merged.svas.length) merged.svas = cached.svas;
    }
    CONSUMO_CACHE[line] = { data: merged, cdrs: cdrs, idx: idx, line: line };
    renderConsumoData(merged, line, idx, cdrs);
  })
  .catch(function(e){
    // Fallback: fetch separately
    Promise.all([
      fetch('/clientes-movilbro/'+CM_FISCAL+'/line/'+encodeURIComponent(line)+'/info',{method:'POST'}).then(function(r){return r.json();}),
      fetch('/clientes-movilbro/'+CM_FISCAL+'/line/'+encodeURIComponent(line)+'/cdrs',{method:'POST'}).then(function(r){return r.json();})
    ])
    .then(function(results) {
      var infoRes = results[0], cdrsRes = results[1];
      var infoData = (infoRes && infoRes.ok) ? (infoRes.data||{}) : {};
      var cdrsData = (cdrsRes && cdrsRes.ok && Array.isArray(cdrsRes.data)) ? cdrsRes.data : [];
      CONSUMO_CACHE[line] = { data: infoData, cdrs: cdrsData, idx: idx, line: line };
      renderConsumoData(infoData, line, idx, cdrsData);
    })
    .catch(function(e2){
      document.getElementById('cmConsumoModalBody').innerHTML = '<div class="alert alert-danger">Error: '+(e2.message||'Error al cargar datos')+'</div>';
    });
  });
}

