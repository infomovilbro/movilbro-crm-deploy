    <button class="btn btn-sm btn-outline-success" onclick="showKYCUpload()">
      <i class="bi bi-upload"></i> Subir documento
    </button>
    <div id="kycUploadPanel" style="display:none;margin-top:8px;">
      <select id="kycDocType" class="form-select form-select-sm mb-2">
        <option value="obverseDocument">Anverso DNI</option>
