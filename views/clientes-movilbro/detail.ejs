function submitChangeTariff() {
  var line = document.getElementById('cmChangeTariffModal').dataset.line;
  var product = document.getElementById('cmChangeTariffProduct').value;
  if (!product) { err('Selecciona una tarifa'); return; }
  if (!confirm('¿Cambiar tarifa de '+line+' a '+product+'?')) return;
  var btn = document.querySelector('#cmChangeTariffModal .btn-primary');
  btn.disabled = true; btn.innerHTML = '<div class="spinner-sm me-1"></div>Enviando...';
  fetch('/clientes-movilbro/'+CM_FISCAL+'/line/'+encodeURIComponent(line)+'/change-tariff',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ newProductId: product, productId: product })
  })
  .then(function(r){return r.json()})
  .then(function(res){
    if (res.ok) { toast('✅ Cambio de tarifa solicitado','success'); m('cmChangeTariffModal').hide(); }
