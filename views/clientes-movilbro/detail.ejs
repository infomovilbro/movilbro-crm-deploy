function submitKYCUpload(fiscalId) {
  var fileInput = document.getElementById('kycFileInput2');
  var tipo = document.getElementById('kycDocType').value;
  var file = fileInput.files && fileInput.files[0];
  if (!file) { err('Selecciona un archivo'); return; }
  var btn = document.querySelector('#kycUploadPanel .btn-primary');
  var resultDiv = document.getElementById('kycUploadResult');
  var origText = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '<div class="spinner-sm me-1"></div>Subiendo...';
  resultDiv.innerHTML = '';
  var fd = new FormData();
  fd.append('file', file);
  fd.append('tipo', tipo);
  fetch('/clientes-movilbro/' + encodeURIComponent(fiscalId) + '/upload-kyc', { method: 'POST', body: fd })
  .then(function(r){return r.json()})
  .then(function(res){
    if (res.ok) {
      resultDiv.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Subido: ' + (res.apiOk ? 'API + Drive' : 'Drive') + '</span>';
      toast('✅ Documento ' + tipo + ' subido correctamente', 'success');
      fileInput.value = '';
    } else {
      resultDiv.innerHTML = '<span class="text-danger">' + (res.error || 'Error') + '</span>';
    }
    btn.disabled = false; btn.innerHTML = origText;
  })
  .catch(function(e){ err(e.message); btn.disabled = false; btn.innerHTML = origText; });
}

// --- SUBIR DOCUMENTO KYC ---
function uploadKycDoc(tipo, btn) {
  var input = document.getElementById('cmFileInput');
  input.accept = 'image/*';
  input.onchange = function() {
    var file = input.files && input.files[0];
    if (!file) return;
    var origText = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = '<div class="spinner-sm me-1"></div>Subiendo...';
    var fd = new FormData();
    fd.append('file', file);
    fd.append('tipo', tipo);
    fetch('/clientes-movilbro/'+CM_FISCAL+'/upload-kyc', { method: 'POST', body: fd })
    .then(function(r){return r.json()})
    .then(function(res){
      if (res.ok) {
        toast('✅ Documento subido: ' + (res.apiOk ? 'API + Drive' : 'Drive'), 'success');
        // Recargar fila si existe
        var existingRow = document.querySelector('#kycDocsTable tr[data-kyc-type="'+tipo+'"]');
        if (existingRow) {
          var actionCell = existingRow.querySelector('td:last-child');
          if (actionCell) actionCell.innerHTML = '<span class="text-success small"><i class="bi bi-check-circle"></i> Subido</span>';
        } else {
          // Añadir nueva fila
          var tbody = document.querySelector('#kycDocsTable tbody');
          if (tbody) {
            var tr = document.createElement('tr');
            tr.dataset.kycType = tipo;
            tr.innerHTML = '<td>'+tipo+'</td><td><code>'+file.name+'</code></td><td><span class="text-success small"><i class="bi bi-check-circle"></i> Subido'+(res.driveLink?' <a href="'+res.driveLink+'" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>':'')+'</span></td>';
            tbody.appendChild(tr);
          }
        }
        // Ocultar botón correspondiente en kycUploadButtons
        var btns = document.querySelectorAll('#kycUploadButtons button');
        btns.forEach(function(b) { if (b.textContent.includes(tipo) || b.textContent.includes(file.name) || (tipo==='obverseDocument' && b.textContent.includes('anverso')) || (tipo==='reverseDocument' && b.textContent.includes('reverso')) || (tipo==='obverseFace' && b.textContent.includes('Selfie'))) b.style.display='none'; });
      } else {
        err(res.error || 'Error al subir');
      }
      btn.disabled = false; btn.innerHTML = origText;
    })
    .catch(function(e){ err(e.message); btn.disabled = false; btn.innerHTML = origText; });
  };
  input.value = '';
  input.click();
}

// --- OBTENER PARTE DE TRABAJO (instalaciones) ---
function fetchWorkOrder(fiscalId, installId, btn) {
  var orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '<div class="spinner-sm me-1"></div>Descargando...';
  fetch('/clientes-movilbro/'+encodeURIComponent(fiscalId)+'/installation/'+encodeURIComponent(installId)+'/work-order',{method:'POST'})
  .then(function(r){return r.json()})
  .then(function(res){
    if (!res.ok) throw new Error(res.error||'No disponible');
    var wo = res.data;
    // Si la API devuelve URL, abrirla
    var url = wo.url || wo.downloadUrl || wo.parteUrl || wo.link || '';
    if (url) {
      window.open(url, '_blank');
      toast('✅ Parte de trabajo disponible', 'success');
      btn.innerHTML = '<i class="bi bi-file-pdf"></i> Ver parte';
      btn.onclick = function(){ window.open(url, '_blank'); };
    } else {
      // Intentar mostrar datos del parte
      var html = '<div class="alert alert-info small py-1">Datos del parte recibidos. Revisa la consola.</div>';
      btn.parentElement.insertAdjacentHTML('beforeend', html);
      console.log('[WorkOrder]', wo);
      toast('⚠️ Parte recibido sin URL de descarga', 'warning');
      btn.innerHTML = orig;
    }
  })
  .catch(function(e){
    toast('⚠️ '+e.message, 'warning');
    btn.innerHTML = orig;
  })
  .finally(function(){ btn.disabled = false; });
}

