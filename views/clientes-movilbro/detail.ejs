<section>
<style>
.cm-header { background:linear-gradient(135deg,#f8f9fa 0%,#e9ecef 100%);border-radius:12px;padding:20px;margin-bottom:20px; }
.cm-header h2 { margin:0;font-size:1.4rem;font-weight:700; }
.cm-header .cm-sub { color:#666;font-size:0.85rem; }
.cm-card-stat { border-radius:10px;border:1px solid #e0e0e0;padding:14px;background:#fff;text-align:center; }
.cm-card-stat .cm-stat-value { font-size:1.5rem;font-weight:700;color:var(--primary,#0050A1); }
.cm-card-stat .cm-stat-label { font-size:0.7rem;color:#888;text-transform:uppercase;letter-spacing:0.5px; }
.cm-line-card { border-left:4px solid var(--primary,#0050A1);border-radius:8px;padding:14px;margin-bottom:10px;background:#fff;border:1px solid #e0e0e0;border-left-width:4px; }
.cm-line-card .cm-line-num { font-size:1.05rem;font-weight:600; }
.cm-badge-line { display:inline-block;padding:1px 8px;border-radius:8px;font-size:0.7rem;font-weight:600; }
.cm-badge-line.active { background:#e8f5e9;color:#2e7d32; }
.cm-badge-line.suspended { background:#fff3e0;color:#e65100; }
.cm-badge-line.blocked { background:#fce4ec;color:#c62828; }
.cons-bar { height:8px;background:#e0e0e0;border-radius:4px;overflow:hidden; }
.cons-bar-fill { height:100%;background:linear-gradient(90deg,#4caf50,#8bc34a);border-radius:4px;transition:width 0.5s; }
.cons-bar-fill.warning { background:linear-gradient(90deg,#ff9800,#ffc107); }
.cons-bar-fill.danger { background:linear-gradient(90deg,#f44336,#e57373); }
.cm-tabs .nav-link { color:#555;font-size:0.82rem;padding:8px 12px; }
.cm-tabs .nav-link.active { font-weight:600;color:var(--primary,#0050A1);border-bottom-color:var(--primary,#0050A1); }
.cm-section-title { font-size:0.9rem;font-weight:600;color:#444;margin:18px 0 10px;padding-bottom:6px;border-bottom:1px solid #eee; }
.pinpuk-toggle { cursor:pointer;user-select:none; }
.pinpuk-toggle:hover { opacity:0.7; }
.cm-empty { text-align:center;padding:30px;color:#999; }
.cm-modal .modal-header { background:var(--primary,#0050A1);color:#fff; }
.cm-modal .modal-header .btn-close { filter:brightness(0) invert(1); }
.spinner-sm { display:inline-block;width:14px;height:14px;border:2px solid #ddd;border-top-color:var(--primary);border-radius:50%;animation:spin 0.6s linear infinite;vertical-align:middle; }
@keyframes spin { to { transform:rotate(360deg); } }
.cm-badge-link { font-size:0.65rem;padding:1px 6px;border-radius:4px;background:#e3f2fd;color:#1565c0;cursor:pointer; }
.cm-badge-link:hover { background:#bbdefb; }
.cm-line-actions .btn { font-size:0.7rem;padding:2px 8px; }
.cm-sva-chip { display:inline-block;padding:2px 8px;border-radius:12px;font-size:0.7rem;margin:2px;border:1px solid #ddd;cursor:pointer; }
.cm-sva-chip.active { background:#e8f5e9;border-color:#4caf50;color:#2e7d32; }
.cm-sva-chip.inactive { background:#f5f5f5;border-color:#ccc;color:#999; }
.cm-toast { position:fixed;top:70px;right:20px;z-index:9999;max-width:400px; }
.cm-line-terminated { opacity:0.45;border-left-color:#999!important;filter:grayscale(0.5); }
.cm-line-terminated .cm-line-num { text-decoration:line-through; }
.cm-line-activa { border-left-color:var(--primary,#0050A1); }
.cm-daily-bar { flex:1;min-width:20px;display:flex;flex-direction:column;align-items:center; }
.cm-daily-bar .bar { width:100%;border-radius:3px 3px 0 0;opacity:0.85;transition:height 0.3s;cursor:pointer; }
.cm-daily-bar .bar:hover { opacity:1; }
.cm-daily-bar .bar-label { font-size:0.55rem;color:#999;margin-top:2px;transform:rotate(-45deg);white-space:nowrap; }
.cm-daily-bar .bar-val { font-size:0.6rem;color:#666;margin-bottom:2px; }
.cm-month-nav .btn { font-size:0.75rem;padding:2px 10px; }
</style>

<%
function fmtDate(d) { return d ? d.substring(0,10) : '—'; }
function fmtCurr(n) { return (parseFloat(n)||0).toFixed(2)+' €'; }
function lineBadge(st) {
  var s=(st||'').toLowerCase();
  if(s==='active'||s==='activa'||s==='activo') return '<span class="cm-badge-line active">Activa</span>';
  if(s==='suspended'||s==='suspendida') return '<span class="cm-badge-line suspended">Suspendida</span>';
  if(s==='blocked'||s==='bloqueada') return '<span class="cm-badge-line blocked">Bloqueada</span>';
  return '<span class="cm-badge-line" style="background:#f5f5f5;color:#666;">'+(st||'—')+'</span>';
}
%>

<!-- HEADER CLIENTE -->
<div class="cm-header">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
      <h2><i class="bi bi-person-circle me-2"></i><%= customer.name || customer.firstName + ' ' + customer.lastName || fiscalId %></h2>
      <div class="cm-sub">
        <span class="me-3"><i class="bi bi-person-badge"></i> <strong><%= customer.fiscalId || fiscalId %></strong></span>
        <% if (customer.phone) { %><span class="me-3"><i class="bi bi-telephone"></i> <a href="https://wa.me/34<%= customer.phone.replace(/\D/g,'') %>" target="_blank"><%= customer.phone %></a></span><% } %>
        <% if (customer.email) { %><span class="me-3"><i class="bi bi-envelope"></i> <a href="mailto:<%= customer.email %>"><%= customer.email %></a></span><% } %>
        <span class="badge bg-light text-dark ms-1"><%= customer.customerType === 'Residential' ? 'Particular' : customer.customerType %></span>
        <% if (customer.scoring) { %><span class="badge bg-info ms-1"><i class="bi bi-graph-up"></i> Scoring: <%= customer.scoring %></span><% } %>
        <% if (customer.aeatStatus) { %><span class="badge bg-warning text-dark ms-1"><i class="bi bi-building"></i> AEAT: <%= customer.aeatStatus %></span><% } %>
      </div>
    </div>
    <div class="d-flex gap-1 flex-wrap">
      <a href="/clientes?search=<%= encodeURIComponent(customer.fiscalId || fiscalId) %>" class="btn btn-sm btn-outline-secondary" title="Ver en Panel Clientes original"><i class="bi bi-box-arrow-up-right"></i> Ficha antigua</a>
      <% if (customer.phone) { %><a href="https://wa.me/34<%= customer.phone.replace(/\D/g,'') %>" target="_blank" class="btn btn-sm btn-success"><i class="bi bi-whatsapp"></i></a><% } %>
      <% if (customer.email) { %><a href="mailto:<%= customer.email %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-envelope"></i></a><% } %>
      <button class="btn btn-sm btn-outline-warning" onclick="openTicketModal()"><i class="bi bi-ticket"></i> Ticket</button>
    </div>
  </div>
</div>

<!-- CARDS RESUMEN -->
<div class="row g-2 mb-3">
  <div class="col-6 col-md-3">
    <div class="cm-card-stat">
      <div class="cm-stat-label"><i class="bi bi-phone"></i> Líneas</div>
      <div class="cm-stat-value"><%= allLines.filter(function(l){return l.estado==='active'||l.estado==='activa';}).length %></div>
      <small class="text-muted"><%= (typeof allLinesFull !== 'undefined' && allLinesFull.length > 0 ? allLinesFull : allLines).length %> total</small>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="cm-card-stat">
      <div class="cm-stat-label"><i class="bi bi-receipt"></i> Facturas</div>
      <div class="cm-stat-value"><%= invoices.length %></div>
      <small class="text-muted">API</small>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="cm-card-stat">
      <div class="cm-stat-label"><i class="bi bi-cart"></i> Órdenes</div>
      <div class="cm-stat-value"><%= orders.length %></div>
      <small class="text-muted"><%= orders.filter(function(o){return o.status==='COMPLETED';}).length %> completadas</small>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="cm-card-stat">
      <div class="cm-stat-label"><i class="bi bi-tools"></i> Instalaciones</div>
      <div class="cm-stat-value"><%= installations.length %></div>
      <small class="text-muted"><%= installations.filter(function(i){var s=(i.status||'').toLowerCase();return s==='completed'||s==='completada'||s==='realizada';}).length %> realizadas</small>
    </div>
  </div>
</div>

<!-- SCORING / MOROSIDAD -->
<div class="row g-2 mb-3">
  <div class="col-12">
    <div class="cm-card-stat d-flex justify-content-between align-items-center p-3" id="scoringCardBody" style="border-left:4px solid <%= customer.scoring && parseFloat(customer.scoring) >= 7 ? '#28a745' : (customer.scoring && parseFloat(customer.scoring) >= 4 ? '#ffc107' : '#dc3545') %>;">
      <div>
        <div class="cm-stat-label text-start"><i class="bi bi-shield-check"></i> Solvencia / Morosidad</div>
        <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
          <span class="text-muted small"><i class="bi bi-person-badge"></i> <strong><%= fiscalId %></strong></span>
          <% if (customer.scoring) { %>
          <span class="badge bg-<%= parseFloat(customer.scoring) >= 7 ? 'success' : (parseFloat(customer.scoring) >= 4 ? 'warning' : 'danger') %>" style="font-size:0.85rem;">
            <i class="bi bi-graph-up"></i> Score: <%= customer.scoring %>/10
          </span>
          <span class="badge bg-<%= customer.riskLevel === 'bajo' ? 'success' : (customer.riskLevel === 'medio' ? 'warning' : 'danger') %>">
            <%= customer.riskLevel === 'bajo' ? '✅ Fiable' : (customer.riskLevel === 'alto' ? '⚠️ No fiable' : (customer.riskLevel || '—')) %>
          </span>
          <% } else { %>
          <span class="badge bg-secondary">Sin evaluar</span>
          <% } %>
        </div>
      </div>
      <button class="btn btn-sm btn-primary" onclick="calculateScoring('<%= fiscalId %>')"><i class="bi bi-search"></i> Calcular</button>
    </div>
  </div>
</div>

<!-- MODAL SCORING -->
<div class="modal fade cm-modal" id="cmScoringModal" tabindex="-1">
<div class="modal-dialog modal-dialog-scrollable">
<div class="modal-content">
  <div class="modal-header"><h5 class="modal-title"><i class="bi bi-shield-check me-1"></i> Evaluación de solvencia</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <ul class="nav nav-tabs mb-2 small" id="scoringTabs">
      <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#scoringInterno">Scoring interno</button></li>
      <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#scoringExterno">Búsqueda externa</button></li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane fade show active" id="scoringInterno">
        <div id="scoringResult"><div class="text-center py-4"><div class="spinner-sm me-2"></div>Calculando...</div></div>
      </div>
      <div class="tab-pane fade" id="scoringExterno">
        <p class="small text-muted">Busca gratis en bases de datos públicas de morosidad/impagos:</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="https://www.axesor.es/busqueda-avanzada?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Axesor</a>
          <a href="https://www.infocif.es/busqueda-avanzada?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Infocif</a>
          <a href="https://www.iberinform.es/buscar?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Iberinform</a>
          <a href="https://www.rankia.com/buscar?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Rankia</a>
           <a href="https://librebor.me/search?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-warning"><i class="bi bi-shield-check"></i> LibreBOR.me</a>
          <a href="https://www.informa.es/buscar?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Informa D&B</a>
          <a href="https://www.einforma.com/busqueda?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Einforma</a>
          <a href="https://opencorporates.com/companies?q=<%= encodeURIComponent(fiscalId) %>" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-globe"></i> OpenCorporates</a>
          <a href="https://www.google.com/search?q=<%= encodeURIComponent(fiscalId + ' morosidad impagos') %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-google"></i> Google</a>
        </div>
        <hr>
        <div class="small text-muted"><i class="bi bi-info-circle"></i> Estas webs no están afiliadas al CRM. Los resultados dependen de cada servicio.</div>
      </div>
    </div>
  </div>
</div></div></div>

<!-- DATOS CLIENTE expandible -->
<div class="mb-3">
  <a href="#" onclick="event.preventDefault();document.getElementById('cmClienteExtra').style.display=document.getElementById('cmClienteExtra').style.display==='none'?'':'none';" class="text-decoration-none small"><i class="bi bi-chevron-down me-1"></i> Más datos del cliente</a>
  <div id="cmClienteExtra" style="display:none;margin-top:8px;" class="p-3 bg-light rounded">
    <div class="row g-2 small">
      <div class="col-md-4"><span class="text-muted">Dirección:</span><br><%= customer.billingAddress && customer.billingAddress.street ? customer.billingAddress.street : '—' %><% if (customer.billingAddress && customer.billingAddress.cityName) { %>, <%= customer.billingAddress.cityName %><% } %></div>
      <div class="col-md-4"><span class="text-muted">Método pago:</span><br>
        <a href="#" onclick="event.preventDefault();togglePaymentLines()" class="text-decoration-none">
          <%= customer.paymentMethod || '—' %> <span id="pmToggleIcon">▼</span>
        </a>
        <span id="paymentActions" class="ms-1"></span>
        <div id="paymentLinesDetail" style="display:none;margin-top:4px;font-size:0.8rem;"></div>
      </div>
      <div class="col-md-4"><span class="text-muted">IBAN:</span><br><code><%= customer.iban || '—' %></code></div>
      <div class="col-md-4"><span class="text-muted">Fecha alta:</span><br><%= fmtDate(customer.created) %></div>
      <div class="col-md-4"><span class="text-muted">Riesgo:</span><br><%= customer.riskLevel || '—' %></div>
      <div class="col-md-4"><span class="text-muted">AEAT:</span><br><%= customer.aeatStatus || '—' %></div>
    </div>
  </div>
</div>

<!-- LÍNEAS -->
<div class="cm-section-title d-flex align-items-center justify-content-between">
  <span><i class="bi bi-phone me-1"></i> Líneas y Suscripciones</span>
  <% var fullLinesCount = (typeof allLinesFull !== 'undefined' && allLinesFull.length > 0 ? allLinesFull : allLines).length; %>
  <% if (fullLinesCount > allLines.length) { %>
  <div class="dropdown d-inline-block">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle py-0 px-2" type="button" data-bs-toggle="dropdown" id="cmLinesToggle" style="font-size:0.75rem;">
      <i class="bi bi-funnel"></i> <span id="cmLinesFilterLabel">Activas</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" style="font-size:0.8rem;min-width:auto;">
      <li><a class="dropdown-item active" href="#" onclick="event.preventDefault();filterLines('activas')"><i class="bi bi-check-circle text-success"></i> Activas</a></li>
      <li><a class="dropdown-item" href="#" onclick="event.preventDefault();filterLines('terminadas')"><i class="bi bi-stop-circle text-muted"></i> Terminadas</a></li>
      <li><a class="dropdown-item" href="#" onclick="event.preventDefault();filterLines('todas')"><i class="bi bi-list-ul"></i> Todas</a></li>
    </ul>
  </div>
  <% } %>
</div>
<% var linesToRender = (typeof allLinesFull !== 'undefined' && allLinesFull.length > 0 ? allLinesFull : allLines); %>
<% if (linesToRender.length === 0) { %>
<div class="cm-empty"><i class="bi bi-inbox me-1"></i> No hay líneas para este cliente.</div>
<% } else { %>
<div id="cmLinesContainer">
<% linesToRender.forEach(function(line, idx) { %>
<% var isActive = line.estado === 'active' || line.estado === 'activa'; %>
<div class="cm-line-card <%= isActive ? 'cm-line-activa' : 'cm-line-terminated' %>" data-line="<%= line.linea %>" id="lineCard_<%= idx %>" data-estado="<%= line.estado %>" style="<%= isActive ? '' : 'display:none;' %>">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
    <div class="flex-grow-1">
      <div class="cm-line-num"><%= line.linea %> <%- lineBadge(line.estado) %></div>
      <small class="text-muted"><i class="bi bi-tag"></i> <%= line.producto || 'Sin tarifa' %></small>
      <span class="ms-2" style="font-size:0.7rem;color:#999;"><i class="bi bi-sim"></i> ICC: <code><%= line.iccid || '—' %></code></span>
      <% if (line.pin) { %><span class="ms-2" style="font-size:0.7rem;">🔑 PIN: <span class="pinpuk-toggle" onclick="toggleReveal(this)"><code class="rh" style="cursor:pointer;">••••</code><code class="rv" style="display:none;"><%= line.pin %></code></span></span><% } %>
      <% if (line.puk) { %><span class="ms-2" style="font-size:0.7rem;">PUK: <span class="pinpuk-toggle" onclick="toggleReveal(this)"><code class="rh" style="cursor:pointer;">•••••••</code><code class="rv" style="display:none;"><%= line.puk %></code></span></span><% } %>
    </div>
    <div class="cm-line-actions d-flex gap-1 flex-wrap">
      <div class="dropdown d-inline-block">
        <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Acciones"><i class="bi bi-gear"></i> Acciones</button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><h6 class="dropdown-header"><i class="bi bi-phone"></i> <%= line.linea %></h6></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();loadLineInfo('<%= line.linea %>',<%= idx %>)"><i class="bi bi-graph-up"></i> Consumo</a></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();loadLineCDRs('<%= line.linea %>',<%= idx %>)"><i class="bi bi-telephone"></i> CDRs</a></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();showPINPUK('<%= line.linea %>')"><i class="bi bi-key"></i> PIN / PUK</a></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();showLineDetail('<%= line.linea %>')"><i class="bi bi-info-circle"></i> Detalle completo</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();showChangeTariff('<%= line.linea %>')"><i class="bi bi-arrow-repeat"></i> Cambiar tarifa</a></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();showDuplicateSim('<%= line.linea %>')"><i class="bi bi-sim"></i> Duplicar SIM</a></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();toggleBlockLine('<%= line.linea %>',<%= line.estado==='active'||line.estado==='activa' %>)"><i class="bi bi-lock"></i> <%= (line.estado==='active'||line.estado==='activa') ? 'Bloquear' : 'Desbloquear' %></a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();showLineSVA('<%= line.linea %>')"><i class="bi bi-toggles"></i> Servicios (SVA)</a></li>
          <li><a class="dropdown-item" href="#" onclick="event.preventDefault();showCreditLimit('<%= line.linea %>')"><i class="bi bi-credit-card"></i> Límite crédito</a></li>
        </ul>
      </div>
    </div>
  </div>
  <!-- Mini GB bar si disponible -->
  <div id="gbMini_<%= idx %>" style="margin-top:6px;display:none;">
    <div class="d-flex justify-content-between small" style="font-size:0.7rem;">
      <span id="gbMiniUsed_<%= idx %>">0</span>
      <span id="gbMiniTotal_<%= idx %>">0 GB</span>
    </div>
    <div class="cons-bar"><div class="cons-bar-fill" id="gbMiniBar_<%= idx %>" style="width:0%;"></div></div>
  </div>
</div>
<% }); %>
</div>
<% } %>

<!-- Auto-carga datos de líneas (server-side) -->
<script>
var CM_ALL_LINES_DATA = <%= JSON.stringify(allLinesData) %>;
var CM_ALL_LINES = <%= JSON.stringify(allLines) %>;
document.addEventListener('DOMContentLoaded', function() {
  // Init payment method actions
  var pm = '<%= customer.paymentMethod || '' %>';
  var fiscal = '<%= fiscalId %>';
  if (pm) {
    var pa = document.getElementById('paymentActions');
    if (pa) {
      var pmLower = pm.toLowerCase();
      if (pmLower === 'iban' || pmLower.includes('iban') || pmLower.includes('cuenta')) {
        pa.innerHTML = '<button class="btn btn-sm btn-outline-primary py-0 px-1 ms-1" onclick="openPaymentAction(\'IBAN\',\''+fiscal+'\')" title="Configurar IBAN"><i class="bi bi-bank"></i></button>';
      } else if (pmLower === 'prepago' || pmLower.includes('prepago')) {
        pa.innerHTML = '<button class="btn btn-sm btn-outline-warning py-0 px-1 ms-1" onclick="openPaymentAction(\'prepago\',\''+fiscal+'\')" title="Ir a Prepago"><i class="bi bi-coin"></i></button>';
      } else if (pmLower === 'stripe' || pmLower.includes('tarjeta') || pmLower.includes('card')) {
        pa.innerHTML = '<button class="btn btn-sm btn-outline-info py-0 px-1 ms-1" onclick="openPaymentAction(\'stripe\',\''+fiscal+'\')" title="Configurar Stripe"><i class="bi bi-credit-card"></i></button>';
      } else {
        pa.innerHTML = '<button class="btn btn-sm btn-outline-secondary py-0 px-1 ms-1" onclick="openPaymentAction(\''+pm+'\',\''+fiscal+'\')" title="Acción: '+pm+'"><i class="bi bi-gear"></i></button>';
      }
    }
  }
  // Init line cards
  CM_ALL_LINES.forEach(function(line, idx) {
    var ld = CM_ALL_LINES_DATA[line.linea];
    if (!ld) return;
    // Pre-fill PIN/PUK en la card
    if (ld.pinpuk) {
      var card = document.querySelector('[data-line="'+line.linea+'"]');
      if (!card) card = document.getElementById('lineCard_'+idx);
      if (card) {
        var pp = ld.pinpuk;
        var ppHtml = '';
        if (pp.pin || pp.pinCode) {
          var pinVal = pp.pin||pp.pinCode;
          if (!line.pin) {
            ppHtml += '<span class="ms-2" style="font-size:0.7rem;">🔑 PIN: <span class="pinpuk-toggle" onclick="toggleReveal(this)"><code class="rh" style="cursor:pointer;">••••</code><code class="rv" style="display:none;">'+pinVal+'</code></span></span>';
          }
        }
        if (pp.puk || pp.pukCode) {
          var pukVal = pp.puk||pp.pukCode;
          if (!line.puk) {
            ppHtml += '<span class="ms-2" style="font-size:0.7rem;">PUK: <span class="pinpuk-toggle" onclick="toggleReveal(this)"><code class="rh" style="cursor:pointer;">•••••••</code><code class="rv" style="display:none;">'+pukVal+'</code></span></span>';
          }
        }
        if (pp.icc && !line.iccid) {
          ppHtml += '<span class="ms-2" style="font-size:0.7rem;"><i class="bi bi-sim"></i> ICC: <code>'+pp.icc+'</code></span>';
        }
        if (ppHtml) {
          var target = card.querySelector('.text-muted')?.parentElement;
          if (target) target.insertAdjacentHTML('beforeend', ppHtml);
        }
      }
    }
    // Pre-fill GB bar (find by data-line attribute)
    if (ld.gb) {
      var gb = ld.gb;
      var tGB = parseFloat(gb.totalGB||gb.total_gb||0);
      var uGB = parseFloat(gb.usedGB||gb.used_gb||0);
      if (tGB > 0) {
        var pct = Math.min(100,(uGB/tGB)*100);
        var cls = pct>85?'danger':(pct>60?'warning':'');
        var card = document.querySelector('[data-line="' + line.linea + '"]');
        if (card) {
          var barEl = card.querySelector('[id^="gbMiniBar_"]');
          var usedEl = card.querySelector('[id^="gbMiniUsed_"]');
          var totalEl = card.querySelector('[id^="gbMiniTotal_"]');
          var container = card.querySelector('[id^="gbMini_"]');
          if (barEl && usedEl && totalEl && container) {
            usedEl.textContent = uGB.toFixed(1)+' GB';
            totalEl.textContent = tGB.toFixed(1)+' GB';
            barEl.style.width = pct+'%';
            barEl.className = 'cons-bar-fill '+cls;
            container.style.display = 'block';
          }
        }
      }
    }
  });
  // Auto-cargar datos de la primera línea activa en la pestaña Consumo
  var firstActive = CM_ALL_LINES.length > 0 ? CM_ALL_LINES[0] : null;
  if (firstActive) {
    var ld = CM_ALL_LINES_DATA[firstActive.linea];
    if (ld && (ld.gb || ld.svas.length > 0)) {
      var card = document.querySelector('[data-line="'+firstActive.linea+'"]');
      var firstIdx = card ? parseInt(card.id.replace('lineCard_','')) : 0;
      loadLineInfo(firstActive.linea, firstIdx);
    }
  }
});
</script>

