    </td>
  </tr>
  <% }); %>
  </tbody>
  </table></div>
  <% } %>
  <button class="btn btn-sm btn-outline-success mt-1" onclick="uploadContract('nuevo', this)"><i class="bi bi-plus-circle"></i> Añadir contrato</button>
<% } %>
