  .then(function(r){return r.json()})
  .then(function(res){
    if (!res.ok) { document.getElementById('cmLineModalBody').innerHTML = '<div class="alert alert-danger">'+(res.error||'Error')+'</div>'; return; }
    var d = res.data||{}, li = d.lineInfo||{}, pp = d.pinpuk||{}, gb = d.gb||{}, sim = d.sim||{};
    var pinVal = pp.pin||pp.pinCode||li.pin||sim.pin||'';
    var pukVal = pp.puk||pp.pukCode||li.puk||sim.puk||'';
    var iccVal = li.icc||pp.icc||sim.icc||sim.iccid||'';

    function escPp(v, label) {
