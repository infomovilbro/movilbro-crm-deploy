// --- FILTRO LÍNEAS ACTIVAS / TERMINADAS ---
function filterLines(filter) {
  var label = document.getElementById('cmLinesFilterLabel');
  var items = document.querySelectorAll('#cmLinesContainer .cm-line-card');
  items.forEach(function(card) {
    var estado = (card.dataset.estado || '').toLowerCase();
    var isActive = estado === 'active' || estado === 'activa';
    if (filter === 'activas') {
      card.style.display = isActive ? '' : 'none';
    } else if (filter === 'terminadas') {
      card.style.display = isActive ? 'none' : '';
    } else {
      card.style.display = '';
    }
  });
  if (label) {
    label.textContent = filter === 'activas' ? 'Activas' : (filter === 'terminadas' ? 'Terminadas' : 'Todas');
  }
  // Update dropdown active state
  var dd = document.querySelector('[data-bs-toggle="dropdown"]');
  if (dd) {
    var parent = dd.parentElement;
    if (parent) {
      parent.querySelectorAll('.dropdown-item').forEach(function(el) { el.classList.remove('active'); });
      var target = parent.querySelector('[onclick*="filterLines(\''+filter+'\')"]');
      if (target) target.classList.add('active');
    }
  }
}

// --- ACCIONES MÉTODO PAGO ---
function openPaymentAction(method, fiscalId) {
  method = (method || '').toLowerCase();
  if (method === 'iban') {
    window.open('/altas/iban?fiscalId=' + encodeURIComponent(fiscalId), '_blank');
  } else if (method === 'prepago') {
    window.open('/tienda/prepago?fiscalId=' + encodeURIComponent(fiscalId), '_blank');
  } else if (method === 'stripe') {
    window.open('/stripe?fiscalId=' + encodeURIComponent(fiscalId), '_blank');
  } else {
    toast('Método: ' + method, 'info');
  }
}

// --- DESPLEGABLE LÍNEAS DEL MÉTODO PAGO ---
function togglePaymentLines() {
  var detail = document.getElementById('paymentLinesDetail');
  var icon = document.getElementById('pmToggleIcon');
  if (!detail) return;
  if (detail.style.display !== 'none') {
    detail.style.display = 'none';
    if (icon) icon.textContent = '▼';
    return;
  }
  var fiscal = '<%= fiscalId %>';
  var pm = '<%= customer.paymentMethod || '' %>';
  var lines = CM_ALL_LINES || [];
  var canceled = 0, active = 0, total = 0;
  var html = '<div class="small"><i class="bi bi-phone me-1"></i> Líneas con este método:';
  lines.forEach(function(l) {
    total++;
    var st = (l.estado || '').toLowerCase();
    if (st === 'active' || st === 'activa') active++; else canceled++;
    var stLabel = (st === 'active' || st === 'activa') ? '<span class="text-success">●</span>' : '<span class="text-muted">○</span>';
    html += '<div class="ms-2">' + stLabel + ' ' + l.linea + ' <span class="text-muted">(' + (l.producto || '—') + ')</span></div>';
  });
  if (total === 0) html += '<div class="text-muted ms-2">Ninguna línea</div>';
  html += '<div class="mt-1 text-muted" style="font-size:0.7rem;">' + active + ' activas, ' + (total - active) + ' inactivas</div></div>';
  detail.innerHTML = html;
  detail.style.display = 'block';
  if (icon) icon.textContent = '▲';
}

// --- GENERAR PIN/PUK ---
function generatePINPUK(line) {
  if (!confirm('¿Generar nuevo PIN/PUK para ' + line + '?')) return;
  var btn = event && event.target ? event.target : document.querySelector('[onclick*="generatePINPUK"]');
  if (btn) { btn.disabled = true; btn.innerHTML = '<div class="spinner-sm me-1"></div>Generando...'; }
  fetch('/clientes-movilbro/' + CM_FISCAL + '/line/' + encodeURIComponent(line) + '/generate-pinpuk', { method: 'POST' })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (res.ok) {
      toast('✅ Nuevo PIN/PUK generado', 'success');
      showPINPUK(line);
    } else {
      err(res.error || 'Error al generar PIN/PUK');
      if (btn) { btn.disabled = false; btn.innerHTML = '🔑 Generar PIN/PUK'; }
    }
  })
  .catch(function(e) {
    err(e.message);
    if (btn) { btn.disabled = false; btn.innerHTML = '🔑 Generar PIN/PUK'; }
  });
}
