function toggleSVA(el, line, code) {
  var active = el.dataset.svaActive==='true';
  var newStatus = active ? 'INACTIVE' : 'ACTIVE';
  fetch('/clientes-movilbro/'+CM_FISCAL+'/line/'+encodeURIComponent(line)+'/svas',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ lineNumber: line, svas: [{ code: code, status: newStatus }] })
  })
  .then(function(r){return r.json()})
  .then(function(res){
    if (res.ok) {
      el.dataset.svaActive = !active;
      el.className = 'cm-sva-chip '+(active?'inactive':'active');
      el.innerHTML = (!active?'✅ ':'⬜ ')+el.textContent.replace(/✅|⬜/g,'').trim().replace(/\(Activo\)|\(Inactivo\)/g,'')+' <small class="text-muted">('+(!active?'Activo':'Inactivo')+')</small>';
      toast(active?'🟡 Servicio desactivado':'🟢 Servicio activado', 'success');
    } else {
      err(res.error||'Error al cambiar SVA');
    }
  })
  .catch(function(e){ err(e.message); });
}

