<section>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-plus"></i> <%= ui.moduleName.altas %></h2>
    <div>
      <button class="btn btn-outline-info btn-sm" onclick="location.href='/ordenes'"><i class="bi bi-list-check"></i> Órdenes pendientes</button>
    </div>
  </div>

  <% if (locals.success) { %><div class="alert alert-success"><i class="bi bi-check-circle"></i> <%= success %></div><% } %>
  <% if (locals.error) { %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= error %></div><% } %>

  <ul class="nav nav-tabs mb-3" id="altasTab" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#nuevoCliente"><i class="bi bi-person-plus"></i> Nuevo Cliente</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#nuevaOrden"><i class="bi bi-cart-plus"></i> Orden Rápida</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#pendientes"><i class="bi bi-clock-history"></i> Pendientes <span class="badge bg-warning text-dark ms-1"><%= ordenesPendientes ? ordenesPendientes.length : 0 %></span></button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#recientes"><i class="bi bi-clock-history"></i> Recientes</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#portabilidades"><i class="bi bi-arrow-left-right"></i> Portabilidades</button></li>
  </ul>

  <div class="tab-content">
    <!-- NUEVO CLIENTE - Wizard multi-paso -->
    <div class="tab-pane fade show active" id="nuevoCliente">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi bi-person-plus"></i> Asistente de alta</span>
          <div class="wizard-progress" id="wizardSteps">
            <div class="wiz-step completed" id="ws1">
              <div class="wiz-circle">1</div>
              <div class="wiz-label">Datos del cliente</div>
            </div>
            <div class="wiz-step pending" id="ws2">
              <div class="wiz-circle">2</div>
              <div class="wiz-label">Producto / Cobertura</div>
            </div>
            <div class="wiz-step pending" id="ws3">
              <div class="wiz-circle">3</div>
              <div class="wiz-label">Portabilidad / Config</div>
            </div>
            <div class="wiz-step pending" id="ws4">
              <div class="wiz-circle">4</div>
              <div class="wiz-label">Resumen / Confirmación</div>
            </div>
          </div>
        </div>
        <div class="card-body">

          <!-- STEP 1: DATOS DEL CLIENTE -->
          <div id="wizardStep1">
            <h5 class="mb-3"><i class="bi bi-person-vcard"></i> Datos del cliente</h5>
            <form id="formStep1">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Nombre *</label>
                  <input type="text" id="wNombre" name="wNombre" class="form-control" required placeholder="Nombre" oninput="validarPaso1()" onchange="validarPaso1()">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Apellidos</label>
                  <input type="text" id="wApellidos" name="wApellidos" class="form-control" placeholder="Apellidos">
                </div>
                <div class="col-md-4">
                  <label class="form-label">DNI / NIF *</label>
                  <input type="text" id="wDni" name="wDni" class="form-control" required placeholder="12345678Z" onblur="validarDNI(this)" oninput="validarPaso1()" onchange="validarPaso1()">
                  <small class="text-muted" id="wDniVal"></small>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Teléfono *</label>
                  <input type="text" id="wTelefono" name="wTelefono" class="form-control" required placeholder="612345678" oninput="validarPaso1()" onchange="validarPaso1()">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Email</label>
                  <input type="email" id="wEmail" name="wEmail" class="form-control" placeholder="cliente@email.com" onchange="validarPaso1()">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Dirección</label>
                  <input type="text" id="wDireccion" name="wDireccion" class="form-control" placeholder="Calle, número, piso">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Ciudad</label>
                  <input type="text" id="wCiudad" name="wCiudad" class="form-control" value="Antequera">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Código Postal</label>
                  <input type="text" id="wCp" name="wCp" class="form-control" value="29200">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Tipo de cliente</label>
                  <select id="wCustomerType" class="form-select">
                    <option value="Residential">Particular (Residential)</option>
                    <option value="Freelance">Autónomo (Freelance)</option>
                    <option value="Society">Empresa (Society)</option>
                  </select>
                </div>
                <div class="col-md-8">
                  <label class="form-label">Método de pago</label>
                  <div class="pago-cards">
                    <div class="pago-card">
                      <input type="radio" name="wMetodoPago" value="IBAN" id="pagoIBAN" onchange="togglePago()">
                      <label for="pagoIBAN">
                        <i class="bi bi-bank"></i>
                        <span>IBAN (Domiciliación)</span>
                      </label>
                    </div>
                    <div class="pago-card">
                      <input type="radio" name="wMetodoPago" value="TARJETA" id="pagoTarjeta" onchange="togglePago()">
                      <label for="pagoTarjeta">
                        <i class="bi bi-credit-card"></i>
                        <span>Tarjeta</span>
                      </label>
                    </div>
                    <div class="pago-card">
                      <input type="radio" name="wMetodoPago" value="NINGUNO" id="pagoNinguno" onchange="togglePago()">
                      <label for="pagoNinguno">
                        <i class="bi bi-x-circle"></i>
                        <span>Ninguno (Pagaré después)</span>
                      </label>
                    </div>
                  </div>
                  <div class="pago-content-area mt-2">
                    <div id="pagoIBANContent" class="pago-detail" style="display:none;">
                      <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-bank"></i></span>
                        <input type="text" id="wIban" class="form-control" placeholder="ES00 0000 0000 0000 0000 0000" oninput="formatearIBAN(this)">
                      </div>
                      <small class="text-muted"><i class="bi bi-info-circle"></i> Se realizará un cargo de 0,50€ para verificar tu IBAN, reembolsado en la primera factura.</small>
                    </div>
                    <div id="pagoTarjetaContent" class="pago-detail" style="display:none;">
                      <p class="mb-2"><i class="bi bi-shield-check text-primary"></i> Serás redirigido a Stripe para configurar el pago con tarjeta</p>
                      <a href="https://paymentlinks.movilbro.com/b/00g7su6jafByayIfZ1" target="_blank" class="btn btn-primary btn-sm"><i class="bi bi-box-arrow-up-right"></i> Ir a Stripe</a>
                    </div>
                    <div id="pagoNingunoContent" class="pago-detail" style="display:none;">
                      <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Podrás configurar el método de pago más tarde desde tu área de cliente</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-4 d-flex justify-content-between">
                <div></div>
                <button type="button" class="btn btn-primary btn-lg btn-wizard-next" id="btnStep1Next" onclick="goWizardStep2()"><i class="bi bi-arrow-right"></i> Siguiente: Producto</button>
              </div>
            </form>
          </div>

          <!-- STEP 2: SELECCIÓN DE PRODUCTO (iconos + tarjetas + carrito) -->
          <div id="wizardStep2" style="display:none;">
            <h5 class="mb-3"><i class="bi bi-cart"></i> Selección de producto</h5>
            <form id="formStep2">
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label class="form-label">Tipo de contratación</label>
                  <select id="wTipoContratacion" class="form-select">
                    <option value="NUEVA_ALTA">Nueva Alta (nuevo número)</option>
                    <option value="PORTABILIDAD">Portabilidad (mantener mi número)</option>
                    <option value="CAMBIO_PRODUCTO">Cambio de Producto</option>
                    <option value="BAJA">Baja</option>
                  </select>
                </div>
              </div>

              <!-- Categorías como iconos -->
              <label class="form-label">Familia / Categoría</label>
              <div class="row g-2 mb-3" id="familyIcons">
                <% var FAMILY_ICONS = { Mobile: '📱', Fiber: '🌐', TV: '📺', Device: '📟', International: '🌍', Energy: '🔋', Satellite: '📡', Fixed: '📞' }; %>
                <% var FAMILY_TRANS = { Mobile: 'Móvil', Fiber: 'Fibra', Fixed: 'Fijo', TV: 'TV', Satellite: 'Satélite', Device: 'Dispositivo', Energy: 'Energía', International: 'Internacional', Custom: 'Personalizado', Other: 'Otras' }; %>
                <% (familias || []).forEach(function(fam) { %>
                <div class="col-md-2 col-4 col-sm-3">
                  <div class="family-icon-card" data-family="<%= fam.name %>" onclick="selectFamily('<%= fam.name.replace(/'/g,"\\'") %>')">
                    <div class="family-icon-emoji"><%= FAMILY_ICONS[fam.name] || '📦' %></div>
                    <div class="family-icon-name"><%= FAMILY_TRANS[fam.name] || fam.name %></div>
                    <div class="family-icon-count"><%= (fam.items || []).length %> productos</div>
                  </div>
                </div>
                <% }); %>
              </div>

              <!-- Productos como tarjetas -->
              <div id="productGridSection" style="display:none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <label class="form-label mb-0">Productos disponibles</label>
                  <button class="btn btn-sm btn-outline-secondary" onclick="clearFamilySelection()">Cambiar categoría</button>
                </div>
                <div class="row g-2" id="productGrid"></div>
              </div>

              <!-- Carrito -->
              <div id="cartSection" class="mt-3 p-3 border rounded" style="background:#f8f9fa;display:none;">
                <h6 class="mb-2"><i class="bi bi-cart-check"></i> Carrito <span class="badge bg-primary" id="cartCount">0</span></h6>
                <div id="cartItems"></div>
                <div class="mt-2 d-flex justify-content-between align-items-center">
                  <strong>Total: <span id="cartTotal">0.00€</span></strong>
                  <button class="btn btn-sm btn-outline-danger" onclick="clearCart()"><i class="bi bi-trash"></i> Vaciar carrito</button>
                </div>
              </div>

              <!-- Coverage check section (for fiber) -->
              <div id="coverageSection" class="mt-3 p-3 border rounded bg-light" style="display:none;">
                <h6 class="mb-2"><i class="bi bi-geo-alt-fill text-primary"></i> Verificar cobertura de fibra</h6>
                <div class="row g-2">
                  <div class="col-md-8">
                    <input type="text" id="wCoverageDir" class="form-control" placeholder="Dirección de instalación (calle y número)">
                  </div>
                  <div class="col-md-4">
                    <button type="button" class="btn btn-primary w-100 fw-semibold" id="btnCheckCoverage" onclick="checkCoverage()">
                      <i class="bi bi-search"></i> Verificar cobertura
                    </button>
                  </div>
                </div>
                <div id="coverageResult" class="mt-2">
                  <div class="text-muted small"><i class="bi bi-info-circle"></i> Introduce la dirección completa para verificar la disponibilidad de fibra.</div>
                </div>
              </div>

              <div class="mt-4 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-lg btn-wizard-prev" onclick="goWizardStep1()"><i class="bi bi-arrow-left"></i> Volver</button>
                <button type="button" class="btn btn-primary btn-lg btn-wizard-next" id="btnStep2Next" onclick="goWizardStep3()" disabled><i class="bi bi-arrow-right"></i> Siguiente</button>
              </div>
            </form>
          </div>

          <!-- STEP 3: CONFIGURACIÓN DE LÍNEAS -->
          <div id="wizardStep3" style="display:none;">
            <h5 class="mb-3"><i class="bi bi-gear"></i> Configuración de líneas</h5>
            <form id="formStep3">
              <div id="lineasConfig" class="mb-3"></div>
              <div class="mt-4 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-lg btn-wizard-prev" onclick="goWizardStep2()"><i class="bi bi-arrow-left"></i> Volver</button>
                <button type="button" class="btn btn-primary btn-lg btn-wizard-next" id="btnStep3Next" onclick="goWizardStep4()"><i class="bi bi-arrow-right"></i> Siguiente: Resumen</button>
              </div>
            </form>
          </div>

          <!-- STEP 4: RESUMEN Y ENVÍO -->
          <div id="wizardStep4" style="display:none;">
            <h5 class="mb-3"><i class="bi bi-file-text"></i> Resumen y confirmación</h5>
            <div class="row">
              <div class="col-md-6">
                <div class="card mb-3">
                  <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Datos del cliente</span>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="goWizardStep1()"><i class="bi bi-pencil"></i></button>
                  </div>
                  <div class="card-body" id="resumenCliente"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card mb-3">
                  <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Producto y pago</span>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="goWizardStep2()"><i class="bi bi-pencil"></i></button>
                  </div>
                  <div class="card-body" id="resumenProducto"></div>
                </div>
              </div>
            </div>

            <div class="d-flex gap-2 mb-3">
              <button type="button" class="btn btn-outline-primary" onclick="verContrato()" id="btnVerContrato">
                <i class="bi bi-file-text"></i> Ver contrato
              </button>
            </div>

            <div class="alert alert-info">
              <i class="bi bi-info-circle"></i> Al crear el cliente se enviará un email con el enlace de verificación KYC (documentación y firma del contrato).
            </div>

            <div id="resumenChecks" class="mb-3">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="checkDatos" checked disabled>
                <label class="form-check-label">Datos del cliente completos <i class="bi bi-check-circle text-success"></i></label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="checkProducto" checked disabled>
                <label class="form-check-label">Producto seleccionado <i class="bi bi-check-circle text-success"></i></label>
              </div>
              <div class="form-check mb-2" id="checkPortaRow" style="display:none;">
                <input class="form-check-input" type="checkbox" id="checkPorta" checked disabled>
                <label class="form-check-label">Configuración de portabilidad <i class="bi bi-check-circle text-success"></i></label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="checkPago">
                <label class="form-check-label">He repasado los datos del cliente y del producto, todo es correcto.</label>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <button type="button" class="btn btn-outline-secondary btn-lg btn-wizard-prev" onclick="goWizardStep3()"><i class="bi bi-arrow-left"></i> Volver</button>
              <button type="button" class="btn btn-success btn-lg" id="btnCrearCliente" onclick="crearClienteAvanzado()" disabled>
                <i class="bi bi-check-lg"></i> Crear cliente y enviar KYC
              </button>
            </div>
            <div id="submitStatus" class="mt-2"></div>
          </div>

        </div>
      </div>
    </div>

    <!-- ORDEN RÁPIDA (simplificada) -->
    <div class="tab-pane fade" id="nuevaOrden">
      <div class="card">
        <div class="card-header"><i class="bi bi-cart-plus"></i> Crear orden rápida (sin KYC)</div>
        <div class="card-body">
          <form method="POST" action="/altas/crear-orden">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Cliente *</label>
                <select name="client_id" class="form-select" required>
                  <option value="">Seleccionar cliente...</option>
                  <% localCustomers.forEach(function(c) { %>
                  <option value="<%= c.id %>"><%= c.nombre %> <%= c.apellidos || '' %> - <%= c.telefono %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Tipo de contratación</label>
                <select name="tipo" class="form-select">
                  <option value="NUEVA_ALTA">Nueva Alta</option>
                  <option value="PORTABILIDAD">Portabilidad</option>
                  <option value="CAMBIO_PRODUCTO">Cambio de Producto</option>
                  <option value="BAJA">Baja</option>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label">Producto / Servicio *</label>
                <select name="producto_id" class="form-select" required>
                  <option value="">Seleccionar producto...</option>
                  <% if (familias.length > 0) { familias.forEach(function(fam) { %>
                  <optgroup label="<%= fam.name %>">
                    <% (fam.items || []).forEach(function(p) { %>
                    <option value="<%= p.id || p.productId %>"><%= p.productName || p.name %><%= p.price ? ' - ' + p.price + '€' : '' %></option>
                    <% }); %>
                  </optgroup>
                  <% }); } else { %>
                  <option value="">No hay productos disponibles (configura API)</option>
                  <% } %>
                </select>
              </div>
            </div>
            <div class="mt-4">
              <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-check-lg"></i> Crear Orden</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- PENDIENTES -->
    <div class="tab-pane fade" id="pendientes">
      <div class="card">
        <div class="card-header"><i class="bi bi-clock-history"></i> Órdenes pendientes de KYC / aprobación</div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0" id="pendientesTable">
            <thead>
              <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Producto</th>
                <th>Estado</th>
                <th>Email enviado</th>
                <th>Documentos</th>
                <th>Contrato firmado</th>
                <th>Fecha</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% if (!ordenesPendientes || ordenesPendientes.length === 0) { %>
              <tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox"></i> No hay órdenes pendientes</td></tr>
              <% } else { ordenesPendientes.forEach(function(o) { 
                var dc = JSON.parse(o.datos_cliente || '{}');
                var dp = JSON.parse(o.datos_producto || '{}');
              %>
              <tr>
                <td><%= o.id %></td>
                <td><strong><%= dc.nombre || '' %> <%= dc.apellidos || '' %></strong><br><small class="text-muted"><%= dc.telefono || '' %></small></td>
                <td><%= dp.producto_id || '-' %></td>
                <td>
                  <% var est = (o.estado || '').toLowerCase(); %>
                  <span class="badge bg-<%= est === 'pendiente_kyc' ? 'warning' : est === 'pendiente_aprobacion' ? 'info' : est === 'completada' ? 'success' : 'secondary' %>">
                    <%= est === 'pendiente_kyc' ? 'Pendiente KYC' : est === 'pendiente_aprobacion' ? 'Pendiente aprobación' : est === 'completada' ? 'Completada' : est === 'cancelada' ? 'Cancelada' : est %>
                  </span>
                </td>
                <td class="text-center">
                  <% if (o.email_enviado) { %>
                    <span class="badge bg-success"><i class="bi bi-check-lg"></i> Enviado</span>
                    <% if (o.email_leido) { %>
                      <br><small class="text-info">Leído: Sí (<%= o.email_veces_leido || 1 %> veces)</small>
                    <% } else { %>
                      <br><small class="text-muted">No leído</small>
                    <% } %>
                  <% } else { %>
                    <span class="badge bg-secondary"><i class="bi bi-x-lg"></i> Pendiente</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (o.kyc_completado) { %>
                    <span class="badge bg-success"><i class="bi bi-check-lg"></i> Completo</span>
                  <% } else { %>
                    <% var docsSubidos = o.kyc_docs_subidos || 0; %>
                    <span class="badge bg-<%= docsSubidos > 0 ? 'primary' : 'secondary' %>">
                      <%= docsSubidos %>/2
                    </span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (o.kyc_contrato_firmado) { %>
                    <span class="badge bg-success"><i class="bi bi-check-lg"></i> Firmado</span>
                  <% } else { %>
                    <span class="badge bg-secondary"><i class="bi bi-x-lg"></i> Pendiente</span>
                  <% } %>
                </td>
                <td class="small"><%= new Date(o.created_at).toLocaleDateString('es-ES') %></td>
                <td>
                  <div class="btn-group btn-group-sm">
                    <% if (!o.kyc_completado) { %>
                    <button class="btn btn-outline-primary" onclick="enviarKYC(<%= o.id %>)" title="Enviar email KYC"><i class="bi bi-envelope"></i></button>
                    <% } %>
                    <button class="btn btn-outline-success" onclick="completarOrden(<%= o.id %>)" title="Completar y enviar a API"><i class="bi bi-check-lg"></i></button>
                    <button class="btn btn-outline-danger" onclick="cancelarOrden(<%= o.id %>)" title="Cancelar"><i class="bi bi-x-lg"></i></button>
                  </div>
                </td>
              </tr>
              <% }); } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- RECIENTES -->
    <div class="tab-pane fade" id="recientes">
      <div class="card">
        <div class="card-header"><i class="bi bi-clock-history"></i> Altas recientes (API Likes Telecom)</div>
        <div class="row g-3 mb-4 px-3 pt-3">
          <div class="col-md-12">
            <div class="card"><div class="card-body">
              <h6 class="card-title"><span style="font-size:1.2rem;">📈</span> Altas por Mes</h6>
              <div id="chartAltasEstado"></div>
            </div></div>
          </div>
        </div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0">
            <thead><tr><th>Nombre</th><th>Teléfono</th><th>Tipo</th><th>Estado</th><th>Fecha</th><th></th></tr></thead>
            <tbody>
              <% if (recientes.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox"></i> Sin datos</td></tr>
              <% } else { recientes.forEach(function(a) { %>
              <tr>
                <td><strong><%= a.nombre %></strong></td>
                <td><%= a.telefono %></td>
                <td><span class="badge bg-info"><%= a.tipo %></span></td>
                <% var aStatus = (a.estado || '').toUpperCase(); %>
                <td><span class="badge bg-<%= aStatus === 'ACTIVE' || aStatus === 'CREATED' ? 'success' : aStatus === 'ERROR' ? 'danger' : 'warning' %>"><%= aStatus === 'ACTIVE' ? 'Activo' : aStatus === 'CREATED' ? 'Creado' : aStatus === 'ERROR' ? 'Error' : a.estado %></span></td>
                <td class="small"><%= new Date(a.fecha).toLocaleDateString('es-ES', { day:'2-digit', month:'short', year:'numeric' }) %></td>
                <td><a href="/whatsapp?phone=<%= a.telefono.replace(/[^\d]/g, '') %>" class="btn btn-sm btn-outline-success"><i class="bi bi-whatsapp"></i></a></td>
              </tr>
              <% }); } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- PORTABILIDADES -->
    <div class="tab-pane fade" id="portabilidades">
      <div class="card">
        <div class="card-header"><i class="bi bi-arrow-left-right"></i> Portabilidades registradas</div>
        <div class="row g-3 mb-4 px-3 pt-3">
          <div class="col-md-12">
            <div class="card"><div class="card-body">
              <h6 class="card-title"><span style="font-size:1.2rem;">📈</span> Portabilidades por Mes</h6>
              <div id="chartPortaEstado"></div>
              <div id="portaDetail" class="mt-2 text-center"></div>
            </div></div>
          </div>
        </div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0">
            <thead><tr><th>Cliente</th><th>Teléfono</th><th>Donante</th><th>Estado</th><th>Fecha</th></tr></thead>
            <tbody>
              <% if (portabilidades.length === 0) { %>
              <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-inbox"></i> Sin datos</td></tr>
              <% } else { portabilidades.forEach(function(p) { %>
              <tr>
                <td><%= p.customerName || p.name || 'N/A' %></td>
                <td><%= p.phoneNumber || p.phone || '-' %></td>
                <td><%= p.donorOperator || '-' %></td>
                <% var pStatus = (p.status || 'PENDING').toUpperCase(); %>
                <td><span class="badge bg-<%= pStatus === 'COMPLETED' || pStatus === 'ACCEPTED' ? 'success' : pStatus === 'PENDING' ? 'warning' : pStatus === 'CANCELED' || pStatus === 'CANCELLED' ? 'danger' : 'success' %>"><%= pStatus === 'COMPLETED' || pStatus === 'ACCEPTED' ? 'Completada' : pStatus === 'PENDING' ? 'Pendiente' : pStatus === 'CANCELED' || pStatus === 'CANCELLED' ? 'Cancelada' : pStatus %></span></td>
                <td class="small"><%= p.portabilityDate || p.created ? new Date(p.portabilityDate || p.created).toLocaleDateString('es-ES') : '-' %></td>
              </tr>
              <% }); } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Contract Preview Modal -->
<div class="modal fade" id="contratoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-file-text"></i> Vista previa del contrato</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body p-0">
        <iframe id="contratoIframe" style="width:100%;height:600px;border:none;" srcdoc="<p style='text-align:center;padding:60px 20px;color:#6c757d;'><i class='bi bi-file-text' style='font-size:2rem;display:block;margin-bottom:12px;'></i>Complete la creación del cliente para visualizar el contrato.<br><small>El contrato se generará automáticamente tras el registro.</small></p>"></iframe>
      </div>
      <div class="modal-footer">
        <a id="contratoAbrirExterno" href="#" target="_blank" class="btn btn-outline-primary"><i class="bi bi-box-arrow-up-right"></i> Abrir en ventana completa</a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Hidden field to store order token -->
<input type="hidden" id="orderTokenHolder" value="">

<script>
// Wizard state
var WIZARD = { step: 1 };

function actualizarProgressBar(step) {
  for (var i = 1; i <= 4; i++) {
    var el = document.getElementById('ws' + i);
    el.classList.remove('completed', 'active', 'pending');
    if (i < step) el.classList.add('completed');
    else if (i === step) el.classList.add('active');
    else el.classList.add('pending');
  }
}

function validarPaso1() {
  var nombre = document.getElementById('wNombre').value.trim();
  var telefono = document.getElementById('wTelefono').value.trim();
  var dni = document.getElementById('wDni').value.trim();
  var btn = document.getElementById('btnStep1Next');
  btn.disabled = !(nombre && telefono && dni);
}

function validarPaso2() {
  document.getElementById('btnStep2Next').disabled = cart.length === 0;
}

function validarPaso3() {
  var allValid = true;
  document.querySelectorAll('.linea-tipo').forEach(function(sel) {
    var idx = sel.dataset.linea;
    if (sel.value === 'PORTABILIDAD') {
      var num = document.querySelector('.linea-porta-num[data-linea="' + idx + '"]');
      var don = document.querySelector('.linea-donante[data-linea="' + idx + '"]');
      if (!num || !num.value.trim() || !don || !don.value) allValid = false;
    }
  });
  document.getElementById('btnStep3Next').disabled = !allValid;
}

function goWizardStep4() {
  var nombre = document.getElementById('wNombre').value.trim();
  var apellidos = document.getElementById('wApellidos').value.trim();
  var dni = document.getElementById('wDni').value.trim();
  var telefono = document.getElementById('wTelefono').value.trim();
  var email = document.getElementById('wEmail').value.trim();
  var direccion = document.getElementById('wDireccion').value.trim();
  var ciudad = document.getElementById('wCiudad').value.trim();
  var cp = document.getElementById('wCp').value.trim();
  var customerType = document.getElementById('wCustomerType').value;
  var metodoPagoEl = document.querySelector('input[name="wMetodoPago"]:checked');
  var metodoPago = metodoPagoEl ? metodoPagoEl.value : '';
  var iban = document.getElementById('wIban').value.trim();

  // Collect line data from dynamic forms
  lineasData = [];
  document.querySelectorAll('.linea-tipo').forEach(function(sel) {
    var idx = sel.dataset.linea;
    var tipo = sel.value;
    var numPorta = tipo === 'PORTABILIDAD' ? (document.querySelector('.linea-porta-num[data-linea="' + idx + '"]')?.value || '') : '';
    var donante = tipo === 'PORTABILIDAD' ? (document.querySelector('.linea-donante[data-linea="' + idx + '"]')?.value || '') : '';
    var sim = document.querySelector('.linea-sim[data-linea="' + idx + '"]')?.value || 'fisica';
    var icc = document.querySelector('.linea-icc[data-linea="' + idx + '"]')?.value || '';
    lineasData.push({ tipo: tipo, numero: numPorta, donante: donante, sim: sim, icc: icc });
  });

  document.getElementById('resumenCliente').innerHTML =
    '<p><strong>' + nombre + ' ' + apellidos + '</strong><br>' +
    'DNI: ' + dni + '<br>' +
    'Tel: ' + telefono + '<br>' +
    (email ? 'Email: ' + email + '<br>' : '') +
    (direccion ? direccion + ', ' + ciudad + ' ' + cp + '<br>' : '') +
    'Tipo: ' + customerType + '</p>' +
    '<p><strong>Método de pago:</strong> ' + (metodoPago ? ({
      'IBAN': 'IBAN (Domiciliación)',
      'TARJETA': 'Tarjeta',
      'NINGUNO': 'Ninguno (Pagaré después)'
    })[metodoPago] || metodoPago : 'No seleccionado') + (metodoPago === 'IBAN' && iban ? '<br>IBAN: ' + iban : '') + '</p>';

  var prodText = cart.map(function(c) { return c.name + ' (' + conIva(c.price).toFixed(2) + '€)'; }).join(', ');
  var lineasResumen = lineasData.map(function(l, i) {
    return '<br><small>Línea ' + (i+1) + ': ' + (l.tipo === 'PORTABILIDAD' ? 'Portar ' + l.numero : 'Nueva línea') + (l.icc ? ' · ICC: ' + l.icc : '') + '</small>';
  }).join('');
  // Recoger datos de envío
  var envioMetodo = document.getElementById('envioMetodo')?.value || 'manual';
  var envioDireccion = document.getElementById('envioDireccion')?.value || '';
  var envioContacto = document.getElementById('envioContacto')?.value || '';
  
  document.getElementById('resumenProducto').innerHTML =
    '<p><strong>Productos:</strong> ' + prodText + '<br>' +
    '<strong>Total (IVA incl.):</strong> ' + cart.reduce(function(s, c) { return s + conIva(c.price); }, 0).toFixed(2) + '€' +
    (lineasData.length > 0 ? lineasResumen : '') +
    '</p>';

  document.getElementById('checkPortaRow').style.display = 'none';

  // Mostrar paso 4
  document.getElementById('wizardStep1').style.display = 'none';
  document.getElementById('wizardStep2').style.display = 'none';
  document.getElementById('wizardStep3').style.display = 'none';
  document.getElementById('wizardStep4').style.display = 'block';
  actualizarProgressBar(4);
  WIZARD.step = 4;

  document.getElementById('checkPago').addEventListener('change', function() {
    document.getElementById('btnCrearCliente').disabled = !this.checked;
  });
}

function goWizardStep1() {
  document.getElementById('wizardStep1').style.display = 'block';
  document.getElementById('wizardStep2').style.display = 'none';
  document.getElementById('wizardStep3').style.display = 'none';
  document.getElementById('wizardStep4').style.display = 'none';
  actualizarProgressBar(1);
  WIZARD.step = 1;
  validarPaso1();
}

// Cart state
var cart = [];
var allProducts = <%- JSON.stringify(products || []) %>;
var allFamilias = <%- JSON.stringify(familias || []) %>;
var donantesList = <%- JSON.stringify(donantes || []) %>;
var lineasData = [];
var IVA = 1.21;
function conIva(precio) { return (parseFloat(precio || 0) * IVA); }

function goWizardStep2() {
  var nombre = document.getElementById('wNombre').value.trim();
  var telefono = document.getElementById('wTelefono').value.trim();
  var dni = document.getElementById('wDni').value.trim();
  if (!nombre) { alert('El nombre es obligatorio'); return; }
  if (!telefono) { alert('El teléfono es obligatorio'); return; }
  if (!dni) { alert('El DNI/NIF es obligatorio'); return; }

  document.getElementById('wizardStep1').style.display = 'none';
  document.getElementById('wizardStep2').style.display = 'block';
  document.getElementById('wizardStep3').style.display = 'none';
  document.getElementById('wizardStep4').style.display = 'none';
  actualizarProgressBar(2);
  WIZARD.step = 2;
  validarPaso2();
}

function selectFamily(family) {
  document.querySelectorAll('.family-icon-card').forEach(function(c) { c.classList.remove('active'); });
  document.querySelector('.family-icon-card[data-family="' + family + '"]').classList.add('active');
  var fam = allFamilias.find(function(f) { return f.name === family; });
  if (!fam) return;
  var grid = document.getElementById('productGrid');
  grid.innerHTML = '';
  (fam.items || []).forEach(function(p) {
    var prodId = p.id || p.productId;
    var name = p.productName || p.name;
    var price = conIva(p.price || 0).toFixed(2);
    var inCart = cart.some(function(c) { return c.id === prodId; });
    var card = document.createElement('div');
    card.className = 'col-md-3 col-6';
    card.innerHTML = '<div class="product-card' + (inCart ? ' in-cart' : '') + '" onclick="toggleCartProduct(\'' + prodId + '\',\'' + name.replace(/'/g,"\\'") + '\',' + (p.price || 0) + ')">' +
      '<div class="product-card-name">' + name + '</div>' +
      '<div class="product-card-price">' + price + '€</div>' +
      '<div class="product-card-btn"><i class="bi bi-' + (inCart ? 'check-circle-fill text-success' : 'plus-circle') + '"></i></div>' +
      '</div>';
    grid.appendChild(card);
  });
  document.getElementById('productGridSection').style.display = '';
  updateCartUI();
}

function clearFamilySelection() {
  document.querySelectorAll('.family-icon-card').forEach(function(c) { c.classList.remove('active'); });
  document.getElementById('productGridSection').style.display = 'none';
  document.getElementById('productGrid').innerHTML = '';
}

function toggleCartProduct(id, name, price) {
  var idx = cart.findIndex(function(c) { return c.id === id; });
  if (idx > -1) {
    cart.splice(idx, 1);
  } else {
    cart.push({ id: id, name: name, price: parseFloat(price || 0) });
  }
  // Update all product cards
  document.querySelectorAll('.product-card').forEach(function(card) {
    var btn = card.querySelector('.product-card-btn i');
    if (btn && card.closest) {
      // Re-render cards to reflect cart state
    }
  });
  selectFamily(document.querySelector('.family-icon-card.active')?.dataset?.family || '');
  updateCartUI();
}

function updateCartUI() {
  var section = document.getElementById('cartSection');
  var items = document.getElementById('cartItems');
  var count = document.getElementById('cartCount');
  var total = document.getElementById('cartTotal');
  count.textContent = cart.length;
  if (cart.length === 0) {
    section.style.display = 'none';
    items.innerHTML = '';
    total.textContent = '0.00€';
    document.getElementById('btnStep2Next').disabled = true;
    return;
  }
  section.style.display = '';
  document.getElementById('btnStep2Next').disabled = false;
  var sum = 0;
  items.innerHTML = cart.map(function(c, i) {
    sum += conIva(c.price);
    return '<div class="d-flex justify-content-between align-items-center py-1 border-bottom"><span><strong>' + c.name + '</strong> <small class="text-muted">' + conIva(c.price).toFixed(2) + '€</small></span><button class="btn btn-sm btn-outline-danger" onclick="removeFromCart(' + i + ')"><i class="bi bi-x"></i></button></div>';
  }).join('');
  total.textContent = sum.toFixed(2) + '€';
}

function removeFromCart(idx) {
  cart.splice(idx, 1);
  selectFamily(document.querySelector('.family-icon-card.active')?.dataset?.family || '');
  updateCartUI();
}

function clearCart() {
  cart = [];
  selectFamily(document.querySelector('.family-icon-card.active')?.dataset?.family || '');
  updateCartUI();
}

function goWizardStep3() {
  if (cart.length === 0) { alert('Añade al menos un producto al carrito'); return; }

  // Generate line forms for each product in cart
  var container = document.getElementById('lineasConfig');
  var html = '';

  cart.forEach(function(prod, idx) {
    var numLineas = 1;
    // Parse product name for bundled lines (e.g., "2x30GB" → 2 lines)
    var match = prod.name.match(/(\d+)x\d+/i);
    if (match) numLineas = parseInt(match[1]);

    var isFiber = allProducts.some(function(p) { return (p.id === prod.id || p.productId === prod.id) && p.family === 'Fiber'; });
    if (isFiber) numLineas = Math.max(numLineas, 1);

    for (var l = 0; l < numLineas; l++) {
      var lineaIdx = idx + '-' + l;
      var label = (numLineas > 1) ? 'Línea ' + (l + 1) + ' de ' + prod.name : prod.name;
      html += '<div class="card mb-2"><div class="card-header py-1"><strong>' + label + '</strong></div><div class="card-body py-2"><div class="row g-2">';
      // Portability / New line type
      html += '<div class="col-md-3"><label class="form-label small">Tipo</label><select class="form-select form-select-sm linea-tipo" data-linea="' + lineaIdx + '" onchange="toggleLineaTipo(\'' + lineaIdx + '\')">';
      html += '<option value="NUEVA_ALTA">Nueva línea</option><option value="PORTABILIDAD">Portabilidad</option></select></div>';
      // Phone number (for portability)
      html += '<div class="col-md-3 linea-porta-group" id="lnum-' + lineaIdx + '" style="display:none;"><label class="form-label small">Número a portar</label><input type="text" class="form-control form-control-sm linea-porta-num" data-linea="' + lineaIdx + '" placeholder="612345678"></div>';
      // Donor operator (for portability)
      html += '<div class="col-md-3 linea-porta-group" id="ldon-' + lineaIdx + '" style="display:none;"><label class="form-label small">Operador actual</label><select class="form-select form-select-sm linea-donante" data-linea="' + lineaIdx + '"><option value="">Seleccionar...</option>';
      donantesList.forEach(function(d) { html += '<option value="' + (d.Code || d.code || d.id) + '">' + (d.Name || d.name || d.Code || d.code) + '</option>'; });
      html += '</select></div>';
      // Cambio de titular (for portability)
      html += '<div class="col-md-3 linea-porta-group" id="ltit-' + lineaIdx + '" style="display:none;"><label class="form-label small">Titularidad</label><select class="form-select form-select-sm linea-titular" data-linea="' + lineaIdx + '"><option value="mantener">Mantener titular</option><option value="cambiar">Cambiar titular</option></select></div>';
      // SIM type
      html += '<div class="col-md-3"><label class="form-label small">Tipo SIM</label><select class="form-select form-select-sm linea-sim" data-linea="' + lineaIdx + '" onchange="toggleLineaIcc(\'' + lineaIdx + '\')">';
      html += '<option value="fisica">SIM física</option><option value="esim">eSIM</option></select></div>';
      // ICC
      html += '<div class="col-md-3 linea-icc-group" id="licc-' + lineaIdx + '"><label class="form-label small">ICC (código SIM)</label><input type="text" class="form-control form-control-sm linea-icc" data-linea="' + lineaIdx + '" placeholder="8934..."></div>';
      html += '</div></div></div>';
    }
  });

  // SIM shipping section
  html += '<div class="card mt-2"><div class="card-header py-1"><strong>📦 Envío de SIM</strong></div><div class="card-body py-2"><div class="row g-2">';
  html += '<div class="col-md-4"><label class="form-label small">Método de envío</label><select class="form-select form-select-sm" id="envioMetodo"><option value="manual">Envío manual</option><option value="MRW">MRW</option><option value="SEUR">SEUR</option><option value="Correos">Correos</option></select></div>';
  html += '<div class="col-md-4"><label class="form-label small">Dirección de envío</label><input type="text" class="form-control form-control-sm" id="envioDireccion" placeholder="Calle, número, ciudad, CP"></div>';
  html += '<div class="col-md-4"><label class="form-label small">Contacto</label><input type="text" class="form-control form-control-sm" id="envioContacto" placeholder="Nombre y teléfono"></div>';
  html += '</div></div></div>';

  container.innerHTML = html;
  validarPaso3();

  document.getElementById('wizardStep1').style.display = 'none';
  document.getElementById('wizardStep2').style.display = 'none';
  document.getElementById('wizardStep3').style.display = 'block';
  document.getElementById('wizardStep4').style.display = 'none';
  actualizarProgressBar(3);
  WIZARD.step = 3;
}

function toggleLineaTipo(lineaIdx) {
  var tipo = document.querySelector('.linea-tipo[data-linea="' + lineaIdx + '"]').value;
  document.getElementById('lnum-' + lineaIdx).style.display = tipo === 'PORTABILIDAD' ? '' : 'none';
  document.getElementById('ldon-' + lineaIdx).style.display = tipo === 'PORTABILIDAD' ? '' : 'none';
  document.getElementById('ltit-' + lineaIdx).style.display = tipo === 'PORTABILIDAD' ? '' : 'none';
  validarPaso3();
}

function toggleLineaIcc(lineaIdx) {
  var sim = document.querySelector('.linea-sim[data-linea="' + lineaIdx + '"]').value;
  document.getElementById('licc-' + lineaIdx).style.display = sim === 'fisica' ? '' : 'none';
}

// Payment methods
function togglePago() {
  var metodoEl = document.querySelector('input[name="wMetodoPago"]:checked');
  var metodo = metodoEl ? metodoEl.value : '';
  document.getElementById('pagoIBANContent').style.display = metodo === 'IBAN' ? '' : 'none';
  document.getElementById('pagoTarjetaContent').style.display = metodo === 'TARJETA' ? '' : 'none';
  document.getElementById('pagoNingunoContent').style.display = metodo === 'NINGUNO' ? '' : 'none';
  document.querySelectorAll('.pago-card').forEach(function(c) {
    c.classList.toggle('active', c.querySelector('input') && c.querySelector('input').checked);
  });
}

function formatearIBAN(input) {
  var val = input.value.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
  var formatted = '';
  for (var i = 0; i < val.length && i < 24; i += 4) {
    formatted += val.substring(i, i + 4) + ' ';
  }
  input.value = formatted.trim();
}

function validarDNI(input) {
  var val = input.value.trim();
  var valEl = document.getElementById('wDniVal');
  if (val.length < 5) { valEl.textContent = ''; return; }
  var dniRegex = /^[0-9]{8}[A-Z]$/;
  var nieRegex = /^[XYZ][0-9]{7}[A-Z]$/;
  if (dniRegex.test(val) || nieRegex.test(val)) {
    valEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Formato correcto</span>';
  } else {
    valEl.innerHTML = '<span class="text-warning"><i class="bi bi-exclamation-triangle"></i> Formato incorrecto (ej: 12345678Z)</span>';
  }
}

// Coverage check
function checkCoverage() {
  var dir = document.getElementById('wCoverageDir').value.trim();
  if (!dir) { alert('Introduce una dirección'); return; }
  var resultEl = document.getElementById('coverageResult');
  var btn = document.getElementById('btnCheckCoverage');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Verificando...';
  resultEl.innerHTML = '<div class="text-center py-3"><span class="spinner-border text-primary spinner-border-sm"></span> <span class="text-muted">Consultando cobertura...</span></div>';

  fetch('/api/cobertura?address=' + encodeURIComponent(dir))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var addresses = data?.addresses || data?.results || data?.data || (Array.isArray(data) ? data : []);
      if (addresses.length > 0) {
        var addr = addresses[0];
        resultEl.innerHTML =
          '<div class="alert alert-success mb-0 d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill fs-5"></i> <span><strong>Cobertura disponible</strong><br><small>' + (addr.fullAddress || addr.address || addr.name || addr.label || 'Dirección encontrada') + '</small></span></div>';
      } else {
        resultEl.innerHTML = '<div class="alert alert-danger mb-0 d-flex align-items-center gap-2"><i class="bi bi-x-circle-fill fs-5"></i> <span><strong>Sin cobertura</strong><br><small>No hay cobertura disponible en esta dirección</small></span></div>';
      }
    })
    .catch(function(e) {
      resultEl.innerHTML = '<div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle"></i> Error al verificar. Introduce una dirección más concreta.</div>';
    })
    .finally(function() {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-search"></i> Verificar cobertura';
    });
}

// Contract preview modal
function verContrato() {
  var frame = document.getElementById('contratoIframe');
  var token = document.getElementById('orderTokenHolder').value;
  var externoLink = document.getElementById('contratoAbrirExterno');
  if (token) {
    var url = '/kyc/contrato/' + encodeURIComponent(token);
    frame.src = url;
    externoLink.href = url;
    externoLink.style.display = 'inline-block';
  } else {
    frame.src = '';
    frame.srcdoc = '<div style="text-align:center;padding:60px 20px;color:#6c757d;font-family:sans-serif;"><i class="bi bi-file-text" style="font-size:2.5rem;display:block;margin-bottom:16px;color:#0d6efd;"></i><h5>Contrato no disponible</h5><p style="color:#6c757d;">Primero crea el cliente para generar el contrato.</p></div>';
    externoLink.href = '#';
