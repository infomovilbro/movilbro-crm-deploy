<section>
<style>
.fn-card{background:#fff;border-radius:10px;border:1px solid #e0e0e0;padding:14px;margin-bottom:10px;border-left:4px solid #e74c3c;}
.fn-card.fixed{border-left-color:#27ae60;opacity:0.7;}
.fn-card .fn-url{font-size:0.75rem;color:#888;word-break:break-all;margin-bottom:4px;}
.fn-card .fn-sel{font-size:0.75rem;color:#999;font-family:monospace;background:#f5f5f5;padding:2px 6px;border-radius:4px;}
.fn-card .fn-note{font-size:0.9rem;margin:6px 0;}
.fn-card .fn-text{font-size:0.8rem;color:#666;background:#fafafa;padding:4px 8px;border-radius:4px;border-left:2px solid #ddd;}
.fn-card .fn-meta{font-size:0.7rem;color:#aaa;}
.fn-card .fn-verif{font-size:0.75rem;color:#27ae60;background:#e8f5e9;padding:3px 8px;border-radius:4px;margin-top:4px;}
.fn-card .fn-type{font-size:0.6rem;padding:1px 6px;border-radius:8px;font-weight:600;text-transform:uppercase;}
.type-cliente{background:#e3f2fd;color:#1565c0;}
.type-factura{background:#fff3e0;color:#e65100;}
.type-cdr{background:#f3e5f5;color:#7b1fa2;}
.type-codeopen{background:#e8f5e9;color:#2e7d32;}
.type-ui{background:#fce4ec;color:#c62828;}
.type-global{background:#f5f5f5;color:#616161;}
.fn-test-result{font-size:0.75rem;padding:3px 8px;border-radius:4px;margin-top:4px;}
.fn-test-ok{background:#e8f5e9;color:#2e7d32;}
.fn-test-fail{background:#ffebee;color:#c62828;}
</style>
<div class="card mb-3 bg-light">
  <div class="card-body py-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <button class="btn btn-sm btn-outline-primary" onclick="saveToDrive()"><i class="bi bi-cloud-upload"></i> Guardar en Drive</button>
      <button class="btn btn-sm btn-outline-info" onclick="toggleDriveHistory()"><i class="bi bi-cloud-download"></i> Cargar de Drive</button>
      <span id="driveStatus" class="small text-muted"></span>
    </div>
    <div id="driveHistoryPanel" class="mt-2" style="display:none">
      <div class="card"><div class="card-body">
        <div class="d-flex gap-2 align-items-center mb-2 flex-wrap" id="dhNav">
          <button class="btn btn-sm btn-outline-secondary" onclick="dhLoadYears()">📂 Raíz</button>
          <span id="dhPath" class="small text-muted"></span>
        </div>
        <div id="dhContent" class="small" style="max-height:300px;overflow-y:auto;"><div class="text-muted">Cargando...</div></div>
      </div></div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><i class="bi bi-bug me-2"></i>Notas de Error — Soluciones Pendientes</h4>
  <span class="badge bg-danger fs-6"><%= pending.length %> pendientes</span>
</div>

<% if (pending.length === 0) { %>
<div class="alert alert-success">🎉 No hay errores pendientes de revisar.</div>
<% } else { %>
  <% pending.forEach(function(n) { %>
  <div class="fn-card" id="fn_<%= n.id %>">
    <div class="d-flex justify-content-between align-items-start">
      <div class="flex-grow-1">
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="fn-type type-<%= n.type || 'global' %>"><%= (n.type || 'global').toUpperCase() %></span>
          <span class="fn-meta">#<%= n.id %> · <%= n.created_at %></span>
        </div>
        <div class="fn-url"><i class="bi bi-link-45deg"></i> <a href="<%= n.url %>" target="_blank"><%= n.url %></a></div>
        <% if (n.selector) { %><div class="fn-sel"><%= n.selector %></div><% } %>
        <div class="fn-note"><%= n.note %></div>
        <% if (n.element_text) { %><div class="fn-text">📄 <%= n.element_text.substring(0,150) %></div><% } %>
        <div id="testResult_<%= n.id %>" class="fn-test-result" style="display:none;"></div>
      </div>
      <div class="d-flex gap-1 flex-shrink-0 ms-2 flex-wrap" style="max-width:130px;">
        <button class="btn btn-sm btn-outline-info" onclick="fnTest(<%= n.id %>)" title="Comprobar si funciona en TODOS los clientes" style="font-size:0.65rem;"><i class="bi bi-search"></i> Comprobar</button>
        <button class="btn btn-sm btn-outline-success" onclick="fnFix(<%= n.id %>)" title="Marcar como arreglado (solo si pasó comprobación)">✅ Hecho</button>
        <button class="btn btn-sm btn-outline-danger" onclick="fnDel(<%= n.id %>)" title="Eliminar">🗑️</button>
        <button class="btn btn-sm btn-outline-warning" onclick="fnReport(<%= n.id %>)" title="Reportar que sigue fallando" style="font-size:0.65rem;">❌ Reportar fallo</button>
      </div>
    </div>
  </div>
  <% }); %>
<% } %>

<% if (fixed.length > 0) { %>
<h5 class="mt-4 mb-2"><i class="bi bi-check-circle text-success me-1"></i>Arreglados (<%= fixed.length %>)</h5>
<% fixed.forEach(function(n) { %>
<div class="fn-card fixed">
  <div class="d-flex align-items-center gap-2 mb-1">
    <span class="fn-type type-<%= n.type || 'global' %>"><%= (n.type || 'global').toUpperCase() %></span>
    <span class="fn-meta">#<%= n.id %> · ✅ <%= n.fixed_at %></span>
  </div>
  <div class="fn-url"><i class="bi bi-link-45deg"></i> <%= n.url %></div>
  <% if (n.selector) { %><div class="fn-sel"><%= n.selector %></div><% } %>
  <div class="fn-note"><%= n.note %></div>
  <% if (n.verification) { %><div class="fn-verif"><i class="bi bi-check-circle"></i> <%= n.verification %></div><% } %>
  <div class="d-flex gap-1 mt-1">
    <button class="btn btn-sm btn-outline-info" onclick="fnTest(<%= n.id %>)" style="font-size:0.65rem;"><i class="bi bi-arrow-repeat"></i> Re-test</button>
    <button class="btn btn-sm btn-outline-warning" onclick="fnReport(<%= n.id %>)" style="font-size:0.65rem;">❌ Sigue fallando</button>
  </div>
</div>
<% }); %>
<% } %>
</section>

<script>
function fnFix(id) {
  var verif = prompt('Describe brevemente cómo comprobaste que funciona (ej: "Test 188/188 clientes OK"):');
  if (verif === null) return;
  fetch('/api/fix-notes/' + id + '/fix', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({ verification: verif || 'Sin verification' })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.ok) { location.reload(); }
    else { alert('Error: ' + d.error); }
  });
}

function fnTest(id) {
  var resultDiv = document.getElementById('testResult_' + id);
  resultDiv.style.display = 'block';
  resultDiv.className = 'fn-test-result';
  resultDiv.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Probando...';
  resultDiv.style.display = 'block';
  fetch('/api/fix-notes/test/' + id, { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (!d.ok) {
        resultDiv.className = 'fn-test-result fn-test-fail';
        resultDiv.innerHTML = '❌ Error: ' + (d.error || '');
        return;
      }
      var cls = d.failed === 0 ? 'fn-test-ok' : 'fn-test-fail';
      var icon = d.failed === 0 ? '✅' : '❌';
      resultDiv.className = 'fn-test-result ' + cls;
      var extra = d.note ? '<br><small>' + d.note + '</small>' : '';
      var samples = d.samples && d.samples.length > 0 ? '<br><small class="text-muted">Ejemplos que fallan: ' + d.samples.join(', ') + '</small>' : '';
      resultDiv.innerHTML = icon + ' Probados: ' + d.tested + ' | ✅ OK: ' + d.passed + ' | ❌ Fallos: ' + d.failed + extra + samples;
    })
    .catch(function(e) {
      resultDiv.className = 'fn-test-result fn-test-fail';
      resultDiv.innerHTML = '❌ Error de conexión: ' + e.message;
    });
}

function fnReport(originalId) {
  var url = prompt('Pega la URL exacta donde falla (o pulsa Cancelar para usar la actual):');
  if (url === null) return;
  if (!url) url = window.location.href;
  var selector = prompt('Selector CSS del elemento que falla (opcional, lo que ves en el inspector):');
  var note = prompt('Describe QUÉ esperabas ver y QUÉ ves en su lugar:');
  if (!note) { alert('Necesito una descripción del fallo'); return; }
  fetch('/api/fix-notes/report-fail', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({ originalId: originalId, url: url, selector: selector || '', note: note })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.ok) { alert('✅ Fallo reportado como #' + d.id + '. Lo revisaré ahora mismo.'); location.reload(); }
    else { alert('Error: ' + d.error); }
  });
}

function fnDel(id) {
  if (!confirm('¿Eliminar nota #' + id + '?')) return;
  fetch('/api/fix-notes/' + id, { method: 'DELETE' })
    .then(function(r) { return r.json(); })
    .then(function(d) { if (d.ok) document.getElementById('fn_' + id).remove(); });
}

// Drive persistence con navegador de fechas
function saveToDrive() {
  var status = document.getElementById('driveStatus');
  status.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Guardando...';
  fetch('/api/fix-notes/save-to-drive', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.ok) status.innerHTML = '<span class="text-success">✓ Guardado en Drive</span>';
      else status.innerHTML = '<span class="text-warning">⚠️ ' + (d.error || 'Error') + '</span>';
    })
    .catch(function(e) { status.innerHTML = '<span class="text-danger">⚠️ Error de conexión</span>'; });
}
function toggleDriveHistory() {
  var p = document.getElementById('driveHistoryPanel');
  p.style.display = p.style.display === 'none' ? 'block' : 'none';
  if (p.style.display === 'block') dhLoadYears();
}
var dhState = {};
function dhShow(msg) { document.getElementById('dhContent').innerHTML = msg; }
function dhPath(t) { document.getElementById('dhPath').textContent = t; }
function dhLoadYears() {
  dhState = {}; dhPath('');
  fetch('/api/fix-notes/drive-history').then(function(r){return r.json()}).then(function(d){
    if (!d.ok||!d.years||d.years.length===0){dhShow('<div class="text-muted">Sin datos en Drive</div>');return;}
    var h='<div class="fw-bold mb-1">Años:</div><div class="d-flex gap-1 flex-wrap">';
    d.years.forEach(function(y){h+='<button class="btn btn-sm btn-outline-primary" onclick="dhLoadMonths(\''+y.name+'\')">'+y.name+'</button>';});
    h+='</div>';dhShow(h);
  }).catch(function(){dhShow('<div class="text-danger">Error al cargar</div>');});
}
function dhLoadMonths(year){
  fetch('/api/fix-notes/drive-history').then(function(r){return r.json()}).then(function(d){
    if(!d.ok)return;
    var yr=d.years.find(function(y){return y.name===year;});if(!yr)return;
    dhPath(year);
    var h='<div class="fw-bold mb-1">Meses de '+year+':</div><div class="d-flex gap-1 flex-wrap">';
    yr.months.forEach(function(m){h+='<button class="btn btn-sm btn-outline-info" onclick="dhLoadDays(\''+year+'\',\''+m.name+'\')">'+m.name+'</button>';});
    h+='</div>';dhShow(h);
  });
}
function dhLoadDays(year,month){
  fetch('/api/fix-notes/drive-history').then(function(r){return r.json()}).then(function(d){
    if(!d.ok)return;
    var yr=d.years.find(function(y){return y.name===year;});if(!yr)return;
    var mo=yr.months.find(function(m){return m.name===month;});if(!mo)return;
    dhPath(year+'/'+month);
    var h='<div class="fw-bold mb-1">Días de '+month+':</div><div class="d-flex gap-1 flex-wrap">';
    mo.days.forEach(function(day){h+='<button class="btn btn-sm btn-outline-secondary" onclick="dhLoadFiles(\''+year+'\',\''+month+'\',\''+day.name+'\')">'+day.name+'</button>';});
    h+='</div>';dhShow(h);
  });
}
function dhLoadFiles(year,month,day){
  fetch('/api/fix-notes/drive-history').then(function(r){return r.json()}).then(function(d){
    if(!d.ok)return;
    var yr=d.years.find(function(y){return y.name===year;});if(!yr)return;
    var mo=yr.months.find(function(m){return m.name===month;});if(!mo)return;
    var dy=mo.days.find(function(d2){return d2.name===day;});if(!dy)return;
    dhPath(year+'/'+month+'/'+day);
    if(!dy.files||dy.files.length===0){dhShow('<div class="text-muted">Sin archivos</div>');return;}
    var h='<div class="fw-bold mb-1">Archivos:</div>';
    dy.files.forEach(function(f){
      h+='<div class="d-flex align-items-center gap-2 mb-1 p-1 border rounded"><span style="flex:1;font-size:0.75rem;">'+f.name+'</span>';
      h+='<button class="btn btn-sm btn-outline-success" onclick="dhLoadSnapshot(\''+f.id+'\',\''+f.name+'\')">📂 Cargar</button></div>';
    });
    dhShow(h);
  });
}
function dhLoadSnapshot(fileId,fileName){
  var status=document.getElementById('driveStatus');
  status.innerHTML='<span class="spinner-border spinner-border-sm"></span> Cargando '+fileName+'...';
  fetch('/api/fix-notes/drive-snapshot-by-id/'+fileId).then(function(r){return r.json()}).then(function(d){
    if(d.ok&&d.data){
      status.innerHTML='<span class="text-success">✓ Cargado: '+d.fileName+' ('+d.data.notes.length+' notas)</span>';
      // Recargar pagina para mostrar las notas cargadas (se importan al cargar)
      if(confirm('Cargado '+d.data.notes.length+' notas. Refrescar pagina?')) location.reload();
    }else{status.innerHTML='<span class="text-warning">⚠️ Error al cargar</span>';}
  }).catch(function(){status.innerHTML='<span class="text-warning">⚠️ Error de conexion</span>';});
}
</script>
</section>